function SoftFloatISqrt64(const aValue:TPasRISCVUInt64):TPasRISCVUInt64;
var s,r,Bit:TPasRISCVUInt64;
begin
 s:=0;
 r:=aValue;
 Bit:=TPasRISCVUInt64(1) shl 62;
 while Bit>r do begin
  Bit:=Bit shr 2;
 end;
 while Bit<>0 do begin
  if r>=(s+Bit) then begin
   r:=r-s-Bit;
   s:=(s shr 1)+Bit;
  end else begin
   s:=s shr 1;
  end;
  Bit:=Bit shr 2;
 end;
 result:=s;
end;

function SoftFloatISqrt128(const aValue:TSoftFloatBits128):TPasRISCVUInt64;
var s,r,Bit,Temporary:TSoftFloatBits128;
begin
 s:=SoftFloatBits128Zero;
 r:=aValue;
 Bit:=SoftFloatBits128SingleBit(126);
 while (not SoftFloatBits128IsZero(Bit)) and (SoftFloatBits128Compare(Bit,r)>0) do begin
  Bit:=SoftFloatBits128Shr(Bit,2);
 end;
 while not SoftFloatBits128IsZero(Bit) do begin
  Temporary:=SoftFloatBits128Add(s,Bit);
  if SoftFloatBits128Compare(r,Temporary)>=0 then begin
   r:=SoftFloatBits128Sub(r,Temporary);
   s:=SoftFloatBits128Shr(s,1);
   s:=SoftFloatBits128Add(s,Bit);
  end else begin
   s:=SoftFloatBits128Shr(s,1);
  end;
  Bit:=SoftFloatBits128Shr(Bit,2);
 end;
 result:=s.Lo;
end;

