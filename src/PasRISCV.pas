    ExtMantissa:TPasRISCVUInt64;
begin
 if aSourceBits<64 then begin
  aValue:=aValue and ((TPasRISCVUInt64(1) shl aSourceBits)-1);
 end;
 if aValue=0 then begin
  result:=0;
  exit;
 end;
 Position:=63-SoftFloatCLZ64(aValue);
 Exponent:=Position+aExponentBias;
 if Position>(aMantissaBits+3) then begin
  ExtMantissa:=SoftFloatShiftRightJam64(aValue,Position-(aMantissaBits+3));
 end else begin
  ExtMantissa:=aValue shl ((aMantissaBits+3)-Position);
 end;
 result:=SoftFloatRoundPack(aSign,Exponent,ExtMantissa,aMantissaBits,aSignShift,aInfiniteExponent,0,aRM,aFFlags);
end;

function SoftFloatUIntToFloat(const aValue:TPasRISCVUInt64;const aSourceBits,aMantissaBits,aSignShift:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32;const aExponentBias:TPasRISCVInt32;const aRM:TPasRISCVUInt8;var aFFlags:TPasRISCVUInt8):TPasRISCVUInt64;
begin
 result:=SoftFloatUIntToFloatWithSign(aValue,aSourceBits,aMantissaBits,aSignShift,aInfiniteExponent,aExponentBias,false,aRM,aFFlags);
end;

function SoftFloatIntToFloat(v:TPasRISCVInt64;const SourceBits,MantissaBits,SignShift:TPasRISCVInt32;const InfiniteExponent:TPasRISCVUInt32;const ExponentBias:TPasRISCVInt32;const aRM:TPasRISCVUInt8;var aFFlags:TPasRISCVUInt8):TPasRISCVUInt64;
var absV:TPasRISCVUInt64;
begin
 if v=0 then begin
  result:=0;
 end else if v<0 then begin
  absV:=TPasRISCVUInt64(-(v+1));
  inc(absV);
  result:=SoftFloatUIntToFloatWithSign(absV,SourceBits,MantissaBits,SignShift,InfiniteExponent,ExponentBias,true,aRM,aFFlags);
 end else begin
  result:=SoftFloatUIntToFloatWithSign(TPasRISCVUInt64(v),SourceBits,MantissaBits,SignShift,InfiniteExponent,ExponentBias,false,aRM,aFFlags);
 end;
end;

function SoftFloatFloatToUInt(const aA:TPasRISCVUInt64;const aMantissaBits,aSignShift:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32;const aExponentBias:TPasRISCVInt32;const aDestinationBits:TPasRISCVInt32;const aIsSigned:boolean;const aRM:TPasRISCVUInt8;var aFFlags:TPasRISCVUInt8):TPasRISCVUInt64;
var Sign,NonZero:boolean;
    Exponent,TrueExponent,Shift:TPasRISCVInt32;
    Mantissa,Sig,AbsoluteInteger,Rounded,MaxUnsigned,MaxSigned,MinSignedAbsolute:TPasRISCVUInt64;
    GRS:TPasRISCVUInt8;
begin
 SoftFloatUnpack(aA,aMantissaBits,aSignShift,aInfiniteExponent,Sign,Exponent,Mantissa);
 NonZero:=not ((Exponent=0) and (Mantissa=0));
 if SoftFloatIsNaN(Exponent,Mantissa,aInfiniteExponent) then begin
  aFFlags:=aFFlags or SoftFloatFF_NV;
  if aIsSigned then begin
   if aDestinationBits=64 then begin
    result:=(TPasRISCVUInt64(1) shl 63)-1;
   end else begin
    result:=(TPasRISCVUInt64(1) shl (aDestinationBits-1))-1;
   end;
  end else begin
   if aDestinationBits=64 then begin
    result:=not TPasRISCVUInt64(0);
   end else begin
    result:=(TPasRISCVUInt64(1) shl aDestinationBits)-1;
   end;
  end;
  exit;
 end;
{if Sign and (not aIsSigned) and NonZero then begin
  aFFlags:=aFFlags or SoftFloatFF_NV;
  result:=0;
  exit;
 end;}
 if Exponent=TPasRISCVInt32(aInfiniteExponent) then begin
  aFFlags:=aFFlags or SoftFloatFF_NV;
  if aIsSigned then begin
   if Sign then begin
    result:=TPasRISCVUInt64(1) shl (aDestinationBits-1);
   end else if aDestinationBits=64 then begin
    result:=(TPasRISCVUInt64(1) shl 63)-1;
   end else begin
    result:=(TPasRISCVUInt64(1) shl (aDestinationBits-1))-1;
   end;
  end else begin
   if Sign then begin
    result:=0;
   end else if aDestinationBits=64 then begin
    result:=not TPasRISCVUInt64(0);
   end else begin
    result:=(TPasRISCVUInt64(1) shl aDestinationBits)-1;
   end;
  end;
  exit;
 end;
 if not NonZero then begin
  result:=0;
  exit;
 end;
 Sig:=Mantissa;
 SoftFloatNormalizeOperand(Exponent,Sig,aMantissaBits);
 TrueExponent:=Exponent-aExponentBias;
 if aDestinationBits=64 then begin
  MaxUnsigned:=not TPasRISCVUInt64(0);
 end else begin
  MaxUnsigned:=(TPasRISCVUInt64(1) shl aDestinationBits)-1;
 end;
 if aDestinationBits=64 then begin
  MaxSigned:=(TPasRISCVUInt64(1) shl 63)-1;
  MinSignedAbsolute:=TPasRISCVUInt64(1) shl 63;
 end else begin
  MaxSigned:=(TPasRISCVUInt64(1) shl (aDestinationBits-1))-1;
  MinSignedAbsolute:=TPasRISCVUInt64(1) shl (aDestinationBits-1);
 end;
 if TrueExponent>=aMantissaBits then begin
  Shift:=TrueExponent-aMantissaBits;
  if Shift>63 then begin
   aFFlags:=aFFlags or SoftFloatFF_NV;
   if aIsSigned then begin
    if Sign then begin
     result:=MinSignedAbsolute;
    end else begin
     result:=MaxSigned;
    end;
   end else begin
    //result:=MaxUnsigned;
    if Sign then begin
     result:=0;
    end else begin
     result:=MaxUnsigned;
    end;
   end;
   exit;
  end;
  AbsoluteInteger:=Sig shl Shift;
  GRS:=0;
 end else if TrueExponent>=0 then begin
  Shift:=aMantissaBits-TrueExponent;
  AbsoluteInteger:=Sig shr Shift;
  GRS:=SoftFloatMakeGRSFromShiftedValue(Sig,Shift);
 end else begin
  AbsoluteInteger:=0;
  GRS:=SoftFloatMakeGRSFromShiftedValue(Sig,aMantissaBits-TrueExponent);
 end;
 Rounded:=AbsoluteInteger;
 if (GRS<>0) and SoftFloatRoundBit(Sign,TPasRISCVUInt8(Rounded and 1),GRS,aRM) then begin
  inc(Rounded);
 end;
 if aIsSigned then begin
  if Sign then begin
   if Rounded>MinSignedAbsolute then begin
    aFFlags:=aFFlags or SoftFloatFF_NV;
    result:=MinSignedAbsolute;
    exit;
   end;
  end else begin
   if Rounded>MaxSigned then begin
    aFFlags:=aFFlags or SoftFloatFF_NV;
    result:=MaxSigned;
    exit;
   end;
  end;
 end else begin
  if Rounded>MaxUnsigned then begin
   aFFlags:=aFFlags or SoftFloatFF_NV;
   result:=MaxUnsigned;
   exit;
  end;
 end;
 if GRS<>0 then begin
  aFFlags:=aFFlags or SoftFloatFF_NX;
 end;
 if Sign then begin
  if Rounded=0 then begin
   result:=0;
  end else if not aIsSigned then begin
   aFFlags:=(aFFlags and not SoftFloatFF_NX) or SoftFloatFF_NV;
   result:=0;
  end else if Rounded=MinSignedAbsolute then begin
   result:=MinSignedAbsolute;
  end else begin
   result:=(not Rounded)+1;
   if aDestinationBits<64 then begin
    result:=result and ((TPasRISCVUInt64(1) shl aDestinationBits)-1);
   end;
  end;
 end else begin
  result:=Rounded;
 end;
end;

function SoftFloatConvertFloatBits(const aA:TPasRISCVUInt64;const aSourceMantissaBits,aSourceSignShift:TPasRISCVInt32;const aSourceInfiniteExponent:TPasRISCVUInt32;const aSourceExponentBias:TPasRISCVInt32;const aDestinationMantissaBits,aDestinationSignShift:TPasRISCVInt32;const DestinationInfiniteExponent:TPasRISCVUInt32;const aDestinationExponentBias:TPasRISCVInt32;const aDestinationCanonicalNaN:TPasRISCVUInt64;const aRM:TPasRISCVUInt8;var aFFlags:TPasRISCVUInt8):TPasRISCVUInt64;
var Sign:boolean;
    Exponent,DestinationExponent,Shift:TPasRISCVInt32;
    Mantissa,Sig,ExtMantissa:TPasRISCVUInt64;
begin
 SoftFloatUnpack(aA,aSourceMantissaBits,aSourceSignShift,aSourceInfiniteExponent,Sign,Exponent,Mantissa);
 if SoftFloatIsNaN(Exponent,Mantissa,aSourceInfiniteExponent) then begin
  if SoftFloatIsSignalingNaN(Mantissa,aSourceMantissaBits) then begin
   aFFlags:=aFFlags or SoftFloatFF_NV;
  end;
//result:=SoftFloatConvertNaN(Sign,Mantissa,aSourceMantissaBits,aDestinationMantissaBits,aDestinationSignShift,DestinationInfiniteExponent);
  result:=aDestinationCanonicalNaN;
  exit;
 end;
 if Exponent=TPasRISCVInt32(aSourceInfiniteExponent) then begin
  result:=SoftFloatInf(Sign,aDestinationSignShift,aDestinationMantissaBits,DestinationInfiniteExponent);
  exit;
 end;
 if (Exponent=0) and (Mantissa=0) then begin
  result:=SoftFloatZero(Sign,aDestinationSignShift);
  exit;
 end;
 Sig:=Mantissa;
 SoftFloatNormalizeOperand(Exponent,Sig,aSourceMantissaBits);
 DestinationExponent:=Exponent-aSourceExponentBias+aDestinationExponentBias;
 Shift:=aSourceMantissaBits-(aDestinationMantissaBits+3);
 if Shift>0 then begin
  ExtMantissa:=SoftFloatShiftRightJam64(Sig,Shift);
 end else if Shift<0 then begin
  ExtMantissa:=Sig shl (-Shift);
 end else begin
  ExtMantissa:=Sig;
 end;
 if DestinationExponent<=0 then begin
  ExtMantissa:=SoftFloatShiftRightJam64(ExtMantissa,1-DestinationExponent);
  DestinationExponent:=0;
 end;
 result:=SoftFloatRoundPack(Sign,DestinationExponent,ExtMantissa,aDestinationMantissaBits,aDestinationSignShift,DestinationInfiniteExponent,aDestinationCanonicalNaN,aRM,aFFlags);
end;

