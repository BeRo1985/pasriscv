constructor TPasRISCV.TSnapshot.Create;
begin
 inherited Create;
 fRoot:=TNode.Create;
 fRoot.fType:=TType.ObjectValue;
 fRoot.fKey:='';
 fCompression:=TSnapshotCompression.None;
 fCompressionLevel:=5;
end;

destructor TPasRISCV.TSnapshot.Destroy;
begin
 FreeAndNil(fRoot);
 inherited Destroy;
end;

procedure TPasRISCV.TSnapshot.TNode.SerializeToStream(const aStream:TStream);
var TypeTag:TPasRISCVUInt8;
    KeyLen:TPasRISCVUInt16;
    ChildCount:TPasRISCVUInt32;
    StrLen:TPasRISCVUInt32;
    Index:TPasRISCVInt32;
begin
 TypeTag:=ord(fType);
 aStream.WriteBuffer(TypeTag,SizeOf(TPasRISCVUInt8));
 KeyLen:=length(fKey);
 aStream.WriteBuffer(KeyLen,SizeOf(TPasRISCVUInt16));
 if KeyLen>0 then begin
  aStream.WriteBuffer(fKey[1],KeyLen);
 end;
 case fType of
  TPasRISCV.TSnapshot.TType.None,
  TPasRISCV.TSnapshot.TType.Null:begin
  end;
  TPasRISCV.TSnapshot.TType.Bool:begin
   aStream.WriteBuffer(fValue.ValueBool,SizeOf(TPasRISCVUInt8));
  end;
  TPasRISCV.TSnapshot.TType.UInt8:begin
   aStream.WriteBuffer(fValue.ValueUInt8,SizeOf(TPasRISCVUInt8));
  end;
  TPasRISCV.TSnapshot.TType.UInt16:begin
   aStream.WriteBuffer(fValue.ValueUInt16,SizeOf(TPasRISCVUInt16));
  end;
  TPasRISCV.TSnapshot.TType.UInt32:begin
   aStream.WriteBuffer(fValue.ValueUInt32,SizeOf(TPasRISCVUInt32));
  end;
  TPasRISCV.TSnapshot.TType.UInt64:begin
   aStream.WriteBuffer(fValue.ValueUInt64,SizeOf(TPasRISCVUInt64));
  end;
  TPasRISCV.TSnapshot.TType.Int8:begin
   aStream.WriteBuffer(fValue.ValueInt8,SizeOf(TPasRISCVInt8));
  end;
  TPasRISCV.TSnapshot.TType.Int16:begin
   aStream.WriteBuffer(fValue.ValueInt16,SizeOf(TPasRISCVInt16));
  end;
  TPasRISCV.TSnapshot.TType.Int32:begin
   aStream.WriteBuffer(fValue.ValueInt32,SizeOf(TPasRISCVInt32));
  end;
  TPasRISCV.TSnapshot.TType.Int64:begin
   aStream.WriteBuffer(fValue.ValueInt64,SizeOf(TPasRISCVInt64));
  end;
  TPasRISCV.TSnapshot.TType.Float16:begin
   aStream.WriteBuffer(fValue.ValueFloat16,SizeOf(TPasRISCVHalfFloat));
  end;
  TPasRISCV.TSnapshot.TType.BFloat16:begin
   aStream.WriteBuffer(fValue.ValueBFloat16,SizeOf(TPasRISCVUInt16));
  end;
  TPasRISCV.TSnapshot.TType.Float32:begin
   aStream.WriteBuffer(fValue.ValueFloat32,SizeOf(TPasRISCVFloat));
  end;
  TPasRISCV.TSnapshot.TType.Float64:begin
   aStream.WriteBuffer(fValue.ValueFloat64,SizeOf(TPasRISCVDouble));
  end;
  TPasRISCV.TSnapshot.TType.StringValue:begin
   StrLen:=length(fValue.ValueString);
   aStream.WriteBuffer(StrLen,SizeOf(TPasRISCVUInt32));
   if StrLen>0 then begin
    aStream.WriteBuffer(fValue.ValueString[1],StrLen);
   end;
  end;
  TPasRISCV.TSnapshot.TType.Binary:begin
   aStream.WriteBuffer(fValue.ValueBinarySize,SizeOf(TPasRISCVUInt64));
   if fValue.ValueBinarySize>0 then begin
    aStream.WriteBuffer(fValue.ValueBinaryData^,fValue.ValueBinarySize);
   end;
  end;
  TPasRISCV.TSnapshot.TType.ObjectValue,
  TPasRISCV.TSnapshot.TType.ArrayValue:begin
   ChildCount:=fChildCount;
   aStream.WriteBuffer(ChildCount,SizeOf(TPasRISCVUInt32));
   for Index:=0 to fChildCount-1 do begin
    fChildren[Index].SerializeToStream(aStream);
   end;
  end;
 end;
end;

procedure TPasRISCV.TSnapshot.TNode.DeserializeFromStream(const aStream:TStream);
var TypeTag:TPasRISCVUInt8;
    KeyLen:TPasRISCVUInt16;
    ChildCount:TPasRISCVUInt32;
    StrLen:TPasRISCVUInt32;
    Index:TPasRISCVInt32;
    Child:TPasRISCV.TSnapshot.TNode;
begin
 aStream.ReadBuffer(TypeTag,SizeOf(TPasRISCVUInt8));
 fType:=TPasRISCV.TSnapshot.TType(TypeTag);
 aStream.ReadBuffer(KeyLen,SizeOf(TPasRISCVUInt16));
 if KeyLen>0 then begin
  SetLength(fKey,KeyLen);
  aStream.ReadBuffer(fKey[1],KeyLen);
 end else begin
  fKey:='';
 end;
 case fType of
  TPasRISCV.TSnapshot.TType.None,
  TPasRISCV.TSnapshot.TType.Null:begin
  end;
  TPasRISCV.TSnapshot.TType.Bool:begin
   aStream.ReadBuffer(fValue.ValueBool,SizeOf(TPasRISCVUInt8));
  end;
  TPasRISCV.TSnapshot.TType.UInt8:begin
   aStream.ReadBuffer(fValue.ValueUInt8,SizeOf(TPasRISCVUInt8));
  end;
  TPasRISCV.TSnapshot.TType.UInt16:begin
   aStream.ReadBuffer(fValue.ValueUInt16,SizeOf(TPasRISCVUInt16));
  end;
  TPasRISCV.TSnapshot.TType.UInt32:begin
   aStream.ReadBuffer(fValue.ValueUInt32,SizeOf(TPasRISCVUInt32));
  end;
  TPasRISCV.TSnapshot.TType.UInt64:begin
   aStream.ReadBuffer(fValue.ValueUInt64,SizeOf(TPasRISCVUInt64));
  end;
  TPasRISCV.TSnapshot.TType.Int8:begin
   aStream.ReadBuffer(fValue.ValueInt8,SizeOf(TPasRISCVInt8));
  end;
  TPasRISCV.TSnapshot.TType.Int16:begin
   aStream.ReadBuffer(fValue.ValueInt16,SizeOf(TPasRISCVInt16));
  end;
  TPasRISCV.TSnapshot.TType.Int32:begin
   aStream.ReadBuffer(fValue.ValueInt32,SizeOf(TPasRISCVInt32));
  end;
  TPasRISCV.TSnapshot.TType.Int64:begin
   aStream.ReadBuffer(fValue.ValueInt64,SizeOf(TPasRISCVInt64));
  end;
  TPasRISCV.TSnapshot.TType.Float16:begin
   aStream.ReadBuffer(fValue.ValueFloat16,SizeOf(TPasRISCVHalfFloat));
  end;
  TPasRISCV.TSnapshot.TType.BFloat16:begin
   aStream.ReadBuffer(fValue.ValueBFloat16,SizeOf(TPasRISCVUInt16));
  end;
  TPasRISCV.TSnapshot.TType.Float32:begin
   aStream.ReadBuffer(fValue.ValueFloat32,SizeOf(TPasRISCVFloat));
  end;
  TPasRISCV.TSnapshot.TType.Float64:begin
   aStream.ReadBuffer(fValue.ValueFloat64,SizeOf(TPasRISCVDouble));
  end;
  TPasRISCV.TSnapshot.TType.StringValue:begin
   aStream.ReadBuffer(StrLen,SizeOf(TPasRISCVUInt32));
   SetLength(fValue.ValueString,StrLen);
   if StrLen>0 then begin
    aStream.ReadBuffer(fValue.ValueString[1],StrLen);
   end;
  end;
  TPasRISCV.TSnapshot.TType.Binary:begin
   aStream.ReadBuffer(fValue.ValueBinarySize,SizeOf(TPasRISCVUInt64));
   if fValue.ValueBinarySize>0 then begin
    GetMem(fValue.ValueBinaryData,fValue.ValueBinarySize);
    aStream.ReadBuffer(fValue.ValueBinaryData^,fValue.ValueBinarySize);
   end else begin
    fValue.ValueBinaryData:=nil;
   end;
  end;
  TPasRISCV.TSnapshot.TType.ObjectValue,
  TPasRISCV.TSnapshot.TType.ArrayValue:begin
   aStream.ReadBuffer(ChildCount,SizeOf(TPasRISCVUInt32));
   SetLength(fChildren,ChildCount);
   fChildCount:=ChildCount;
   for Index:=0 to TPasRISCVInt32(ChildCount)-1 do begin
    Child:=TPasRISCV.TSnapshot.TNode.Create;
    fChildren[Index]:=Child;
    Child.DeserializeFromStream(aStream);
   end;
  end;
 end;
end;

procedure TPasRISCV.TSnapshot.SaveToStream(const aStream:TStream);
var Magic:array[0..7] of AnsiChar;
    FormatVersion,Flags:TPasRISCVUInt8;
    UncompressedSize:TPasRISCVUInt64;
    NodeStream:TMemoryStream;
    CompressedData:Pointer;
    CompressedSize:TPasRISCVUInt64;
begin
 Magic:='PRISCVSS';
 FormatVersion:=1;
 case fCompression of
  TSnapshotCompression.LZBRRC:begin
   Flags:=1;
  end;
  TSnapshotCompression.LZBRSF:begin
   Flags:=2;
  end;
  else begin
   Flags:=0;
  end;
 end;
 NodeStream:=TMemoryStream.Create;
 try
  fRoot.SerializeToStream(NodeStream);
  UncompressedSize:=NodeStream.Size;
  aStream.WriteBuffer(Magic,SizeOf(Magic));
  aStream.WriteBuffer(FormatVersion,SizeOf(TPasRISCVUInt8));
  aStream.WriteBuffer(Flags,SizeOf(TPasRISCVUInt8));
  aStream.WriteBuffer(UncompressedSize,SizeOf(TPasRISCVUInt64));
  if (Flags and $07)<>0 then begin
   CompressedData:=nil;
   CompressedSize:=0;
   try
    case fCompression of
     TSnapshotCompression.LZBRRC:begin
      LZBRRCCompress(NodeStream.Memory,UncompressedSize,CompressedData,CompressedSize,fCompressionLevel,false);
     end;
     TSnapshotCompression.LZBRSF:begin
      LZBRSFCompress(NodeStream.Memory,UncompressedSize,CompressedData,CompressedSize,fCompressionLevel,false);
     end;
     else begin
     end;
    end;
    if assigned(CompressedData) and (CompressedSize>0) then begin
     aStream.WriteBuffer(CompressedData^,CompressedSize);
    end;
   finally
    if assigned(CompressedData) then begin
     FreeMem(CompressedData);
    end;
   end;
  end else begin
   aStream.WriteBuffer(NodeStream.Memory^,UncompressedSize);
  end;
 finally
  NodeStream.Free;
 end;
end;

procedure TPasRISCV.TSnapshot.LoadFromStream(const aStream:TStream);
var Magic:array[0..7] of AnsiChar;
    FormatVersion,Flags:TPasRISCVUInt8;
    UncompressedSize:TPasRISCVUInt64;
    NodeStream:TMemoryStream;
    CompressedData:Pointer;
    CompressedSize:TPasRISCVUInt64;
    DecompressedData:Pointer;
    DecompressedSize:TPasRISCVUInt64;
begin
 aStream.ReadBuffer(Magic,SizeOf(Magic));
 if Magic<>'PRISCVSS' then begin
  raise Exception.Create('Invalid snapshot magic');
 end;
 aStream.ReadBuffer(FormatVersion,SizeOf(TPasRISCVUInt8));
 if FormatVersion<>1 then begin
  raise Exception.Create('Unsupported snapshot format version');
 end;
 aStream.ReadBuffer(Flags,SizeOf(TPasRISCVUInt8));
 aStream.ReadBuffer(UncompressedSize,SizeOf(TPasRISCVUInt64));
 FreeAndNil(fRoot);
 fRoot:=TNode.Create;
 NodeStream:=TMemoryStream.Create;
 try
  if (Flags and $07)<>0 then begin
   CompressedSize:=aStream.Size-aStream.Position;
   GetMem(CompressedData,CompressedSize);
   try
    aStream.ReadBuffer(CompressedData^,CompressedSize);
    DecompressedData:=nil;
    DecompressedSize:=0;
    try
     case Flags and $07 of
      1:begin
       LZBRRCDecompress(CompressedData,CompressedSize,DecompressedData,DecompressedSize,UncompressedSize,false);
      end;
      2:begin
       LZBRSFDecompress(CompressedData,CompressedSize,DecompressedData,DecompressedSize,UncompressedSize,false);
      end;
      else begin
      end;
     end;
     if assigned(DecompressedData) and (DecompressedSize>0) then begin
      NodeStream.WriteBuffer(DecompressedData^,DecompressedSize);
      NodeStream.Position:=0;
     end;
    finally
     if assigned(DecompressedData) then begin
      FreeMem(DecompressedData);
     end;
    end;
   finally
    FreeMem(CompressedData);
   end;
  end else begin
   NodeStream.CopyFrom(aStream,UncompressedSize);
   NodeStream.Position:=0;
  end;
  fRoot.DeserializeFromStream(NodeStream);
 finally
  NodeStream.Free;
 end;
end;

procedure TPasRISCV.TSnapshot.SaveToFile(const aFileName:TPasRISCVUTF8String);
var FileStream:TFileStream;
begin
 FileStream:=TFileStream.Create(aFileName,fmCreate);
 try
  SaveToStream(FileStream);
 finally
  FileStream.Free;
 end;
end;

procedure TPasRISCV.TSnapshot.LoadFromFile(const aFileName:TPasRISCVUTF8String);
var FileStream:TFileStream;
begin
 FileStream:=TFileStream.Create(aFileName,fmOpenRead);
 try
  LoadFromStream(FileStream);
 finally
  FileStream.Free;
 end;
end;


{ TPasRISCV.TBusDevice }

constructor TPasRISCV.TBusDevice.Create(const aMachine:TPasRISCV;const aBase,aSize:TPasRISCVUInt64);
begin
 inherited Create;
 fMachine:=aMachine;
 fBase:=aBase;
 fSize:=aSize;
 fPHandle:=fMachine.AllocatePHandle;
 fUnalignedAccessSupport:=true;
 fMinOpSize:=1;
 fMaxOpSize:=8;
 fSubBusDevices:=nil;
 fCountSubBusDevices:=0;
end;

destructor TPasRISCV.TBusDevice.Destroy;
var Index:TPasRISCVSizeInt;
begin
 for Index:=0 to fCountSubBusDevices-1 do begin
  FreeAndNil(fSubBusDevices[Index]);
 end;
 fSubBusDevices:=nil;
 fCountSubBusDevices:=0;
 inherited Destroy;
end;

procedure TPasRISCV.TBusDevice.AddSubBusDevice(const aSubBusDevice:TBusDevice);
var Index:TPasRISCVSizeInt;
begin
 Index:=fCountSubBusDevices;
 inc(fCountSubBusDevices);
 if length(fSubBusDevices)<fCountSubBusDevices then begin
  SetLength(fSubBusDevices,fCountSubBusDevices+((fCountSubBusDevices+1) shr 1)); // Grow by 1.5
 end;
 fSubBusDevices[Index]:=aSubBusDevice;
{$ifdef PasRISCVAddressSpaceDispatch}
 if assigned(fMachine) and assigned(fMachine.fBus) then begin
  fMachine.fBus.fAddressSpaceDispatch.Invalidate;
 end;
{$endif}
{$ifdef PasRISCVMMIOTLB}
 TPasMPInterlocked.Increment(fMachine.fMMIOTLBGeneration);
{$endif}
end;

procedure TPasRISCV.TBusDevice.RemoveSubBusDevice(const aSubBusDevice:TBusDevice);
var Index:TPasRISCVSizeInt;
begin
 for Index:=0 to fCountSubBusDevices-1 do begin
  if fSubBusDevices[Index]=aSubBusDevice then begin
   if (Index+1)<fCountSubBusDevices then begin
    fSubBusDevices[Index]:=fSubBusDevices[fCountSubBusDevices-1];
   end;
   fSubBusDevices[fCountSubBusDevices-1]:=nil;
   dec(fCountSubBusDevices);
{$ifdef PasRISCVAddressSpaceDispatch}
   if assigned(fMachine) and assigned(fMachine.fBus) then begin
    fMachine.fBus.fAddressSpaceDispatch.Invalidate;
   end;
{$endif}
{$ifdef PasRISCVMMIOTLB}
   TPasMPInterlocked.Increment(fMachine.fMMIOTLBGeneration);
{$endif}
   exit;
  end;
 end;
end;

function TPasRISCV.TBusDevice.FindSubBusDevice(const aAddress:TPasRISCVUInt64):TPasRISCV.TBusDevice;
var Index:TPasRISCVSizeInt;
    SubBusDevice:TBusDevice;
begin
 for Index:=0 to fCountSubBusDevices-1 do begin
  SubBusDevice:=fSubBusDevices[Index];
  if (SubBusDevice.fBase<=aAddress) and ((aAddress-SubBusDevice.fBase)<SubBusDevice.fSize) then begin
   result:=SubBusDevice;
   exit;
  end;
 end;
 result:=self;
end;

procedure TPasRISCV.TBusDevice.SetBase(const aValue:TPasRISCVUInt64);
begin
 fBase:=aValue;
end;

procedure TPasRISCV.TBusDevice.SetSize(const aValue:TPasRISCVUInt64);
begin
 fSize:=aValue;
end;

procedure TPasRISCV.TBusDevice.SetEnd(const aValue:TPasRISCVUInt64);
begin
 fSize:=(aValue-fBase)+1;
end;

procedure TPasRISCV.TBusDevice.Reset;
begin
end;

function TPasRISCV.TBusDevice.GetDeviceDirectMemoryAccessPointer(const aAddress:TPasRISCVUInt64;const aSize:TPasRISCVUInt64;const aWrite:Boolean;const aBounce:Pointer):Pointer;
var Index:TPasRISCVSizeInt;
    SubBusDevice:TBusDevice;
begin
 for Index:=0 to fCountSubBusDevices-1 do begin
  SubBusDevice:=fSubBusDevices[Index];
  if (SubBusDevice.fBase<=aAddress) and ((aAddress-SubBusDevice.fBase)<SubBusDevice.fSize) then begin
   result:=SubBusDevice.GetDeviceDirectMemoryAccessPointer(aAddress,aSize,aWrite,aBounce);
   if assigned(result) then begin
    exit;
   end;
  end;
 end;
 result:=nil;
end;

function TPasRISCV.TBusDevice.GetGlobalDirectMemoryAccessPointer(const aAddress:TPasRISCVUInt64;const aSize:TPasRISCVUInt64;const aWrite:Boolean;const aBounce:Pointer):Pointer;
begin
 result:=fMachine.fBus.GetDirectMemoryAccessPointer(nil,aAddress,aSize,aWrite,aBounce);
end;

function TPasRISCV.TBusDevice.Load(const aAddress:TPasRISCVUInt64;const aSize:TPasRISCVUInt64):TPasRISCVUInt64;
var Index:TPasRISCVSizeInt;
    SubBusDevice:TBusDevice;
begin
 for Index:=0 to fCountSubBusDevices-1 do begin
  SubBusDevice:=fSubBusDevices[Index];
  if (SubBusDevice.fBase<=aAddress) and ((aAddress-SubBusDevice.fBase)<SubBusDevice.fSize) then begin
   result:=SubBusDevice.Load(aAddress,aSize);
   exit;
  end;
 end;
 result:=0;
end;

procedure TPasRISCV.TBusDevice.Store(const aAddress:TPasRISCVUInt64;const aValue:TPasRISCVUInt64;const aSize:TPasRISCVUInt64);
var Index:TPasRISCVSizeInt;
    SubBusDevice:TBusDevice;
begin
 for Index:=0 to fCountSubBusDevices-1 do begin
  SubBusDevice:=fSubBusDevices[Index];
  if (SubBusDevice.fBase<=aAddress) and ((aAddress-SubBusDevice.fBase)<SubBusDevice.fSize) then begin
   SubBusDevice.Store(aAddress,aValue,aSize);
   exit;
  end;
 end;
end;

