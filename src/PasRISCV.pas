 movsd qword ptr [rsp-16],xmm1
 movsd qword ptr [rsp-24],xmm2
 fld qword ptr [rsp-8]
 fld qword ptr [rsp-16]
 fmulp st(1),st(0)
 fld qword ptr [rsp-24]
 faddp st(1),st(0)
 fstp qword ptr [rsp-8]
 movsd xmm0,qword ptr [rsp-8]
{$endif}
end;
