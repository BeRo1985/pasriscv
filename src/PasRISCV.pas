procedure TPasRISCV.THART.NonStrictExecVNCvtRODFF32(const aVS2,aVD:TPasRISCVUInt32;const aVSTART,aEVL:TPasRISCVUInt32;const aUnmasked:Boolean);
var Index:TPasRISCVUInt32;
    FFlags:TPasRISCVUInt8;
    F32Bits,F32Sign,F32BiasedExponent,F32Mantissa:TPasRISCVUInt32;
    F16BiasedExponent,F16Mantissa,ShiftAmount,FullSignificand24,LostBits32:TPasRISCVUInt32;
    F16Result:TPasRISCVUInt16;
begin
 FFlags:=0;
 if aVSTART<aEVL then begin
  for Index:=aVSTART to aEVL-1 do begin
   if aUnmasked or VectorGetMaskBit(Index) then begin
    F32Bits:=TPasRISCVUInt32(VectorGetElement(aVS2,Index,32));
    F32Sign:=(F32Bits shr 31) and 1;
    F32BiasedExponent:=(F32Bits shr 23) and $ff;
    F32Mantissa:=F32Bits and $7fffff;
    if F32BiasedExponent=$ff then begin
     // NaN or Inf
     if F32Mantissa<>0 then begin
      // sNaN: quiet bit clear
      if (F32Mantissa and $400000)=0 then begin
       FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Invalid);
      end;
      F16Result:=$7e00; // canonical qNaN
     end else begin
      // Inf: copy sign
      F16Result:=TPasRISCVUInt16((F32Sign shl 15) or $7c00);
     end;
    end else if F32BiasedExponent>=143 then begin
     // f32 exponent too large for f16 -> RTZ gives max-finite f16, ROD keeps bit 0 (already set)
     F16Result:=TPasRISCVUInt16((F32Sign shl 15) or $7bff);
     FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Overflow) or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Inexact);
    end else if F32BiasedExponent>=113 then begin
     // normal f32 -> normal f16
     F16BiasedExponent:=F32BiasedExponent-112;
     F16Mantissa:=F32Mantissa shr 13;
     LostBits32:=F32Mantissa and $1fff;
     F16Result:=TPasRISCVUInt16((F32Sign shl 15) or (F16BiasedExponent shl 10) or F16Mantissa);
     if LostBits32<>0 then begin
      F16Result:=F16Result or 1; // round-to-odd: force LSB
      FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Inexact);
     end;
    end else if F32BiasedExponent>=103 then begin
     // normal f32 -> subnormal f16 (biased exp 103..112 maps to shift 14..23)
     ShiftAmount:=126-F32BiasedExponent;
     FullSignificand24:=(1 shl 23) or F32Mantissa;
     F16Mantissa:=FullSignificand24 shr ShiftAmount;
     LostBits32:=FullSignificand24 and ((1 shl ShiftAmount)-1);
     F16Result:=TPasRISCVUInt16((F32Sign shl 15) or F16Mantissa);
     if LostBits32<>0 then begin
      F16Result:=F16Result or 1; // round-to-odd: force LSB
      FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Inexact) or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Underflow);
     end;
    end else begin
     // f32 too small for any f16 subnormal -> underflow
     if (F32Bits and $7fffffff)<>0 then begin
      // nonzero: RTZ gives 0, ROD forces bit 0
      F16Result:=TPasRISCVUInt16((F32Sign shl 15) or 1);
      FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Inexact) or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Underflow);
     end else begin
      // zero: copy sign, no flags
      F16Result:=TPasRISCVUInt16(F32Sign shl 15);
     end;
    end;
    VectorSetElement(aVD,Index,16,F16Result);
   end;
  end;
 end;
 fState.CSR.SetFPUException(FFlags);
end;

procedure TPasRISCV.THART.NonStrictExecVNCvtRODFF64(const aVS2,aVD:TPasRISCVUInt32;const aVSTART,aEVL:TPasRISCVUInt32;const aUnmasked:Boolean);
