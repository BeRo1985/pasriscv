function RoundUp(x,y:TPasRISCVUInt32):TPasRISCVUInt32;
var m:TPasRISCVUInt32;
begin
 m:=y-1;
 if (y and m)=0 then begin
  result:=(x+m) and not TPasRISCVUInt32(m);
 end else begin
  result:=((x+m) div y)*y;
 end;
end;

