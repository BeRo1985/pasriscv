{$ifdef PasRISCVJustInTimeCompilerVector}

// Vector register emit primitives (x86-64)

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitVectorLoad(const aHostRegister:TPasRISCVUInt8;const aBaseRegister:TPasRISCVUInt8;const aOffset:TPasRISCVInt32);
begin
 if fHasAVX2 then begin
  // VMOVDQU ymm, [base+offset] - VEX.256.F3.0F.WIG 6F /r
  EmitVEXMemOp($02,true,false,$01,$6f,aHostRegister,aBaseRegister,aOffset,0);
 end else begin
  // MOVDQU xmm, [base+offset] - F3 0F 6F /r
  EmitSSE2MemOp($f3,$6f,aHostRegister,aBaseRegister,aOffset);
 end;
end;

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitVectorStore(const aHostRegister:TPasRISCVUInt8;const aBaseRegister:TPasRISCVUInt8;const aOffset:TPasRISCVInt32);
begin
 if fHasAVX2 then begin
  // VMOVDQU [base+offset], ymm - VEX.256.F3.0F.WIG 7F /r
  EmitVEXMemOp($02,true,false,$01,$7f,aHostRegister,aBaseRegister,aOffset,0);
 end else begin
  // MOVDQU [base+offset], xmm - F3 0F 7F /r
  EmitSSE2MemOp($f3,$7f,aHostRegister,aBaseRegister,aOffset);
 end;
end;

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitVectorMov(const aDstRegister:TPasRISCVUInt8;const aSrcRegister:TPasRISCVUInt8);
begin
 if aDstRegister<>aSrcRegister then begin
  if fHasAVX2 then begin
   // VMOVDQU ymm, ymm - VEX.256.F3.0F.WIG 6F /r
   EmitVEXOp($02,true,false,$01,$6f,aDstRegister,aSrcRegister,0);
  end else begin
   // MOVDQU xmm, xmm - F3 0F 6F /r
   EmitSSE2Op($f3,$6f,aDstRegister,aSrcRegister);
  end;
 end;
end;

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitVectorOp(const aOpcode:TPasRISCVUInt8;const aDstRegister:TPasRISCVUInt8;const aSrc1Register:TPasRISCVUInt8;const aSrc2Register:TPasRISCVUInt8);
begin
 if fHasAVX2 then begin
  // VPxxx ymm_dst, ymm_src1, ymm_src2 - VEX.256.66.0F opcode /r
  EmitVEXOp($01,true,false,$01,aOpcode,aDstRegister,aSrc2Register,aSrc1Register);
 end else begin
  // SSE 2-operand: dst=dst OP src2, so ensure dst contains src1 first
  if aDstRegister<>aSrc1Register then begin
   EmitVectorMov(aDstRegister,aSrc1Register);
  end;
  // Pxxx xmm_dst, xmm_src2 - 66 0F opcode /r
  EmitSSE2Op($66,aOpcode,aDstRegister,aSrc2Register);
 end;
end;

// Vector JIT intrinsic implementations (x86-64)

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitVectorEnabledCheck;
var HostTmp:TPasRISCVUInt8;
    OkFixup:TPasRISCVUInt32;
begin
 // Runtime check: if MSTATUS.VS == Off (bits[10:9] == 0), bail to interpreter
 // IsVectorEnabled = ((MSTATUS >> 9) & 3) <> 0
 if not fBlockVectorEnabled then begin
  HostTmp:=ClaimHostIntRegister;
  EmitNativeLoad(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.MSTATUS)),true);
  EmitShiftRegImm(SHIFT_SHR,HostTmp,9,true);
  EmitImmOp(ALU_AND,HostTmp,3,true);
  EmitTEST(HostTmp,HostTmp,true);
  FreeHostIntRegister(HostTmp);
  // JNE .vs_ok (skip bailout if VS != Off)
  EmitJccRel32(CC_NE,0);
  OkFixup:=fTemporaryCodeSize-4;
  EmitVectorBailout;
  PatchJmpRel32(OkFixup);
  fBlockVectorEnabled:=true;
 end;
end;

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitSetVSDirty;
var HostTmp:TPasRISCVUInt8;
    MSTATUSOffset:TPasRISCVUInt32;
begin
 // Set MSTATUS.VS = Dirty (bits[10:9] = 11) via OR with (3 shl 9)
 if not fBlockVSDirtyEmitted then begin
  fBlockVSDirtyEmitted:=true;
  HostTmp:=ClaimHostIntRegister;
  MSTATUSOffset:=GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.MSTATUS));
  EmitNativeLoad(HostTmp,VMPtrRegister,MSTATUSOffset,true);
  EmitImmOp(ALU_OR,HostTmp,TPasRISCVInt32(3 shl 9),true);
  EmitNativeStore(HostTmp,VMPtrRegister,MSTATUSOffset,true);
  FreeHostIntRegister(HostTmp);
 end;
end;

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitVectorVStartCheck(const aHostTemporaryRegister:TPasRISCVInt32);
var HostTmp:TPasRISCVUInt8;
    OkFixup:TPasRISCVUInt32;
begin
 if not fBlockVStartChecked then begin
  fBlockVStartChecked:=true;
  if aHostTemporaryRegister>=0 then begin
   HostTmp:=aHostTemporaryRegister;
  end else begin
   HostTmp:=ClaimHostIntRegister;
  end;
  EmitNativeLoad(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VSTART)),true);
  EmitTEST(HostTmp,HostTmp,true);
  EmitJccRel32(CC_E,0);
  OkFixup:=fTemporaryCodeSize-4;
  EmitVectorBailout;
  PatchJmpRel32(OkFixup);
  if aHostTemporaryRegister<0 then begin
   FreeHostIntRegister(HostTmp);
  end;
 end;
end;

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitVectorClearVStart(const aHostTemporaryRegister:TPasRISCVInt32);
var HostTmp:TPasRISCVUInt8;
begin
 if aHostTemporaryRegister>=0 then begin
  HostTmp:=aHostTemporaryRegister;
 end else begin
  HostTmp:=ClaimHostIntRegister;
 end;
 EmitNativeZeroReg(HostTmp);
 EmitNativeStore(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VSTART)),true);
 if aHostTemporaryRegister<0 then begin
  FreeHostIntRegister(HostTmp);
 end;
 fBlockVStartChecked:=true;
end;

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitVectorVLCheck(const aVLValue:TPasRISCVUInt64);
var HostTmp,HostCmp:TPasRISCVUInt8;
    OkFixup:TPasRISCVUInt32;
begin
 if not fBlockVLChecked then begin
  fBlockVLChecked:=true;
  HostTmp:=ClaimHostIntRegister;
  EmitNativeLoad(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VL)),true);
  HostCmp:=ClaimHostIntRegister;
  EmitNativeSetReg64(HostCmp,aVLValue);
  Emit2RegOp(X86_CMP,HostTmp,HostCmp,true);
  FreeHostIntRegister(HostCmp);
  EmitJccRel32(CC_E,0);
  OkFixup:=fTemporaryCodeSize-4;
  EmitVectorBailout;
  PatchJmpRel32(OkFixup);
  FreeHostIntRegister(HostTmp);
 end;
end;

procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitVectorVTypeCheck(const aVTypeValue:TPasRISCVUInt64);
var HostTmp,HostCmp:TPasRISCVUInt8;
    OkFixup:TPasRISCVUInt32;
begin
 if not fBlockVTypeChecked then begin
  fBlockVTypeChecked:=true;
  HostTmp:=ClaimHostIntRegister;
  EmitNativeLoad(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VTYPE)),true);
  HostCmp:=ClaimHostIntRegister;
  EmitNativeSetReg64(HostCmp,aVTypeValue);
  Emit2RegOp(X86_CMP,HostTmp,HostCmp,true);
  FreeHostIntRegister(HostCmp);
  EmitJccRel32(CC_E,0);
  OkFixup:=fTemporaryCodeSize-4;
  EmitVectorBailout;
  PatchJmpRel32(OkFixup);
  FreeHostIntRegister(HostTmp);
 end;
end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVSETVLI(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
var RD,RS1:TRegister;
    VTypeValue,SEW,LMUL8,VLMAX:TPasRISCVUInt64;
    vsew,vlmul:TPasRISCVUInt32;
    HostRD,HostRS1,HostTmp:TPasRISCVUInt8;
begin
 // vsetvli: bit31=0, vtypei[10:0] = bits[30:20]
 RD:=TRegister(aParameter0);
 RS1:=TRegister(aParameter1);
 VTypeValue:=(aInstruction shr 20) and $7ff;

 // Validate vtype at JIT-compile time
 vsew:=(VTypeValue shr 3) and 7;
 vlmul:=VTypeValue and 7;
 if (VTypeValue and not TPasRISCVUInt64($ff))<>0 then begin
  result:=false;
  exit;
 end;
 if vsew>3 then begin
  result:=false;
  exit;
 end;
 if vlmul=4 then begin
  result:=false;
  exit;
 end;

 SEW:=8 shl vsew;
 case vlmul of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;
 if (TPasRISCVUInt64(fJITVLEN)*LMUL8)<(SEW*8) then begin
  result:=false;
  exit;
 end;
 VLMAX:=((fJITVLEN div SEW)*LMUL8) shr 3;

 EmitVectorEnabledCheck;

 // rs1=x0, rd=x0 depends on the runtime old VLMAX/current vtype state.
 // Let the interpreter handle this case to preserve exact semantics.
 if (RS1=TRegister.Zero) and (RD=TRegister.Zero) then begin
  result:=false;
  exit;
 end;

 // Normal case: VL = min(AVL, VLMAX)
 if RS1=TRegister.Zero then begin
  // rs1=x0, rd!=x0 => AVL=VLMAX => VL=VLMAX (all constants)
  FreeAllHostIntRegisters;
  HostTmp:=ClaimHostIntRegister;
  // Store VTYPE
  EmitNativeSetReg64(HostTmp,VTypeValue);
  EmitNativeStore(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VTYPE)),true);
  // Store VL = VLMAX and rd = VLMAX
  EmitNativeSetReg64(HostTmp,VLMAX);
  EmitNativeStore(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VL)),true);
  EmitNativeStore(HostTmp,VMPtrRegister,GuestIntRegisterOffset(RD),true);
  EmitVectorClearVStart(HostTmp);
  FreeHostIntRegister(HostTmp);
 end else begin
  // rs1!=x0 => AVL from register, VL = min(AVL, VLMAX)
  HostRS1:=MapGuestToHostIntRegister(RS1,REG_SRC);
  if RD<>TRegister.Zero then begin
   HostRD:=MapGuestToHostIntRegister(RD,REG_DST);
  end else begin
   HostRD:=ClaimHostIntRegister;
  end;

  // HostRD = VLMAX
  EmitNativeSetReg64(HostRD,VLMAX);
  // CMP HostRS1, HostRD (unsigned comparison of AVL vs VLMAX)
  Emit2RegOp(X86_CMP,HostRS1,HostRD,true);
  // CMOVBE HostRD, HostRS1: if AVL <= VLMAX (CF=1 or ZF=1), VL = AVL
  EmitCMOVCC(CC_BE,HostRD,HostRS1,true);

  // Store VL to CSR (HostRD = min(AVL, VLMAX))
  EmitNativeStore(HostRD,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VL)),true);
  // Store rd
  if RD<>TRegister.Zero then begin
   EmitNativeStore(HostRD,VMPtrRegister,GuestIntRegisterOffset(RD),true);
  end else begin
   FreeHostIntRegister(HostRD);
  end;

  // Store VTYPE constant
  HostTmp:=ClaimHostIntRegister;
  EmitNativeSetReg64(HostTmp,VTypeValue);
  EmitNativeStore(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VTYPE)),true);
  EmitVectorClearVStart(HostTmp);
  FreeHostIntRegister(HostTmp);
 end;

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

 // A traced vsetvli changes the vector configuration for following ops in the block.
 fBlockVLChecked:=false;
 fBlockVTypeChecked:=false;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VSETVLI pc=',LowerCase(IntToHex(fHART.fState.PC,16)));
{$endif}

 result:=true;
end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVSETIVLI(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
var RD:TRegister;
    AVL,VTypeValue,SEW,LMUL8,VLMAX,NewVL:TPasRISCVUInt64;
    vsew,vlmul:TPasRISCVUInt32;
    HostTmp:TPasRISCVUInt8;
begin
 // vsetivli: bits[31:30]=11, AVL = imm5 from rs1 field, vtypei[9:0] = bits[29:20]
 RD:=TRegister(aParameter0);
 AVL:=(aInstruction shr 15) and $1f;
 VTypeValue:=(aInstruction shr 20) and $3ff;

 // Validate vtype at JIT-compile time
 vsew:=(VTypeValue shr 3) and 7;
 vlmul:=VTypeValue and 7;
 if (VTypeValue and not TPasRISCVUInt64($ff))<>0 then begin
  result:=false;
  exit;
 end;
 if vsew>3 then begin
  result:=false;
  exit;
 end;
 if vlmul=4 then begin
  result:=false;
  exit;
 end;

 SEW:=8 shl vsew;
 case vlmul of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;
 if (TPasRISCVUInt64(fJITVLEN)*LMUL8)<(SEW*8) then begin
  result:=false;
  exit;
 end;
 VLMAX:=((fJITVLEN div SEW)*LMUL8) shr 3;

 // Both AVL and VLMAX are compile-time constants
 if AVL<=VLMAX then begin
  NewVL:=AVL;
 end else begin
  NewVL:=VLMAX;
 end;

 EmitVectorEnabledCheck;

 // Emit stores for all CSRs and rd (all constants)
 FreeAllHostIntRegisters;
 HostTmp:=ClaimHostIntRegister;
 // Store VTYPE
 EmitNativeSetReg64(HostTmp,VTypeValue);
 EmitNativeStore(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VTYPE)),true);
 // Store VL
 EmitNativeSetReg64(HostTmp,NewVL);
 EmitNativeStore(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VL)),true);
 // Store rd
 if RD<>TRegister.Zero then begin
  EmitNativeStore(HostTmp,VMPtrRegister,GuestIntRegisterOffset(RD),true);
 end;
 EmitVectorClearVStart(HostTmp);
 FreeHostIntRegister(HostTmp);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

 // A traced vsetivli changes the vector configuration for following ops in the block.
 fBlockVLChecked:=false;
 fBlockVTypeChecked:=false;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VSETIVLI pc=',LowerCase(IntToHex(fHART.fState.PC,16)));
{$endif}

 result:=true;
end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVSETVL(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
begin
 // vsetvl has runtime VTYPE from rs2 - no trace hook fires for this (excluded in dispatch)
 result:=false;
end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVLE(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for unit-stride vector loads: vle8.v / vle16.v / vle32.v / vle64.v
// Conditions for JIT: VSTART==0, unmasked (vm=1), no segmented (nf=0), EMUL>=1
// Supports EMUL=1,2,4,8 (multiple register groups)
// Emits: runtime VSTART check => bailout, TLB lookup, page-crossing check => bailout,
//        MOVDQU/VMOVDQU load from host memory into allocated vector registers,
//        clear VSTART
var vd:TPasRISCVUInt32;
    RS1:TRegister;
    Width,NumFields,MemOpType,UnitStrideMop:TPasRISCVUInt32;
    Unmasked:Boolean;
    EEW,SEW,LMUL8,EMUL8,VL_val:TPasRISCVUInt64;
    NumRegs,TotalBytes,RegIdx:TPasRISCVUInt32;
    HostAddr,HostTmp,HostRS1,HostCmp,HostVd:TPasRISCVUInt8;
    PageOkFixup:TPasRISCVUInt32;
begin
 // Decode instruction fields
 vd:=(aInstruction shr 7) and $1f;
 RS1:=TRegister((aInstruction shr 15) and $1f);
 Width:=(aInstruction shr 12) and 7;
 MemOpType:=(aInstruction shr 26) and 3;
 Unmasked:=((aInstruction shr 25) and 1)<>0;
 NumFields:=((aInstruction shr 29) and 7);
 UnitStrideMop:=(aInstruction shr 20) and $1f;

 // Only JIT unit-stride, non-segmented, unmasked loads
 if MemOpType<>0 then begin
  result:=false;
  exit;
 end;
 if UnitStrideMop<>0 then begin
  result:=false;
  exit;
 end;
 if not Unmasked then begin
  result:=false;
  exit;
 end;
 if NumFields<>0 then begin
  result:=false;
  exit;
 end;

 // Determine EEW from width encoding
 case Width of
  $0:begin
   EEW:=8;
  end;
  $5:begin
   EEW:=16;
  end;
  $6:begin
   EEW:=32;
  end;
  $7:begin
   EEW:=64;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 // Read current CSR state at JIT-compile time for validation
 SEW:=8 shl ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7);
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 // Compute EMUL = (EEW/SEW)*LMUL in units of 1/8
 if (SEW>0) and (LMUL8>0) then begin
  EMUL8:=(EEW*LMUL8) div SEW;
 end else begin
  result:=false;
  exit;
 end;

 // Support EMUL=1,2,4,8 (EMUL8=8,16,32,64). Bail for fractional LMUL.
 if EMUL8<8 then begin
  result:=false;
  exit;
 end;
 NumRegs:=EMUL8 div 8;
 if not (NumRegs in [1,2,4,8]) then begin
  result:=false;
  exit;
 end;

 // Check register group alignment
 if (vd and (NumRegs-1))<>0 then begin
  result:=false;
  exit;
 end;

 // vill check
 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 // Get VL at compile time for byte count
 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 // Only JIT when VL fills the entire register group
 TotalBytes:=NumRegs*fJITVLENB;
 if (VL_val*(EEW shr 3))<>TotalBytes then begin
  result:=false;
  exit;
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters(TPasRISCVUInt32(1) shl 0);
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 // === Runtime checks: VL/VTYPE must still match compile-time values ===
 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === TLB lookup for base address ===
 HostAddr:=ClaimHostIntRegister;
 EmitDataTLBLookup(HostAddr,RS1,0,TLB_R,1);

 // === Page-crossing check: use GUEST virtual address (not host address) ===
 // RelativeMemory may have non-zero lower 12 bits, making HostAddr & $fff wrong
 HostTmp:=ClaimHostIntRegister;
 HostRS1:=MapGuestToHostIntRegister(RS1,REG_SRC);
 EmitNativeAndi(HostTmp,HostRS1,$fff);
 HostCmp:=ClaimHostIntRegister;
 EmitNativeSetReg32s(HostCmp,TPasRISCVInt32(($1000-TotalBytes)+1));
 Emit2RegOp(X86_CMP,HostTmp,HostCmp,false);
 FreeHostIntRegister(HostCmp);
 // JB .page_ok (page offset < threshold means no crossing)
 EmitJccRel32(CC_B,0);
 PageOkFixup:=fTemporaryCodeSize-4;
 EmitVectorBailout;
 PatchJmpRel32(PageOkFixup);
 // .page_ok:
 FreeHostIntRegister(HostTmp);

 // === Load NumRegs consecutive vector registers from host memory ===
 for RegIdx:=0 to NumRegs-1 do begin
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
  EmitVectorLoad(0,HostAddr,TPasRISCVInt32(RegIdx*fJITVLENB));
  EmitVectorStore(0,VMPtrRegister,GuestVectorRegisterOffset((vd+RegIdx) and 31));
{$else}
  HostVd:=MapGuestToHostVectorRegister((vd+RegIdx) and 31,REG_DST);
  EmitVectorLoad(HostVd,HostAddr,TPasRISCVInt32(RegIdx*fJITVLENB));
{$endif}
 end;

 EmitVectorClearVStart(HostAddr);

 FreeHostIntRegister(HostAddr);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VLE pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd,' nr=',NumRegs);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVSE(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for unit-stride vector stores: vse8.v / vse16.v / vse32.v / vse64.v
// Conditions for JIT: VSTART==0, unmasked (vm=1), no segmented (nf=0), EMUL>=1
// Supports EMUL=1,2,4,8 (multiple register groups)
var vs3:TPasRISCVUInt32;
    RS1:TRegister;
    Width,NumFields,MemOpType,UnitStrideMop:TPasRISCVUInt32;
    Unmasked:Boolean;
    EEW,SEW,LMUL8,EMUL8,VL_val:TPasRISCVUInt64;
    NumRegs,TotalBytes,RegIdx:TPasRISCVUInt32;
    HostAddr,HostTmp,HostRS1,HostCmp,HostVs3:TPasRISCVUInt8;
    PageOkFixup:TPasRISCVUInt32;
begin
 // Decode instruction fields
 vs3:=(aInstruction shr 7) and $1f;
 RS1:=TRegister((aInstruction shr 15) and $1f);
 Width:=(aInstruction shr 12) and 7;
 MemOpType:=(aInstruction shr 26) and 3;
 Unmasked:=((aInstruction shr 25) and 1)<>0;
 NumFields:=((aInstruction shr 29) and 7);
 UnitStrideMop:=(aInstruction shr 20) and $1f;

 // Only JIT unit-stride, non-segmented, unmasked stores
 if MemOpType<>0 then begin
  result:=false;
  exit;
 end;
 if UnitStrideMop<>0 then begin
  result:=false;
  exit;
 end;
 if not Unmasked then begin
  result:=false;
  exit;
 end;
 if NumFields<>0 then begin
  result:=false;
  exit;
 end;

 // Determine EEW from width encoding
 case Width of
  $0:begin
   EEW:=8;
  end;
  $5:begin
   EEW:=16;
  end;
  $6:begin
   EEW:=32;
  end;
  $7:begin
   EEW:=64;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 // Read current CSR state at JIT-compile time for validation
 SEW:=8 shl ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7);
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 // Compute EMUL = (EEW/SEW)*LMUL in units of 1/8
 if (SEW>0) and (LMUL8>0) then begin
  EMUL8:=(EEW*LMUL8) div SEW;
 end else begin
  result:=false;
  exit;
 end;

 // Support EMUL=1,2,4,8 (EMUL8=8,16,32,64). Bail for fractional LMUL.
 if EMUL8<8 then begin
  result:=false;
  exit;
 end;
 NumRegs:=EMUL8 div 8;
 if not (NumRegs in [1,2,4,8]) then begin
  result:=false;
  exit;
 end;

 // Check register group alignment
 if (vs3 and (NumRegs-1))<>0 then begin
  result:=false;
  exit;
 end;

 // vill check
 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 // Get VL at compile time for byte count
 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 // Only JIT when VL fills the entire register group
 TotalBytes:=NumRegs*fJITVLENB;
 if (VL_val*(EEW shr 3))<>TotalBytes then begin
  result:=false;
  exit;
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters(TPasRISCVUInt32(1) shl 0);
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 // === Runtime checks: VL/VTYPE must still match compile-time values ===
 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === TLB lookup for base address (write access) ===
 HostAddr:=ClaimHostIntRegister;
 EmitDataTLBLookup(HostAddr,RS1,0,TLB_W,1);

 // === Page-crossing check: use GUEST virtual address (not host address) ===
 // RelativeMemory may have non-zero lower 12 bits, making HostAddr & $fff wrong
 HostTmp:=ClaimHostIntRegister;
 HostRS1:=MapGuestToHostIntRegister(RS1,REG_SRC);
 EmitNativeAndi(HostTmp,HostRS1,$fff);
 HostCmp:=ClaimHostIntRegister;
 EmitNativeSetReg32s(HostCmp,TPasRISCVInt32(($1000-TotalBytes)+1));
 Emit2RegOp(X86_CMP,HostTmp,HostCmp,false);
 FreeHostIntRegister(HostCmp);
 // JB .page_ok (page offset < threshold means no crossing)
 EmitJccRel32(CC_B,0);
 PageOkFixup:=fTemporaryCodeSize-4;
 EmitVectorBailout;
 PatchJmpRel32(PageOkFixup);
 // .page_ok:
 FreeHostIntRegister(HostTmp);

 // Keep TState coherent before touching guest memory so interrupts/traps/context
 // switches never observe stale vector register contents after the store becomes visible.
 SaveAllDirtyVectorRegisters;

 // === Store NumRegs consecutive vector registers to host memory ===
 for RegIdx:=0 to NumRegs-1 do begin
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
  EmitVectorLoad(0,VMPtrRegister,GuestVectorRegisterOffset((vs3+RegIdx) and 31));
  EmitVectorStore(0,HostAddr,TPasRISCVInt32(RegIdx*fJITVLENB));
{$else}
  HostVs3:=MapGuestToHostVectorRegister((vs3+RegIdx) and 31,REG_SRC);
  EmitVectorStore(HostVs3,HostAddr,TPasRISCVInt32(RegIdx*fJITVLENB));
{$endif}
 end;

 EmitVectorClearVStart(HostAddr);

 EmitSetVSDirty;

 FreeHostIntRegister(HostAddr);

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VSE pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vs3=',vs3,' nr=',NumRegs,' HostAddrReg=',HostAddr,' codeFrom=',fInitialCodeSize,' codeTo=',fTemporaryCodeSize);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVMVVX(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for vmv.v.x: broadcast scalar GPR rs1 to all elements of vector register vd
// Conditions: unmasked, vs2=0, EMUL=1, VSTART=0, full register (VL*SEW/8==fJITVLENB)
var vd,vs2:TPasRISCVUInt32;
    RS1:TRegister;
    Unmasked:Boolean;
    SEW,LMUL8,EMUL8,VL_val:TPasRISCVUInt64;
    HostRS1,HostVd:TPasRISCVUInt8;
    UseL:Boolean;
begin
 // Decode instruction fields
 vd:=(aInstruction shr 7) and $1f;
 RS1:=TRegister((aInstruction shr 15) and $1f);
 vs2:=(aInstruction shr 20) and $1f;
 Unmasked:=((aInstruction shr 25) and 1)<>0;

 // Only JIT unmasked vmv.v.x (not vmerge.vxm)
 if not Unmasked then begin
  result:=false;
  exit;
 end;
 if vs2<>0 then begin
  result:=false;
  exit;
 end;

 // Read CSR state at JIT-compile time
 SEW:=8 shl ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7);
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 // EMUL = LMUL for same-width ops
 EMUL8:=LMUL8;
 if EMUL8<>8 then begin
  result:=false;
  exit;
 end;

 // vill check
 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 // Only JIT full register broadcast (VL*SEW/8 == fJITVLENB)
 if (VL_val*(SEW shr 3))<>fJITVLENB then begin
  result:=false;
  exit;
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters((TPasRISCVUInt32(1) shl 0) or (TPasRISCVUInt32(1) shl 1) or (TPasRISCVUInt32(1) shl 2));
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 // === Runtime checks: VL/VTYPE must still match compile-time values ===
 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === Load scalar value from guest register rs1 ===
 HostRS1:=ClaimHostIntRegister;
 EmitNativeLoad(HostRS1,VMPtrRegister,GuestIntRegisterOffset(RS1),true);

 // === Allocate host vector register for vd ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostVd:=0;
{$else}
 HostVd:=MapGuestToHostVectorRegister(vd,REG_DST);
{$endif}

 // === Broadcast scalar to allocated xmm/ymm register ===
 UseL:=fHasAVX2;

 if fHasAVX2 then begin
  // VMOVD/VMOVQ xmm, HostRS1
  if SEW=64 then begin
   // VMOVQ xmm, r64: VEX.128.66.0F.W1 6E /r
   EmitVEXOp(1,false,true,1,$6e,HostVd,HostRS1,0);
  end else begin
   // VMOVD xmm, r32: VEX.128.66.0F 6E /r
   EmitVEXOp(1,false,false,1,$6e,HostVd,HostRS1,0);
  end;
  // VPBROADCASTx ymm/xmm, xmm: VEX.L.66.0F38 opcode /r
  case SEW of
   8:begin
    EmitVEXOp(1,UseL,false,2,$78,HostVd,HostVd,0);
   end;
   16:begin
    EmitVEXOp(1,UseL,false,2,$79,HostVd,HostVd,0);
   end;
   32:begin
    EmitVEXOp(1,UseL,false,2,$58,HostVd,HostVd,0);
   end;
   64:begin
    EmitVEXOp(1,UseL,false,2,$59,HostVd,HostVd,0);
   end;
  end;
 end else begin
  // SSE2 path
  if SEW=64 then begin
   // MOVQ xmm, r64: 66 REX.W 0F 6E ModRM(3, xmm, gpr)
   EmitByte($66);
   EmitREX(true,HostVd,0,HostRS1);
   EmitByte(X86_FAR_BRANCH);
   EmitByte($6e);
   EmitModRM(3,HostVd,HostRS1);
  end else begin
   EmitSSE2Op($66,$6e,HostVd,HostRS1);
  end;
  // Broadcast within xmm depending on SEW
  case SEW of
   8:begin
    // PUNPCKLBW xmm, xmm
    EmitSSE2Op($66,$60,HostVd,HostVd);
    // PUNPCKLWD xmm, xmm
    EmitSSE2Op($66,$61,HostVd,HostVd);
    // PSHUFD xmm, xmm, $00
    EmitSSE2Op($66,$70,HostVd,HostVd);
    EmitByte($00);
   end;
   16:begin
    // PUNPCKLWD xmm, xmm
    EmitSSE2Op($66,$61,HostVd,HostVd);
    // PSHUFD xmm, xmm, $00
    EmitSSE2Op($66,$70,HostVd,HostVd);
    EmitByte($00);
   end;
   32:begin
    // PSHUFD xmm, xmm, $00
    EmitSSE2Op($66,$70,HostVd,HostVd);
    EmitByte($00);
   end;
   64:begin
    // PSHUFD xmm, xmm, $44 (duplicate low qword to high)
    EmitSSE2Op($66,$70,HostVd,HostVd);
    EmitByte($44);
   end;
  end;
 end;

{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 EmitVectorStore(HostVd,VMPtrRegister,GuestVectorRegisterOffset(vd));
{$endif}

 EmitVectorClearVStart(HostRS1);

 FreeHostIntRegister(HostRS1);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VMVVX pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVMVVI(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for vmv.v.i: broadcast sign-extended 5-bit immediate to all elements of vector register vd
// Conditions: unmasked, vs2=0, EMUL=1, VSTART=0, full register (VL*SEW/8==fJITVLENB)
var vd,vs2:TPasRISCVUInt32;
    Unmasked:Boolean;
    SEW,LMUL8,EMUL8,VL_val,ImmVal:TPasRISCVUInt64;
    HostTmp,HostVd:TPasRISCVUInt8;
    UseL:Boolean;
begin
 // Decode instruction fields
 vd:=(aInstruction shr 7) and $1f;
 vs2:=(aInstruction shr 20) and $1f;
 Unmasked:=((aInstruction shr 25) and 1)<>0;

 // Only JIT unmasked vmv.v.i (not vmerge.vim)
 if not Unmasked then begin
  result:=false;
  exit;
 end;
 if vs2<>0 then begin
  result:=false;
  exit;
 end;

 // Read CSR state at JIT-compile time
 SEW:=8 shl ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7);
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 EMUL8:=LMUL8;
 if EMUL8<>8 then begin
  result:=false;
  exit;
 end;

 // vill check
 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 if (VL_val*(SEW shr 3))<>fJITVLENB then begin
  result:=false;
  exit;
 end;

 // Compute sign-extended immediate, masked to SEW
 ImmVal:=TPasRISCVUInt64(SignExtend((aInstruction shr 15) and $1f,5));
 if SEW<64 then begin
  ImmVal:=ImmVal and ((TPasRISCVUInt64(1) shl SEW)-1);
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters((TPasRISCVUInt32(1) shl 0) or (TPasRISCVUInt32(1) shl 1) or (TPasRISCVUInt32(1) shl 2));
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 // === Runtime checks: VL/VTYPE must still match compile-time values ===
 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === Load immediate into host GPR and broadcast ===
 HostTmp:=ClaimHostIntRegister;
 if SEW=64 then begin
  EmitNativeSetReg64(HostTmp,ImmVal);
 end else begin
  EmitNativeSetReg32s(HostTmp,TPasRISCVInt32(ImmVal));
 end;

 // === Allocate host vector register for vd ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostVd:=0;
{$else}
 HostVd:=MapGuestToHostVectorRegister(vd,REG_DST);
{$endif}

 UseL:=fHasAVX2;

 if fHasAVX2 then begin
  if SEW=64 then begin
   EmitVEXOp(1,false,true,1,$6e,HostVd,HostTmp,0);
  end else begin
   EmitVEXOp(1,false,false,1,$6e,HostVd,HostTmp,0);
  end;
  case SEW of
   8:begin
    EmitVEXOp(1,UseL,false,2,$78,HostVd,HostVd,0);
   end;
   16:begin
    EmitVEXOp(1,UseL,false,2,$79,HostVd,HostVd,0);
   end;
   32:begin
    EmitVEXOp(1,UseL,false,2,$58,HostVd,HostVd,0);
   end;
   64:begin
    EmitVEXOp(1,UseL,false,2,$59,HostVd,HostVd,0);
   end;
  end;
 end else begin
  if SEW=64 then begin
   EmitByte($66);
   EmitREX(true,HostVd,0,HostTmp);
   EmitByte(X86_FAR_BRANCH);
   EmitByte($6e);
   EmitModRM(3,HostVd,HostTmp);
  end else begin
   EmitSSE2Op($66,$6e,HostVd,HostTmp);
  end;
  case SEW of
   8:begin
    EmitSSE2Op($66,$60,HostVd,HostVd);
    EmitSSE2Op($66,$61,HostVd,HostVd);
    EmitSSE2Op($66,$70,HostVd,HostVd);
    EmitByte($00);
   end;
   16:begin
    EmitSSE2Op($66,$61,HostVd,HostVd);
    EmitSSE2Op($66,$70,HostVd,HostVd);
    EmitByte($00);
   end;
   32:begin
    EmitSSE2Op($66,$70,HostVd,HostVd);
    EmitByte($00);
   end;
   64:begin
    EmitSSE2Op($66,$70,HostVd,HostVd);
    EmitByte($44);
   end;
  end;
 end;

{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 EmitVectorStore(HostVd,VMPtrRegister,GuestVectorRegisterOffset(vd));
{$endif}

 EmitVectorClearVStart(HostTmp);

 FreeHostIntRegister(HostTmp);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VMVVI pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVArithVV(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for vadd/vsub/vand/vor/vxor.vv: vector-vector arithmetic/logic
// Conditions: unmasked, EMUL=1, VSTART=0, full register (VL*SEW/8==fJITVLENB)
// Pattern: MapGuestToHostVectorRegister(vs2,SRC) OP MapGuestToHostVectorRegister(vs1,SRC) => MapGuestToHostVectorRegister(vd,DST)
var vd,vs1,vs2,funct6:TPasRISCVUInt32;
    Unmasked:Boolean;
    SEW,LMUL8,EMUL8,VL_val:TPasRISCVUInt64;
    SSEOpcode,HostVd,HostVs1,HostVs2:TPasRISCVUInt8;
begin
 // Decode instruction fields
 vd:=(aInstruction shr 7) and $1f;
 vs1:=(aInstruction shr 15) and $1f;
 vs2:=(aInstruction shr 20) and $1f;
 Unmasked:=((aInstruction shr 25) and 1)<>0;
 funct6:=(aInstruction shr 26) and $3f;

 // Only JIT unmasked operations
 if not Unmasked then begin
  result:=false;
  exit;
 end;

 // Determine SSE2 opcode from funct6 and SEW
 case funct6 of
  $00:begin
   // vadd.vv: PADDB=$fc, PADDW=$fd, PADDD=$fe, PADDQ=$d4
   case ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7) of
    0:begin
     SSEOpcode:=$fc;
    end;
    1:begin
     SSEOpcode:=$fd;
    end;
    2:begin
     SSEOpcode:=$fe;
    end;
    3:begin
     SSEOpcode:=$d4;
    end;
    else begin
     result:=false;
     exit;
    end;
   end;
  end;
  $02:begin
   // vsub.vv: PSUBB=$f8, PSUBW=$f9, PSUBD=$fa, PSUBQ=$fb
   case ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7) of
    0:begin
     SSEOpcode:=$f8;
    end;
    1:begin
     SSEOpcode:=$f9;
    end;
    2:begin
     SSEOpcode:=$fa;
    end;
    3:begin
     SSEOpcode:=$fb;
    end;
    else begin
     result:=false;
     exit;
    end;
   end;
  end;
  $09:begin
   // vand.vv: PAND=$db (bitwise, SEW-independent)
   SSEOpcode:=$db;
  end;
  $0a:begin
   // vor.vv: POR=$eb
   SSEOpcode:=$eb;
  end;
  $0b:begin
   // vxor.vv: PXOR=$ef
   SSEOpcode:=$ef;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 // Read CSR state at JIT-compile time
 SEW:=8 shl ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7);
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 EMUL8:=LMUL8;
 if EMUL8<>8 then begin
  result:=false;
  exit;
 end;

 // vill check
 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 // Only JIT full register operations
 if (VL_val*(SEW shr 3))<>fJITVLENB then begin
  result:=false;
  exit;
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters((TPasRISCVUInt32(1) shl 0) or (TPasRISCVUInt32(1) shl 1));
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 // === Runtime checks: VL/VTYPE must still match compile-time values ===
 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === Map vs2, vs1 as sources, vd as destination ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostVs2:=0;
 HostVs1:=1;
 HostVd:=0;
 EmitVectorLoad(HostVs2,VMPtrRegister,GuestVectorRegisterOffset(vs2));
 EmitVectorLoad(HostVs1,VMPtrRegister,GuestVectorRegisterOffset(vs1));
{$else}
 HostVs2:=MapGuestToHostVectorRegister(vs2,REG_SRC);
 HostVs1:=MapGuestToHostVectorRegister(vs1,REG_SRC);
 HostVd:=MapGuestToHostVectorRegister(vd,REG_DST);
{$endif}

 // === vd = vs2 OP vs1 ===
 EmitVectorOp(SSEOpcode,HostVd,HostVs2,HostVs1);

{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 EmitVectorStore(HostVd,VMPtrRegister,GuestVectorRegisterOffset(vd));
{$endif}

 EmitVectorClearVStart(-1);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VArithVV pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVArithVX(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for vadd/vsub/vrsub/vand/vor/vxor.vx: broadcast rs1, operate with vs2
// Conditions: unmasked, EMUL=1, VSTART=0, full register (VL*SEW/8==fJITVLENB)
var vd,vs2,funct6:TPasRISCVUInt32;
    rs1:TRegister;
    Unmasked:Boolean;
    SEW,LMUL8,EMUL8,VL_val:TPasRISCVUInt64;
    vsew:TPasRISCVUInt32;
    SSEOpcode:TPasRISCVUInt8;
    IsVRSUB:Boolean;
    HostScalar,HostVs2,HostVd,HostBroadcast:TPasRISCVUInt8;
begin
 // Decode instruction fields
 vd:=(aInstruction shr 7) and $1f;
 rs1:=TRegister((aInstruction shr 15) and $1f);
 vs2:=(aInstruction shr 20) and $1f;
 Unmasked:=((aInstruction shr 25) and 1)<>0;
 funct6:=(aInstruction shr 26) and $3f;

 if not Unmasked then begin
  result:=false;
  exit;
 end;

 IsVRSUB:=false;
 vsew:=(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7;

 // Determine SSE2 opcode from funct6 and SEW
 case funct6 of
  $00:begin
   // vadd.vx
   case vsew of
    0:begin
     SSEOpcode:=$fc;
    end;
    1:begin
     SSEOpcode:=$fd;
    end;
    2:begin
     SSEOpcode:=$fe;
    end;
    3:begin
     SSEOpcode:=$d4;
    end;
    else begin
     result:=false;
     exit;
    end;
   end;
  end;
  $02:begin
   // vsub.vx: result = vs2 - broadcast(rs1)
   case vsew of
    0:begin
     SSEOpcode:=$f8;
    end;
    1:begin
     SSEOpcode:=$f9;
    end;
    2:begin
     SSEOpcode:=$fa;
    end;
    3:begin
     SSEOpcode:=$fb;
    end;
    else begin
     result:=false;
     exit;
    end;
   end;
  end;
  $03:begin
   // vrsub.vx: result = broadcast(rs1) - vs2
   IsVRSUB:=true;
   case vsew of
    0:begin
     SSEOpcode:=$f8;
    end;
    1:begin
     SSEOpcode:=$f9;
    end;
    2:begin
     SSEOpcode:=$fa;
    end;
    3:begin
     SSEOpcode:=$fb;
    end;
    else begin
     result:=false;
     exit;
    end;
   end;
  end;
  $09:begin
   SSEOpcode:=$db;
  end;
  $0a:begin
   SSEOpcode:=$eb;
  end;
  $0b:begin
   SSEOpcode:=$ef;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 // Read CSR state at JIT-compile time
 SEW:=8 shl vsew;
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 EMUL8:=LMUL8;
 if EMUL8<>8 then begin
  result:=false;
  exit;
 end;

 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 if (VL_val*(SEW shr 3))<>fJITVLENB then begin
  result:=false;
  exit;
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters((TPasRISCVUInt32(1) shl 0) or (TPasRISCVUInt32(1) shl 1) or (TPasRISCVUInt32(1) shl 2));
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 // === Runtime checks: VL/VTYPE ===
 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === Map vs2 as source, vd as destination ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostVs2:=0;
 HostVd:=0;
 EmitVectorLoad(HostVs2,VMPtrRegister,GuestVectorRegisterOffset(vs2));
{$else}
 HostVs2:=MapGuestToHostVectorRegister(vs2,REG_SRC);
 HostVd:=MapGuestToHostVectorRegister(vd,REG_DST);
{$endif}

 // === Claim temporary vector register for broadcast ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostBroadcast:=1;
{$else}
 HostBroadcast:=ClaimHostVectorRegister;
{$endif}

 // === Load scalar rs1 and broadcast to temp vector register ===
 HostScalar:=ClaimHostIntRegister;
 EmitNativeLoad(HostScalar,VMPtrRegister,GuestIntRegisterOffset(rs1),true);

 if fHasAVX2 then begin
  // VMOVD/VMOVQ xmm, HostScalar
  if SEW=64 then begin
   EmitVEXOp(1,false,true,1,$6e,HostBroadcast,HostScalar,0);
  end else begin
   EmitVEXOp(1,false,false,1,$6e,HostBroadcast,HostScalar,0);
  end;
  // VPBROADCASTx ymm/xmm, xmm
  case vsew of
   0:begin
    EmitVEXOp(1,fHasAVX2,false,2,$78,HostBroadcast,HostBroadcast,0);
   end;
   1:begin
    EmitVEXOp(1,fHasAVX2,false,2,$79,HostBroadcast,HostBroadcast,0);
   end;
   2:begin
    EmitVEXOp(1,fHasAVX2,false,2,$58,HostBroadcast,HostBroadcast,0);
   end;
   3:begin
    EmitVEXOp(1,fHasAVX2,false,2,$59,HostBroadcast,HostBroadcast,0);
   end;
  end;
 end else begin
  // SSE2 path: MOVD/MOVQ + shuffle broadcast
  if SEW=64 then begin
   EmitByte($66);
   EmitREX(true,HostBroadcast,0,HostScalar);
   EmitByte(X86_FAR_BRANCH);
   EmitByte($6e);
   EmitModRM(3,HostBroadcast,HostScalar);
  end else begin
   EmitSSE2Op($66,$6e,HostBroadcast,HostScalar);
  end;
  case vsew of
   0:begin
    EmitSSE2Op($66,$60,HostBroadcast,HostBroadcast);
    EmitSSE2Op($66,$61,HostBroadcast,HostBroadcast);
    EmitSSE2Op($66,$70,HostBroadcast,HostBroadcast);
    EmitByte($00);
   end;
   1:begin
    EmitSSE2Op($66,$61,HostBroadcast,HostBroadcast);
    EmitSSE2Op($66,$70,HostBroadcast,HostBroadcast);
    EmitByte($00);
   end;
   2:begin
    EmitSSE2Op($66,$70,HostBroadcast,HostBroadcast);
    EmitByte($00);
   end;
   3:begin
    EmitSSE2Op($66,$70,HostBroadcast,HostBroadcast);
    EmitByte($44);
   end;
  end;
 end;

 // === Apply operation: vd = vs2 OP broadcast (or broadcast OP vs2 for VRSUB) ===
 if IsVRSUB then begin
  EmitVectorOp(SSEOpcode,HostVd,HostBroadcast,HostVs2);
 end else begin
  EmitVectorOp(SSEOpcode,HostVd,HostVs2,HostBroadcast);
 end;

 // === Return broadcast temp to vector register mask ===
{$ifndef PasRISCVJustInTimeCompilerVectorScratch}
 FreeHostVectorRegister(HostBroadcast);
{$endif}

{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 EmitVectorStore(HostVd,VMPtrRegister,GuestVectorRegisterOffset(vd));
{$endif}

 EmitVectorClearVStart(HostScalar);

 FreeHostIntRegister(HostScalar);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VArithVX pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVArithVI(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for vadd/vrsub/vand/vor/vxor.vi: broadcast sign-extended imm5, operate with vs2
// Conditions: unmasked, EMUL=1, VSTART=0, full register (VL*SEW/8==fJITVLENB)
var vd,vs2,funct6:TPasRISCVUInt32;
    Unmasked:Boolean;
    SEW,LMUL8,EMUL8,VL_val:TPasRISCVUInt64;
    vsew:TPasRISCVUInt32;
    Imm5:TPasRISCVInt64;
    SSEOpcode:TPasRISCVUInt8;
    IsVRSUB:Boolean;
    HostScalar,HostVs2,HostVd,HostBroadcast:TPasRISCVUInt8;
begin
 // Decode instruction fields
 vd:=(aInstruction shr 7) and $1f;
 vs2:=(aInstruction shr 20) and $1f;
 Unmasked:=((aInstruction shr 25) and 1)<>0;
 funct6:=(aInstruction shr 26) and $3f;

 if not Unmasked then begin
  result:=false;
  exit;
 end;

 IsVRSUB:=false;
 vsew:=(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7;

 case funct6 of
  $00:begin
   // vadd.vi
   case vsew of
    0:begin
     SSEOpcode:=$fc;
    end;
    1:begin
     SSEOpcode:=$fd;
    end;
    2:begin
     SSEOpcode:=$fe;
    end;
    3:begin
     SSEOpcode:=$d4;
    end;
    else begin
     result:=false;
     exit;
    end;
   end;
  end;
  $03:begin
   // vrsub.vi: result = broadcast(imm) - vs2
   IsVRSUB:=true;
   case vsew of
    0:begin
     SSEOpcode:=$f8;
    end;
    1:begin
     SSEOpcode:=$f9;
    end;
    2:begin
     SSEOpcode:=$fa;
    end;
    3:begin
     SSEOpcode:=$fb;
    end;
    else begin
     result:=false;
     exit;
    end;
   end;
  end;
  $09:begin
   SSEOpcode:=$db;
  end;
  $0a:begin
   SSEOpcode:=$eb;
  end;
  $0b:begin
   SSEOpcode:=$ef;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 // Read CSR state at JIT-compile time
 SEW:=8 shl vsew;
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 EMUL8:=LMUL8;
 if EMUL8<>8 then begin
  result:=false;
  exit;
 end;

 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 if (VL_val*(SEW shr 3))<>fJITVLENB then begin
  result:=false;
  exit;
 end;

 // Sign-extend 5-bit immediate
 Imm5:=TPasRISCVInt64(SignExtend((aInstruction shr 15) and $1f,5));

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters((TPasRISCVUInt32(1) shl 0) or (TPasRISCVUInt32(1) shl 1) or (TPasRISCVUInt32(1) shl 2));
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 // === Runtime checks: VL/VTYPE ===
 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === Map vs2 as source, vd as destination ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostVs2:=0;
 HostVd:=0;
 EmitVectorLoad(HostVs2,VMPtrRegister,GuestVectorRegisterOffset(vs2));
{$else}
 HostVs2:=MapGuestToHostVectorRegister(vs2,REG_SRC);
 HostVd:=MapGuestToHostVectorRegister(vd,REG_DST);
{$endif}

 // === Claim temporary vector register for broadcast ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostBroadcast:=1;
{$else}
 HostBroadcast:=ClaimHostVectorRegister;
{$endif}

 // === Load immediate into GPR, broadcast to temp vector register ===
 HostScalar:=ClaimHostIntRegister;
 if SEW<64 then begin
  EmitNativeSetReg64(HostScalar,TPasRISCVUInt64(Imm5) and ((TPasRISCVUInt64(1) shl SEW)-1));
 end else begin
  EmitNativeSetReg64(HostScalar,Imm5);
 end;

 if fHasAVX2 then begin
  if SEW=64 then begin
   EmitVEXOp(1,false,true,1,$6e,HostBroadcast,HostScalar,0);
  end else begin
   EmitVEXOp(1,false,false,1,$6e,HostBroadcast,HostScalar,0);
  end;
  case vsew of
   0:begin
    EmitVEXOp(1,fHasAVX2,false,2,$78,HostBroadcast,HostBroadcast,0);
   end;
   1:begin
    EmitVEXOp(1,fHasAVX2,false,2,$79,HostBroadcast,HostBroadcast,0);
   end;
   2:begin
    EmitVEXOp(1,fHasAVX2,false,2,$58,HostBroadcast,HostBroadcast,0);
   end;
   3:begin
    EmitVEXOp(1,fHasAVX2,false,2,$59,HostBroadcast,HostBroadcast,0);
   end;
  end;
 end else begin
  // SSE2 path
  if SEW=64 then begin
   EmitByte($66);
   EmitREX(true,HostBroadcast,0,HostScalar);
   EmitByte(X86_FAR_BRANCH);
   EmitByte($6e);
   EmitModRM(3,HostBroadcast,HostScalar);
  end else begin
   EmitSSE2Op($66,$6e,HostBroadcast,HostScalar);
  end;
  case vsew of
   0:begin
    EmitSSE2Op($66,$60,HostBroadcast,HostBroadcast);
    EmitSSE2Op($66,$61,HostBroadcast,HostBroadcast);
    EmitSSE2Op($66,$70,HostBroadcast,HostBroadcast);
    EmitByte($00);
   end;
   1:begin
    EmitSSE2Op($66,$61,HostBroadcast,HostBroadcast);
    EmitSSE2Op($66,$70,HostBroadcast,HostBroadcast);
    EmitByte($00);
   end;
   2:begin
    EmitSSE2Op($66,$70,HostBroadcast,HostBroadcast);
    EmitByte($00);
   end;
   3:begin
    EmitSSE2Op($66,$70,HostBroadcast,HostBroadcast);
    EmitByte($44);
   end;
  end;
 end;

 // === Apply operation: vd = vs2 OP broadcast (or broadcast OP vs2 for VRSUB) ===
 if IsVRSUB then begin
  EmitVectorOp(SSEOpcode,HostVd,HostBroadcast,HostVs2);
 end else begin
  EmitVectorOp(SSEOpcode,HostVd,HostVs2,HostBroadcast);
 end;

 // === Return broadcast temp to vector register mask ===
{$ifndef PasRISCVJustInTimeCompilerVectorScratch}
 FreeHostVectorRegister(HostBroadcast);
{$endif}

{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 EmitVectorStore(HostVd,VMPtrRegister,GuestVectorRegisterOffset(vd));
{$endif}

 EmitVectorClearVStart(HostScalar);

 FreeHostIntRegister(HostScalar);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VArithVI pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVMVNR(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for vmv1r.v/vmv2r.v/vmv4r.v/vmv8r.v: whole-register move
// No masking, no VL/VTYPE dependency. Only needs VSTART=0 check.
// Emits N × MOVDQU/VMOVDQU pairs (load from vs2, store to vd)
var vd,vs2,vs1Field,NumRegs,RegIdx:TPasRISCVUInt32;
    Unmasked:Boolean;
    HostSrc,HostDst:TPasRISCVUInt8;
begin
 // Decode instruction fields
 vd:=(aInstruction shr 7) and $1f;
 vs2:=(aInstruction shr 20) and $1f;
 Unmasked:=((aInstruction shr 25) and 1)<>0;
 vs1Field:=(aInstruction shr 15) and $1f;

 // Must be unmasked
 if not Unmasked then begin
  result:=false;
  exit;
 end;

 // Validate nr-1 encoding
 if not (vs1Field in [0,1,3,7]) then begin
  result:=false;
  exit;
 end;
 NumRegs:=vs1Field+1;

 // Check alignment
 if ((vd and (NumRegs-1))<>0) or ((vs2 and (NumRegs-1))<>0) then begin
  result:=false;
  exit;
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters(TPasRISCVUInt32(1) shl 0);
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 // === Copy N registers via allocator ===
 for RegIdx:=0 to NumRegs-1 do begin
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
  EmitVectorLoad(0,VMPtrRegister,GuestVectorRegisterOffset((vs2+RegIdx) and 31));
  EmitVectorStore(0,VMPtrRegister,GuestVectorRegisterOffset((vd+RegIdx) and 31));
{$else}
  HostSrc:=MapGuestToHostVectorRegister((vs2+RegIdx) and 31,REG_SRC);
  HostDst:=MapGuestToHostVectorRegister((vd+RegIdx) and 31,REG_DST);
  EmitVectorMov(HostDst,HostSrc);
{$endif}
 end;

 EmitVectorClearVStart(-1);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VMVNR pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd,' nr=',NumRegs);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVCmpVV(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for vmseq.vv / vmsne.vv: vector compare producing mask bits
// SEW=8/16/32 only (SEW=64 needs SSE4.1 PCMPEQQ - bail out)
// Pattern: PCMPEQB/W/D => PMOVMSKB/MOVMSKPS => [NOT for vmsne] => store mask to vd
var vd,vs1,vs2,funct6:TPasRISCVUInt32;
    Unmasked:Boolean;
    SEW,LMUL8,VL_val,NumElements,MaskBits:TPasRISCVUInt64;
    vsew:TPasRISCVUInt32;
    CmpOpcode:TPasRISCVUInt8;
    IsNotEqual:Boolean;
    HostMask,HostVs2,HostVs1,HostTemp:TPasRISCVUInt8;
begin
 // Decode instruction fields
 vd:=(aInstruction shr 7) and $1f;
 vs1:=(aInstruction shr 15) and $1f;
 vs2:=(aInstruction shr 20) and $1f;
 Unmasked:=((aInstruction shr 25) and 1)<>0;
 funct6:=(aInstruction shr 26) and $3f;

 // Only JIT unmasked comparisons
 if not Unmasked then begin
  result:=false;
  exit;
 end;

 case funct6 of
  $18:begin
   IsNotEqual:=false;
  end;
  $19:begin
   IsNotEqual:=true;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 // Read CSR state
 vsew:=(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7;
 SEW:=8 shl vsew;

 // No PCMPEQQ in SSE2 - bail for SEW=64
 if vsew>2 then begin
  result:=false;
  exit;
 end;

 // Determine comparison opcode
 case vsew of
  0:begin
   CmpOpcode:=$74; // PCMPEQB
  end;
  1:begin
   CmpOpcode:=$75; // PCMPEQW
  end;
  2:begin
   CmpOpcode:=$76; // PCMPEQD
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 if LMUL8<>8 then begin
  result:=false;
  exit;
 end;

 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 if (VL_val*(SEW shr 3))<>fJITVLENB then begin
  result:=false;
  exit;
 end;

 NumElements:=fJITVLENB div (SEW shr 3);
 MaskBits:=(TPasRISCVUInt64(1) shl NumElements)-1;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters((TPasRISCVUInt32(1) shl 0) or (TPasRISCVUInt32(1) shl 1) or (TPasRISCVUInt32(1) shl 2));
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 // === Runtime checks ===

 EmitVectorVStartCheck(-1);

 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === Map vs2 and vs1 as sources ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostVs2:=0;
 HostVs1:=1;
 EmitVectorLoad(HostVs2,VMPtrRegister,GuestVectorRegisterOffset(vs2));
 EmitVectorLoad(HostVs1,VMPtrRegister,GuestVectorRegisterOffset(vs1));
{$else}
 HostVs2:=MapGuestToHostVectorRegister(vs2,REG_SRC);
 HostVs1:=MapGuestToHostVectorRegister(vs1,REG_SRC);
{$endif}

 // === Claim temp vector register for compare result ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostTemp:=2;
{$else}
 HostTemp:=ClaimHostVectorRegister;
{$endif}

 // === Compare: HostTemp = (HostVs2 == HostVs1) ? $ff : $00 ===
 EmitVectorOp(CmpOpcode,HostTemp,HostVs2,HostVs1);

 // === Extract mask bits to GPR ===
 HostMask:=ClaimHostIntRegister;

 if fHasAVX2 and (vsew<>1) then begin
  if vsew=0 then begin
   // VPMOVMSKB: VEX.L.66.0F D7 /r
   EmitVEXOp(1,fHasAVX2,false,1,$d7,HostMask,HostTemp,0);
  end else begin
   // VMOVMSKPS: VEX.L.NP.0F 50 /r
   EmitVEXOp(0,fHasAVX2,false,1,$50,HostMask,HostTemp,0);
  end;
 end else begin
  // SSE2 path
  if vsew<=1 then begin
   if vsew=1 then begin
    // SEW=16: PACKSSWB HostTemp, HostTemp then PMOVMSKB
    EmitSSE2Op($66,$63,HostTemp,HostTemp);
   end;
   // PMOVMSKB HostMask, HostTemp: 66 0F D7 /r
   EmitSSE2Op($66,$d7,HostMask,HostTemp);
   if vsew=1 then begin
    EmitNativeAndi(HostMask,HostMask,$ff);
   end;
  end else begin
   // SEW=32: MOVMSKPS HostMask, HostTemp: NP 0F 50 /r
   EmitSSE2Op(-1,$50,HostMask,HostTemp);
  end;
 end;

 // === Return temp vector register ===
{$ifndef PasRISCVJustInTimeCompilerVectorScratch}
 FreeHostVectorRegister(HostTemp);
{$endif}

 // For vmsne: invert the mask
 if IsNotEqual then begin
  EmitNativeXori(HostMask,HostMask,TPasRISCVInt32(MaskBits));
 end;

 // Store mask to vd (32-bit store covers all cases, tail bits zeroed)
 EmitNativeStore(HostMask,VMPtrRegister,GuestVectorRegisterOffset(vd),false);

 EmitVectorClearVStart(HostMask);

 FreeHostIntRegister(HostMask);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VCmpVV pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVMVVV(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for vmv.v.v (unmasked vmerge funct6=$17 with vs2=0): copy vs1 to vd
// Only for EMUL=1 full-register copies with stable runtime VL/VTYPE.
var vd,vs1,vs2:TPasRISCVUInt32;
    Unmasked:Boolean;
    SEW,LMUL8,EMUL8,VL_val:TPasRISCVUInt64;
    HostVs1,HostVd:TPasRISCVUInt8;
begin
 vd:=(aInstruction shr 7) and $1f;
 vs1:=(aInstruction shr 15) and $1f;
 vs2:=(aInstruction shr 20) and $1f;
 Unmasked:=((aInstruction shr 25) and 1)<>0;

 // Only handle unmasked vmv.v.v
 if not Unmasked then begin
  result:=false;
  exit;
 end;
 if vs2<>0 then begin
  result:=false;
  exit;
 end;

 // Read CSR state at JIT-compile time
 SEW:=8 shl ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7);
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 EMUL8:=LMUL8;
 if EMUL8<>8 then begin
  result:=false;
  exit;
 end;

 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 if (VL_val*(SEW shr 3))<>fJITVLENB then begin
  result:=false;
  exit;
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters(TPasRISCVUInt32(1) shl 0);
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 // === Runtime checks: VL/VTYPE must still match compile-time values ===
 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === Copy vs1 => vd via allocator ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostVs1:=0;
 HostVd:=0;
 EmitVectorLoad(HostVs1,VMPtrRegister,GuestVectorRegisterOffset(vs1));
{$else}
 HostVs1:=MapGuestToHostVectorRegister(vs1,REG_SRC);
 HostVd:=MapGuestToHostVectorRegister(vd,REG_DST);
{$endif}
 EmitVectorMov(HostVd,HostVs1);

{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 EmitVectorStore(HostVd,VMPtrRegister,GuestVectorRegisterOffset(vd));
{$endif}

 EmitVectorClearVStart(-1);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VMVVV pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVSlideVI(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for vslidedown.vi: shift vector elements toward index 0 by imm5 positions
// Also covers vslideup.vi (funct6=$0e) but bails out (too complex due to merge semantics)
// Conditions: unmasked, EMUL=1, VSTART=0, full register, shift_bytes fits in PSRLDQ/cross-lane
var vd,vs2,funct6,Imm5,ShiftBytes:TPasRISCVUInt32;
    Unmasked:Boolean;
    SEW,LMUL8,EMUL8,VL_val:TPasRISCVUInt64;
    HostTmp,HostVs2,HostVd,HostTemp:TPasRISCVUInt8;
    OkFixup:TPasRISCVUInt32;
begin
 vd:=(aInstruction shr 7) and $1f;
 vs2:=(aInstruction shr 20) and $1f;
 Unmasked:=((aInstruction shr 25) and 1)<>0;
 funct6:=(aInstruction shr 26) and $3f;
 Imm5:=(aInstruction shr 15) and $1f;

 // Only JIT vslidedown.vi (funct6=$0f), not vslideup.vi ($0e)
 if funct6<>$0f then begin
  result:=false;
  exit;
 end;

 if not Unmasked then begin
  result:=false;
  exit;
 end;

 // Read CSR state at JIT-compile time
 SEW:=8 shl ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7);
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 EMUL8:=LMUL8;
 if EMUL8<>8 then begin
  result:=false;
  exit;
 end;

 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 if (VL_val*(SEW shr 3))<>fJITVLENB then begin
  result:=false;
  exit;
 end;

 // Compute byte shift amount
 ShiftBytes:=Imm5*(SEW shr 3);
 if ShiftBytes=0 then begin
  result:=false;
  exit;
 end;
 if ShiftBytes>=fJITVLENB then begin
  result:=false;
  exit;
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters((TPasRISCVUInt32(1) shl 0) or (TPasRISCVUInt32(1) shl 1) or (TPasRISCVUInt32(1) shl 2) or (TPasRISCVUInt32(1) shl 3));
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 // === Runtime checks ===
 HostTmp:=ClaimHostIntRegister;
 EmitNativeLoad(HostTmp,VMPtrRegister,GuestCSRDataOffset(TPasRISCVUInt32(TCSR.TAddress.VSTART)),true);
 EmitTEST(HostTmp,HostTmp,true);
 EmitJccRel32(CC_E,0);
 OkFixup:=fTemporaryCodeSize-4;
 EmitVectorBailout;
 PatchJmpRel32(OkFixup);

 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === Map vs2 as source, vd as destination ===
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 HostVs2:=0;
 HostVd:=0;
 EmitVectorLoad(HostVs2,VMPtrRegister,GuestVectorRegisterOffset(vs2));
{$else}
 HostVs2:=MapGuestToHostVectorRegister(vs2,REG_SRC);
 HostVd:=MapGuestToHostVectorRegister(vd,REG_DST);
{$endif}

 if fHasAVX2 then begin
  // Claim temp for zero/permute
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
  HostTemp:=1;
{$else}
  HostTemp:=ClaimHostVectorRegister;
{$endif}
  if ShiftBytes<16 then begin
   // VPXOR HostTemp, HostTemp, HostTemp
   EmitVEXOp(1,true,false,1,$ef,HostTemp,HostTemp,HostTemp);
   // VPERM2I128 HostTemp, HostVs2(vvvv=src1), HostTemp(rm=src2=zero), $81
   // => HostTemp = [vs2_high | 0]
   EmitVEXOp(1,true,false,3,$46,HostTemp,HostTemp,HostVs2);
   EmitByte($81);
   // VPALIGNR HostVd, HostTemp(vvvv=src1), HostVs2(rm=src2), ShiftBytes
   EmitVEXOp(1,true,false,3,$0f,HostVd,HostVs2,HostTemp);
   EmitByte(ShiftBytes);
  end else if ShiftBytes=16 then begin
   // VPXOR HostTemp, HostTemp, HostTemp
   EmitVEXOp(1,true,false,1,$ef,HostTemp,HostTemp,HostTemp);
   // VPERM2I128 HostVd, HostVs2(vvvv=src1), HostTemp(rm=src2=zero), $81
   EmitVEXOp(1,true,false,3,$46,HostVd,HostTemp,HostVs2);
   EmitByte($81);
  end else begin
   // ShiftBytes 17..31: permute high=>low, then VPSRLDQ
   EmitVEXOp(1,true,false,1,$ef,HostTemp,HostTemp,HostTemp);
   EmitVEXOp(1,true,false,3,$46,HostVd,HostTemp,HostVs2);
   EmitByte($81);
   // VPSRLDQ HostVd, HostVd, (ShiftBytes-16): VEX.256.66.0F 73 /3 ib
   EmitVEXOp(1,true,false,1,$73,3,HostVd,HostVd);
   EmitByte(ShiftBytes-16);
  end;
  // Return temp
{$ifndef PasRISCVJustInTimeCompilerVectorScratch}
  FreeHostVectorRegister(HostTemp);
{$endif}
 end else begin
  // SSE VLEN=128: copy vs2=>vd, then PSRLDQ in-place
  EmitVectorMov(HostVd,HostVs2);
  // PSRLDQ HostVd, ShiftBytes: 66 [REX] 0F 73 /3 ib
  EmitSSE2Op($66,$73,3,HostVd);
  EmitByte(ShiftBytes);
 end;

{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
 EmitVectorStore(HostVd,VMPtrRegister,GuestVectorRegisterOffset(vd));
{$endif}

 EmitVectorClearVStart(-1);

 // === Set VS dirty in MSTATUS ===
 EmitSetVSDirty;

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VSlideVI pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd);
{$endif}

 result:=true;

end;

function TPasRISCV.THART.TJustInTimeCompilerX8664.IntrinsicVLEFF(const aInstruction:TPasRISCVUInt32;const aParameter0,aParameter1,aParameter2,aParameter3:TPasRISCVUInt64):Boolean;
// JIT for fault-only-first vector loads: vle8ff.v / vle16ff.v / vle32ff.v / vle64ff.v
// Same as VLE but only JIT when entire access fits in one page (no page crossing).
// Supports EMUL=1,2,4,8 (multiple register groups)
var vd:TPasRISCVUInt32;
    RS1:TRegister;
    Width,NumFields,MemOpType,UnitStrideMop:TPasRISCVUInt32;
    Unmasked:Boolean;
    EEW,SEW,LMUL8,EMUL8,VL_val:TPasRISCVUInt64;
    NumRegs,TotalBytes,RegIdx:TPasRISCVUInt32;
    HostAddr,HostTmp,HostRS1,HostCmp,HostVd:TPasRISCVUInt8;
    PageOkFixup:TPasRISCVUInt32;
begin
 // Decode instruction fields
 vd:=(aInstruction shr 7) and $1f;
 RS1:=TRegister((aInstruction shr 15) and $1f);
 Width:=(aInstruction shr 12) and 7;
 MemOpType:=(aInstruction shr 26) and 3;
 Unmasked:=((aInstruction shr 25) and 1)<>0;
 NumFields:=((aInstruction shr 29) and 7);
 UnitStrideMop:=(aInstruction shr 20) and $1f;

 // Only JIT unit-stride fault-only-first, non-segmented, unmasked
 if MemOpType<>0 then begin
  result:=false;
  exit;
 end;
 if UnitStrideMop<>$10 then begin
  result:=false;
  exit;
 end;
 if not Unmasked then begin
  result:=false;
  exit;
 end;
 if NumFields<>0 then begin
  result:=false;
  exit;
 end;

 case Width of
  $0:begin
   EEW:=8;
  end;
  $5:begin
   EEW:=16;
  end;
  $6:begin
   EEW:=32;
  end;
  $7:begin
   EEW:=64;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 SEW:=8 shl ((fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] shr 3) and 7);
 case fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and 7 of
  $00:begin
   LMUL8:=8;
  end;
  $01:begin
   LMUL8:=16;
  end;
  $02:begin
   LMUL8:=32;
  end;
  $03:begin
   LMUL8:=64;
  end;
  $05:begin
   LMUL8:=1;
  end;
  $06:begin
   LMUL8:=2;
  end;
  $07:begin
   LMUL8:=4;
  end;
  else begin
   result:=false;
   exit;
  end;
 end;

 if (SEW>0) and (LMUL8>0) then begin
  EMUL8:=(EEW*LMUL8) div SEW;
 end else begin
  result:=false;
  exit;
 end;

 // Support EMUL=1,2,4,8. Bail for fractional LMUL.
 if EMUL8<8 then begin
  result:=false;
  exit;
 end;
 NumRegs:=EMUL8 div 8;
 if not (NumRegs in [1,2,4,8]) then begin
  result:=false;
  exit;
 end;

 // Check register group alignment
 if (vd and (NumRegs-1))<>0 then begin
  result:=false;
  exit;
 end;

 if (fHART.fState.CSR.fData[TCSR.TAddress.VTYPE] and (TPasRISCVUInt64(1) shl 63))<>0 then begin
  result:=false;
  exit;
 end;

 VL_val:=fHART.fState.CSR.fData[TCSR.TAddress.VL];
 if VL_val=0 then begin
  result:=false;
  exit;
 end;

 TotalBytes:=NumRegs*fJITVLENB;
 if (VL_val*(EEW shr 3))<>TotalBytes then begin
  result:=false;
  exit;
 end;

 EmitVectorEnabledCheck;

{$ifdef PasRISCVJustInTimeCompilerVectorFreeRegisters}
 FreeAllHostIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerVectorFreeAllFPUVectorRegisters}
 FreeAllHostFPURegisters;
{$else}
 FreeHostFloatRegisters(TPasRISCVUInt32(1) shl 0);
{$endif}
 FreeAllHostVectorRegisters;
{$endif}

 EmitVectorVStartCheck(-1);

 EmitVectorVLCheck(VL_val);
 EmitVectorVTypeCheck(fHART.fState.CSR.fData[TCSR.TAddress.VTYPE]);

 // === TLB lookup for base address ===
 HostAddr:=ClaimHostIntRegister;
 EmitDataTLBLookup(HostAddr,RS1,0,TLB_R,1);

 // === Page-crossing check: if (addr & $fff) + TotalBytes > $1000, bailout ===
 HostTmp:=ClaimHostIntRegister;
 HostRS1:=MapGuestToHostIntRegister(RS1,REG_SRC);
 EmitNativeAndi(HostTmp,HostRS1,$fff);
 HostCmp:=ClaimHostIntRegister;
 EmitNativeSetReg32s(HostCmp,TPasRISCVInt32(($1000-TotalBytes)+1));
 Emit2RegOp(X86_CMP,HostTmp,HostCmp,false);
 FreeHostIntRegister(HostCmp);
 EmitJccRel32(CC_B,0);
 PageOkFixup:=fTemporaryCodeSize-4;
 EmitVectorBailout;
 PatchJmpRel32(PageOkFixup);
 FreeHostIntRegister(HostTmp);

 // === Load NumRegs consecutive vector registers from host memory ===
 for RegIdx:=0 to NumRegs-1 do begin
{$ifdef PasRISCVJustInTimeCompilerVectorScratch}
  HostVd:=0;
  EmitVectorLoad(HostVd,HostAddr,TPasRISCVInt32(RegIdx*fJITVLENB));
  EmitVectorStore(HostVd,VMPtrRegister,GuestVectorRegisterOffset((vd+RegIdx) and 31));
{$else}
  HostVd:=MapGuestToHostVectorRegister((vd+RegIdx) and 31,REG_DST);
  EmitVectorLoad(HostVd,HostAddr,TPasRISCVInt32(RegIdx*fJITVLENB));
{$endif}
 end;

 EmitVectorClearVStart(HostAddr);

 FreeHostIntRegister(HostAddr);

{$ifdef PasRISCVJustInTimeCompilerVectorDebug}
 writeln('[JIT] VLEFF pc=',LowerCase(IntToHex(fHART.fState.PC,16)),' vd=',vd,' nr=',NumRegs);
{$endif}

 result:=true;

end;

{$endif}

