     // normal f64 -> normal f32 (f32 biased exp = f64 biased exp - 896)
     F32BiasedExponent:=F64BiasedExponent-896;
     F32Mantissa:=TPasRISCVUInt32(F64Mantissa shr 29);
     LostBits64:=F64Mantissa and TPasRISCVUInt64($1fffffff);
