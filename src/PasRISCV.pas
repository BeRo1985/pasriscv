    ui32:=TPasRISCVUInt32(VectorGetElement(aVS2,Index,32));
    SFResult:=TPasRISCVUInt16(SoftFloatConvertFloatBits(ui32,23,31,$ff,127,7,15,$ff,127,BF16CanonicalNaN,aRM,FFlags));
    VectorSetElement(aVD,Index,16,SFResult);
   end;
  end;
 end;
 fState.CSR.SetFPUException(FFlags);
