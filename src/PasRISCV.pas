function SoftFloatFClassCore(const aA:TPasRISCVUInt64;const aMantissaBits,aSignShift:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32):TPasRISCVUInt32;
var Sign:boolean;
    Exponent:TPasRISCVInt32;
