 for ForwardIndex:=0 to High(fIPv6FragmentReassemblyTable) do begin
  ClearIPv6FragmentReassemblyEntry(ForwardIndex);
 end;

 for ForwardIndex:=0 to fPortForwardCount-1 do begin
  PortForwardItem:=@fPortForwards[ForwardIndex];
