procedure TPasRISCV.TConfiguration.LoadSnapshot(const aNode:TSnapshot.TNode);
var BinarySize:TPasRISCVSizeInt;
    BinaryData:Pointer;
    ExtraNode:TSnapshot.TNode;
    ExtraCount:TPasRISCVSizeInt;
    ElementNode:TSnapshot.TNode;
    ExtraIndex:TPasRISCVSizeInt;
    ExtraSharedMemoryRange:PExtraSharedMemoryRange;
begin
 if not assigned(aNode) then begin
  exit;
 end;

 // Debugger settings
 fDebugger:=aNode.GetBool('Debugger',fDebugger);
 fDebuggerLocal:=aNode.GetBool('DebuggerLocal',fDebuggerLocal);
 fDebuggerPort:=aNode.GetUInt16('DebuggerPort',fDebuggerPort);

 // Machine basics
 fCountHARTs:=aNode.GetUInt64('CountHARTs',fCountHARTs);
 fBootArguments:=aNode.GetString('BootArguments',fBootArguments);
 fBootMemoryBase:=aNode.GetUInt64('BootMemoryBase',fBootMemoryBase);
 fBootMemorySize:=aNode.GetUInt64('BootMemorySize',fBootMemorySize);
 fMemoryBase:=aNode.GetUInt64('MemoryBase',fMemoryBase);
 fMemorySize:=aNode.GetUInt64('MemorySize',fMemorySize);

 // Interrupt controllers (CLINT, IMSIC, APLIC, PLIC)
 fCLINTBase:=aNode.GetUInt64('CLINTBase',fCLINTBase);
 fCLINTSize:=aNode.GetUInt64('CLINTSize',fCLINTSize);
 fIMSICMachineBase:=aNode.GetUInt64('IMSICMachineBase',fIMSICMachineBase);
 fIMSICMachineSizePerHART:=aNode.GetUInt64('IMSICMachineSizePerHART',fIMSICMachineSizePerHART);
 fIMSICSupervisorBase:=aNode.GetUInt64('IMSICSupervisorBase',fIMSICSupervisorBase);
 fIMSICSupervisorSizePerHART:=aNode.GetUInt64('IMSICSupervisorSizePerHART',fIMSICSupervisorSizePerHART);
 fAPLICMachineBase:=aNode.GetUInt64('APLICMachineBase',fAPLICMachineBase);
 fAPLICMachineSize:=aNode.GetUInt64('APLICMachineSize',fAPLICMachineSize);
 fAPLICSupervisorBase:=aNode.GetUInt64('APLICSupervisorBase',fAPLICSupervisorBase);
 fAPLICSupervisorSize:=aNode.GetUInt64('APLICSupervisorSize',fAPLICSupervisorSize);
 fPLICBase:=aNode.GetUInt64('PLICBase',fPLICBase);
 fPLICSize:=aNode.GetUInt64('PLICSize',fPLICSize);

 // System control
 fSYSCONBase:=aNode.GetUInt64('SYSCONBase',fSYSCONBase);
 fSYSCONSize:=aNode.GetUInt64('SYSCONSize',fSYSCONSize);

 // UART
 fUARTBase:=aNode.GetUInt64('UARTBase',fUARTBase);
 fUARTSize:=aNode.GetUInt64('UARTSize',fUARTSize);
 fUARTIRQ:=aNode.GetUInt64('UARTIRQ',fUARTIRQ);

 // VirtIO Block
 fVirtIOBlockBase:=aNode.GetUInt64('VirtIOBlockBase',fVirtIOBlockBase);
 fVirtIOBlockSize:=aNode.GetUInt64('VirtIOBlockSize',fVirtIOBlockSize);
 fVirtIOBlockIRQ:=aNode.GetUInt64('VirtIOBlockIRQ',fVirtIOBlockIRQ);

 // RTC
 fRTCMode:=TRTCMode(aNode.GetUInt32('RTCMode',TPasRISCVUInt32(ord(fRTCMode))));
 fGoldfishRTCBase:=aNode.GetUInt64('GoldfishRTCBase',fGoldfishRTCBase);
 fGoldfishRTCSize:=aNode.GetUInt64('GoldfishRTCSize',fGoldfishRTCSize);
 fGoldfishRTCIRQ:=aNode.GetUInt64('GoldfishRTCIRQ',fGoldfishRTCIRQ);
 fDS1742Base:=aNode.GetUInt64('DS1742Base',fDS1742Base);
 fDS1742Size:=aNode.GetUInt64('DS1742Size',fDS1742Size);

 // Frame buffer
 fFrameBufferBase:=aNode.GetUInt64('FrameBufferBase',fFrameBufferBase);
 fFrameBufferSize:=aNode.GetUInt64('FrameBufferSize',fFrameBufferSize);
 fFrameBufferWidth:=aNode.GetUInt64('FrameBufferWidth',fFrameBufferWidth);
 fFrameBufferHeight:=aNode.GetUInt64('FrameBufferHeight',fFrameBufferHeight);
 fFrameBufferBytesPerPixel:=aNode.GetUInt64('FrameBufferBytesPerPixel',fFrameBufferBytesPerPixel);
 fFrameBufferStride:=aNode.GetUInt64('FrameBufferStride',fFrameBufferStride);
 fFrameBufferFormat:=aNode.GetUInt64('FrameBufferFormat',fFrameBufferFormat);

 // Shared memory
 fSharedMemoryBase:=aNode.GetUInt64('SharedMemoryBase',fSharedMemoryBase);
 fSharedMemorySize:=aNode.GetUInt64('SharedMemorySize',fSharedMemorySize);
 fSharedMemoryIRQ:=aNode.GetUInt64('SharedMemoryIRQ',fSharedMemoryIRQ);

 // Extra shared memory ranges
 ExtraNode:=aNode.FindNode('ExtraSharedMemory');
 if assigned(ExtraNode) then begin
  ExtraCount:=ExtraNode.ChildCount;
  fExtraSharedMemoryRanges.Clear;
  for ExtraIndex:=0 to ExtraCount-1 do begin
   ExtraSharedMemoryRange:=PExtraSharedMemoryRange(fExtraSharedMemoryRanges.AddNew);
   ElementNode:=ExtraNode.Children[ExtraIndex];
   ExtraSharedMemoryRange^.Base:=ElementNode.GetUInt64('Base',0);
   ExtraSharedMemoryRange^.Size:=ElementNode.GetUInt64('Size',0);
   ExtraSharedMemoryRange^.IRQ:=ElementNode.GetUInt64('IRQ',0);
   ExtraSharedMemoryRange^.Raw:=ElementNode.GetBool('Raw',false);
   ExtraSharedMemoryRange^.ExternalPointer:=nil;
  end;
 end else begin
  fExtraSharedMemoryRanges.Clear;
 end;
 fNextAutoSharedMemoryBase:=aNode.GetUInt64('NextAutoSharedMemoryBase',0);
 fNextAutoSharedMemoryIRQ:=aNode.GetUInt64('NextAutoSharedMemoryIRQ',0);

 // Raw keyboard
 fRawKeyboardBase:=aNode.GetUInt64('RawKeyboardBase',fRawKeyboardBase);
 fRawKeyboardSize:=aNode.GetUInt64('RawKeyboardSize',fRawKeyboardSize);

 // I2C
 fI2CMode:=TI2CMode(aNode.GetUInt32('I2CMode',TPasRISCVUInt32(ord(fI2CMode))));
 fOpenCoresI2CBase:=aNode.GetUInt64('OpenCoresI2CBase',fOpenCoresI2CBase);
 fOpenCoresI2CSize:=aNode.GetUInt64('OpenCoresI2CSize',fOpenCoresI2CSize);
 fDesignWareI2CBase:=aNode.GetUInt64('DesignWareI2CBase',fDesignWareI2CBase);
 fDesignWareI2CSize:=aNode.GetUInt64('DesignWareI2CSize',fDesignWareI2CSize);

 // PS/2
 fPS2KeyboardBase:=aNode.GetUInt64('PS2KeyboardBase',fPS2KeyboardBase);
 fPS2KeyboardSize:=aNode.GetUInt64('PS2KeyboardSize',fPS2KeyboardSize);
 fPS2KeyboardIRQ:=aNode.GetUInt64('PS2KeyboardIRQ',fPS2KeyboardIRQ);
 fPS2MouseBase:=aNode.GetUInt64('PS2MouseBase',fPS2MouseBase);
 fPS2MouseSize:=aNode.GetUInt64('PS2MouseSize',fPS2MouseSize);
 fPS2MouseIRQ:=aNode.GetUInt64('PS2MouseIRQ',fPS2MouseIRQ);

 // VirtIO Input
 fVirtIOInputKeyboardBase:=aNode.GetUInt64('VirtIOInputKeyboardBase',fVirtIOInputKeyboardBase);
 fVirtIOInputKeyboardSize:=aNode.GetUInt64('VirtIOInputKeyboardSize',fVirtIOInputKeyboardSize);
 fVirtIOInputKeyboardIRQ:=aNode.GetUInt64('VirtIOInputKeyboardIRQ',fVirtIOInputKeyboardIRQ);
 fVirtIOInputMouseBase:=aNode.GetUInt64('VirtIOInputMouseBase',fVirtIOInputMouseBase);
 fVirtIOInputMouseSize:=aNode.GetUInt64('VirtIOInputMouseSize',fVirtIOInputMouseSize);
 fVirtIOInputMouseIRQ:=aNode.GetUInt64('VirtIOInputMouseIRQ',fVirtIOInputMouseIRQ);
 fVirtIOInputTabletBase:=aNode.GetUInt64('VirtIOInputTabletBase',fVirtIOInputTabletBase);
 fVirtIOInputTabletSize:=aNode.GetUInt64('VirtIOInputTabletSize',fVirtIOInputTabletSize);
 fVirtIOInputTabletIRQ:=aNode.GetUInt64('VirtIOInputTabletIRQ',fVirtIOInputTabletIRQ);
 fVirtIOInputGamepadBase:=aNode.GetUInt64('VirtIOInputGamepadBase',fVirtIOInputGamepadBase);
 fVirtIOInputGamepadSize:=aNode.GetUInt64('VirtIOInputGamepadSize',fVirtIOInputGamepadSize);
 fVirtIOInputGamepadIRQ:=aNode.GetUInt64('VirtIOInputGamepadIRQ',fVirtIOInputGamepadIRQ);

 // VirtIO Sound
 fVirtIOSoundBase:=aNode.GetUInt64('VirtIOSoundBase',fVirtIOSoundBase);
 fVirtIOSoundSize:=aNode.GetUInt64('VirtIOSoundSize',fVirtIOSoundSize);
 fVirtIOSoundIRQ:=aNode.GetUInt64('VirtIOSoundIRQ',fVirtIOSoundIRQ);

 // VirtIO 9P
 fVirtIO9PBase:=aNode.GetUInt64('VirtIO9PBase',fVirtIO9PBase);
 fVirtIO9PSize:=aNode.GetUInt64('VirtIO9PSize',fVirtIO9PSize);
 fVirtIO9PIRQ:=aNode.GetUInt64('VirtIO9PIRQ',fVirtIO9PIRQ);
 fVirtIO9PMountTag:=aNode.GetString('VirtIO9PMountTag',fVirtIO9PMountTag);

 // VirtIO Net
 fVirtIONetBase:=aNode.GetUInt64('VirtIONetBase',fVirtIONetBase);
 fVirtIONetSize:=aNode.GetUInt64('VirtIONetSize',fVirtIONetSize);
 fVirtIONetIRQ:=aNode.GetUInt64('VirtIONetIRQ',fVirtIONetIRQ);
 fVirtIONetTAPInterface:=aNode.GetString('VirtIONetTAPInterface',fVirtIONetTAPInterface);
 fNetworkHostForwards:=aNode.GetString('NetworkHostForwards',fNetworkHostForwards);
 fUserModeIPv6Enabled:=aNode.GetBool('UserModeIPv6Enabled',fUserModeIPv6Enabled);
 fUserModeTracerouteEnabled:=aNode.GetBool('UserModeTracerouteEnabled',fUserModeTracerouteEnabled);
 fUserModeTCPIdleTimeoutTicks:=aNode.GetUInt32('UserModeTCPIdleTimeoutTicks',fUserModeTCPIdleTimeoutTicks);

 // VirtIO Random Generator
 fVirtIORandomGeneratorBase:=aNode.GetUInt64('VirtIORandomGeneratorBase',fVirtIORandomGeneratorBase);
 fVirtIORandomGeneratorSize:=aNode.GetUInt64('VirtIORandomGeneratorSize',fVirtIORandomGeneratorSize);
 fVirtIORandomGeneratorIRQ:=aNode.GetUInt64('VirtIORandomGeneratorIRQ',fVirtIORandomGeneratorIRQ);

 // VirtIO GPU
 fVirtIOGPUBase:=aNode.GetUInt64('VirtIOGPUBase',fVirtIOGPUBase);
 fVirtIOGPUSize:=aNode.GetUInt64('VirtIOGPUSize',fVirtIOGPUSize);
 fVirtIOGPUIRQ:=aNode.GetUInt64('VirtIOGPUIRQ',fVirtIOGPUIRQ);

 // VirtIO VSock
 fVirtIOVSockBase:=aNode.GetUInt64('VirtIOVSockBase',fVirtIOVSockBase);
 fVirtIOVSockSize:=aNode.GetUInt64('VirtIOVSockSize',fVirtIOVSockSize);
 fVirtIOVSockIRQ:=aNode.GetUInt64('VirtIOVSockIRQ',fVirtIOVSockIRQ);
 fVirtIOVSockGuestCID:=aNode.GetUInt64('VirtIOVSockGuestCID',fVirtIOVSockGuestCID);

 // VirtIO RTC
 fVirtIORTCBase:=aNode.GetUInt64('VirtIORTCBase',fVirtIORTCBase);
 fVirtIORTCSize:=aNode.GetUInt64('VirtIORTCSize',fVirtIORTCSize);
 fVirtIORTCIRQ:=aNode.GetUInt64('VirtIORTCIRQ',fVirtIORTCIRQ);

 // VirtIO FS
 fVirtIOFSBase:=aNode.GetUInt64('VirtIOFSBase',fVirtIOFSBase);
 fVirtIOFSSize:=aNode.GetUInt64('VirtIOFSSize',fVirtIOFSSize);
 fVirtIOFSIRQ:=aNode.GetUInt64('VirtIOFSIRQ',fVirtIOFSIRQ);
 fVirtIOFSMountTag:=aNode.GetString('VirtIOFSMountTag',fVirtIOFSMountTag);

 // VirtIO FS DAX
 fVirtIOFSDAXBase:=aNode.GetUInt64('VirtIOFSDAXBase',fVirtIOFSDAXBase);
 fVirtIOFSDAXSize:=aNode.GetUInt64('VirtIOFSDAXSize',fVirtIOFSDAXSize);

 // VirtIO Crypto
 fVirtIOCryptoBase:=aNode.GetUInt64('VirtIOCryptoBase',fVirtIOCryptoBase);
 fVirtIOCryptoSize:=aNode.GetUInt64('VirtIOCryptoSize',fVirtIOCryptoSize);
 fVirtIOCryptoIRQ:=aNode.GetUInt64('VirtIOCryptoIRQ',fVirtIOCryptoIRQ);

 // IVSHMEM
 fIVSHMEMSharedMemorySize:=aNode.GetUInt64('IVSHMEMSharedMemorySize',fIVSHMEMSharedMemorySize);

 // Feature flags
 fAIA:=aNode.GetBool('AIA',fAIA);
 fStrictCompliantFPU:=aNode.GetBool('StrictCompliantFPU',fStrictCompliantFPU);
{$ifdef PasRISCVFastRMMFixup}
 fFastRMMFixupEnabled:=aNode.GetBool('FastRMMFixupEnabled',fFastRMMFixupEnabled);
{$endif}
{$ifdef PasRISCVJITFPUInvalidFlag}
 fJITFPUInvalidFlagEnabled:=aNode.GetBool('JITFPUInvalidFlagEnabled',fJITFPUInvalidFlagEnabled);
{$endif}
 fSVVPTC:=aNode.GetBool('SVVPTC',fSVVPTC);
 fVirtIOBlockEnabled:=aNode.GetBool('VirtIOBlockEnabled',fVirtIOBlockEnabled);
 fVirtIOBlockMQ:=aNode.GetBool('VirtIOBlockMQ',fVirtIOBlockMQ);
 fNVMeEnabled:=aNode.GetBool('NVMeEnabled',fNVMeEnabled);
 fSoundMode:=TSoundMode(aNode.GetUInt32('SoundMode',TPasRISCVUInt32(ord(fSoundMode))));
 fDisplayMode:=TDisplayMode(aNode.GetUInt32('DisplayMode',TPasRISCVUInt32(ord(fDisplayMode))));
 fVirtIOGPUVirGL:=aNode.GetBool('VirtIOGPUVirGL',fVirtIOGPUVirGL);
 fNetworkMode:=TNetworkMode(aNode.GetUInt32('NetworkMode',TPasRISCVUInt32(ord(fNetworkMode))));

 // CPU settings
 fLRSCMaximumCycles:=aNode.GetUInt64('LRSCMaximumCycles',fLRSCMaximumCycles);
 fVector:=aNode.GetBool('Vector',fVector);
{$ifdef PasRISCVJustInTimeCompiler}
 fJITEnabled:=aNode.GetBool('JITEnabled',fJITEnabled);
{$ifdef PasRISCVJustInTimeCompilerFPU}
 fJITFPUEnabled:=aNode.GetBool('JITFPUEnabled',fJITFPUEnabled);
 fJITFastFPUCodePaths:=aNode.GetBool('JITFastFPUCodePaths',fJITFastFPUCodePaths);
{$endif}
{$ifdef PasRISCVJustInTimeCompilerVector}
 fJITVectorEnabled:=aNode.GetBool('JITVectorEnabled',fJITVectorEnabled);
{$endif}
{$endif}
 // Firmware (embedded mode)
 BinarySize:=aNode.GetBinarySize('BIOSData');
 if BinarySize>0 then begin
  fBIOS.Clear;
  fBIOS.SetSize(BinarySize);
  aNode.GetBinary('BIOSData',fBIOS.Memory,BinarySize);
 end;
 BinarySize:=aNode.GetBinarySize('KernelData');
 if BinarySize>0 then begin
  fKernel.Clear;
  fKernel.SetSize(BinarySize);
  aNode.GetBinary('KernelData',fKernel.Memory,BinarySize);
 end;
 BinarySize:=aNode.GetBinarySize('INITRDData');
 if BinarySize>0 then begin
  fINITRD.Clear;
  fINITRD.SetSize(BinarySize);
  aNode.GetBinary('INITRDData',fINITRD.Memory,BinarySize);
 end;
end;

procedure TPasRISCV.TConfiguration.SaveSnapshot(const aNode:TSnapshot.TNode;const aFirmwareMode:TSnapshotFirmwareMode);
var ExtraNode:TSnapshot.TNode;
    ElementNode:TSnapshot.TNode;
    ExtraIndex:TPasRISCVSizeInt;
    ExtraSharedMemoryRange:PExtraSharedMemoryRange;
begin

 if not assigned(aNode) then begin
