var Mask:TPasRISCVUInt64;
begin
 Mask:=TPasRISCVUInt64(1) shl TPasRISCVUInt64(aInterruptValue);
 TPasMPInterlocked.BitwiseAnd(fState.PendingIRQs,TPasRISCVUInt64(not TPasRISCVUInt64(Mask)));
//TPasMPInterlocked.BitwiseAnd(fState.CSR.fData[TCSR.TAddress.MIP],TPasRISCVUInt64(not TPasRISCVUInt64(Mask)));
end;

procedure TPasRISCV.THART.RaiseInterrupt(const aInterruptValue:TPasRISCV.THART.TInterruptValue);
var Mask:TPasRISCVUInt64;
begin
 Mask:=TPasRISCVUInt64(1) shl TPasRISCVUInt64(aInterruptValue);
 if (TPasMPInterlocked.ExchangeBitwiseOr(fState.PendingIRQs,Mask) and Mask)=0 then begin
{$ifdef PasRISCVDumpNVMeIO}
  if aInterruptValue=TPasRISCV.THART.TInterruptValue.SupervisorExternal then begin
   //writeln(StdErr,'HART ',fHARTID,' RaiseInterrupt S-ext (new) at ',GetTickCount64,'ms');
  end;
{$endif}
{$ifdef PasRISCVPerHARTConditionVariables}
{$ifdef PasRISCVUseFutexEvents}
{$if defined(PasRISCVInterruptWakeupHardening)}
//TPasMPInterlocked.Increment(fMachine.fWakeGeneration);
{$ifend}
//RestartExecution;
  TPasMPInterlocked.BitwiseOr(fMachine.fRunState,fHARTMask);
  fWakeUpFutexEvent.Wake;
{$else}
  fWakeUpConditionVariableLock.Acquire;
  try
{$if defined(PasRISCVInterruptWakeupHardening)}
// TPasMPInterlocked.Increment(fWakeGeneration);
{$ifend}
// RestartExecution;
   TPasMPInterlocked.BitwiseOr(fMachine.fRunState,fHARTMask);
   fWakeUpConditionVariable.Signal;
  finally
   fWakeUpConditionVariableLock.Release;
  end;
{$endif}
{$else}
{$ifdef PasRISCVUseFutexEvents}
{$if defined(PasRISCVInterruptWakeupHardening)}
//TPasMPInterlocked.Increment(fMachine.fWakeGeneration);
{$ifend}
//RestartExecution;
  TPasMPInterlocked.BitwiseOr(fMachine.fRunState,fHARTMask);
//TPasMPInterlocked.BitwiseOr(fMachine.fRunState,fMachine.fAllHARTMask);
  fMachine.fWakeUpFutexEvent.WakeAll;
{$else}
  fMachine.fWakeUpConditionVariableLock.Acquire;
  try
{$if defined(PasRISCVInterruptWakeupHardening)}
// TPasMPInterlocked.Increment(fMachine.fWakeGeneration);
{$ifend}
// RestartExecution;
   TPasMPInterlocked.BitwiseOr(fMachine.fRunState,fHARTMask);
// TPasMPInterlocked.BitwiseOr(fMachine.fRunState,fMachine.fAllHARTMask);
   fMachine.fWakeUpConditionVariable.Broadcast;
  finally
   fMachine.fWakeUpConditionVariableLock.Release;
  end;
{$endif}
{$endif}
 end else begin
{$ifdef PasRISCVDumpNVMeIO}
  if aInterruptValue=TPasRISCV.THART.TInterruptValue.SupervisorExternal then begin
   //writeln(StdErr,'HART ',fHARTID,' RaiseInterrupt S-ext DEDUP (already pending) at ',GetTickCount64,'ms');
  end;
{$endif}
 end;
end;

function TPasRISCV.THART.SetInterrupt(const aInterruptValue:TPasRISCV.THART.TInterruptValue):Boolean;
var Mask:TPasRISCVUInt64;
begin
 Mask:=TPasRISCVUInt64(1) shl TPasRISCVUInt64(aInterruptValue);
 result:=(TPasMPInterlocked.ExchangeBitwiseOr(fState.PendingIRQs,Mask) and Mask)=0;
end;

function TPasRISCV.THART.GetVGEIN:TPasRISCVUInt32;
begin
 result:=(fState.CSR.fData[TCSR.TAddress.HSTATUS] shr TCSR.TMask.THSTATUSBit.VGEIN) and $3f;
end;

function TPasRISCV.THART.IsVGEINValid:Boolean;
var VGEIN:TPasRISCVUInt32;
begin
 VGEIN:=GetVGEIN;
 result:=(VGEIN>=1) and (VGEIN<=TCSR.TMask.GEILEN);
end;

{$ifdef AIAIPrio}
function TPasRISCV.THART.GetEffectiveIPrio(const aIRQ:TPasRISCVUInt32;const aMLevel:Boolean):TPasRISCVUInt8;
var Prio:TPasRISCVUInt8;
begin
 // Returns the effective priority number for interrupt aIRQ
 // Lower number = higher priority; 1 is highest, 255 is lowest
 if aIRQ<TCSR.IPRIO_MAX_IRQ then begin
  if aMLevel then begin
   Prio:=fMIPrio[aIRQ];
  end else begin
   Prio:=fSIPrio[aIRQ];
  end;
  if Prio=0 then begin
   // iprio[i]=0 means use default priority from the AIA spec table
   if aIRQ<Length(TCSR.IPRIO_DEFAULTS) then begin
    result:=TCSR.IPRIO_DEFAULTS[aIRQ];
   end else begin
    // For interrupts >= 16 with no specific default, use a value based on IRQ number
    // Higher IRQ numbers get lower priority (higher number)
    result:=TPasRISCVUInt8(aIRQ);
   end;
  end else begin
   result:=Prio;
  end;
 end else begin
  result:=255; // Out of range: lowest priority
 end;
end;

function TPasRISCV.THART.ReadIPrioCSR(const aISelectOffset:TPasRISCVUInt32;const aMLevel:Boolean):TPasRISCVUInt64;
var ByteIdx,IRQ:TPasRISCVUInt32;
    MapBase:TPasRISCVUInt32;
begin
 // Read iprio CSR at iselect offset k (0..15), returns packed 8-byte value for RV64
 result:=0;
 if aISelectOffset<16 then begin
  MapBase:=aISelectOffset*TCSR.IPRIO_BYTES_PER_REG;
  for ByteIdx:=0 to TCSR.IPRIO_BYTES_PER_REG-1 do begin
   IRQ:=TCSR.IPRIO_ISELECT_MAP[MapBase+ByteIdx];
   if (IRQ>0) and (IRQ<TCSR.IPRIO_MAX_IRQ) then begin
    if aMLevel then begin
     result:=result or (TPasRISCVUInt64(fMIPrio[IRQ]) shl (ByteIdx*8));
    end else begin
     result:=result or (TPasRISCVUInt64(fSIPrio[IRQ]) shl (ByteIdx*8));
    end;
   end;
  end;
 end;
end;

procedure TPasRISCV.THART.WriteIPrioCSR(const aISelectOffset:TPasRISCVUInt32;const aValue:TPasRISCVUInt64;const aMLevel:Boolean);
var ByteIdx,IRQ:TPasRISCVUInt32;
    MapBase:TPasRISCVUInt32;
    PrioByte:TPasRISCVUInt8;
begin
 // Write iprio CSR at iselect offset k (0..15), unpacks 8-byte value for RV64
 if aISelectOffset<16 then begin
  MapBase:=aISelectOffset*TCSR.IPRIO_BYTES_PER_REG;
  for ByteIdx:=0 to TCSR.IPRIO_BYTES_PER_REG-1 do begin
   IRQ:=TCSR.IPRIO_ISELECT_MAP[MapBase+ByteIdx];
   if (IRQ>0) and (IRQ<TCSR.IPRIO_MAX_IRQ) then begin
    PrioByte:=TPasRISCVUInt8((aValue shr (ByteIdx*8)) and $ff);
    if aMLevel then begin
     fMIPrio[IRQ]:=PrioByte;
    end else begin
     fSIPrio[IRQ]:=PrioByte;
    end;
   end;
  end;
 end;
end;
{$endif}

procedure TPasRISCV.THART.SendAIAIRQ(const aAIARegFileMode:TPasRISCV.TAIARegFileMode;const aIRQ:TPasRISCVUInt32);
var AIARegFile:TPasRISCV.THART.TAIARegFile;
    MSIP:THART.TInterruptValue;
    Threshold,Reg,Value,EIE,Previous:TPasRISCVUInt32;
begin
 AIARegFile:=fAIARegFiles[aAIARegFileMode];
 if assigned(AIARegFile) and (aIRQ>0) and (aIRQ<TPasRISCV.THART.TAIARegFile.IRQ_LIMIT) then begin
  // Always set EIP bit regardless of eidelivery (per AIA spec: eidelivery has no effect on interrupt file state)
  Reg:=aIRQ shr 5;
  Value:=TPasRISCVUInt32(1) shl (aIRQ and $1f);
  Previous:=TPasMPInterlocked.ExchangeBitwiseOr(AIARegFile.fEIP[Reg],Value);
  // Only raise external interrupt signal if delivery is enabled
  TPasMPMemoryBarrier.ReadDependency;
  if AIARegFile.fEIDelivery<>0 then begin
   TPasMPMemoryBarrier.ReadDependency;
   Threshold:=AIARegFile.fEIThreshold;
   case aAIARegFileMode of
    TPasRISCV.TAIARegFileMode.Machine:begin
     MSIP:=THART.TInterruptValue.MachineExternal;
    end;
    TPasRISCV.TAIARegFileMode.Supervisor:begin
     MSIP:=THART.TInterruptValue.SupervisorExternal;
    end;
    TPasRISCV.TAIARegFileMode.VirtualSupervisor:begin
     MSIP:=THART.TInterruptValue.SupervisorExternal;
    end;
    else begin
     MSIP:=THART.TInterruptValue.None;
    end;
   end;
   TPasMPMemoryBarrier.ReadDependency;
   EIE:=AIARegFile.fEIE[Reg];
   if ((Threshold=0) or (aIRQ<Threshold)) and ((Value and EIE)<>0) and ((Value and Previous)=0) then begin
    RaiseInterrupt(MSIP);
   end;
  end;
 end;
end;

function TPasRISCV.THART.UpdateAIAInternal(const aAIARegFileMode:TPasRISCV.TAIARegFileMode;const aUpdate,aClaim:Boolean):TPasRISCVUInt32;
var AIARegFile:TPasRISCV.THART.TAIARegFile;
    MSIP:THART.TInterruptValue;
    Threshold,EIE,EIP,Bits,Bit,IRQ,Mask:TPasRISCVUInt32;
    Index:TPasRISCVInt32;
    DeliveryEnabled:Boolean;
begin
 result:=0;
 AIARegFile:=fAIARegFiles[aAIARegFileMode];
 if assigned(AIARegFile) then begin
  TPasMPMemoryBarrier.ReadDependency;
  Threshold:=AIARegFile.fEIThreshold;
  TPasMPMemoryBarrier.ReadDependency;
  DeliveryEnabled:=AIARegFile.fEIDelivery<>0;
  case aAIARegFileMode of
   TPasRISCV.TAIARegFileMode.Machine:begin
    MSIP:=THART.TInterruptValue.MachineExternal;
   end;
   TPasRISCV.TAIARegFileMode.Supervisor:begin
    MSIP:=THART.TInterruptValue.SupervisorExternal;
   end;
   TPasRISCV.TAIARegFileMode.VirtualSupervisor:begin
    MSIP:=THART.TInterruptValue.SupervisorExternal;
   end;
   else begin
    MSIP:=THART.TInterruptValue.None;
   end;
  end;
  if aUpdate and DeliveryEnabled then begin
   ClearInterrupt(MSIP);
  end;
  // Scan pending-and-enabled interrupts regardless of eidelivery (per AIA spec: *topei is not affected by eidelivery)
  for Index:=0 to TPasRISCV.THART.TAIARegFile.ARRAY_LENGTH-1 do begin
   TPasMPMemoryBarrier.ReadDependency;
   EIE:=AIARegFile.fEIE[Index];
   TPasMPMemoryBarrier.ReadDependency;
   EIP:=AIARegFile.fEIP[Index];
   Bits:=EIE and EIP;
   if Bits<>0 then begin
    if result<>0 then begin
     if DeliveryEnabled then begin
      RaiseInterrupt(MSIP);
     end;
     exit;
    end else begin
     Bit:=CTZDWord(Bits); // Lowest set bit = lowest IRQ number = highest priority per AIA spec
     IRQ:=(Index shl 5) or Bit;
     Mask:=not (TPasRISCVUInt32(1) shl Bit);
     if (Threshold=0) or (IRQ<Threshold) then begin
      result:=IRQ;
      if aClaim then begin
       Bits:=Bits and Mask;
       TPasMPInterlocked.BitwiseAnd(AIARegFile.fEIP[Index],Mask);
      end;
      if aUpdate then begin
       if Bits<>0 then begin
        if DeliveryEnabled then begin
         RaiseInterrupt(MSIP);
        end;
        exit;
       end;
      end else begin
       exit;
      end;
     end;
    end;
   end;
  end;
 end;
end;

function TPasRISCV.THART.UpdateAIAState(const aAIARegFileMode:TPasRISCV.TAIARegFileMode):TPasRISCVUInt32;
begin
 result:=UpdateAIAInternal(aAIARegFileMode,true,false);
end;

function TPasRISCV.THART.GetAIAIRQ(const aAIARegFileMode:TPasRISCV.TAIARegFileMode;const aClaim:Boolean):TPasRISCVUInt32;
begin
 result:=UpdateAIAInternal(aAIARegFileMode,true,aClaim);
end;

// Smrnmi: dispatch a resumable non-maskable interrupt.
// Always taken in M-mode; non-maskable (ignores mstatus.MIE / mnstatus.NMIE).
procedure TPasRISCV.THART.TakeNMI;
var MNStatus:TPasRISCVUInt64;
begin
 // Save PC into mnepc
 fState.CSR.fData[TCSR.TAddress.MNEPC]:=fState.PC;

 // Build new mnstatus:
 //   MNPP[12:11] = current privilege mode
 //   MNPV[7]    = current virtual mode (H-extension V-bit)
 //   NMIE[3]    = 0  (disable further NMIs while in handler)
 MNStatus:=fState.CSR.fData[TCSR.TAddress.MNSTATUS];
 // Clear MNPP, MNPV, NMIE
 MNStatus:=MNStatus and not (TCSR.MNSTATUS_MNPP or TCSR.MNSTATUS_MNPV or TCSR.MNSTATUS_NMIE);
 // Set MNPP from current mode
 MNStatus:=MNStatus or ((TPasRISCVUInt64(ord(fState.Mode)) and 3) shl 11);
 // Set MNPV from current virtual mode
 if fState.VirtualMode then begin
  MNStatus:=MNStatus or TCSR.MNSTATUS_MNPV;
 end;
 // NMIE stays 0
 fState.CSR.fData[TCSR.TAddress.MNSTATUS]:=MNStatus;

 // Set mncause: bit63=1 (interrupt-like), low bits = implementation-defined NMI code 0
 fState.CSR.fData[TCSR.TAddress.MNCAUSE]:=TPasRISCVUInt64(1) shl 63;

 // Enter Machine mode, leave virtual mode
 if fState.VirtualMode then begin
  SetVirtualMode(false);
 end;
 SetMode(THART.TMode.Machine);

 // Jump to NMI handler vector (implementation-defined)
 fState.PC:=fNMIVector-4; // -4 because the main loop adds 4 after each instruction

end;

procedure TPasRISCV.THART.TriggerNMI;
begin
 // Atomically set the NMI-pending flag; the execution loop will call TakeNMI on the next HandleInterrupts.
 TPasMPInterlocked.Write(fState.NMIPending,TPasMPBool32(true));
 Interrupt; // wake the HART if sleeping
end;

procedure TPasRISCV.THART.Interrupt;
begin
 TPasMPInterlocked.BitwiseOr(fMachine.fRunState,fHARTMask);
end;

{$ifdef PasRISCVSmcntrpmf}
// Smcntrpmf: recompute CycleIncrement (1=count, 0=inhibited) and CycleCountInhibit
// from the current privilege mode, virtual mode, and mcyclecfg/minstretcfg values.
procedure TPasRISCV.THART.UpdateCycleCountInhibit;
var InhibitBit:TPasRISCVUInt64;
begin
 if fState.VirtualMode then begin
  if fState.Mode=TMode.Supervisor then begin
   InhibitBit:=TCSR.COUNTERCFG_VSINH;
  end else begin
   InhibitBit:=TCSR.COUNTERCFG_VUINH;
  end;
 end else begin
  case fState.Mode of
   TMode.Machine:begin
    InhibitBit:=TCSR.COUNTERCFG_MINH;
   end;
   TMode.Supervisor:begin
    InhibitBit:=TCSR.COUNTERCFG_SINH;
   end;
   else begin
    InhibitBit:=TCSR.COUNTERCFG_UINH;
   end;
  end;
 end;
 fState.CycleCountInhibit:=((fState.CycleCfg or fState.InstRetCfg) and InhibitBit)<>0;
 fState.CycleIncrement:=TPasRISCVUInt64(ord(not fState.CycleCountInhibit) and 1);
 fState.CycleIncrementMask:=TPasRISCVUInt64(TPasRISCVInt64(0-TPasRISCVInt64(fState.CycleIncrement)));
end;

procedure TPasRISCV.THART.CSRHandlerMCYCLECFG(const aPC,aInstruction,aCSR,aRHS:TPasRISCVUInt64;const aOperation:TCSROperation);
var rd:TRegister;
    OldValue,NewValue:TPasRISCVUInt64;
begin
 if fState.Mode<TPasRISCV.THART.TMode((aCSR shr 8) and 3) then begin
  SetException(TExceptionValue.IllegalInstruction,aInstruction,fState.PC);
 end else begin
  rd:=TRegister((aInstruction shr 7) and $1f);
  OldValue:=fState.CycleCfg;
  if aCSR=TCSR.TAddress.MCYCLECFGH then begin
   // RV32 high-word access: operate on bits [63:32] only
   NewValue:=(TPasRISCV.THART.CSROperation(aOperation,OldValue shr 32,aRHS) and (TCSR.COUNTERCFG_MASK shr 32)) shl 32;
   NewValue:=NewValue or (OldValue and $ffffffff);
   fState.CycleCfg:=NewValue;
  end else begin
   fState.CycleCfg:=TPasRISCV.THART.CSROperation(aOperation,OldValue,aRHS) and TCSR.COUNTERCFG_MASK;
  end;
  UpdateCycleCountInhibit;
  {$ifndef ExplicitEnforceZeroRegister}if rd<>TRegister.Zero then{$endif}begin
   if aCSR=TCSR.TAddress.MCYCLECFGH then begin
    fState.Registers[rd]:=OldValue shr 32;
   end else begin
    fState.Registers[rd]:=OldValue;
   end;
  end;
 end;
end;

procedure TPasRISCV.THART.CSRHandlerMINSTRETCFG(const aPC,aInstruction,aCSR,aRHS:TPasRISCVUInt64;const aOperation:TCSROperation);
var rd:TRegister;
    OldValue,NewValue:TPasRISCVUInt64;
begin
 if fState.Mode<TPasRISCV.THART.TMode((aCSR shr 8) and 3) then begin
  SetException(TExceptionValue.IllegalInstruction,aInstruction,fState.PC);
 end else begin
  rd:=TRegister((aInstruction shr 7) and $1f);
  OldValue:=fState.InstRetCfg;
  if aCSR=TCSR.TAddress.MINSTRETCFGH then begin
   // RV32 high-word access: operate on bits [63:32] only
   NewValue:=(TPasRISCV.THART.CSROperation(aOperation,OldValue shr 32,aRHS) and (TCSR.COUNTERCFG_MASK shr 32)) shl 32;
   NewValue:=NewValue or (OldValue and $ffffffff);
   fState.InstRetCfg:=NewValue;
  end else begin
   fState.InstRetCfg:=TPasRISCV.THART.CSROperation(aOperation,OldValue,aRHS) and TCSR.COUNTERCFG_MASK;
  end;
  UpdateCycleCountInhibit;
  {$ifndef ExplicitEnforceZeroRegister}if rd<>TRegister.Zero then{$endif}begin
   if aCSR=TCSR.TAddress.MINSTRETCFGH then begin
    fState.Registers[rd]:=OldValue shr 32;
   end else begin
    fState.Registers[rd]:=OldValue;
   end;
  end;
 end;
end;
