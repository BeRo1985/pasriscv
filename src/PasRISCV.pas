 aNode.SetUInt64('IMSICSupervisorBase',fIMSICSupervisorBase);
 aNode.SetUInt64('IMSICSupervisorSizePerHART',fIMSICSupervisorSizePerHART);
 aNode.SetUInt64('APLICMachineBase',fAPLICMachineBase);
 aNode.SetUInt64('APLICMachineSize',fAPLICMachineSize);
 aNode.SetUInt64('APLICSupervisorBase',fAPLICSupervisorBase);
 aNode.SetUInt64('APLICSupervisorSize',fAPLICSupervisorSize);
 aNode.SetUInt64('PLICBase',fPLICBase);
 aNode.SetUInt64('PLICSize',fPLICSize);

 // System control
 aNode.SetUInt64('SYSCONBase',fSYSCONBase);
 aNode.SetUInt64('SYSCONSize',fSYSCONSize);

 // UART
 aNode.SetUInt64('UARTBase',fUARTBase);
 aNode.SetUInt64('UARTSize',fUARTSize);
 aNode.SetUInt64('UARTIRQ',fUARTIRQ);

 // VirtIO Block
 aNode.SetUInt64('VirtIOBlockBase',fVirtIOBlockBase);
 aNode.SetUInt64('VirtIOBlockSize',fVirtIOBlockSize);
 aNode.SetUInt64('VirtIOBlockIRQ',fVirtIOBlockIRQ);

 // RTC
 aNode.SetUInt32('RTCMode',TPasRISCVUInt32(ord(fRTCMode)));
 aNode.SetUInt64('GoldfishRTCBase',fGoldfishRTCBase);
 aNode.SetUInt64('GoldfishRTCSize',fGoldfishRTCSize);
 aNode.SetUInt64('GoldfishRTCIRQ',fGoldfishRTCIRQ);
 aNode.SetUInt64('DS1742Base',fDS1742Base);
 aNode.SetUInt64('DS1742Size',fDS1742Size);

 // Frame buffer
 aNode.SetUInt64('FrameBufferBase',fFrameBufferBase);
 aNode.SetUInt64('FrameBufferSize',fFrameBufferSize);
 aNode.SetUInt64('FrameBufferWidth',fFrameBufferWidth);
 aNode.SetUInt64('FrameBufferHeight',fFrameBufferHeight);
 aNode.SetUInt64('FrameBufferBytesPerPixel',fFrameBufferBytesPerPixel);
 aNode.SetUInt64('FrameBufferStride',fFrameBufferStride);
 aNode.SetUInt64('FrameBufferFormat',fFrameBufferFormat);

 // Shared memory
 aNode.SetUInt64('SharedMemoryBase',fSharedMemoryBase);
 aNode.SetUInt64('SharedMemorySize',fSharedMemorySize);
 aNode.SetUInt64('SharedMemoryIRQ',fSharedMemoryIRQ);

 // Extra shared memory ranges
 ExtraNode:=aNode.AddArray('ExtraSharedMemory');
 for ExtraIndex:=0 to fExtraSharedMemoryRanges.Count-1 do begin
  ElementNode:=ExtraNode.AddElement;
  ExtraSharedMemoryRange:=@fExtraSharedMemoryRanges.fItems[ExtraIndex];
  ElementNode.SetUInt64('Base',ExtraSharedMemoryRange^.Base);
  ElementNode.SetUInt64('Size',ExtraSharedMemoryRange^.Size);
  ElementNode.SetUInt64('IRQ',ExtraSharedMemoryRange^.IRQ);
  ElementNode.SetBool('Raw',ExtraSharedMemoryRange^.Raw);
 end;
 aNode.SetUInt64('NextAutoSharedMemoryBase',fNextAutoSharedMemoryBase);
 aNode.SetUInt64('NextAutoSharedMemoryIRQ',fNextAutoSharedMemoryIRQ);

 // Raw keyboard
 aNode.SetUInt64('RawKeyboardBase',fRawKeyboardBase);
 aNode.SetUInt64('RawKeyboardSize',fRawKeyboardSize);

 // I2C
 aNode.SetUInt32('I2CMode',TPasRISCVUInt32(ord(fI2CMode)));
 aNode.SetUInt64('OpenCoresI2CBase',fOpenCoresI2CBase);
 aNode.SetUInt64('OpenCoresI2CSize',fOpenCoresI2CSize);
 aNode.SetUInt64('DesignWareI2CBase',fDesignWareI2CBase);
 aNode.SetUInt64('DesignWareI2CSize',fDesignWareI2CSize);

 // PS/2
 aNode.SetUInt64('PS2KeyboardBase',fPS2KeyboardBase);
 aNode.SetUInt64('PS2KeyboardSize',fPS2KeyboardSize);
 aNode.SetUInt64('PS2KeyboardIRQ',fPS2KeyboardIRQ);
 aNode.SetUInt64('PS2MouseBase',fPS2MouseBase);
 aNode.SetUInt64('PS2MouseSize',fPS2MouseSize);
 aNode.SetUInt64('PS2MouseIRQ',fPS2MouseIRQ);

 // VirtIO Input
 aNode.SetUInt64('VirtIOInputKeyboardBase',fVirtIOInputKeyboardBase);
 aNode.SetUInt64('VirtIOInputKeyboardSize',fVirtIOInputKeyboardSize);
 aNode.SetUInt64('VirtIOInputKeyboardIRQ',fVirtIOInputKeyboardIRQ);
 aNode.SetUInt64('VirtIOInputMouseBase',fVirtIOInputMouseBase);
 aNode.SetUInt64('VirtIOInputMouseSize',fVirtIOInputMouseSize);
 aNode.SetUInt64('VirtIOInputMouseIRQ',fVirtIOInputMouseIRQ);
 aNode.SetUInt64('VirtIOInputTabletBase',fVirtIOInputTabletBase);
 aNode.SetUInt64('VirtIOInputTabletSize',fVirtIOInputTabletSize);
 aNode.SetUInt64('VirtIOInputTabletIRQ',fVirtIOInputTabletIRQ);
 aNode.SetUInt64('VirtIOInputGamepadBase',fVirtIOInputGamepadBase);
 aNode.SetUInt64('VirtIOInputGamepadSize',fVirtIOInputGamepadSize);
 aNode.SetUInt64('VirtIOInputGamepadIRQ',fVirtIOInputGamepadIRQ);

 // VirtIO Sound
 aNode.SetUInt64('VirtIOSoundBase',fVirtIOSoundBase);
 aNode.SetUInt64('VirtIOSoundSize',fVirtIOSoundSize);
 aNode.SetUInt64('VirtIOSoundIRQ',fVirtIOSoundIRQ);

 // VirtIO 9P
 aNode.SetUInt64('VirtIO9PBase',fVirtIO9PBase);
 aNode.SetUInt64('VirtIO9PSize',fVirtIO9PSize);
 aNode.SetUInt64('VirtIO9PIRQ',fVirtIO9PIRQ);
 aNode.SetString('VirtIO9PMountTag',fVirtIO9PMountTag);

 // VirtIO Net
 aNode.SetUInt64('VirtIONetBase',fVirtIONetBase);
 aNode.SetUInt64('VirtIONetSize',fVirtIONetSize);
 aNode.SetUInt64('VirtIONetIRQ',fVirtIONetIRQ);
 aNode.SetString('VirtIONetTAPInterface',fVirtIONetTAPInterface);
 aNode.SetString('NetworkHostForwards',fNetworkHostForwards);
 aNode.SetBool('UserModeIPv6Enabled',fUserModeIPv6Enabled);
 aNode.SetBool('UserModeTracerouteEnabled',fUserModeTracerouteEnabled);
 aNode.SetUInt32('UserModeTCPIdleTimeoutTicks',fUserModeTCPIdleTimeoutTicks);

 // VirtIO Random Generator
 aNode.SetUInt64('VirtIORandomGeneratorBase',fVirtIORandomGeneratorBase);
 aNode.SetUInt64('VirtIORandomGeneratorSize',fVirtIORandomGeneratorSize);
 aNode.SetUInt64('VirtIORandomGeneratorIRQ',fVirtIORandomGeneratorIRQ);

 // VirtIO GPU
 aNode.SetUInt64('VirtIOGPUBase',fVirtIOGPUBase);
 aNode.SetUInt64('VirtIOGPUSize',fVirtIOGPUSize);
 aNode.SetUInt64('VirtIOGPUIRQ',fVirtIOGPUIRQ);

 // VirtIO VSock
 aNode.SetUInt64('VirtIOVSockBase',fVirtIOVSockBase);
 aNode.SetUInt64('VirtIOVSockSize',fVirtIOVSockSize);
 aNode.SetUInt64('VirtIOVSockIRQ',fVirtIOVSockIRQ);
 aNode.SetUInt64('VirtIOVSockGuestCID',fVirtIOVSockGuestCID);

 // VirtIO RTC
 aNode.SetUInt64('VirtIORTCBase',fVirtIORTCBase);
 aNode.SetUInt64('VirtIORTCSize',fVirtIORTCSize);
 aNode.SetUInt64('VirtIORTCIRQ',fVirtIORTCIRQ);

 // VirtIO FS
 aNode.SetUInt64('VirtIOFSBase',fVirtIOFSBase);
 aNode.SetUInt64('VirtIOFSSize',fVirtIOFSSize);
 aNode.SetUInt64('VirtIOFSIRQ',fVirtIOFSIRQ);
 aNode.SetString('VirtIOFSMountTag',fVirtIOFSMountTag);

 // VirtIO FS DAX
 aNode.SetUInt64('VirtIOFSDAXBase',fVirtIOFSDAXBase);
 aNode.SetUInt64('VirtIOFSDAXSize',fVirtIOFSDAXSize);

 // VirtIO Crypto
 aNode.SetUInt64('VirtIOCryptoBase',fVirtIOCryptoBase);
 aNode.SetUInt64('VirtIOCryptoSize',fVirtIOCryptoSize);
 aNode.SetUInt64('VirtIOCryptoIRQ',fVirtIOCryptoIRQ);

 // IVSHMEM
 aNode.SetUInt64('IVSHMEMSharedMemorySize',fIVSHMEMSharedMemorySize);

 // Feature flags
 aNode.SetBool('AIA',fAIA);
 aNode.SetBool('StrictCompliantFPU',fStrictCompliantFPU);
{$ifdef PasRISCVFastRMMFixup}
 aNode.SetBool('FastRMMFixupEnabled',fFastRMMFixupEnabled);
{$endif}
{$ifdef PasRISCVJITFPUInvalidFlag}
 aNode.SetBool('JITFPUInvalidFlagEnabled',fJITFPUInvalidFlagEnabled);
{$endif}
 aNode.SetBool('SVVPTC',fSVVPTC);
 aNode.SetBool('VirtIOBlockEnabled',fVirtIOBlockEnabled);
 aNode.SetBool('VirtIOBlockMQ',fVirtIOBlockMQ);
 aNode.SetBool('NVMeEnabled',fNVMeEnabled);
 aNode.SetUInt32('SoundMode',TPasRISCVUInt32(ord(fSoundMode)));
 aNode.SetUInt32('DisplayMode',TPasRISCVUInt32(ord(fDisplayMode)));
 aNode.SetBool('VirtIOGPUVirGL',fVirtIOGPUVirGL);
 aNode.SetUInt32('NetworkMode',TPasRISCVUInt32(ord(fNetworkMode)));

 // CPU settings
 aNode.SetUInt64('LRSCMaximumCycles',fLRSCMaximumCycles);
 aNode.SetBool('Vector',fVector);
{$ifdef PasRISCVJustInTimeCompiler}
 aNode.SetBool('JITEnabled',fJITEnabled);
{$ifdef PasRISCVJustInTimeCompilerFPU}
 aNode.SetBool('JITFPUEnabled',fJITFPUEnabled);
 aNode.SetBool('JITFastFPUCodePaths',fJITFastFPUCodePaths);
{$endif}
{$ifdef PasRISCVJustInTimeCompilerVector}
 aNode.SetBool('JITVectorEnabled',fJITVectorEnabled);
{$endif}
{$endif}
 // Firmware
 case aFirmwareMode of
  TSnapshotFirmwareMode.Embedded:begin
   if fBIOS.Size>0 then begin
    aNode.SetBinary('BIOSData',fBIOS.Memory,fBIOS.Size);
   end;
   if fKernel.Size>0 then begin
    aNode.SetBinary('KernelData',fKernel.Memory,fKernel.Size);
   end;
   if fINITRD.Size>0 then begin
    aNode.SetBinary('INITRDData',fINITRD.Memory,fINITRD.Size);
   end;
  end;
 end;

end;

procedure TPasRISCV.TConfiguration.AddSharedMemoryRange(const aBase:TPasRISCVUInt64;const aSize:TPasRISCVUInt64;const aIRQ:TPasRISCVUInt64;const aRaw:Boolean;const aExternalPointer:Pointer);
const AutoAllocAlignment=TPasRISCVUInt64($1000000); // 16 MB
      AutoAllocIRQBase=TPasRISCVUInt64(48);
var ResolvedBase,ResolvedIRQ:TPasRISCVUInt64;
    Index:TPasRISCVSizeInt;
    ExtraSharedMemoryRange:PExtraSharedMemoryRange;
begin
 // Resolve base: auto-alloc above RAM if zero
 if aBase=0 then begin
  if fNextAutoSharedMemoryBase=0 then begin
   // First auto-alloc: align above RAM
   fNextAutoSharedMemoryBase:=(fMemoryBase+fMemorySize+AutoAllocAlignment-1) and not (AutoAllocAlignment-1);
  end;
  ResolvedBase:=fNextAutoSharedMemoryBase;
  fNextAutoSharedMemoryBase:=ResolvedBase+((aSize+AutoAllocAlignment-1) and not (AutoAllocAlignment-1));
 end else begin
  ResolvedBase:=aBase;
 end;
 // Resolve IRQ: auto-assign starting from 48 if zero
 if aIRQ=0 then begin
  if fNextAutoSharedMemoryIRQ=0 then begin
   fNextAutoSharedMemoryIRQ:=AutoAllocIRQBase;
  end;
  ResolvedIRQ:=fNextAutoSharedMemoryIRQ;
  inc(fNextAutoSharedMemoryIRQ);
 end else begin
  ResolvedIRQ:=aIRQ;
 end;
 ExtraSharedMemoryRange:=PExtraSharedMemoryRange(fExtraSharedMemoryRanges.AddNew);
 ExtraSharedMemoryRange^.Base:=ResolvedBase;
 ExtraSharedMemoryRange^.Size:=aSize;
 ExtraSharedMemoryRange^.IRQ:=ResolvedIRQ;
 ExtraSharedMemoryRange^.Raw:=aRaw;
 ExtraSharedMemoryRange^.ExternalPointer:=aExternalPointer;
end;

procedure TPasRISCV.TConfiguration.ClearSharedMemoryRanges;
begin
 fExtraSharedMemoryRanges.Clear;
 fNextAutoSharedMemoryBase:=0;
 fNextAutoSharedMemoryIRQ:=0;
end;

{ TPasRISCV }

constructor TPasRISCV.Create(const aConfiguration:TConfiguration);
var Index:TPasRISCVSizeInt;
    HART:THART;
    DebuggerOptions:TPasRISCV.TDebugger.TOptions;
    HostForwardsRemaining:TPasRISCVRawByteString;
    SemicolonPosition:TPasRISCVInt32;
    ForwardSpec:TPasRISCVRawByteString;
    ExtraIndex:TPasRISCVSizeInt;
    ExtraRange:TConfiguration.PExtraSharedMemoryRange;
    BusExtraIndex:TPasRISCVSizeInt;
begin
 inherited Create;

 fRandomGeneratorLock:=TPasMPSlimReaderWriterLock.Create;

 fRandomGenerator:=TRNLRandomGenerator.Create;

 fPCG32Lock:=TPasMPSlimReaderWriterLock.Create;

 fPCG32.Init(GetCurrentTime xor fRandomGenerator.GetUInt64);

 fPHandleCounter:=0;

 fInterrupts:=TInterrupts.Create(self);

 fFDT:=TFDT.Create;

 fFDTStream:=TMemoryStream.Create;

 fConfiguration:=TConfiguration.Create;
 if assigned(aConfiguration) then begin
  fConfiguration.Assign(aConfiguration);
 end;

 fAIA:=fConfiguration.fAIA;

 fStrictCompliantFPU:=fConfiguration.fStrictCompliantFPU;

{$ifdef PasRISCVFastRMMFixup}
 fFastRMMFixupEnabled:=fConfiguration.fFastRMMFixupEnabled;
{$endif}
{$ifdef PasRISCVJITFPUInvalidFlag}
 fJITFPUInvalidFlagEnabled:=fConfiguration.fJITFPUInvalidFlagEnabled;
{$endif}

 fCountHARTs:=fConfiguration.fCountHARTs;
 if fCountHARTs<1 then begin
  fCountHARTs:=1;
 end else if fCountHARTs>TPasRISCV.MaximumCountHARTs then begin
  fCountHARTs:=TPasRISCV.MaximumCountHARTs;
 end;

 InitializeFDT;

 fRunState:=RUNSTATE_RUNNING;

{$ifdef PasRISCVSingleStepCounter}
 fSingleStepCounter:=0;
{$endif}

 fFlushTLBHARTMask:=0;

 fHARTActiveMask:=0;

 fHARTRunningMask:=0;

 fAllHARTMask:=0;

 fLRSCMaximumCycles:=fConfiguration.fLRSCMaximumCycles;

 fVector:=fConfiguration.fVector;

{$if defined(PasRISCVJustInTimeCompiler) and defined(PasRISCVJustInTimeCompilerVector) and defined(PasRISCVJustInTimeCompilerTargetX8664)}
 if (CPUFeatures and CPUFeatures_X86_AVX2_Mask)<>0 then begin
  fVLEN:=256;
 end else begin
  fVLEN:=128;
 end;
{$else}
 fVLEN:={$ifdef VLEN128}128{$else}256{$endif};
{$ifend}
 fVLENB:=fVLEN div 8;

{$ifdef PasRISCVJustInTimeCompiler}
 fJITEnabled:=fConfiguration.fJITEnabled;
{$ifdef PasRISCVJustInTimeCompilerFPU}
 fJITFPUEnabled:=fConfiguration.fJITFPUEnabled;
 fJITFastFPUCodePaths:=fConfiguration.fJITFastFPUCodePaths;
{$endif}
{$ifdef PasRISCVJustInTimeCompilerVector}
 fJITVectorEnabled:=fConfiguration.fJITVectorEnabled;
{$endif}
{$endif}

{$ifdef PasRISCVUseFutexEvents}
 fHARTWakeUpFutexEvent:=TPasMPFutexEvent.Create;
 fHARTStatusChangeFutexEvent:=TPasMPFutexEvent.Create;
{$else}
 fHARTWakeUpConditionVariableLock:=TPasMPConditionVariableLock.Create;
 fHARTWakeUpConditionVariable:=TPasMPConditionVariable.Create;

 fHARTStatusChangeConditionVariableLock:=TPasMPConditionVariableLock.Create;
 fHARTStatusChangeConditionVariable:=TPasMPConditionVariable.Create;
{$endif}

 fOnReboot:=nil;

 fOnNewFrame:=nil;

 fOnCPUException:=nil;

{$ifndef PasRISCVPerHARTConditionVariables}
{$ifdef PasRISCVUseFutexEvents}
 fWakeUpFutexEvent:=TPasMPFutexEvent.Create;
{$else}
 fWakeUpConditionVariableLock:=TPasMPConditionVariableLock.Create;

 fWakeUpConditionVariable:=TPasMPConditionVariable.Create;
{$endif}

{$if defined(PasRISCVInterruptWakeupHardening)}
 fWakeGeneration:=0;
{$ifend}
{$endif}

 fGlobalLock:=TPasMPMultipleReaderSingleWriterSpinLock.Create;

 fEventTickLock:=TPasMPMultipleReaderSingleWriterSpinLock.Create;

 fJobManager:=TJobManager.Create(4);

 fBootMemoryDevice:=TMemoryDevice.Create(self,fConfiguration.fBootMemoryBase,fConfiguration.fBootMemorySize);

 fMemoryDevice:=TMemoryDevice.Create(self,fConfiguration.fMemoryBase,fConfiguration.fMemorySize);

 fACLINTDevice:=TACLINTDevice.Create(self);

 if fAIA then begin

  fIMSICMachineDevice:=TIMSICDevice.Create(self,fConfiguration.fIMSICMachineBase,fConfiguration.fIMSICMachineSizePerHART*fConfiguration.CountHARTs,TPasRISCV.TAIARegFileMode.Machine);

  fIMSICSupervisorDevice:=TIMSICDevice.Create(self,fConfiguration.fIMSICSupervisorBase,fConfiguration.fIMSICSupervisorSizePerHART*fConfiguration.CountHARTs,TPasRISCV.TAIARegFileMode.Supervisor);

  fAPLICDevice:=TAPLICDevice.Create(self);

  fPLICDevice:=nil;

  fINTCDevice:=fAPLICDevice;

 end else begin

  fIMSICMachineDevice:=nil;

  fIMSICSupervisorDevice:=nil;

  fPLICDevice:=TPLICDevice.Create(self);

  fINTCDevice:=fPLICDevice;

 end;

 fSYSCONDevice:=TSYSCONDevice.Create(self);

 if fConfiguration.fVirtIOBlockEnabled then begin
  fVirtIOBlockDevice:=TVirtIOBlockDevice.Create(self);
 end else begin
  fVirtIOBlockDevice:=nil;
 end;

 fUARTDevice:=TUARTDevice.Create(self);

 case fConfiguration.fRTCMode of
  TRTCMode.DS1742:begin
   fDS1742Device:=TDS1742Device.Create(self);
   fGoldfishRTCDevice:=nil;
   fDS1307Device:=nil;
  end;
  TRTCMode.Goldfish:begin
   fDS1742Device:=nil;
   fGoldfishRTCDevice:=TGoldfishRTCDevice.Create(self);
   fDS1307Device:=nil;
  end;
  TRTCMode.DS1307:begin
   fDS1742Device:=nil;
   fGoldfishRTCDevice:=nil;
   // DS1307 is an I2C device, created later when I2C bus is set up
   fDS1307Device:=nil;
  end;
  else begin
   fDS1742Device:=TDS1742Device.Create(self);
   fGoldfishRTCDevice:=nil;
   fDS1307Device:=nil;
  end;
 end;

 fSoundIO:=TSoundIO.Create(self);

 fPCIBusDevice:=TPCIBusDevice.Create(self);

 if TPCI.PCI_IO_DEFAULT_SIZE<>0 then begin
  fPCIIODevice:=TPCIIODevice.Create(self,TPCI.PCI_IO_DEFAULT_ADDR,TPCI.PCI_IO_DEFAULT_SIZE);
 end else begin
  fPCIIODevice:=nil;
 end;

 fFrameBufferDevice:=TFrameBufferDevice.Create(self);

 case fConfiguration.fDisplayMode of
  TDisplayMode.SimpleFB:begin
   fSimpleFBDevice:=TSimpleFBDevice.Create(self);
  end;
  else begin
   fSimpleFBDevice:=nil;
  end;
 end;

 fSharedMemoryDevice:=TSharedMemoryDevice.Create(self);

 // Create extra shared memory devices (configured before boot)
 fExtraSharedMemoryDevices:=TSharedMemoryDevices.Create;
 for ExtraIndex:=0 to fConfiguration.fExtraSharedMemoryRanges.Count-1 do begin
  ExtraRange:=@fConfiguration.fExtraSharedMemoryRanges.fItems[ExtraIndex];
  fExtraSharedMemoryDevices.Add(TSharedMemoryDevice.Create(self,ExtraRange^.Base,ExtraRange^.Size,ExtraRange^.IRQ,ExtraRange^.Raw,ExtraRange^.ExternalPointer));
 end;

 fRawKeyboardDevice:=TRawKeyboardDevice.Create(self);

 if fConfiguration.fRTCMode=TRTCMode.DS1307 then begin
  case fConfiguration.fI2CMode of
   TI2CMode.OpenCores:begin
    fI2CDevice:=TOpenCoresI2CDevice.Create(self);
   end;
   else begin
    fI2CDevice:=TDesignWareI2CDevice.Create(self);
   end;
  end;
  fDS1307Device:=TDS1307I2CBusDevice.Create(fI2CDevice);
  fI2CDevice.AttachBusDevice(fDS1307Device);
 end else begin
  fI2CDevice:=nil;
 end;

{fI2CDevice:=TI2CDevice.Create(self);

 fI2CHIDKeyboardBusDevice:=TI2CHIDKeyboardBusDevice.Create(fI2CDevice);
 fI2CDevice.AttachBusDevice(fI2CHIDKeyboardBusDevice);//\}

 fPS2KeyboardDevice:=TPS2KeyboardDevice.Create(self);

 fPS2MouseDevice:=TPS2MouseDevice.Create(self);

 case fConfiguration.fSoundMode of
  TSoundMode.VirtIO:begin
   fVirtIOSoundDevice:=TVirtIOSoundDevice.Create(self,fSoundIO);
   fFM801Device:=nil;
   fCMI8738Device:=nil;
   fHDADevice:=nil;
  end;
  TSoundMode.FM801:begin
   fVirtIOSoundDevice:=nil;
   fFM801Device:=nil; // FM801 is created later after fPCIBusDevice
   fCMI8738Device:=nil;
   fHDADevice:=nil;
  end;
  TSoundMode.CMI8738:begin
   fVirtIOSoundDevice:=nil;
   fFM801Device:=nil;
   fCMI8738Device:=nil; // CMI8738 is created later after fPCIBusDevice
   fHDADevice:=nil;
  end;
  TSoundMode.HDA:begin
   fVirtIOSoundDevice:=nil;
   fFM801Device:=nil;
   fCMI8738Device:=nil;
