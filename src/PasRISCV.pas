  BorrowLo:=0;
 end;
 Temporary:=aA.Mid-aB.Mid;
 if aA.Mid<aB.Mid then begin
  BorrowMid:=1;
 end else begin
  BorrowMid:=0;
 end;
 result.Mid:=Temporary-BorrowLo;
 if Temporary<BorrowLo then begin
  inc(BorrowMid);
 end;
 result.Hi:=aA.Hi-aB.Hi-BorrowMid;
end;

function SoftFloatBits192Shl(const aValue:TSoftFloatBits192;aShift:TPasRISCVInt32):TSoftFloatBits192;
begin
 if aShift<=0 then begin
  result:=aValue;
 end else if aShift>=192 then begin
  result:=SoftFloatBits192Zero;
 end else if aShift=128 then begin
  result.Lo:=0;
  result.Mid:=0;
  result.Hi:=aValue.Lo;
 end else if aShift>128 then begin
  result.Lo:=0;
  result.Mid:=0;
  result.Hi:=aValue.Lo shl (aShift-128);
 end else if aShift=64 then begin
  result.Lo:=0;
  result.Mid:=aValue.Lo;
  result.Hi:=aValue.Mid;
 end else if aShift>64 then begin
  result.Lo:=0;
  result.Mid:=aValue.Lo shl (aShift-64);
  result.Hi:=(aValue.Mid shl (aShift-64)) or (aValue.Lo shr (128-aShift));
 end else begin
  result.Lo:=aValue.Lo shl aShift;
  result.Mid:=(aValue.Mid shl aShift) or (aValue.Lo shr (64-aShift));
  result.Hi:=(aValue.Hi shl aShift) or (aValue.Mid shr (64-aShift));
 end;
end;

function SoftFloatBits192Shr(const aValue:TSoftFloatBits192;aShift:TPasRISCVInt32):TSoftFloatBits192;
begin
 if aShift<=0 then begin
  result:=aValue;
 end else if aShift>=192 then begin
  result:=SoftFloatBits192Zero;
 end else if aShift=128 then begin
  result.Lo:=aValue.Hi;
  result.Mid:=0;
  result.Hi:=0;
 end else if aShift>128 then begin
  result.Lo:=aValue.Hi shr (aShift-128);
  result.Mid:=0;
  result.Hi:=0;
 end else if aShift=64 then begin
  result.Lo:=aValue.Mid;
  result.Mid:=aValue.Hi;
  result.Hi:=0;
 end else if aShift>64 then begin
  result.Lo:=(aValue.Mid shr (aShift-64)) or (aValue.Hi shl (128-aShift));
  result.Mid:=aValue.Hi shr (aShift-64);
  result.Hi:=0;
 end else begin
  result.Lo:=(aValue.Lo shr aShift) or (aValue.Mid shl (64-aShift));
  result.Mid:=(aValue.Mid shr aShift) or (aValue.Hi shl (64-aShift));
  result.Hi:=aValue.Hi shr aShift;
 end;
end;

function SoftFloatBits192ShrSticky(const aValue:TSoftFloatBits192;const aShift:TPasRISCVInt32):TSoftFloatBits192;
var Lost:boolean;
begin
 if aShift<=0 then begin
  result:=aValue;
 end else if aShift<64 then begin
  Lost:=(aValue.Lo and ((TPasRISCVUInt64(1) shl aShift)-1))<>0;
  result.Lo:=(aValue.Lo shr aShift) or (aValue.Mid shl (64-aShift));
  result.Mid:=(aValue.Mid shr aShift) or (aValue.Hi shl (64-aShift));
  result.Hi:=aValue.Hi shr aShift;
  if Lost then begin
   result.Lo:=result.Lo or 1;
  end;
 end else if aShift=64 then begin
  result.Lo:=aValue.Mid;
  result.Mid:=aValue.Hi;
  result.Hi:=0;
  if aValue.Lo<>0 then begin
   result.Lo:=result.Lo or 1;
  end;
 end else if aShift<128 then begin
  Lost:=aValue.Lo<>0;
  if (aValue.Mid and ((TPasRISCVUInt64(1) shl (aShift-64))-1))<>0 then begin
   Lost:=true;
  end;
  result.Lo:=(aValue.Mid shr (aShift-64)) or (aValue.Hi shl (128-aShift));
  result.Mid:=aValue.Hi shr (aShift-64);
  result.Hi:=0;
  if Lost then begin
   result.Lo:=result.Lo or 1;
  end;
 end else if aShift=128 then begin
  result.Lo:=aValue.Hi;
  result.Mid:=0;
  result.Hi:=0;
  if (aValue.Lo<>0) or (aValue.Mid<>0) then begin
   result.Lo:=result.Lo or 1;
  end;
 end else if aShift<192 then begin
  Lost:=(aValue.Lo<>0) or (aValue.Mid<>0);
  if (aValue.Hi and ((TPasRISCVUInt64(1) shl (aShift-128))-1))<>0 then begin
   Lost:=true;
  end;
  result.Lo:=aValue.Hi shr (aShift-128);
  result.Mid:=0;
  result.Hi:=0;
  if Lost then begin
   result.Lo:=result.Lo or 1;
  end;
 end else begin
  result.Mid:=0;
  result.Hi:=0;
  if (aValue.Lo<>0) or (aValue.Mid<>0) or (aValue.Hi<>0) then begin
   result.Lo:=1;
  end else begin
   result.Lo:=0;
  end;
 end;
end;

procedure SoftFloatMul64to128(const aA,aB:TPasRISCVUInt64;out aHi,aLo:TPasRISCVUInt64);
var a0,a1,b0,b1:TPasRISCVUInt64;
    p00,p01,p10,p11:TPasRISCVUInt64;
    Mid:TPasRISCVUInt64;
begin
 a0:=aA and $ffffffff;
 a1:=aA shr 32;
 b0:=aB and $ffffffff;
 b1:=aB shr 32;
 p00:=a0*b0;
 p01:=a0*b1;
 p10:=a1*b0;
 p11:=a1*b1;
 Mid:=(p00 shr 32)+(p01 and $ffffffff)+(p10 and $ffffffff);
 aLo:=(p00 and $ffffffff) or (Mid shl 32);
 aHi:=p11+(p01 shr 32)+(p10 shr 32)+(Mid shr 32);
end;

function SoftFloatRoundBit(const aSign:boolean;const aLSB,aGRS:TPasRISCVUInt8;const aRM:TPasRISCVUInt8):boolean;
begin
 if aRM=SoftFloatRM_RTZ then begin
  result:=false;
 end else if aRM=SoftFloatRM_RDN then begin
  result:=aSign and (aGRS<>0);
 end else if aRM=SoftFloatRM_RUP then begin
  result:=(not aSign) and (aGRS<>0);
 end else if aRM=SoftFloatRM_RMM then begin
  result:=(aGRS and 4)<>0;
 end else begin
  if aGRS>4 then begin
   result:=true;
  end else if aGRS=4 then begin
   result:=(aLSB and 1)<>0;
  end else begin
   result:=false;
  end;
 end;
end;

function SoftFloatPackOverflow(const aResultSign:boolean;aSignShift,aMantissaBits:TPasRISCVInt32;aInfiniteExponent:TPasRISCVUInt32;aMantissaMask,aCanonicalNaN:TPasRISCVUInt64;aRM:TPasRISCVUInt8;var aFFlags:TPasRISCVUInt8):TPasRISCVUInt64;
var SignPart,MaximumFinite,InfiniteValue:TPasRISCVUInt64;
begin
 aFFlags:=aFFlags or SoftFloatFF_OF or SoftFloatFF_NX;
 if aCanonicalNaN=0 then begin
 end;
 SignPart:=0;
 if aResultSign then begin
  SignPart:=SoftFloatSignBit(aSignShift);
 end;
 MaximumFinite:=SignPart or (TPasRISCVUInt64(aInfiniteExponent-1) shl aMantissaBits) or aMantissaMask;
 InfiniteValue:=SignPart or (TPasRISCVUInt64(aInfiniteExponent) shl aMantissaBits);
 if aRM=SoftFloatRM_RTZ then begin
  result:=MaximumFinite;
 end else if aRM=SoftFloatRM_RDN then begin
  if aResultSign then begin
   result:=InfiniteValue;
  end else begin
   result:=MaximumFinite;
  end;
 end else if aRM=SoftFloatRM_RUP then begin
  if aResultSign then begin
   result:=MaximumFinite;
  end else begin
   result:=InfiniteValue;
  end;
 end else begin
  result:=InfiniteValue;
 end;
end;

procedure SoftFloatUnpack(const aA:TPasRISCVUInt64;const aMantissaBits,aSignShift:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32;out aSign:boolean;out aExponent:TPasRISCVInt32;out aMantissa:TPasRISCVUInt64);
begin
 aSign:=(aA and SoftFloatSignBit(aSignShift))<>0;
 aExponent:=TPasRISCVInt32((aA shr aMantissaBits) and aInfiniteExponent);
 aMantissa:=aA and SoftFloatMantissaMask(aMantissaBits);
end;

function SoftFloatIsNaN(const aExponent:TPasRISCVInt32;const aMantissa:TPasRISCVUInt64;const aInfiniteExponent:TPasRISCVUInt32):boolean;
begin
 result:=(aExponent=TPasRISCVInt32(aInfiniteExponent)) and (aMantissa<>0);
end;

function SoftFloatIsSignalingNaN(const aMantissa:TPasRISCVUInt64;const aMantissaBits:TPasRISCVInt32):boolean;
begin
 result:=(aMantissa<>0) and ((aMantissa and (TPasRISCVUInt64(1) shl (aMantissaBits-1)))=0);
end;

function SoftFloatInf(const aSign:boolean;const aSignShift,aMantissaBits:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32):TPasRISCVUInt64;
begin
 result:=TPasRISCVUInt64(aInfiniteExponent) shl aMantissaBits;
 if aSign then begin
  result:=result or SoftFloatSignBit(aSignShift);
 end;
end;

function SoftFloatZero(const aSign:boolean;const aSignShift:TPasRISCVInt32):TPasRISCVUInt64;
begin
 if aSign then begin
  result:=SoftFloatSignBit(aSignShift);
 end else begin
  result:=0;
 end;
end;

procedure SoftFloatNormalizeOperand(var aExponent:TPasRISCVInt32;var aMantissa:TPasRISCVUInt64;const aMantissaBits:TPasRISCVInt32);
var HighestBit,Shift:TPasRISCVInt32;
begin
 if aExponent=0 then begin
  if aMantissa<>0 then begin
   HighestBit:=63-SoftFloatCLZ64(aMantissa);
   Shift:=aMantissaBits-HighestBit;
   if Shift>0 then begin
    aMantissa:=aMantissa shl Shift;
    dec(aExponent,Shift-1);
   end else begin
    inc(aExponent);
   end;
  end;
 end else begin
  aMantissa:=aMantissa or (TPasRISCVUInt64(1) shl aMantissaBits);
 end;
end;

function SoftFloatRoundPack(const aSign:boolean;aExponent:TPasRISCVInt32;aMantissaExtenstion:TPasRISCVUInt64;const aMantissaBits,aSignShift:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32;const aCanonicalNaN:TPasRISCVUInt64;const aRM:TPasRISCVUInt8;var aFFlags:TPasRISCVUInt8):TPasRISCVUInt64;
var MantissaMask,ImplicitBit,Mantissa,SignPart:TPasRISCVUInt64;
    GRS,LSB:TPasRISCVUInt8;
begin
 MantissaMask:=SoftFloatMantissaMask(aMantissaBits);
 ImplicitBit:=TPasRISCVUInt64(1) shl aMantissaBits;
 if aExponent<0 then begin
  aMantissaExtenstion:=SoftFloatShiftRightJam64(aMantissaExtenstion,1-aExponent);
  aExponent:=0;
 end;
 GRS:=TPasRISCVUInt8(aMantissaExtenstion and 7);
 LSB:=TPasRISCVUInt8((aMantissaExtenstion shr 3) and 1);
 Mantissa:=aMantissaExtenstion shr 3;
 if GRS<>0 then begin
  if SoftFloatRoundBit(aSign,LSB,GRS,aRM) then begin
   inc(Mantissa);
  end;
 end;
 if aExponent=0 then begin
  if Mantissa>=(ImplicitBit shl 1) then begin
   Mantissa:=Mantissa shr 1;
   aExponent:=1;
  end else if Mantissa>=ImplicitBit then begin
   aExponent:=1;
  end;
 end else begin
  if Mantissa>=(ImplicitBit shl 1) then begin
   Mantissa:=Mantissa shr 1;
   inc(aExponent);
  end;
 end;
 if (aExponent=0) and (GRS<>0) then begin
  aFFlags:=aFFlags or SoftFloatFF_UF;
 end;
 if aExponent>=TPasRISCVInt32(aInfiniteExponent) then begin
  result:=SoftFloatPackOverflow(aSign,aSignShift,aMantissaBits,aInfiniteExponent,MantissaMask,aCanonicalNaN,aRM,aFFlags);
  exit;
 end;
 if GRS<>0 then begin
  aFFlags:=aFFlags or SoftFloatFF_NX;
 end;
 SignPart:=0;
 if aSign then begin
  SignPart:=SoftFloatSignBit(aSignShift);
 end;
 result:=SignPart or (TPasRISCVUInt64(aExponent) shl aMantissaBits) or (Mantissa and MantissaMask);
end;

function SoftFloatMakeGRSFromShiftedValue(const aValue:TPasRISCVUInt64;const aShift:TPasRISCVInt32):TPasRISCVUInt8;
var StickyBits:TPasRISCVInt32;
begin
 result:=0;
 if (aValue=0) or (aShift<=0) then begin
  exit;
 end;
 if aShift<=64 then begin
  if ((aValue shr (aShift-1)) and 1)<>0 then begin
   result:=result or 4;
  end;
  if aShift>=2 then begin
   if ((aValue shr (aShift-2)) and 1)<>0 then begin
    result:=result or 2;
   end;
  end;
  if aShift>2 then begin
   StickyBits:=aShift-2;
   if StickyBits>=64 then begin
    if aValue<>0 then begin
     result:=result or 1;
    end;
   end else if (aValue and ((TPasRISCVUInt64(1) shl StickyBits)-1))<>0 then begin
    result:=result or 1;
   end;
  end;
 end else begin
  result:=1;
 end;
end;

function SoftFloatConvertNaN(const aSign:boolean;const aMantissa:TPasRISCVUInt64;const aSourceMantissaBits,aDestinationMantissaBits,aDestinationSignShift:TPasRISCVInt32;const aDestinationInfiniteExponent:TPasRISCVUInt32):TPasRISCVUInt64;
var Payload,DestinationMask:TPasRISCVUInt64;
begin
 Payload:=aMantissa and SoftFloatMantissaMask(aSourceMantissaBits);
 DestinationMask:=SoftFloatMantissaMask(aDestinationMantissaBits);
 if aSourceMantissaBits>aDestinationMantissaBits then begin
  Payload:=Payload shr (aSourceMantissaBits-aDestinationMantissaBits);
 end else if aSourceMantissaBits<aDestinationMantissaBits then begin
  Payload:=Payload shl (aDestinationMantissaBits-aSourceMantissaBits);
 end;
 Payload:=Payload and DestinationMask;
 Payload:=Payload or (TPasRISCVUInt64(1) shl (aDestinationMantissaBits-1));
 result:=(TPasRISCVUInt64(aDestinationInfiniteExponent) shl aDestinationMantissaBits) or Payload;
 if aSign then begin
  result:=result or SoftFloatSignBit(aDestinationSignShift);
 end;
end;

function SoftFloatOrderedCompare(const aA,aB:TPasRISCVUInt64;const aSignShift:TPasRISCVInt32):TPasRISCVInt32;
var SignBit,MagnitudeMask,MagnitudeA,MagnitudeB:TPasRISCVUInt64;
    SignA,SignB:boolean;
begin
 SignBit:=SoftFloatSignBit(aSignShift);
 MagnitudeMask:=SignBit-1;
 SignA:=(aA and SignBit)<>0;
 SignB:=(aB and SignBit)<>0;
 MagnitudeA:=aA and MagnitudeMask;
 MagnitudeB:=aB and MagnitudeMask;
 if (MagnitudeA=0) and (MagnitudeB=0) then begin
  result:=0;
 end else if SignA<>SignB then begin
  if SignA then begin
   result:=-1;
  end else begin
   result:=1;
  end;
 end else if MagnitudeA=MagnitudeB then begin
  result:=0;
 end else if SignA then begin
  if MagnitudeA>MagnitudeB then begin
   result:=-1;
  end else begin
   result:=1;
  end;
 end else begin
  if MagnitudeA<MagnitudeB then begin
   result:=-1;
  end else begin
   result:=1;
  end;
 end;
end;

function SoftFloatMinMaxCore(const aA,aB:TPasRISCVUInt64;const aMantissaBits,aSignShift:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32;const aCanonicalNaN:TPasRISCVUInt64;const aIsMaximum:boolean;var aFFlags:TPasRISCVUInt8):TPasRISCVUInt64;
var SignA,SignB:boolean;
    ExponentA,ExponentB:TPasRISCVInt32;
    MantissaA,MantissaB:TPasRISCVUInt64;
    IsNaNA,IsNaNB,IsSNaNA,IsSNaNB:boolean;
    Comparison:TPasRISCVInt32;
begin
 SoftFloatUnpack(aA,aMantissaBits,aSignShift,aInfiniteExponent,SignA,ExponentA,MantissaA);
 SoftFloatUnpack(aB,aMantissaBits,aSignShift,aInfiniteExponent,SignB,ExponentB,MantissaB);
 IsNaNA:=SoftFloatIsNaN(ExponentA,MantissaA,aInfiniteExponent);
 IsNaNB:=SoftFloatIsNaN(ExponentB,MantissaB,aInfiniteExponent);
 IsSNaNA:=IsNaNA and SoftFloatIsSignalingNaN(MantissaA,aMantissaBits);
 IsSNaNB:=IsNaNB and SoftFloatIsSignalingNaN(MantissaB,aMantissaBits);
 if IsSNaNA or IsSNaNB then begin
  aFFlags:=aFFlags or SoftFloatFF_NV;
 end;
 if IsNaNA then begin
  if IsNaNB then begin
   result:=aCanonicalNaN;
  end else begin
   result:=aB;
  end;
  exit;
 end;
 if IsNaNB then begin
  result:=aA;
  exit;
 end;
 if ((aA and (SoftFloatSignBit(aSignShift)-1))=0) and ((aB and (SoftFloatSignBit(aSignShift)-1))=0) then begin
  if aIsMaximum then begin
   result:=0;
   if SignA and SignB then begin
    result:=SoftFloatZero(true,aSignShift);
   end;
  end else begin
   if SignA or SignB then begin
    result:=SoftFloatZero(true,aSignShift);
   end else begin
    result:=0;
   end;
  end;
  exit;
 end;
 Comparison:=SoftFloatOrderedCompare(aA,aB,aSignShift);
 if aIsMaximum then begin
  if Comparison>=0 then begin
   result:=aA;
  end else begin
   result:=aB;
  end;
 end else begin
  if Comparison<=0 then begin
   result:=aA;
  end else begin
   result:=aB;
  end;
 end;
end;

function SoftFloatCompareEQCore(const aA,aB:TPasRISCVUInt64;const aMantissaBits,aSignShift:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32;var aFFlags:TPasRISCVUInt8):boolean;
var SignA,SignB:boolean;
    ExponentA,ExponentB:TPasRISCVInt32;
    MantissaA,MantissaB:TPasRISCVUInt64;
begin
 SoftFloatUnpack(aA,aMantissaBits,aSignShift,aInfiniteExponent,SignA,ExponentA,MantissaA);
 SoftFloatUnpack(aB,aMantissaBits,aSignShift,aInfiniteExponent,SignB,ExponentB,MantissaB);
 if SoftFloatIsNaN(ExponentA,MantissaA,aInfiniteExponent) or SoftFloatIsNaN(ExponentB,MantissaB,aInfiniteExponent) then begin
  if (SoftFloatIsNaN(ExponentA,MantissaA,aInfiniteExponent) and SoftFloatIsSignalingNaN(MantissaA,aMantissaBits)) or
     (SoftFloatIsNaN(ExponentB,MantissaB,aInfiniteExponent) and SoftFloatIsSignalingNaN(MantissaB,aMantissaBits)) then begin
   aFFlags:=aFFlags or SoftFloatFF_NV;
  end;
  result:=false;
 end else begin
  result:=SoftFloatOrderedCompare(aA,aB,aSignShift)=0;
 end;
end;

