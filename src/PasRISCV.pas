 fActiveFeatures:=TPasRISCV.TVirtIODevice.VIRTIO_F_VERSION_1;
 fDeviceFeaturesSelected:=0;
 fDriverFeaturesSelected:=0;
 TPasMPInterlocked.Write(fIntStatus,0);
 UpdateIRQ;
 for Index:=0 to MAXIMUM_COUNT_QUEUES-1 do begin
