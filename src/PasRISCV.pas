end;

procedure TPasRISCV.THART.NonStrictExecVNCvtBF16(const aVS2,aVD:TPasRISCVUInt32;const aVSTART,aEVL:TPasRISCVUInt32;const aUnmasked:Boolean;const aRM:TPasRISCVUInt8);
const BF16CanonicalNaN=$7fc0;
var Index:TPasRISCVUInt32;
    FFlags:TPasRISCVUInt8;
    F32Bits,F32Sign,F32BiasedExponent,F32Upper,LostBits16:TPasRISCVUInt32;
    RoundedUp:Boolean;
begin
 FFlags:=0;
 if aVSTART<aEVL then begin
  for Index:=aVSTART to aEVL-1 do begin
   if aUnmasked or VectorGetMaskBit(Index) then begin
    F32Bits:=TPasRISCVUInt32(VectorGetElement(aVS2,Index,32));
    F32Sign:=(F32Bits shr 31) and 1;
    F32BiasedExponent:=(F32Bits shr 23) and $ff;
    if F32BiasedExponent=$ff then begin
     // NaN or Inf
     if (F32Bits and $7fffff)<>0 then begin
      // sNaN: quiet bit clear
      if (F32Bits and $400000)=0 then begin
       FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Invalid);
      end;
      VectorSetElement(aVD,Index,16,BF16CanonicalNaN);
     end else begin
      // Inf: copy sign
      VectorSetElement(aVD,Index,16,TPasRISCVUInt64((F32Sign shl 15) or $7f80));
     end;
    end else begin
     // finite: BF16 = top 16 bits of f32, lower 16 bits are lost
     F32Upper:=F32Bits shr 16;
     LostBits16:=F32Bits and $ffff;
     RoundedUp:=false;
     if LostBits16<>0 then begin
      FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Inexact);
      // underflow: biased exponent in BF16 upper bits is 0 (denormal result)
      if (F32Upper and $7f80)=0 then begin
       FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Underflow);
      end;
      case aRM of
       0:begin
        // RNE: round up if guard > half, or guard=half and result is odd
        if (LostBits16>$8000) or ((LostBits16=$8000) and ((F32Upper and 1)<>0)) then begin
         RoundedUp:=true;
        end;
       end;
       1:begin
        // RTZ: truncate, never round up
       end;
       2:begin
        // RDN: towards -inf, round up (increase magnitude) if negative
        if F32Sign=1 then begin
         RoundedUp:=true;
        end;
       end;
       3:begin
        // RUP: towards +inf, round up (increase magnitude) if positive
        if F32Sign=0 then begin
         RoundedUp:=true;
        end;
       end;
       else begin
        // RMMA (4): nearest, ties away from zero
        if LostBits16>=$8000 then begin
         RoundedUp:=true;
        end;
       end;
      end;
     end;
     if RoundedUp then begin
      F32Upper:=F32Upper+1;
      // rounding into exponent=$ff -> overflow to BF16 Inf
      if (F32Upper and $7f80)=$7f80 then begin
       FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Overflow);
      end;
     end;
     VectorSetElement(aVD,Index,16,TPasRISCVUInt64(TPasRISCVUInt16(F32Upper)));
    end;
   end;
  end;
 end;
 fState.CSR.SetFPUException(FFlags);
end;

