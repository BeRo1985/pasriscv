procedure TPasRISCV.THART.SoftFloatExecVWCvtBF16(const aVS2,aVD:TPasRISCVUInt32;const aVSTART,aEVL:TPasRISCVUInt32;const aUnmasked:Boolean);
var Index:TPasRISCVUInt32;
    FFlags:TPasRISCVUInt8;
    ui16:TPasRISCVUInt16;
    Exponent,Mantissa:TPasRISCVUInt32;
begin
 FFlags:=0;
 if aVSTART<aEVL then begin
  for Index:=aVSTART to aEVL-1 do begin
   if aUnmasked or VectorGetMaskBit(Index) then begin
    ui16:=TPasRISCVUInt16(VectorGetElement(aVS2,Index,16));
    Exponent:=(ui16 shr 7) and $ff;
    Mantissa:=ui16 and $7f;
    if (Exponent=$ff) and (Mantissa<>0) then begin
     if (Mantissa and $40)=0 then begin
      FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Invalid);
     end;
     VectorSetElement(aVD,Index,32,SoftFloatF32_CanonicalNaN);
    end else begin
     VectorSetElement(aVD,Index,32,TPasRISCVUInt64(TPasRISCVUInt32(ui16) shl 16));
    end;
   end;
  end;
 end;
 fState.CSR.SetFPUException(FFlags);
end;

