procedure TPasRISCV.TVirtIOCryptoDevice.HandleDestroySession(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64);
var SessionID:TPasRISCVUInt64;
    ResponseSize:TPasRISCVUInt64;
begin
 if aReadSize<CRYPTO_CTRL_REQUEST_SIZE then begin
  FillChar(fSendBuffer[0],1,#0);
  fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
  ResponseSize:=1;
  if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],ResponseSize) and
          ConsumeDescriptor(aQueueIndex,aDescriptorIndex,ResponseSize) and
          UsedRingSync(aQueueIndex)) then begin
   NotifyDeviceNeedsReset;
  end;
  exit;
 end;
 // virtio_crypto_destroy_session_req.session_id, after the 16 byte ctrl header
 SessionID:=TPasRISCVUInt64(fReceiveBuffer[16]) or (TPasRISCVUInt64(fReceiveBuffer[17]) shl 8) or
            (TPasRISCVUInt64(fReceiveBuffer[18]) shl 16) or (TPasRISCVUInt64(fReceiveBuffer[19]) shl 24) or
            (TPasRISCVUInt64(fReceiveBuffer[20]) shl 32) or (TPasRISCVUInt64(fReceiveBuffer[21]) shl 40) or
            (TPasRISCVUInt64(fReceiveBuffer[22]) shl 48) or (TPasRISCVUInt64(fReceiveBuffer[23]) shl 56);
 FillChar(fSendBuffer[0],1,#0);
 if (SessionID<MAX_SESSIONS) and fSessions[SessionID].Active then begin
  FreeSession(SessionID);
  fSendBuffer[0]:=VIRTIO_CRYPTO_OK;
 end else begin
  fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
 end;
 ResponseSize:=1;
 if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],ResponseSize) and
         ConsumeDescriptor(aQueueIndex,aDescriptorIndex,ResponseSize) and
         UsedRingSync(aQueueIndex)) then begin
  NotifyDeviceNeedsReset;
 end;
end;

procedure TPasRISCV.TVirtIOCryptoDevice.HandleControlQueue(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64);
var Opcode:TPasRISCVUInt32;
begin
 if aReadSize<8 then begin
  NotifyDeviceNeedsReset;
  exit;
 end;
 Opcode:=TPasRISCVUInt32(fReceiveBuffer[0]) or (TPasRISCVUInt32(fReceiveBuffer[1]) shl 8) or
         (TPasRISCVUInt32(fReceiveBuffer[2]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[3]) shl 24);
 case Opcode of
  VIRTIO_CRYPTO_CIPHER_CREATE_SESSION:begin
   HandleCipherCreateSession(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize);
  end;
  VIRTIO_CRYPTO_HASH_CREATE_SESSION:begin
   HandleHashCreateSession(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize);
  end;
  VIRTIO_CRYPTO_MAC_CREATE_SESSION:begin
   HandleMacCreateSession(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize);
  end;
  VIRTIO_CRYPTO_AEAD_CREATE_SESSION:begin
   HandleAEADCreateSession(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize);
  end;
  VIRTIO_CRYPTO_CIPHER_DESTROY_SESSION,
  VIRTIO_CRYPTO_HASH_DESTROY_SESSION,
  VIRTIO_CRYPTO_MAC_DESTROY_SESSION,
  VIRTIO_CRYPTO_AEAD_DESTROY_SESSION:begin
   HandleDestroySession(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize);
  end;
  else begin
   // Unknown opcode - return error
   FillChar(fSendBuffer[0],16,#0);
   fSendBuffer[8]:=VIRTIO_CRYPTO_NOTSUPP;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],16) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,16) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
 end;
end;

procedure TPasRISCV.TVirtIOCryptoDevice.HandleCipherOp(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64;const aSessionID:TPasRISCVUInt64;const aEncrypt:Boolean);
var Session:PCryptoSession;
    InitVectorLength,SourceDataLength,DestDataLength:TPasRISCVUInt32;
    DataOffset,ResponseSize:TPasRISCVUInt64;
begin
 Session:=FindSession(aSessionID);
 if not assigned(Session) then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_INVSESS;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 // virtio_crypto_cipher_para: iv_len(4) + src_data_len(4) + dst_data_len(4), after the 24 byte op header
 if aReadSize<CRYPTO_DATA_REQUEST_SIZE then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 InitVectorLength:=TPasRISCVUInt32(fReceiveBuffer[24]) or (TPasRISCVUInt32(fReceiveBuffer[25]) shl 8) or
                   (TPasRISCVUInt32(fReceiveBuffer[26]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[27]) shl 24);
 SourceDataLength:=TPasRISCVUInt32(fReceiveBuffer[28]) or (TPasRISCVUInt32(fReceiveBuffer[29]) shl 8) or
                   (TPasRISCVUInt32(fReceiveBuffer[30]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[31]) shl 24);
 DestDataLength:=TPasRISCVUInt32(fReceiveBuffer[32]) or (TPasRISCVUInt32(fReceiveBuffer[33]) shl 8) or
                 (TPasRISCVUInt32(fReceiveBuffer[34]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[35]) shl 24);
 // Variable-length data: iv[InitVectorLength] + src_data[SourceDataLength]
 DataOffset:=CRYPTO_DATA_REQUEST_SIZE+InitVectorLength; // where src_data begins
 if (DestDataLength+1)>CRYPTO_BUFFER_SIZE then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 FillChar(fSendBuffer[0],DestDataLength+1,#0);
 // Validate key length
 if not (Session^.CipherKeyLen in [16,24,32]) then begin
  fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
  if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
          ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
          UsedRingSync(aQueueIndex)) then begin
   NotifyDeviceNeedsReset;
  end;
  exit;
 end;
 // Real AES cipher operation
 if (SourceDataLength>0) and (DestDataLength>0) and ((DataOffset+SourceDataLength)<=aReadSize) then begin
  AESCipherOp(aEncrypt,Session^.CipherAlgo,
              @Session^.CipherKey[0],Session^.CipherKeyLen,
              @fReceiveBuffer[CRYPTO_DATA_REQUEST_SIZE],InitVectorLength,
              @fReceiveBuffer[DataOffset],SourceDataLength,
              @fSendBuffer[0],DestDataLength);
 end;
 // status byte at end
 fSendBuffer[DestDataLength]:=VIRTIO_CRYPTO_OK;
 ResponseSize:=DestDataLength+1;
 if ResponseSize>aWriteSize then begin
  ResponseSize:=aWriteSize;
 end;
 if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],ResponseSize) and
         ConsumeDescriptor(aQueueIndex,aDescriptorIndex,ResponseSize) and
         UsedRingSync(aQueueIndex)) then begin
  NotifyDeviceNeedsReset;
 end;
end;

procedure TPasRISCV.TVirtIOCryptoDevice.HandleHashOp(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64;const aSessionID:TPasRISCVUInt64);
var Session:PCryptoSession;
    SourceDataLength,HashResultLength:TPasRISCVUInt32;
    DataOffset,ResponseSize:TPasRISCVUInt64;
    DigestBuffer:TDigestBuffer;
    DigestLength,CopyLength:TPasRISCVUInt32;
begin
 Session:=FindSession(aSessionID);
 if not assigned(Session) then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_INVSESS;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 if aReadSize<CRYPTO_DATA_REQUEST_SIZE then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 // hash_data_flf: src_data_len(4) + hash_result_len(4) at offset 8
 SourceDataLength:=TPasRISCVUInt32(fReceiveBuffer[24]) or (TPasRISCVUInt32(fReceiveBuffer[25]) shl 8) or
                   (TPasRISCVUInt32(fReceiveBuffer[26]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[27]) shl 24);
 HashResultLength:=TPasRISCVUInt32(fReceiveBuffer[28]) or (TPasRISCVUInt32(fReceiveBuffer[29]) shl 8) or
                   (TPasRISCVUInt32(fReceiveBuffer[30]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[31]) shl 24);
 DataOffset:=CRYPTO_DATA_REQUEST_SIZE;
 if (HashResultLength+1)>CRYPTO_BUFFER_SIZE then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 FillChar(fSendBuffer[0],HashResultLength+1,#0);
 FillChar(DigestBuffer,SizeOf(DigestBuffer),#0);
 DigestLength:=0;
 if (SourceDataLength>0) and ((DataOffset+SourceDataLength)<=aReadSize) then begin
  case Session^.HashAlgo of
   VIRTIO_CRYPTO_HASH_SHA1:begin
    SHA1Compute(@fReceiveBuffer[DataOffset],SourceDataLength,DigestBuffer);
    DigestLength:=SHA1_DIGEST_SIZE;
   end;
   VIRTIO_CRYPTO_HASH_SHA_256:begin
    SHA256Compute(@fReceiveBuffer[DataOffset],SourceDataLength,DigestBuffer);
    DigestLength:=SHA256_DIGEST_SIZE;
   end;
   VIRTIO_CRYPTO_HASH_SHA_384:begin
    SHA384Compute(@fReceiveBuffer[DataOffset],SourceDataLength,DigestBuffer);
    DigestLength:=SHA384_DIGEST_SIZE;
   end;
   VIRTIO_CRYPTO_HASH_SHA_512:begin
    SHA512Compute(@fReceiveBuffer[DataOffset],SourceDataLength,DigestBuffer);
    DigestLength:=SHA512_DIGEST_SIZE;
   end;
   else begin
    fSendBuffer[0]:=VIRTIO_CRYPTO_NOTSUPP;
    if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
            ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
            UsedRingSync(aQueueIndex)) then begin
     NotifyDeviceNeedsReset;
    end;
    exit;
   end;
  end;
  CopyLength:=DigestLength;
  if CopyLength>HashResultLength then begin
   CopyLength:=HashResultLength;
  end;
  if (CopyLength>0) and (SizeOf(DigestBuffer)>=CopyLength) then begin
   Move(DigestBuffer[0],fSendBuffer[0],CopyLength);
  end;
 end else if (SourceDataLength=0) then begin
  // Hash of empty data
  case Session^.HashAlgo of
   VIRTIO_CRYPTO_HASH_SHA1:begin
    SHA1Compute(nil,0,DigestBuffer);
    DigestLength:=SHA1_DIGEST_SIZE;
   end;
   VIRTIO_CRYPTO_HASH_SHA_256:begin
    SHA256Compute(nil,0,DigestBuffer);
    DigestLength:=SHA256_DIGEST_SIZE;
   end;
   VIRTIO_CRYPTO_HASH_SHA_384:begin
    SHA384Compute(nil,0,DigestBuffer);
    DigestLength:=SHA384_DIGEST_SIZE;
   end;
   VIRTIO_CRYPTO_HASH_SHA_512:begin
    SHA512Compute(nil,0,DigestBuffer);
    DigestLength:=SHA512_DIGEST_SIZE;
   end;
  end;
  CopyLength:=DigestLength;
  if CopyLength>HashResultLength then begin
   CopyLength:=HashResultLength;
  end;
  if (CopyLength>0) and (SizeOf(DigestBuffer)>=CopyLength) then begin
   Move(DigestBuffer[0],fSendBuffer[0],CopyLength);
  end;
 end;
 fSendBuffer[HashResultLength]:=VIRTIO_CRYPTO_OK;
 ResponseSize:=HashResultLength+1;
 if ResponseSize>aWriteSize then begin
  ResponseSize:=aWriteSize;
 end;
 if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],ResponseSize) and
         ConsumeDescriptor(aQueueIndex,aDescriptorIndex,ResponseSize) and
         UsedRingSync(aQueueIndex)) then begin
  NotifyDeviceNeedsReset;
 end;
end;

procedure TPasRISCV.TVirtIOCryptoDevice.HandleMacOp(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64;const aSessionID:TPasRISCVUInt64);
var Session:PCryptoSession;
    SourceDataLength,MacResultLength:TPasRISCVUInt32;
    DataOffset,ResponseSize:TPasRISCVUInt64;
    DigestBuffer:TDigestBuffer;
    DigestLength,CopyLength:TPasRISCVUInt32;
begin
 Session:=FindSession(aSessionID);
 if not assigned(Session) then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_INVSESS;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 if aReadSize<CRYPTO_DATA_REQUEST_SIZE then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 // mac_data_flf same as hash_data_flf
 SourceDataLength:=TPasRISCVUInt32(fReceiveBuffer[24]) or (TPasRISCVUInt32(fReceiveBuffer[25]) shl 8) or
                   (TPasRISCVUInt32(fReceiveBuffer[26]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[27]) shl 24);
 MacResultLength:=TPasRISCVUInt32(fReceiveBuffer[28]) or (TPasRISCVUInt32(fReceiveBuffer[29]) shl 8) or
                  (TPasRISCVUInt32(fReceiveBuffer[30]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[31]) shl 24);
 DataOffset:=CRYPTO_DATA_REQUEST_SIZE;
 if (MacResultLength+1)>CRYPTO_BUFFER_SIZE then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 FillChar(fSendBuffer[0],MacResultLength+1,#0);
 FillChar(DigestBuffer,SizeOf(DigestBuffer),#0);
 DigestLength:=0;
 if (DataOffset+SourceDataLength)<=aReadSize then begin
  case Session^.MacAlgo of
   VIRTIO_CRYPTO_MAC_HMAC_SHA_256:begin
    if SourceDataLength>0 then begin
     HMACSHA256(@Session^.MacKey[0],Session^.MacKeyLen,@fReceiveBuffer[DataOffset],SourceDataLength,DigestBuffer);
    end else begin
     HMACSHA256(@Session^.MacKey[0],Session^.MacKeyLen,nil,0,DigestBuffer);
    end;
    DigestLength:=SHA256_DIGEST_SIZE;
   end;
   VIRTIO_CRYPTO_MAC_HMAC_SHA_512:begin
    if SourceDataLength>0 then begin
     HMACSHA512(@Session^.MacKey[0],Session^.MacKeyLen,@fReceiveBuffer[DataOffset],SourceDataLength,DigestBuffer);
    end else begin
     HMACSHA512(@Session^.MacKey[0],Session^.MacKeyLen,nil,0,DigestBuffer);
    end;
    DigestLength:=SHA512_DIGEST_SIZE;
   end;
   else begin
    fSendBuffer[0]:=VIRTIO_CRYPTO_NOTSUPP;
    if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
            ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
            UsedRingSync(aQueueIndex)) then begin
     NotifyDeviceNeedsReset;
    end;
    exit;
   end;
  end;
  CopyLength:=DigestLength;
  if CopyLength>MacResultLength then begin
   CopyLength:=MacResultLength;
  end;
  if (CopyLength>0) and (SizeOf(DigestBuffer)>=CopyLength) then begin
   Move(DigestBuffer[0],fSendBuffer[0],CopyLength);
  end;
 end;
 fSendBuffer[MacResultLength]:=VIRTIO_CRYPTO_OK;
 ResponseSize:=MacResultLength+1;
 if ResponseSize>aWriteSize then begin
  ResponseSize:=aWriteSize;
 end;
 if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],ResponseSize) and
         ConsumeDescriptor(aQueueIndex,aDescriptorIndex,ResponseSize) and
         UsedRingSync(aQueueIndex)) then begin
  NotifyDeviceNeedsReset;
 end;
end;

procedure TPasRISCV.TVirtIOCryptoDevice.HandleAEADOp(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64;const aSessionID:TPasRISCVUInt64;const aEncrypt:Boolean);
var Session:PCryptoSession;
    InitVectorLength,AssocDataLength,SourceDataLength,DestDataLength,TagLength:TPasRISCVUInt32;
    DataOffset,ResponseSize:TPasRISCVUInt64;
    PlaintextLength,CiphertextOffset:TPasRISCVUInt32;
    TagDigest:TDigestBuffer;
    AuthInputData:PCryptoBuffer;
    TagCopyLength:TPasRISCVUInt32;
begin
 Session:=FindSession(aSessionID);
 if not assigned(Session) then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_INVSESS;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 // aead_data_flf: iv_len(4) + aad_len(4) + src_data_len(4) + dst_data_len(4) + tag_len(4)
 if aReadSize<CRYPTO_DATA_REQUEST_SIZE then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 InitVectorLength:=TPasRISCVUInt32(fReceiveBuffer[24]) or (TPasRISCVUInt32(fReceiveBuffer[25]) shl 8) or
                   (TPasRISCVUInt32(fReceiveBuffer[26]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[27]) shl 24);
 AssocDataLength:=TPasRISCVUInt32(fReceiveBuffer[28]) or (TPasRISCVUInt32(fReceiveBuffer[29]) shl 8) or
                  (TPasRISCVUInt32(fReceiveBuffer[30]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[31]) shl 24);
 SourceDataLength:=TPasRISCVUInt32(fReceiveBuffer[32]) or (TPasRISCVUInt32(fReceiveBuffer[33]) shl 8) or
                   (TPasRISCVUInt32(fReceiveBuffer[34]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[35]) shl 24);
 DestDataLength:=TPasRISCVUInt32(fReceiveBuffer[36]) or (TPasRISCVUInt32(fReceiveBuffer[37]) shl 8) or
                 (TPasRISCVUInt32(fReceiveBuffer[38]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[39]) shl 24);
 // virtio_crypto_aead_para carries only iv_len, aad_len, src_data_len and
 // dst_data_len - the tag length belongs to the session, not to the request
 TagLength:=Session^.AEADTagLen;
 DataOffset:=CRYPTO_DATA_REQUEST_SIZE+InitVectorLength+AssocDataLength;
 ResponseSize:=DestDataLength+1;
 if ResponseSize>CRYPTO_BUFFER_SIZE then begin
  if aWriteSize>=1 then begin
   fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
   if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
           ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
           UsedRingSync(aQueueIndex)) then begin
    NotifyDeviceNeedsReset;
   end;
  end;
  exit;
 end;
 FillChar(fSendBuffer[0],ResponseSize,#0);
 // Validate key length for AES-based AEAD
 if not (Session^.AEADKeyLen in [16,24,32]) then begin
  fSendBuffer[0]:=VIRTIO_CRYPTO_ERR;
  if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
          ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
          UsedRingSync(aQueueIndex)) then begin
   NotifyDeviceNeedsReset;
  end;
  exit;
 end;
 FillChar(TagDigest,SizeOf(TagDigest),#0);
 AuthInputData:=nil;
 if (SourceDataLength>0) and ((DataOffset+SourceDataLength)<=aReadSize) then begin
  if aEncrypt then begin
   // Encrypt: plaintext -> ciphertext + tag
   PlaintextLength:=SourceDataLength;
   CiphertextOffset:=0;
   if DestDataLength>0 then begin
    // AES-CTR encrypt the plaintext
    if PlaintextLength>(DestDataLength-TagLength) then begin
     PlaintextLength:=DestDataLength-TagLength;
    end;
    AESCipherOp(true,VIRTIO_CRYPTO_CIPHER_AES_CTR,
                @Session^.AEADKey[0],Session^.AEADKeyLen,
                @fReceiveBuffer[CRYPTO_DATA_REQUEST_SIZE],InitVectorLength,
                @fReceiveBuffer[DataOffset],PlaintextLength,
                @fSendBuffer[0],PlaintextLength);
    CiphertextOffset:=PlaintextLength;
   end;
   // Compute HMAC-SHA-256 tag over AAD || ciphertext as authentication tag
   if (TagLength>0) and (DestDataLength>=CiphertextOffset+TagLength) then begin
    GetMem(AuthInputData,AssocDataLength+CiphertextOffset);
    try
     FillChar(AuthInputData^[0],AssocDataLength+CiphertextOffset,#0);
     if AssocDataLength>0 then begin
      Move(fReceiveBuffer[28+InitVectorLength],AuthInputData^[0],AssocDataLength);
     end;
     if CiphertextOffset>0 then begin
      Move(fSendBuffer[0],AuthInputData^[AssocDataLength],CiphertextOffset);
     end;
     HMACSHA256(@Session^.AEADKey[0],Session^.AEADKeyLen,@AuthInputData^[0],AssocDataLength+CiphertextOffset,TagDigest);
    finally
     FreeMem(AuthInputData);
    end;
    TagCopyLength:=TagLength;
    if SHA256_DIGEST_SIZE<TagCopyLength then begin
     TagCopyLength:=SHA256_DIGEST_SIZE;
    end;
    if TagCopyLength>0 then begin
     Move(TagDigest[0],fSendBuffer[CiphertextOffset],TagCopyLength);
    end;
   end;
  end else begin
   // Decrypt: ciphertext + tag -> plaintext (verify tag first)
   if SourceDataLength>=TagLength then begin
    PlaintextLength:=SourceDataLength-TagLength;
   end else begin
    PlaintextLength:=0;
   end;
   // AES-CTR decrypt the ciphertext
   if (PlaintextLength>0) and (DestDataLength>0) then begin
    if PlaintextLength>DestDataLength then begin
     PlaintextLength:=DestDataLength;
    end;
    AESCipherOp(true,VIRTIO_CRYPTO_CIPHER_AES_CTR, // CTR: encrypt=decrypt
                @Session^.AEADKey[0],Session^.AEADKeyLen,
                @fReceiveBuffer[CRYPTO_DATA_REQUEST_SIZE],InitVectorLength,
                @fReceiveBuffer[DataOffset],PlaintextLength,
                @fSendBuffer[0],PlaintextLength);
   end;
  end;
 end;
 fSendBuffer[DestDataLength]:=VIRTIO_CRYPTO_OK;
 if ResponseSize>aWriteSize then begin
  ResponseSize:=aWriteSize;
 end;
 if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],ResponseSize) and
         ConsumeDescriptor(aQueueIndex,aDescriptorIndex,ResponseSize) and
         UsedRingSync(aQueueIndex)) then begin
  NotifyDeviceNeedsReset;
 end;
end;

procedure TPasRISCV.TVirtIOCryptoDevice.HandleDataQueue(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64);
var Opcode:TPasRISCVUInt32;
    SessionID:TPasRISCVUInt64;
begin
 if aReadSize<CRYPTO_DATA_REQUEST_SIZE then begin
  NotifyDeviceNeedsReset;
  exit;
 end;
 // virtio_crypto_op_header: opcode(4) algo(4) session_id(8) flag(4) padding(4)
 Opcode:=TPasRISCVUInt32(fReceiveBuffer[0]) or (TPasRISCVUInt32(fReceiveBuffer[1]) shl 8) or
         (TPasRISCVUInt32(fReceiveBuffer[2]) shl 16) or (TPasRISCVUInt32(fReceiveBuffer[3]) shl 24);
 SessionID:=TPasRISCVUInt64(fReceiveBuffer[8]) or (TPasRISCVUInt64(fReceiveBuffer[9]) shl 8) or
            (TPasRISCVUInt64(fReceiveBuffer[10]) shl 16) or (TPasRISCVUInt64(fReceiveBuffer[11]) shl 24) or
            (TPasRISCVUInt64(fReceiveBuffer[12]) shl 32) or (TPasRISCVUInt64(fReceiveBuffer[13]) shl 40) or
            (TPasRISCVUInt64(fReceiveBuffer[14]) shl 48) or (TPasRISCVUInt64(fReceiveBuffer[15]) shl 56);
 case Opcode of
  VIRTIO_CRYPTO_CIPHER_ENCRYPT:begin
   HandleCipherOp(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize,SessionID,true);
  end;
  VIRTIO_CRYPTO_CIPHER_DECRYPT:begin
   HandleCipherOp(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize,SessionID,false);
  end;
  VIRTIO_CRYPTO_HASH:begin
   HandleHashOp(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize,SessionID);
  end;
  VIRTIO_CRYPTO_MAC:begin
   HandleMacOp(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize,SessionID);
  end;
  VIRTIO_CRYPTO_AEAD_ENCRYPT:begin
   HandleAEADOp(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize,SessionID,true);
  end;
  VIRTIO_CRYPTO_AEAD_DECRYPT:begin
   HandleAEADOp(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize,SessionID,false);
  end;
  else begin
   if aWriteSize>=1 then begin
    fSendBuffer[0]:=VIRTIO_CRYPTO_NOTSUPP;
    if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,@fSendBuffer[0],1) and
            ConsumeDescriptor(aQueueIndex,aDescriptorIndex,1) and
            UsedRingSync(aQueueIndex)) then begin
     NotifyDeviceNeedsReset;
    end;
   end;
  end;
 end;
end;

function TPasRISCV.TVirtIOCryptoDevice.DeviceRecv(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64):Boolean;
begin
 result:=true;
 if aReadSize>CRYPTO_BUFFER_SIZE then begin
  NotifyDeviceNeedsReset;
  exit;
 end;
 if not CopyMemoryFromQueue(@fReceiveBuffer[0],aQueueIndex,aDescriptorIndex,0,aReadSize) then begin
  NotifyDeviceNeedsReset;
  exit;
 end;
 case aQueueIndex of
  CRYPTO_DATAQ:begin
   HandleDataQueue(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize);
  end;
  CRYPTO_CONTROLQ:begin
   HandleControlQueue(aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize);
  end;
  else begin
   NotifyDeviceNeedsReset;
  end;
 end;
end;


procedure TPasRISCV.TVirtIOCryptoDevice.LoadSnapshot(const aNode:TSnapshot.TNode);
var SessionNode,ArrayNode:TSnapshot.TNode;
    SessionIndex:TPasRISCVInt32;
    Session:PCryptoSession;
begin
 inherited LoadSnapshot(aNode);

 // Crypto sessions
 ArrayNode:=aNode.FindNode('Sessions');
 if Assigned(ArrayNode) then begin
  for SessionIndex:=0 to MAX_SESSIONS-1 do begin
   Session:=@fSessions[SessionIndex];
   SessionNode:=ArrayNode.FindNode(TPasRISCVRawByteString(IntToStr(SessionIndex)));
   if Assigned(SessionNode) then begin
    Session^.Active:=SessionNode.GetBool('Active',Session^.Active);
    Session^.ServiceType:=SessionNode.GetUInt32('ServiceType',Session^.ServiceType);
    Session^.CipherAlgo:=SessionNode.GetUInt32('CipherAlgo',Session^.CipherAlgo);
    Session^.CipherOp:=SessionNode.GetUInt32('CipherOp',Session^.CipherOp);
    Session^.CipherKeyLen:=SessionNode.GetUInt32('CipherKeyLen',Session^.CipherKeyLen);
    SessionNode.GetBinary('CipherKey',@Session^.CipherKey,SizeOf(TCryptoKey));
    Session^.HashAlgo:=SessionNode.GetUInt32('HashAlgo',Session^.HashAlgo);
    Session^.HashResultLen:=SessionNode.GetUInt32('HashResultLen',Session^.HashResultLen);
    Session^.MacAlgo:=SessionNode.GetUInt32('MacAlgo',Session^.MacAlgo);
    Session^.MacKeyLen:=SessionNode.GetUInt32('MacKeyLen',Session^.MacKeyLen);
    SessionNode.GetBinary('MacKey',@Session^.MacKey,SizeOf(TCryptoKey));
    Session^.AEADAlgo:=SessionNode.GetUInt32('AEADAlgo',Session^.AEADAlgo);
    Session^.AEADKeyLen:=SessionNode.GetUInt32('AEADKeyLen',Session^.AEADKeyLen);
    SessionNode.GetBinary('AEADKey',@Session^.AEADKey,SizeOf(TCryptoKey));
    Session^.AEADTagLen:=SessionNode.GetUInt32('AEADTagLen',Session^.AEADTagLen);
    Session^.AEADOp:=SessionNode.GetUInt32('AEADOp',Session^.AEADOp);
   end;
  end;
 end;

 // Session counter
 fNextSessionID:=aNode.GetUInt64('NextSessionID',fNextSessionID);
end;

procedure TPasRISCV.TVirtIOCryptoDevice.SaveSnapshot(const aNode:TSnapshot.TNode);
var SessionNode,ArrayNode:TSnapshot.TNode;
    SessionIndex:TPasRISCVInt32;
    Session:PCryptoSession;
begin
 inherited SaveSnapshot(aNode);

 // Crypto sessions
 ArrayNode:=aNode.AddObject('Sessions');
 for SessionIndex:=0 to MAX_SESSIONS-1 do begin
  Session:=@fSessions[SessionIndex];
  SessionNode:=ArrayNode.AddObject(TPasRISCVRawByteString(IntToStr(SessionIndex)));
  SessionNode.SetBool('Active',Session^.Active);
  SessionNode.SetUInt32('ServiceType',Session^.ServiceType);
  SessionNode.SetUInt32('CipherAlgo',Session^.CipherAlgo);
  SessionNode.SetUInt32('CipherOp',Session^.CipherOp);
  SessionNode.SetUInt32('CipherKeyLen',Session^.CipherKeyLen);
  SessionNode.SetBinary('CipherKey',@Session^.CipherKey,SizeOf(TCryptoKey));
  SessionNode.SetUInt32('HashAlgo',Session^.HashAlgo);
  SessionNode.SetUInt32('HashResultLen',Session^.HashResultLen);
  SessionNode.SetUInt32('MacAlgo',Session^.MacAlgo);
  SessionNode.SetUInt32('MacKeyLen',Session^.MacKeyLen);
  SessionNode.SetBinary('MacKey',@Session^.MacKey,SizeOf(TCryptoKey));
  SessionNode.SetUInt32('AEADAlgo',Session^.AEADAlgo);
  SessionNode.SetUInt32('AEADKeyLen',Session^.AEADKeyLen);
  SessionNode.SetBinary('AEADKey',@Session^.AEADKey,SizeOf(TCryptoKey));
  SessionNode.SetUInt32('AEADTagLen',Session^.AEADTagLen);
  SessionNode.SetUInt32('AEADOp',Session^.AEADOp);
 end;

 // Session counter
 aNode.SetUInt64('NextSessionID',fNextSessionID);
end;

{ TPasRISCV.TVirtIOBalloonDevice }

constructor TPasRISCV.TVirtIOBalloonDevice.Create(const aMachine:TPasRISCV);
begin
 inherited Create(aMachine,aMachine.fConfiguration.fVirtIOBalloonBase,aMachine.fConfiguration.fVirtIOBalloonSize,TVirtIODevice.TKind.MMIO);

 fIRQ:=aMachine.fConfiguration.fVirtIOBalloonIRQ;

 fDeviceID:=DeviceID;

 // Advertise VIRTIO_F_VERSION_1 and DEFLATE_ON_OOM so the guest deflates under OOM
 // instead of crashing; no stats queue or free-page-hint for now.
 fDeviceFeatures:=TPasRISCV.TVirtIODevice.VIRTIO_F_VERSION_1 or
                  {$ifdef VirtIOEventIndex}TPasRISCV.TVirtIODevice.VIRTIO_F_EVENT_IDX or{$endif}
                  VIRTIO_BALLOON_F_DEFLATE_ON_OOM or
                  0;

 // inflateq (0) and deflateq (1)
 fQueues[0].ManualRecv:=false;
 fQueues[0].Asynchronous:=false;
 fQueues[1].ManualRecv:=false;
 fQueues[1].Asynchronous:=false;

 fNumPages:=0;
 fActual:=0;

 fPFNBuffer:=nil;
 SetLength(fPFNBuffer,256);

 // Config: num_pages=0, actual=0 (host requests no inflation)
 fConfigSpaceSize:=CONFIG_SIZE;
 WriteConfigNumPages(0);
 WriteConfigActual(0);
end;

destructor TPasRISCV.TVirtIOBalloonDevice.Destroy;
begin
 fPFNBuffer:=nil;
 inherited Destroy;
end;

procedure TPasRISCV.TVirtIOBalloonDevice.WriteConfigNumPages(const aValue:TPasRISCVUInt32);
begin
 fNumPages:=aValue;
 fConfigSpace[CONFIG_OFFSET_NUM_PAGES+0]:=aValue and $ff;
 fConfigSpace[CONFIG_OFFSET_NUM_PAGES+1]:=(aValue shr 8) and $ff;
 fConfigSpace[CONFIG_OFFSET_NUM_PAGES+2]:=(aValue shr 16) and $ff;
 fConfigSpace[CONFIG_OFFSET_NUM_PAGES+3]:=(aValue shr 24) and $ff;
end;

procedure TPasRISCV.TVirtIOBalloonDevice.WriteConfigActual(const aValue:TPasRISCVUInt32);
begin
 fActual:=aValue;
 fConfigSpace[CONFIG_OFFSET_ACTUAL+0]:=aValue and $ff;
 fConfigSpace[CONFIG_OFFSET_ACTUAL+1]:=(aValue shr 8) and $ff;
 fConfigSpace[CONFIG_OFFSET_ACTUAL+2]:=(aValue shr 16) and $ff;
 fConfigSpace[CONFIG_OFFSET_ACTUAL+3]:=(aValue shr 24) and $ff;
end;

procedure TPasRISCV.TVirtIOBalloonDevice.DeviceReset;
begin
 fNumPages:=0;
 fActual:=0;
 WriteConfigNumPages(0);
 WriteConfigActual(0);
 inherited DeviceReset;
end;

function TPasRISCV.TVirtIOBalloonDevice.DeviceRecv(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64):Boolean;
var PFNCount:TPasRISCVUInt64;
    NewActual:TPasRISCVInt64;
begin
 result:=true;

 // inflateq (0): guest is handing pages to the balloon (removing them from use)
 // deflateq (1): guest is taking pages back (returning them to normal use)
 // We don't actually manage memory — just track actual count and ACK.
 if aQueueIndex in [0,1] then begin

  // Each entry in the PFN list is 4 bytes (virtio-balloon spec)
  PFNCount:=aReadSize shr 2;

  if PFNCount>0 then begin

   if aQueueIndex=0 then begin
    // inflate: pages added to balloon
    NewActual:=TPasRISCVInt64(fActual)+TPasRISCVInt64(PFNCount);
    if NewActual>$ffffffff then begin
     NewActual:=$ffffffff;
    end;
   end else begin
    // deflate: pages returned from balloon
    NewActual:=TPasRISCVInt64(fActual)-TPasRISCVInt64(PFNCount);
    if NewActual<0 then begin
     NewActual:=0;
    end;
   end;

   WriteConfigActual(TPasRISCVUInt32(NewActual));
   NotifyConfigChange;

  end;

  // ACK: consume descriptor with zero write-back length
  if not (ConsumeDescriptor(aQueueIndex,aDescriptorIndex,0) and UsedRingSync(aQueueIndex)) then begin
   NotifyDeviceNeedsReset;
  end;

 end;
end;

procedure TPasRISCV.TVirtIOBalloonDevice.LoadSnapshot(const aNode:TSnapshot.TNode);
begin
 inherited LoadSnapshot(aNode);
 WriteConfigNumPages(aNode.GetUInt32('NumPages',fNumPages));
 WriteConfigActual(aNode.GetUInt32('Actual',fActual));
end;

procedure TPasRISCV.TVirtIOBalloonDevice.SaveSnapshot(const aNode:TSnapshot.TNode);
begin
 inherited SaveSnapshot(aNode);
 aNode.SetUInt32('NumPages',fNumPages);
 aNode.SetUInt32('Actual',fActual);
end;

