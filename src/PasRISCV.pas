procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitNativeFMinMD(const aHostDest,aHostSrc1,aHostSrc2:TPasRISCVUInt8);
var ScratchXMM,TempReg,TempReg2:TPasRISCVUInt8;
    NaNFixup,DoneFixup,ZeroFixup:TPasRISCVUInt32;
begin
 if fMachine.fJITFastFPUCodePaths then begin
  ScratchXMM:=ClaimHostFPURegister;
  TempReg:=ClaimHostIntRegister;
  EmitFPUMov(ScratchXMM,aHostSrc1,false);
  // UCOMISD: check for NaN (sets PF if unordered)
  EmitSSE2Op($66,$2e,ScratchXMM,aHostSrc2);
  // JP .is_nan
  EmitJccRel32(CC_P,0);
  NaNFixup:=fTemporaryCodeSize-4;
  // Normal case: MIND/MAXD
  EmitSSE2Op($f2,$5d,ScratchXMM,aHostSrc2);
  EmitFPUMov(aHostDest,ScratchXMM,true);
  // JMP .done
  EmitJmpRel32(0);
  DoneFixup:=fTemporaryCodeSize-4;
  // .is_nan: return canonical NaN
  PatchJmpRel32(NaNFixup);
  EmitMOVRegImm64(TempReg,$7ff8000000000000);
  EmitSSE2MovGPRToXMM(aHostDest,TempReg,true);
  // .done:
  PatchJmpRel32(DoneFixup);
  FreeHostIntRegister(TempReg);
  FreeHostFPURegister(ScratchXMM);
 end else begin
  ScratchXMM:=ClaimHostFPURegister;
  TempReg:=ClaimHostIntRegister;
  TempReg2:=ClaimHostIntRegister;
  EmitFPUMov(ScratchXMM,aHostSrc1,false);
  // UCOMISD: check for NaN (sets PF if unordered)
  EmitSSE2Op($66,$2e,ScratchXMM,aHostSrc2);
  // JP .is_nan
  EmitJccRel32(CC_P,0);
  NaNFixup:=fTemporaryCodeSize-4;
  // Normal case: MINSD
  EmitSSE2Op($f2,$5d,ScratchXMM,aHostSrc2);
  // +-0 tie-break: shift out sign bit and test if result is +-0
  EmitSSE2MovXMMToGPR(TempReg,ScratchXMM,true);
  EmitSSE2MovXMMToGPR(TempReg2,ScratchXMM,true);
  EmitShiftRegImm(SHIFT_SHL,TempReg2,1,true);
  EmitTEST(TempReg2,TempReg2,true);
  EmitJccRel32(CC_NE,0);
  ZeroFixup:=fTemporaryCodeSize-4;
  // Result is +-0: OR src1 and src2 sign bits → -0 if either is -0
  EmitSSE2MovXMMToGPR(TempReg2,aHostSrc1,true);
  EmitSSE2MovXMMToGPR(TempReg,aHostSrc2,true);
  Emit2RegOp(X86_OR,TempReg,TempReg2,true);
  // Isolate sign bit only: SHR 63 then SHL 63 zeros all bits except bit 63
  EmitShiftRegImm(SHIFT_SHR,TempReg,63,true);
  EmitShiftRegImm(SHIFT_SHL,TempReg,63,true);
  EmitSSE2MovGPRToXMM(ScratchXMM,TempReg,true);
  // .zero_done:
  PatchJmpRel32(ZeroFixup);
  EmitFPUMov(aHostDest,ScratchXMM,true);
  // JMP .done
  EmitJmpRel32(0);
  DoneFixup:=fTemporaryCodeSize-4;
  // .is_nan: return canonical NaN
  PatchJmpRel32(NaNFixup);
  EmitMOVRegImm64(TempReg,$7ff8000000000000);
  EmitSSE2MovGPRToXMM(aHostDest,TempReg,true);
  // .done:
  PatchJmpRel32(DoneFixup);
  FreeHostIntRegister(TempReg2);
  FreeHostIntRegister(TempReg);
  FreeHostFPURegister(ScratchXMM);
 end;
end;

