procedure TPasRISCV.THART.SoftFloatExecFCvtModWD(const aInstruction:TPasRISCVUInt32;const aRd:TRegister;const aFrs1:TFPURegister);
var Temporary,Offset:TPasRISCVUInt64;
    Address:TPasRISCVUInt64;
    SFFFlags:TPasRISCVUInt8;
begin
 SFFFlags:=0;
 Temporary:=fState.FPURegisters[aFrs1].ui64;
 if (Temporary and $7ff0000000000000)=$7ff0000000000000 then begin
  SFFFlags:=SFFFlags or SoftFloatFF_NV;
  {$ifndef ExplicitEnforceZeroRegister}if aRd<>TRegister.Zero then{$endif}begin
   fState.Registers[aRd]:=0;
  end;
 end else begin
  Address:=(Temporary shr 52) and $7ff;
  if Address<1023 then begin
   if (Temporary and $7fffffffffffffff)<>0 then begin
    SFFFlags:=SFFFlags or SoftFloatFF_NX;
   end;
   {$ifndef ExplicitEnforceZeroRegister}if aRd<>TRegister.Zero then{$endif}begin
    fState.Registers[aRd]:=0;
   end;
  end else begin
   Address:=Address-1023;
   Offset:=(Temporary and $fffffffffffff) or TPasRISCVUInt64($10000000000000);
   if Address>=84 then begin
    // Out-of-i32-range: NV per Zfa spec (flags like fcvt.w.d RTZ)
    SFFFlags:=SFFFlags or SoftFloatFF_NV;
    {$ifndef ExplicitEnforceZeroRegister}if aRd<>TRegister.Zero then{$endif}begin
     fState.Registers[aRd]:=0;
    end;
   end else begin
    // NV when result overflows i32: positive exponent>=31, negative exponent>31 or (=31 and mantissa<>0)
    if (Temporary shr 63)=0 then begin
     if Address>=31 then begin
      SFFFlags:=SFFFlags or SoftFloatFF_NV;
     end;
    end else begin
     if (Address>31) or ((Address=31) and ((Temporary and $fffffffffffff)<>0)) then begin
      SFFFlags:=SFFFlags or SoftFloatFF_NV;
     end;
    end;
    if Address>=52 then begin
     Offset:=Offset shl (Address-52);
    end else begin
     // NX only when NV was not set (fcvt.w.d RTZ: overflow suppresses inexact)
     if ((SFFFlags and SoftFloatFF_NV)=0) and ((Offset and ((TPasRISCVUInt64(1) shl (52-Address))-1))<>0) then begin
      SFFFlags:=SFFFlags or SoftFloatFF_NX;
     end;
     Offset:=Offset shr (52-Address);
    end;
    if (Temporary shr 63)<>0 then begin
     Offset:=TPasRISCVUInt64(-TPasRISCVInt64(Offset));
    end;
    {$ifndef ExplicitEnforceZeroRegister}if aRd<>TRegister.Zero then{$endif}begin
     fState.Registers[aRd]:=TPasRISCVUInt64(TPasRISCVInt64(TPasRISCVInt32(Offset and $ffffffff)));
    end;
   end;
  end;
 end;
 fState.CSR.SetFPUException(SFFFlags);
 fState.CSR.SetFSDirty;
end;

