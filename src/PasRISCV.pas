  finally
   fVirglLock.Release;
  end;
 end else begin
  SendError(aQueueIndex,aDescriptorIndex,@aCommand^.Header,VIRTIO_GPU_RESP_ERR_UNSPEC);
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleResourceMapBlob(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCommand:PVirtIOGPUResourceMapBlob);
var GPUResource:TGPUResource;
    MapPointer:Pointer;
    MapSize:TPasRISCVUInt64;
    Response:TVirtIOGPUResponseMapInfo;
begin
 if fVirglInitialized then begin
  fVirglLock.Acquire;
  try
   GPUResource:=FindResource(aCommand^.ResourceID);
   if assigned(GPUResource) then begin
    MapPointer:=nil;
    MapSize:=0;
    if assigned(virgl_renderer_resource_map) then begin
     virgl_renderer_resource_map(aCommand^.ResourceID,@MapPointer,@MapSize);
    end;
    GPUResource.fMappedPointer:=MapPointer;
    FillChar(Response,SizeOf(TVirtIOGPUResponseMapInfo),0);
    Response.Header.CtrlType:=VIRTIO_GPU_RESP_OK_MAP_INFO;
    Response.Header.Flags:=aCommand^.Header.Flags;
    Response.Header.FenceID:=aCommand^.Header.FenceID;
    Response.Header.ContextID:=aCommand^.Header.ContextID;
    Response.MapInfo:=0;
    SendResponse(aQueueIndex,aDescriptorIndex,@Response,SizeOf(TVirtIOGPUResponseMapInfo));
   end else begin
    SendError(aQueueIndex,aDescriptorIndex,@aCommand^.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
   end;
  finally
   fVirglLock.Release;
  end;
 end else begin
  SendError(aQueueIndex,aDescriptorIndex,@aCommand^.Header,VIRTIO_GPU_RESP_ERR_UNSPEC);
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleResourceUnmapBlob(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCommand:PVirtIOGPUResourceUnmapBlob);
var GPUResource:TGPUResource;
begin
 if fVirglInitialized then begin
  fVirglLock.Acquire;
  try
   GPUResource:=FindResource(aCommand^.ResourceID);
   if assigned(GPUResource) then begin
    if assigned(virgl_renderer_resource_unmap) then begin
     virgl_renderer_resource_unmap(aCommand^.ResourceID);
    end;
    GPUResource.fMappedPointer:=nil;
   end;
   SendOKNoData(aQueueIndex,aDescriptorIndex,@aCommand^.Header);
  finally
   fVirglLock.Release;
  end;
 end else begin
  SendError(aQueueIndex,aDescriptorIndex,@aCommand^.Header,VIRTIO_GPU_RESP_ERR_UNSPEC);
 end;
end;

{$endif}

procedure TPasRISCV.TVirtIOGPUDevice.HandleUpdateCursor(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUUpdateCursor);
var Resource:TGPUResource;
    CopySize:TPasRISCVUInt64;
begin
 fFrameBuffer.SetCursorPosition(aCmd^.Pos.X,aCmd^.Pos.Y);
 fFrameBuffer.SetCursorHotspot(aCmd^.HotX,aCmd^.HotY);
 if aCmd^.ResourceID<>0 then begin
  Resource:=FindResource(aCmd^.ResourceID);
  if assigned(Resource) and (length(Resource.fData)>0) then begin
   CopySize:=length(Resource.fData);
   if CopySize>TFrameBufferDevice.CURSOR_BYTES then begin
    CopySize:=TFrameBufferDevice.CURSOR_BYTES;
   end;
   fFrameBuffer.SetCursorImage(@Resource.fData[0],CopySize);
   fFrameBuffer.SetCursorVisible(true);
  end else begin
   fFrameBuffer.SetCursorVisible(false);
  end;
 end else begin
  fFrameBuffer.SetCursorVisible(false);
 end;
 fFrameBuffer.fDirty:=true;
 // Cursor queue has no write descriptors per VirtIO spec, consume with length 0
 if not (ConsumeDescriptor(aQueueIndex,aDescriptorIndex,0) and
         UsedRingSync(aQueueIndex)) then begin
  NotifyDeviceNeedsReset;
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleMoveCursor(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUUpdateCursor);
begin
 fFrameBuffer.SetCursorPosition(aCmd^.Pos.X,aCmd^.Pos.Y);
 fFrameBuffer.fDirty:=true;
 // Cursor queue has no write descriptors per VirtIO spec, consume with length 0
 if not (ConsumeDescriptor(aQueueIndex,aDescriptorIndex,0) and
         UsedRingSync(aQueueIndex)) then begin
  NotifyDeviceNeedsReset;
 end;
end;

function TPasRISCV.TVirtIOGPUDevice.DeviceRecv(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64):Boolean;
var Header:TVirtIOGPUCtrlHeader;
begin
 result:=true;
 if aReadSize<SizeOf(TVirtIOGPUCtrlHeader) then begin
  NotifyDeviceNeedsReset;
  exit;
 end;
 if not CopyMemoryFromQueue(@fRecvBuffer[0],aQueueIndex,aDescriptorIndex,0,aReadSize) then begin
  NotifyDeviceNeedsReset;
  exit;
 end;
 Move(fRecvBuffer[0],Header,SizeOf(TVirtIOGPUCtrlHeader));
 case aQueueIndex of
  VIRTIO_GPU_VQ_CONTROL:begin
   case Header.CtrlType of
    VIRTIO_GPU_CMD_GET_DISPLAY_INFO:begin
     HandleGetDisplayInfo(aQueueIndex,aDescriptorIndex,@Header);
    end;
    VIRTIO_GPU_CMD_RESOURCE_CREATE_2D:begin
     if aReadSize>=SizeOf(TVirtIOGPUResourceCreate2D) then begin
      HandleResourceCreate2D(aQueueIndex,aDescriptorIndex,PVirtIOGPUResourceCreate2D(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_RESOURCE_UNREF:begin
     if aReadSize>=SizeOf(TVirtIOGPUResourceUnref) then begin
      HandleResourceUnref(aQueueIndex,aDescriptorIndex,PVirtIOGPUResourceUnref(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_SET_SCANOUT:begin
     if aReadSize>=SizeOf(TVirtIOGPUSetScanout) then begin
      HandleSetScanout(aQueueIndex,aDescriptorIndex,PVirtIOGPUSetScanout(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_RESOURCE_FLUSH:begin
     if aReadSize>=SizeOf(TVirtIOGPUResourceFlush) then begin
      HandleResourceFlush(aQueueIndex,aDescriptorIndex,PVirtIOGPUResourceFlush(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_TRANSFER_TO_HOST_2D:begin
     if aReadSize>=SizeOf(TVirtIOGPUTransferToHost2D) then begin
      HandleTransferToHost2D(aQueueIndex,aDescriptorIndex,PVirtIOGPUTransferToHost2D(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_RESOURCE_ATTACH_BACKING:begin
     HandleResourceAttachBacking(aQueueIndex,aDescriptorIndex,aReadSize);
    end;
    VIRTIO_GPU_CMD_RESOURCE_DETACH_BACKING:begin
     if aReadSize>=SizeOf(TVirtIOGPUResourceDetachBacking) then begin
      HandleResourceDetachBacking(aQueueIndex,aDescriptorIndex,PVirtIOGPUResourceDetachBacking(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_GET_EDID:begin
     if aReadSize>=SizeOf(TVirtIOGPUGetEDID) then begin
      HandleGetEDID(aQueueIndex,aDescriptorIndex,PVirtIOGPUGetEDID(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_GET_CAPSET_INFO,
    VIRTIO_GPU_CMD_GET_CAPSET:begin
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
     if Header.CtrlType=VIRTIO_GPU_CMD_GET_CAPSET_INFO then begin
      HandleGetCapsetInfo(aQueueIndex,aDescriptorIndex,@Header);
     end else begin
      HandleGetCapset(aQueueIndex,aDescriptorIndex,@Header);
     end;
{$else}
     SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_UNSPEC);
{$endif}
    end;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
    VIRTIO_GPU_CMD_CTX_CREATE:begin
     if aReadSize>=SizeOf(TVirtIOGPUContextCreate) then begin
      HandleContextCreate(aQueueIndex,aDescriptorIndex,PVirtIOGPUContextCreate(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_CTX_DESTROY:begin
     HandleContextDestroy(aQueueIndex,aDescriptorIndex,@Header);
    end;
    VIRTIO_GPU_CMD_CTX_ATTACH_RESOURCE:begin
     HandleContextAttachResource(aQueueIndex,aDescriptorIndex,@Header);
    end;
    VIRTIO_GPU_CMD_CTX_DETACH_RESOURCE:begin
     HandleContextDetachResource(aQueueIndex,aDescriptorIndex,@Header);
    end;
    VIRTIO_GPU_CMD_RESOURCE_CREATE_3D:begin
     if aReadSize>=SizeOf(TVirtIOGPUResourceCreate3D) then begin
      HandleResourceCreate3D(aQueueIndex,aDescriptorIndex,PVirtIOGPUResourceCreate3D(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_TRANSFER_TO_HOST_3D:begin
     HandleTransferToHost3D(aQueueIndex,aDescriptorIndex,@Header);
    end;
    VIRTIO_GPU_CMD_TRANSFER_FROM_HOST_3D:begin
     HandleTransferFromHost3D(aQueueIndex,aDescriptorIndex,@Header);
    end;
    VIRTIO_GPU_CMD_SUBMIT_3D:begin
     HandleSubmit3D(aQueueIndex,aDescriptorIndex,@Header);
    end;
    VIRTIO_GPU_CMD_RESOURCE_CREATE_BLOB:begin
     if aReadSize>=SizeOf(TVirtIOGPUResourceCreateBlob) then begin
      HandleResourceCreateBlob(aQueueIndex,aDescriptorIndex,PVirtIOGPUResourceCreateBlob(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_RESOURCE_MAP_BLOB:begin
     if aReadSize>=SizeOf(TVirtIOGPUResourceMapBlob) then begin
      HandleResourceMapBlob(aQueueIndex,aDescriptorIndex,PVirtIOGPUResourceMapBlob(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_RESOURCE_UNMAP_BLOB:begin
     if aReadSize>=SizeOf(TVirtIOGPUResourceUnmapBlob) then begin
      HandleResourceUnmapBlob(aQueueIndex,aDescriptorIndex,PVirtIOGPUResourceUnmapBlob(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_SET_SCANOUT_BLOB:begin
     if aReadSize>=SizeOf(TVirtIOGPUSetScanoutBlob) then begin
      HandleSetScanoutBlob(aQueueIndex,aDescriptorIndex,PVirtIOGPUSetScanoutBlob(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
    VIRTIO_GPU_CMD_RESOURCE_ASSIGN_UUID:begin
     if aReadSize>=SizeOf(TVirtIOGPUResourceUnref) then begin
      HandleResourceAssignUUID(aQueueIndex,aDescriptorIndex,PVirtIOGPUResourceUnref(@fRecvBuffer[0]));
     end else begin
      SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
     end;
    end;
{$endif}
    else begin
     SendError(aQueueIndex,aDescriptorIndex,@Header,VIRTIO_GPU_RESP_ERR_UNSPEC);
    end;
   end;
  end;
  VIRTIO_GPU_VQ_CURSOR:begin
   case Header.CtrlType of
    VIRTIO_GPU_CMD_UPDATE_CURSOR:begin
     if aReadSize>=SizeOf(TVirtIOGPUUpdateCursor) then begin
      HandleUpdateCursor(aQueueIndex,aDescriptorIndex,PVirtIOGPUUpdateCursor(@fRecvBuffer[0]));
     end else begin
      // Cursor queue has no write descriptors, just consume
      if not (ConsumeDescriptor(aQueueIndex,aDescriptorIndex,0) and
              UsedRingSync(aQueueIndex)) then begin
       NotifyDeviceNeedsReset;
      end;
     end;
    end;
    VIRTIO_GPU_CMD_MOVE_CURSOR:begin
     if aReadSize>=SizeOf(TVirtIOGPUUpdateCursor) then begin
      HandleMoveCursor(aQueueIndex,aDescriptorIndex,PVirtIOGPUUpdateCursor(@fRecvBuffer[0]));
     end else begin
      // Cursor queue has no write descriptors, just consume
      if not (ConsumeDescriptor(aQueueIndex,aDescriptorIndex,0) and
              UsedRingSync(aQueueIndex)) then begin
       NotifyDeviceNeedsReset;
      end;
     end;
    end;
    else begin
     // Unknown cursor command, just consume without response
     if not (ConsumeDescriptor(aQueueIndex,aDescriptorIndex,0) and
             UsedRingSync(aQueueIndex)) then begin
      NotifyDeviceNeedsReset;
     end;
    end;
   end;
  end;
  else begin
   NotifyDeviceNeedsReset;
  end;
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.LoadSnapshot(const aNode:TSnapshot.TNode);
var ScanoutNode,ArrayNode,GPUCfgNode:TSnapshot.TNode;
    ScanoutIndex:TPasRISCVInt32;
    Scanout:PGPUScanout;
begin
 inherited LoadSnapshot(aNode);

 // GPU configuration
 GPUCfgNode:=aNode.FindNode('GPUConfig');
 if Assigned(GPUCfgNode) then begin
  fGPUConfig.EventsRead:=GPUCfgNode.GetUInt32('EventsRead',fGPUConfig.EventsRead);
  fGPUConfig.EventsClear:=GPUCfgNode.GetUInt32('EventsClear',fGPUConfig.EventsClear);
  fGPUConfig.NumScanouts:=GPUCfgNode.GetUInt32('NumScanouts',fGPUConfig.NumScanouts);
  fGPUConfig.NumCapsets:=GPUCfgNode.GetUInt32('NumCapsets',fGPUConfig.NumCapsets);
 end;

 // Scanout state
 ArrayNode:=aNode.FindNode('Scanouts');
 if Assigned(ArrayNode) then begin
  for ScanoutIndex:=0 to VIRTIO_GPU_MAX_SCANOUTS-1 do begin
   Scanout:=@fScanouts[ScanoutIndex];
   ScanoutNode:=ArrayNode.FindNode(TPasRISCVRawByteString(IntToStr(ScanoutIndex)));
   if Assigned(ScanoutNode) then begin
    Scanout^.ResourceID:=ScanoutNode.GetUInt32('ResourceID',Scanout^.ResourceID);
    Scanout^.Rect.X:=ScanoutNode.GetUInt32('RectX',Scanout^.Rect.X);
    Scanout^.Rect.Y:=ScanoutNode.GetUInt32('RectY',Scanout^.Rect.Y);
    Scanout^.Rect.Width:=ScanoutNode.GetUInt32('RectWidth',Scanout^.Rect.Width);
    Scanout^.Rect.Height:=ScanoutNode.GetUInt32('RectHeight',Scanout^.Rect.Height);
    Scanout^.Enabled:=ScanoutNode.GetBool('Enabled',Scanout^.Enabled);
   end;
  end;
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.SaveSnapshot(const aNode:TSnapshot.TNode);
var ScanoutNode,ArrayNode,GPUCfgNode:TSnapshot.TNode;
    ScanoutIndex:TPasRISCVInt32;
    Scanout:PGPUScanout;
begin
 inherited SaveSnapshot(aNode);

 // GPU configuration
 GPUCfgNode:=aNode.AddObject('GPUConfig');
 GPUCfgNode.SetUInt32('EventsRead',fGPUConfig.EventsRead);
 GPUCfgNode.SetUInt32('EventsClear',fGPUConfig.EventsClear);
 GPUCfgNode.SetUInt32('NumScanouts',fGPUConfig.NumScanouts);
 GPUCfgNode.SetUInt32('NumCapsets',fGPUConfig.NumCapsets);

 // Scanout state
 ArrayNode:=aNode.AddObject('Scanouts');
 for ScanoutIndex:=0 to VIRTIO_GPU_MAX_SCANOUTS-1 do begin
  Scanout:=@fScanouts[ScanoutIndex];
  ScanoutNode:=ArrayNode.AddObject(TPasRISCVRawByteString(IntToStr(ScanoutIndex)));
  ScanoutNode.SetUInt32('ResourceID',Scanout^.ResourceID);
  ScanoutNode.SetUInt32('RectX',Scanout^.Rect.X);
  ScanoutNode.SetUInt32('RectY',Scanout^.Rect.Y);
  ScanoutNode.SetUInt32('RectWidth',Scanout^.Rect.Width);
  ScanoutNode.SetUInt32('RectHeight',Scanout^.Rect.Height);
  ScanoutNode.SetBool('Enabled',Scanout^.Enabled);
 end;
end;

