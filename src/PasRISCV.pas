 aQuotient:=0;
 aRemainder:=0;
 Highest:=SoftFloatHighestBit128(aDividend);
 if Highest<0 then begin
  exit;
 end;
 for Index:=Highest downto 0 do begin
  aRemainder:=(aRemainder shl 1) or SoftFloatBits128GetBit(aDividend,Index);
  if aRemainder>=aDivisor then begin
   aRemainder:=aRemainder-aDivisor;
   if Index<64 then begin
    aQuotient:=aQuotient or (TPasRISCVUInt64(1) shl Index);
   end;
  end;
 end;
end;

