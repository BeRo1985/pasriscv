constructor TPasRISCV.TVirtIOVSockDevice.TVSockManager.Create(const aDevice:TVirtIOVSockDevice);
var PortMapItem:TPortMapItem;
begin
 inherited Create;

 fDevice:=aDevice;

 PortMapItem.ConnectionClass:=nil;
 PortMapItem.Tag:=nil;
 fPortMap:=TPortMap.Create(PortMapItem);

 fConnections:=nil;
 fCountConnections:=0;

 fConnectionMap:=TConnectionMap.Create(nil);

 fLock:=TPasMPCriticalSection.Create;

end;

destructor TPasRISCV.TVirtIOVSockDevice.TVSockManager.Destroy;
begin
 InternalDestroyAll(false);
 fConnections:=nil;
 FreeAndNil(fConnectionMap);
 FreeAndNil(fPortMap);
 FreeAndNil(fLock);
 inherited Destroy;
end;

procedure TPasRISCV.TVirtIOVSockDevice.TVSockManager.InternalDestroyConnection(const aConnection:TConnection;const aNotify:Boolean);
var Index:TPasRISCVSizeInt;
    ConnectionKey:TManagerConnectionKey;
    OtherConnection:TConnection;
    WasRemoved:Boolean;
begin

 WasRemoved:=false;

 // Acquire the lock before modifying shared connection data structures
 fLock.Acquire;
 try

  if aConnection.fIndex>=0 then begin

   // Remove from the array using the swap-with-last technique (O(1) removal)
   Index:=aConnection.fIndex;
   if (Index+1)<fCountConnections then begin
    OtherConnection:=fConnections[fCountConnections-1];
    fConnections[Index]:=OtherConnection;
    fConnections[fCountConnections-1]:=nil;
    OtherConnection.fIndex:=Index;
   end else begin
    // Connection is the last element, just clear the slot
    fConnections[Index]:=nil;
   end;
   dec(fCountConnections);
   aConnection.fIndex:=-1;

   // Build the map key from the connection's port pair and remove from the hash map
   ConnectionKey.LocalPort:=aConnection.fLocalPort;
   ConnectionKey.RemotePort:=aConnection.fRemotePort;
   fConnectionMap.Delete(ConnectionKey);

   WasRemoved:=true;

  end;

 finally
  fLock.Release;
 end;

 // Outside the lock: notify the caller and free the connection object
 if WasRemoved then begin
  if aNotify then begin
   aConnection.OnDisconnect;
  end;
  aConnection.Free;
 end;

end;

procedure TPasRISCV.TVirtIOVSockDevice.TVSockManager.InternalDestroyAll(const aNotify:Boolean);
var Index:TPasRISCVSizeInt;
    ConnectionSnapshot:TConnections;
    SnapshotCount:TPasRISCVSizeInt;
begin

 ConnectionSnapshot:=nil;

 fLock.Acquire;
 try

  SnapshotCount:=fCountConnections;

  // Take a snapshot of all connection pointers while holding the lock
  SetLength(ConnectionSnapshot,SnapshotCount);

  for Index:=0 to SnapshotCount-1 do begin
   ConnectionSnapshot[Index]:=fConnections[Index];
   // Clear the slot in the live array so no one else picks it up
   fConnections[Index]:=nil;
  end;

  fCountConnections:=0;

  fConnectionMap.Clear;

 finally
  fLock.Release;
 end;

 // Process the snapshot outside the lock: mark, notify, and free each connection
 for Index:=0 to SnapshotCount-1 do begin

  if assigned(ConnectionSnapshot[Index]) then begin

   // Mark as removed from the manager
   ConnectionSnapshot[Index].fIndex:=-1;

   // Notify the caller if requested (e.g., trigger disconnect callbacks)
   if aNotify then begin
    ConnectionSnapshot[Index].OnDisconnect;
   end;

   // Deallocate the connection object
   ConnectionSnapshot[Index].Free;

  end;

 end;

end;

procedure TPasRISCV.TVirtIOVSockDevice.TVSockManager.RegisterPort(const aPort:TPasRISCVUInt32;const aClass:TConnectionClass;const aTag:Pointer);
var PortMapItem:TPortMapItem;
begin
 fLock.Acquire;
 try
  PortMapItem.ConnectionClass:=aClass;
  PortMapItem.Tag:=aTag;
  fPortMap.SetValue(aPort,PortMapItem);
 finally
  fLock.Release;
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.TVSockManager.UnregisterPort(const aPort:TPasRISCVUInt32);
begin
 fLock.Acquire;
 try
  fPortMap.Delete(aPort);
 finally
  fLock.Release;
 end;
end;

function TPasRISCV.TVirtIOVSockDevice.TVSockManager.Connect(const aLocalPort,aRemotePort:TPasRISCVUInt32;const aClass:TConnectionClass;const aTag:Pointer;const aSocketType:TPasRISCVUInt16):TConnection;
var ConnectionKey:TManagerConnectionKey;
    Connection:TConnection;
begin

 result:=nil;

 // Build the lookup key from the local and remote port pair
 ConnectionKey.LocalPort:=aLocalPort;
 ConnectionKey.RemotePort:=aRemotePort;

 fLock.Acquire;
 try

  // Check if a connection with this exact port pair already exists in the map.
  // If it does, we return the existing connection (result stays nil here,
  // but the caller handles the "already connected" case).
  if not fConnectionMap.TryGet(ConnectionKey,Connection) then begin

   // No existing connection — create a new one using the provided class factory.
   // Pass the manager reference, both ports, the guest CID, and the socket type.
   Connection:=aClass.Create(self,aTag,aLocalPort,aRemotePort,fDevice.fGuestCID,aSocketType);

   // Ensure the internal array has room for the new connection.
   // If the array is full, grow it by 50% (capacity + capacity/2) to amortize
   // reallocation cost over future inserts.
   if length(fConnections)<=fCountConnections then begin
    SetLength(fConnections,(fCountConnections+1)+((fCountConnections+1) shr 1));
   end;

   // Place the new connection at the next free slot in the array
   fConnections[fCountConnections]:=Connection;
   Connection.fIndex:=fCountConnections;
   inc(fCountConnections);

   // Register the connection in the hash map for O(1) lookup by port pair
   fConnectionMap.Add(ConnectionKey,Connection);
   result:=Connection;

  end;

 finally
  fLock.Release;
 end;

 // If we created a brand-new connection (not a duplicate), forward the connect
 // request down to the VirtIO vsock device layer so it can establish the
 // transport-level connection with the host or other guests.
 if assigned(result) then begin
  fDevice.Connect(aLocalPort,aRemotePort,aSocketType);
 end;

end;

function TPasRISCV.TVirtIOVSockDevice.TVSockManager.DispatchEvent(var aEventItem:TEventItem):Boolean;
var ConnectionKey:TManagerConnectionKey;
    Connection:TConnection;
    PortMapItem:TPortMapItem;
begin

 // Bail out early if the event item has no associated connection pointer
 if assigned(aEventItem.Connection) then begin

  // Build the lookup key from the event's local/remote port pair
  ConnectionKey.LocalPort:=aEventItem.Connection.fLocalPort;
  ConnectionKey.RemotePort:=aEventItem.Connection.fRemotePort;

  // Dispatch event
  case aEventItem.Kind of

   TEventItem.TEventKind.Connect:begin

   // Incoming connection request from the remote side
    Connection:=nil;

    fLock.Acquire;
    try

     // Check if a connection with this port pair already exists in the active map.
     // If so, an outgoing connection is still pending on the same key — suppress
     // the incoming connect event (don't fire OnConnect) and report success.
     if fConnectionMap.TryGet(ConnectionKey,Connection) then begin

      // Outgoing pending on same key: suppress old callbacks, don't call OnConnect
      result:=true;

      Connection:=nil;

     end else begin

      // No active connection — look up the registered listener class for the local port
      PortMapItem.ConnectionClass:=nil;
      PortMapItem.Tag:=nil;

      if fPortMap.TryGet(ConnectionKey.LocalPort,PortMapItem) and assigned(PortMapItem.ConnectionClass) then begin

       // A listener is registered: instantiate a new connection object using the
       // listener's class factory, passing the remote CID and socket type from the event
       Connection:=PortMapItem.ConnectionClass.Create(self,PortMapItem.Tag,ConnectionKey.LocalPort,ConnectionKey.RemotePort,aEventItem.Connection.fRemoteCID,aEventItem.Connection.fSocketType);

       // Grow the connections array if needed (50% growth factor)
       if length(fConnections)<=fCountConnections then begin
        SetLength(fConnections,(fCountConnections+1)+((fCountConnections+1) shr 1));
       end;

       // Append the new connection to the array and assign its 1-based index
       fConnections[fCountConnections]:=Connection;
       Connection.fIndex:=fCountConnections;
       inc(fCountConnections);

       // Register the connection in the hash map for future O(1) lookups
       fConnectionMap.Add(ConnectionKey,Connection);

       result:=true;

      end else begin
       // No listener registered for this local port — event cannot be dispatched
       result:=false;
      end;

     end;

    finally
     fLock.Release;
    end;

    // Fire the OnConnect callback outside the lock to avoid deadlocks
    if assigned(Connection) then begin
     Connection.OnConnect;
    end;

   end;

   TEventItem.TEventKind.Accept:begin

   // Remote side acknowledged our connect request (accepted or rejected)

    fLock.Acquire;
    try
     // Look up the existing connection by port pair
     if not fConnectionMap.TryGet(ConnectionKey,Connection) then begin
      Connection:=nil;
     end;
     result:=assigned(Connection);
    finally
     fLock.Release;
    end;

    // Notify the connection whether the accept succeeded or failed
    if assigned(Connection) then begin
     Connection.OnAccepted(aEventItem.Accepted);
    end;

   end;

   TEventItem.TEventKind.Receive:begin

    // Incoming data from the remote side

    fLock.Acquire;
    try
     // Look up the existing connection by port pair
     if not fConnectionMap.TryGet(ConnectionKey,Connection) then begin
      Connection:=nil;
     end;
     result:=assigned(Connection);
    finally
     fLock.Release;
    end;

    // Deliver the payload to the connection's receive handler
    if assigned(Connection) then begin
     if length(aEventItem.Payload)>0 then begin
      Connection.OnReceive(@aEventItem.Payload[0],length(aEventItem.Payload),aEventItem.Flags);
     end else begin
      // Zero-length payload (e.g. credit update or flow control only)
      Connection.OnReceive(nil,0,aEventItem.Flags);
     end;
    end;

   end;

   TEventItem.TEventKind.Shutdown:begin

   // Remote side initiated a graceful shutdown (half-close)

    fLock.Acquire;
    try
     // Look up the existing connection by port pair
     if not fConnectionMap.TryGet(ConnectionKey,Connection) then begin
      Connection:=nil;
     end;
     result:=assigned(Connection);
    finally
     fLock.Release;
    end;

    // Notify the connection that the remote side has shut down
    if assigned(Connection) then begin
     Connection.OnShutdown;
    end;

   end;

   TEventItem.TEventKind.Close:begin

   // Remote side closed the connection entirely

    fLock.Acquire;
    try
     // Look up the existing connection by port pair
     if not fConnectionMap.TryGet(ConnectionKey,Connection) then begin
      Connection:=nil;
     end;
     result:=assigned(Connection);
    finally
     fLock.Release;
    end;

    // Destroy the connection: notify it via OnDisconnect, then free the object.
    // This also removes it from the manager's array and hash map.
    if assigned(Connection) then begin
     InternalDestroyConnection(Connection,true);
    end;

   end;

   else begin
    // Unknown event kind, nothing to dispatch
    result:=false;
   end;

  end;

 end else begin

  // No connection pointer in the event item, cannot dispatch
  result:=false;

 end;

end;

procedure TPasRISCV.TVirtIOVSockDevice.TVSockManager.OnDeviceReset;
begin
 InternalDestroyAll(true);
end;

{ TPasRISCV.TVirtIOVSockDevice }

constructor TPasRISCV.TVirtIOVSockDevice.Create(const aMachine:TPasRISCV);
begin

 fConnections:=nil;
 fCountConnections:=0;
 fConnectionMap:=TConnectionHashMap.Create(nil);

 fConnectionMRSWLock:=TPasMPMultipleReaderSingleWriterLock.Create;

{$ifdef PasRISCVVSockParallelThreading}
 fResetMRSWLock:=TPasMPMultipleReaderSingleWriterLock.Create;
{$else}
 fVSockLock:=TPasMPCriticalSection.Create;
{$endif}

 inherited Create(aMachine,aMachine.fConfiguration.fVirtIOVSockBase,aMachine.fConfiguration.fVirtIOVSockSize,TVirtIODevice.TKind.MMIO);

 fIRQ:=aMachine.fConfiguration.fVirtIOVSockIRQ;

 fDeviceID:=VSOCK_DEVICE_ID;

 fDeviceFeatures:=TPasRISCV.TVirtIODevice.VIRTIO_F_VERSION_1 or
                  {$ifdef VirtIOEventIndex}TPasRISCV.TVirtIODevice.VIRTIO_F_EVENT_IDX or{$endif}
                  VIRTIO_VSOCK_F_STREAM or
                  VIRTIO_VSOCK_F_SEQPACKET;

 fQueues[VSOCK_RXQ].ManualRecv:=true;
 fQueues[VSOCK_RXQ].Asynchronous:=false;

 fQueues[VSOCK_TXQ].ManualRecv:=false;
 fQueues[VSOCK_TXQ].Asynchronous:=false;

 fQueues[VSOCK_EVQ].ManualRecv:=true;
 fQueues[VSOCK_EVQ].Asynchronous:=false;

 fGuestCID:=aMachine.fConfiguration.fVirtIOVSockGuestCID;

 // Config space: le64 guest_cid
 FillChar(fConfigSpace[0],8,#0);
 fConfigSpace[0]:=TPasRISCVUInt8(fGuestCID and $ff);
 fConfigSpace[1]:=TPasRISCVUInt8((fGuestCID shr 8) and $ff);
 fConfigSpace[2]:=TPasRISCVUInt8((fGuestCID shr 16) and $ff);
 fConfigSpace[3]:=TPasRISCVUInt8((fGuestCID shr 24) and $ff);
 fConfigSpace[4]:=TPasRISCVUInt8((fGuestCID shr 32) and $ff);
 fConfigSpace[5]:=TPasRISCVUInt8((fGuestCID shr 40) and $ff);
 fConfigSpace[6]:=TPasRISCVUInt8((fGuestCID shr 48) and $ff);
 fConfigSpace[7]:=TPasRISCVUInt8((fGuestCID shr 56) and $ff);
 fConfigSpaceSize:=8;

 fSendBuffer:=nil;
 SetLength(fSendBuffer,VSOCK_MAX_PKT_BUF_SIZE+VSOCK_HDR_SIZE);

 fRecvBuffer:=nil;
 SetLength(fRecvBuffer,VSOCK_MAX_PKT_BUF_SIZE+VSOCK_HDR_SIZE);

 fOnConnect:=nil;
 fOnConnected:=nil;
 fOnShutdown:=nil;
 fOnDisconnect:=nil;
 fOnReceive:=nil;

 fManager:=nil;

{$ifdef PasRISCVVSockParallelThreading}
 fEventQueueThread:=TEventQueueThread.Create(self);
{$else}
 fEventQueue.Initialize;
 fDispatchAfterDrain:=false;
{$endif}

end;

destructor TPasRISCV.TVirtIOVSockDevice.Destroy;
begin
{$ifdef PasRISCVVSockParallelThreading}
 fEventQueueThread.Shutdown;
{$endif}
 FreeAndNil(fManager);
{$ifdef PasRISCVVSockParallelThreading}
 FreeAndNil(fEventQueueThread);
{$endif}
 DestroyAllConnections;
 fConnections:=nil;
 FreeAndNil(fConnectionMap);
 FreeAndNil(fConnectionMRSWLock);
{$ifdef PasRISCVVSockParallelThreading}
 FreeAndNil(fResetMRSWLock);
{$else}
 fEventQueue.Finalize;
 FreeAndNil(fVSockLock);
{$endif}
 fSendBuffer:=nil;
 fRecvBuffer:=nil;
 inherited Destroy;
end;

procedure TPasRISCV.TVirtIOVSockDevice.DeviceReset;
begin
{$ifdef PasRISCVVSockParallelThreading}
 TPasMPMultipleReaderSingleWriterSpinLock.AcquireWrite(fEventQueueThread.fLock);
 try

  TPasMPInterlocked.Increment(fEventQueueThread.fGeneration);

  fResetMRSWLock.AcquireWrite;
  try

   fEventQueueThread.fConditionVariableLock.Acquire;
   try

    fEventQueueThread.FlushQueue(false);

{$else}
    FlushEventQueue;
{$endif}

    DestroyAllConnections;

    if assigned(fManager) then begin
     fManager.OnDeviceReset;
    end;

    inherited DeviceReset;

{$ifdef PasRISCVVSockParallelThreading}
    TPasMPInterlocked.Increment(fEventQueueThread.fGeneration);

   finally
    fEventQueueThread.fConditionVariableLock.Release;
   end;

  finally
   fResetMRSWLock.ReleaseWrite;
  end;

 finally
  TPasMPMultipleReaderSingleWriterSpinLock.ReleaseWrite(fEventQueueThread.fLock);
 end;
{$endif}
end;

function TPasRISCV.TVirtIOVSockDevice.FindConnection(const aLocalPort:TPasRISCVUInt32;const aRemoteCID:TPasRISCVUInt64;const aRemotePort:TPasRISCVUInt32{$ifdef PasRISCVVSockParallelThreading};const aLock:Boolean;const aGeneration:TPasRISCVUInt64{$endif}):TPasRISCV.TVirtIOVSockDevice.TVSockConnection;
var Key:TVSockConnectionKey;
begin
{$ifdef PasRISCVVSockParallelThreading}
 if ((aGeneration or fEventQueueThread.fGeneration) and 1)=0 then begin
{$endif}
  Key.LocalPort:=aLocalPort;
  Key.RemotePort:=aRemotePort;
  Key.RemoteCID:=aRemoteCID;
{$ifdef PasRISCVVSockParallelThreading}
  fConnectionMRSWLock.AcquireRead;
  try
{$endif}
   if not fConnectionMap.TryGet(Key,result) then begin
    result:=nil;
   end else begin
{$ifdef PasRISCVVSockParallelThreading}
    result.AddRef;
    if aLock then begin
     result.fLock.Acquire;
    end;
{$endif}
   end;
{$ifdef PasRISCVVSockParallelThreading}
  finally
   fConnectionMRSWLock.ReleaseRead;
  end;
 end else begin
  result:=nil;
 end;
{$endif}
end;

function TPasRISCV.TVirtIOVSockDevice.CreateConnection(const aLocalPort:TPasRISCVUInt32;const aRemoteCID:TPasRISCVUInt64;const aRemotePort:TPasRISCVUInt32;const aSocketType:TPasRISCVUInt16;{$ifdef PasRISCVVSockParallelThreading}const aLock:Boolean;const aGeneration:TPasRISCVUInt64;{$endif}out aCreated:Boolean):TPasRISCV.TVirtIOVSockDevice.TVSockConnection;
var Key:TVSockConnectionKey;
begin

{$ifdef PasRISCVVSockParallelThreading}
 if ((aGeneration or fEventQueueThread.fGeneration) and 1)=0 then begin

  fConnectionMRSWLock.AcquireWrite;
  try

{$endif}
   Key.LocalPort:=aLocalPort;
   Key.RemotePort:=aRemotePort;
   Key.RemoteCID:=aRemoteCID;

   if fConnectionMap.TryGet(Key,result) then begin

    aCreated:=false;
{$ifdef PasRISCVVSockParallelThreading}
    result.AddRef;
    if aLock then begin
     result.fLock.Acquire;
    end;
{$endif}

   end else if fCountConnections<VSOCK_MAX_CONNECTIONS then begin

    aCreated:=true;

    result:=TVSockConnection.Create;
    result.fIndex:=-1;
    result.fLocalPort:=aLocalPort;
    result.fRemoteCID:=aRemoteCID;
    result.fRemotePort:=aRemotePort;
    result.fState:=TVSockConnectionState.Closed;
    result.fSocketType:=aSocketType;
    result.fBufAlloc:=VSOCK_DEFAULT_BUF_ALLOC;
    result.fFwdCnt:=0;
    result.fTxCnt:=0;
    result.fPeerBufAlloc:=0;
    result.fPeerFwdCnt:=0;
    result.fTxPendingData:=nil;
    result.fTxPendingOffset:=0;
    result.fTxPendingSize:=0;
    result.fShutdownFlags:=0;
    result.fPeerShutdownFlags:=0;
    result.fLastFwdCntReported:=0;

    if length(fConnections)<=fCountConnections then begin
     SetLength(fConnections,(fCountConnections+1)+((fCountConnections+1) shr 1));
    end;
    fConnections[fCountConnections]:=result;
    result.fIndex:=fCountConnections;
    inc(fCountConnections);

    fConnectionMap.Add(Key,result);

{$ifdef PasRISCVVSockParallelThreading}
    // The initial reference is owned by the table; return an extra caller reference.
    result.AddRef;
    if aLock then begin
     result.fLock.Acquire;
    end;
{$endif}

   end else begin

    aCreated:=false;

    result:=nil;

   end;

{$ifdef PasRISCVVSockParallelThreading}

  finally
   fConnectionMRSWLock.ReleaseWrite;
  end;

 end else begin

  aCreated:=false;

  result:=nil;

 end;
{$endif}

end;

procedure TPasRISCV.TVirtIOVSockDevice.DestroyConnection(const aConnection:TVSockConnection);
var Index:TPasRISCVSizeInt;
    Key:TVSockConnectionKey;
    OtherConnection:TVSockConnection;
{$ifdef PasRISCVVSockParallelThreading}
    Removed:Boolean;
{$endif}
begin

 if assigned(aConnection) then begin

{$ifdef PasRISCVVSockParallelThreading}
  Removed:=false;
  try

   fConnectionMRSWLock.AcquireWrite;
   try
{$endif}

    if aConnection.fIndex>=0 then begin

     Index:=aConnection.fIndex;
     if (Index+1)<fCountConnections then begin
      OtherConnection:=fConnections[fCountConnections-1];
      fConnections[Index]:=OtherConnection;
      fConnections[fCountConnections-1]:=nil;
      OtherConnection.fIndex:=Index;
     end else begin
      fConnections[Index]:=nil;
     end;
     dec(fCountConnections);
     aConnection.fIndex:=-1;

     Key.LocalPort:=aConnection.fLocalPort;
     Key.RemotePort:=aConnection.fRemotePort;
     Key.RemoteCID:=aConnection.fRemoteCID;
     fConnectionMap.Delete(Key);

{$ifdef PasRISCVVSockParallelThreading}
     Removed:=true;
{$else}
     aConnection.Free;
{$endif}

    end;

{$ifdef PasRISCVVSockParallelThreading}
   finally
    fConnectionMRSWLock.ReleaseWrite;
   end;

  finally

   if Removed then begin
    aConnection.DecRef;
   end;

  end;
{$endif}

 end;

end;

procedure TPasRISCV.TVirtIOVSockDevice.DestroyAllConnections;
var Index:TPasRISCVSizeInt;
    Connection:TVSockConnection;
begin
{$ifdef PasRISCVVSockParallelThreading}
 fConnectionMRSWLock.AcquireWrite;
 try
{$endif}
  for Index:=0 to fCountConnections-1 do begin
   Connection:=fConnections[Index];
   fConnections[Index]:=nil;
   if assigned(Connection) then begin
    Connection.fIndex:=-1;
{$ifdef PasRISCVVSockParallelThreading}
    Connection.DecRef;
{$else}
    FreeAndNil(Connection);
{$endif}
   end;
  end;
  fCountConnections:=0;
  fConnectionMap.Clear;
{$ifdef PasRISCVVSockParallelThreading}
 finally
  fConnectionMRSWLock.ReleaseWrite;
 end;
{$endif}
end;

procedure TPasRISCV.TVirtIOVSockDevice.SendControlPacket(const aConnection:TVSockConnection;const aOp:TPasRISCVUInt16;const aFlags:TPasRISCVUInt32=0);
var Header:TVSockHeader;
begin
 FillChar(Header,SizeOf(TVSockHeader),#0);
 Header.SrcCID:=VSOCK_CID_HOST;
 Header.DstCID:=fGuestCID;
 Header.SrcPort:=aConnection.fLocalPort;
 Header.DstPort:=aConnection.fRemotePort;
 Header.Len:=0;
 Header.SocketType:=aConnection.fSocketType;
 Header.Op:=aOp;
 Header.Flags:=aFlags;
 Header.BufAlloc:=aConnection.fBufAlloc;
 Header.FwdCnt:=aConnection.fFwdCnt;
{$ifdef PasRISCVDebugVirtIOVSock}
 writeln('VSock SendControl op=',aOp,' lp=',aConnection.fLocalPort,' rp=',aConnection.fRemotePort,' tx=',aConnection.fTxCnt,' peer_buf=',aConnection.fPeerBufAlloc,' peer_fwd=',aConnection.fPeerFwdCnt,' pending=',aConnection.fTxPendingSize);
{$endif}
 WriteRxPacket(Header,nil,0);
end;

function TPasRISCV.TVirtIOVSockDevice.WriteRxPacket(const aHeader:TVSockHeader;const aData:Pointer;const aSize:TPasRISCVUInt32):Boolean;
var Queue:PQueue;
    AvailableIndex,DescriptorIndex:TPasRISCVUInt16;
    ReadSize,WriteSize:TPasRISCVUInt64;
    TotalSize:TPasRISCVSizeInt;
begin
 result:=false;
 Queue:=@fQueues[VSOCK_RXQ];
 if fDriverOK and Queue^.Ready then begin
  TPasMPMultipleReaderSingleWriterSpinLock.AcquireWrite(Queue^.Lock);
  try
   if Read16(Queue^.AvailableAddress+2,AvailableIndex) then begin
    if Queue^.ShadowAvailableIndex<>AvailableIndex then begin
     if Read16(Queue^.AvailableAddress+4+((Queue^.ShadowAvailableIndex and (Queue^.Size-1)) shl 1),DescriptorIndex) then begin
      if GetDescriptors(ReadSize,WriteSize,VSOCK_RXQ,DescriptorIndex) then begin
       TotalSize:=VSOCK_HDR_SIZE+TPasRISCVSizeInt(aSize);
       if TotalSize<=WriteSize then begin
        if length(fSendBuffer)<TotalSize then begin
         SetLength(fSendBuffer,TotalSize+((TotalSize+1) shr 1));
        end;
        Move(aHeader,fSendBuffer[0],VSOCK_HDR_SIZE);
        if (aSize>0) and assigned(aData) then begin
         Move(aData^,fSendBuffer[VSOCK_HDR_SIZE],aSize);
        end;
        if CopyMemoryToQueue(VSOCK_RXQ,DescriptorIndex,0,@fSendBuffer[0],TotalSize) and
           ConsumeDescriptor(VSOCK_RXQ,DescriptorIndex,TotalSize) and
           UsedRingSync(VSOCK_RXQ) and
           AdvanceShadowAvailableIndex(VSOCK_RXQ) then begin
         result:=true;
{$ifdef PasRISCVDebugVirtIOVSock}
         if (aHeader.Len>0) or (aHeader.Op<>VIRTIO_VSOCK_OP_RW) then begin
          writeln('VSock WriteRxPacket ok op=',aHeader.Op,' len=',aHeader.Len,' total=',TotalSize,' desc=',DescriptorIndex,' writeSize=',WriteSize,' shadow=',Queue^.ShadowAvailableIndex,' avail=',AvailableIndex);
         end;
{$endif}
         end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
         writeln('VSock WriteRxPacket copy/consume failed op=',aHeader.Op,' len=',aHeader.Len,' total=',TotalSize,' desc=',DescriptorIndex,' writeSize=',WriteSize);
{$endif}
         NotifyDeviceNeedsReset;
        end;
       end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
        writeln('VSock WriteRxPacket desc too small op=',aHeader.Op,' len=',aHeader.Len,' total=',TotalSize,' desc=',DescriptorIndex,' writeSize=',WriteSize);
{$endif}
       end;
      end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
       writeln('VSock WriteRxPacket GetDescriptors failed op=',aHeader.Op,' len=',aHeader.Len,' desc=',DescriptorIndex);
{$endif}
       NotifyDeviceNeedsReset;
      end;
     end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
      writeln('VSock WriteRxPacket read desc index failed op=',aHeader.Op,' len=',aHeader.Len,' shadow=',Queue^.ShadowAvailableIndex,' avail=',AvailableIndex);
{$endif}
      NotifyDeviceNeedsReset;
     end;
    end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
     writeln('VSock WriteRxPacket no rx descriptor op=',aHeader.Op,' len=',aHeader.Len,' shadow=',Queue^.ShadowAvailableIndex,' avail=',AvailableIndex);
{$endif}
    end;
   end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
    writeln('VSock WriteRxPacket read avail failed op=',aHeader.Op,' len=',aHeader.Len);
{$endif}
    NotifyDeviceNeedsReset;
   end;
  finally
   TPasMPMultipleReaderSingleWriterSpinLock.ReleaseWrite(Queue^.Lock);
  end;
 end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
  writeln('VSock WriteRxPacket no driver/queue ready op=',aHeader.Op,' len=',aSize,' driverOK=',TPasRISCVInt32(fDriverOK),' ready=',TPasRISCVInt32(Queue^.Ready));
{$endif}
 end;
end;

function TPasRISCV.TVirtIOVSockDevice.WriteRxDataPacket(const aHeader:TVSockHeader;const aData:Pointer;const aSize:TPasRISCVUInt32;out aActualSize:TPasRISCVUInt32):Boolean;
var Queue:PQueue;
    Header:TVSockHeader;
    AvailableIndex,DescriptorIndex:TPasRISCVUInt16;
    ReadSize,WriteSize:TPasRISCVUInt64;
    TotalSize:TPasRISCVSizeInt;
    MaxDataSize:TPasRISCVUInt32;
begin
 result:=false;
 aActualSize:=0;
 Queue:=@fQueues[VSOCK_RXQ];
 if fDriverOK and Queue^.Ready then begin
  TPasMPMultipleReaderSingleWriterSpinLock.AcquireWrite(Queue^.Lock);
  try
   if Read16(Queue^.AvailableAddress+2,AvailableIndex) then begin
    if Queue^.ShadowAvailableIndex<>AvailableIndex then begin
     if Read16(Queue^.AvailableAddress+4+((Queue^.ShadowAvailableIndex and (Queue^.Size-1)) shl 1),DescriptorIndex) then begin
      if GetDescriptors(ReadSize,WriteSize,VSOCK_RXQ,DescriptorIndex) then begin
       if WriteSize>VSOCK_HDR_SIZE then begin
        if (WriteSize-VSOCK_HDR_SIZE)>TPasRISCVUInt64(High(TPasRISCVUInt32)) then begin
         MaxDataSize:=High(TPasRISCVUInt32);
        end else begin
         MaxDataSize:=TPasRISCVUInt32(WriteSize-VSOCK_HDR_SIZE);
        end;
        if MaxDataSize>aSize then begin
         MaxDataSize:=aSize;
        end;
        if MaxDataSize>0 then begin
         Header:=aHeader;
         Header.Len:=MaxDataSize;
         TotalSize:=VSOCK_HDR_SIZE+TPasRISCVSizeInt(MaxDataSize);
         if length(fSendBuffer)<TotalSize then begin
          SetLength(fSendBuffer,TotalSize+((TotalSize+1) shr 1));
         end;
         Move(Header,fSendBuffer[0],VSOCK_HDR_SIZE);
         if assigned(aData) then begin
          Move(aData^,fSendBuffer[VSOCK_HDR_SIZE],MaxDataSize);
         end;
         if CopyMemoryToQueue(VSOCK_RXQ,DescriptorIndex,0,@fSendBuffer[0],TotalSize) and
            ConsumeDescriptor(VSOCK_RXQ,DescriptorIndex,TotalSize) and
            UsedRingSync(VSOCK_RXQ) and
            AdvanceShadowAvailableIndex(VSOCK_RXQ) then begin
          aActualSize:=MaxDataSize;
          result:=true;
{$ifdef PasRISCVDebugVirtIOVSock}
          writeln('VSock WriteRxDataPacket ok op=',Header.Op,' requested=',aSize,' actual=',aActualSize,' total=',TotalSize,' desc=',DescriptorIndex,' writeSize=',WriteSize,' shadow=',Queue^.ShadowAvailableIndex,' avail=',AvailableIndex);
{$endif}
         end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
          writeln('VSock WriteRxDataPacket copy/consume failed op=',Header.Op,' requested=',aSize,' actual=',MaxDataSize,' total=',TotalSize,' desc=',DescriptorIndex,' writeSize=',WriteSize);
{$endif}
          NotifyDeviceNeedsReset;
         end;
        end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
         writeln('VSock WriteRxDataPacket no data capacity op=',aHeader.Op,' requested=',aSize,' desc=',DescriptorIndex,' writeSize=',WriteSize);
{$endif}
        end;
       end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
        writeln('VSock WriteRxDataPacket desc header too small op=',aHeader.Op,' requested=',aSize,' desc=',DescriptorIndex,' writeSize=',WriteSize);
{$endif}
       end;
      end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
       writeln('VSock WriteRxDataPacket GetDescriptors failed op=',aHeader.Op,' requested=',aSize,' desc=',DescriptorIndex);
{$endif}
       NotifyDeviceNeedsReset;
      end;
     end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
      writeln('VSock WriteRxDataPacket read desc index failed op=',aHeader.Op,' requested=',aSize,' shadow=',Queue^.ShadowAvailableIndex,' avail=',AvailableIndex);
{$endif}
      NotifyDeviceNeedsReset;
     end;
    end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
     writeln('VSock WriteRxDataPacket no rx descriptor op=',aHeader.Op,' requested=',aSize,' shadow=',Queue^.ShadowAvailableIndex,' avail=',AvailableIndex);
{$endif}
    end;
   end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
    writeln('VSock WriteRxDataPacket read avail failed op=',aHeader.Op,' requested=',aSize);
{$endif}
    NotifyDeviceNeedsReset;
   end;
  finally
   TPasMPMultipleReaderSingleWriterSpinLock.ReleaseWrite(Queue^.Lock);
  end;
 end else begin
{$ifdef PasRISCVDebugVirtIOVSock}
  writeln('VSock WriteRxDataPacket no driver/queue ready op=',aHeader.Op,' requested=',aSize,' driverOK=',TPasRISCVInt32(fDriverOK),' ready=',TPasRISCVInt32(Queue^.Ready));
{$endif}
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.AppendTxPendingData(const aConnection:TVSockConnection;const aData:Pointer;const aSize:TPasRISCVUInt32);
var OldSize,NewSize:TPasRISCVSizeInt;
begin
 if (aSize>0) and assigned(aData) then begin
  if aConnection.fTxPendingSize=0 then begin
   aConnection.fTxPendingOffset:=0;
  end else if aConnection.fTxPendingOffset>0 then begin
   Move(aConnection.fTxPendingData[aConnection.fTxPendingOffset],aConnection.fTxPendingData[0],aConnection.fTxPendingSize);
   aConnection.fTxPendingOffset:=0;
  end;
  OldSize:=aConnection.fTxPendingSize;
  NewSize:=OldSize+TPasRISCVSizeInt(aSize);
  if length(aConnection.fTxPendingData)<NewSize then begin
   SetLength(aConnection.fTxPendingData,NewSize+((NewSize+1) shr 1));
  end;
  Move(aData^,aConnection.fTxPendingData[OldSize],aSize);
  aConnection.fTxPendingSize:=NewSize;
{$ifdef PasRISCVDebugVirtIOVSock}
  writeln('VSock AppendTxPending lp=',aConnection.fLocalPort,' rp=',aConnection.fRemotePort,' added=',aSize,' old=',OldSize,' new=',NewSize,' tx=',aConnection.fTxCnt,' peer_buf=',aConnection.fPeerBufAlloc,' peer_fwd=',aConnection.fPeerFwdCnt);
{$endif}
 end;
end;

function TPasRISCV.TVirtIOVSockDevice.FlushTxPendingData(const aConnection:TVSockConnection):Boolean;
var Header:TVSockHeader;
    ChunkSize,ActualSize:TPasRISCVUInt32;
    PeerFree:TPasRISCVInt64;
begin

 result:=aConnection.fTxPendingSize=0;

{$ifdef PasRISCVDebugVirtIOVSock}
 if aConnection.fTxPendingSize>0 then begin
  writeln('VSock FlushTxPending start lp=',aConnection.fLocalPort,' rp=',aConnection.fRemotePort,' pending=',aConnection.fTxPendingSize,' off=',aConnection.fTxPendingOffset,' tx=',aConnection.fTxCnt,' peer_buf=',aConnection.fPeerBufAlloc,' peer_fwd=',aConnection.fPeerFwdCnt);
 end;
{$endif}

 while (aConnection.fTxPendingSize>0) and (aConnection.fState=TVSockConnectionState.Connected) do begin

  PeerFree:=TPasRISCVInt64(aConnection.fPeerBufAlloc)-TPasRISCVInt64(aConnection.fTxCnt-aConnection.fPeerFwdCnt);
  if PeerFree<=0 then begin
{$ifdef PasRISCVDebugVirtIOVSock}
   writeln('VSock FlushTxPending blocked lp=',aConnection.fLocalPort,' rp=',aConnection.fRemotePort,' pending=',aConnection.fTxPendingSize,' tx=',aConnection.fTxCnt,' peer_buf=',aConnection.fPeerBufAlloc,' peer_fwd=',aConnection.fPeerFwdCnt,' peer_free=',PeerFree);
{$endif}
   SendControlPacket(aConnection,VIRTIO_VSOCK_OP_CREDIT_REQUEST);
   result:=false;
   exit;
  end;

  ChunkSize:=VSOCK_MAX_PKT_DATA_SIZE;
  if aConnection.fTxPendingSize<TPasRISCVSizeInt(ChunkSize) then begin
   ChunkSize:=TPasRISCVUInt32(aConnection.fTxPendingSize);
  end;
  if ChunkSize>TPasRISCVUInt32(PeerFree) then begin
   ChunkSize:=TPasRISCVUInt32(PeerFree);
  end;

  FillChar(Header,SizeOf(TVSockHeader),#0);
  Header.SrcCID:=VSOCK_CID_HOST;
  Header.DstCID:=fGuestCID;
  Header.SrcPort:=aConnection.fLocalPort;
  Header.DstPort:=aConnection.fRemotePort;
  Header.Len:=ChunkSize;
  Header.SocketType:=aConnection.fSocketType;
  Header.Op:=VIRTIO_VSOCK_OP_RW;
  Header.Flags:=0;
  Header.BufAlloc:=aConnection.fBufAlloc;
  Header.FwdCnt:=aConnection.fFwdCnt;
  if not WriteRxDataPacket(Header,@aConnection.fTxPendingData[aConnection.fTxPendingOffset],ChunkSize,ActualSize) then begin
{$ifdef PasRISCVDebugVirtIOVSock}
   writeln('VSock FlushTxPending WriteRxPacket failed lp=',aConnection.fLocalPort,' rp=',aConnection.fRemotePort,' chunk=',ChunkSize,' pending=',aConnection.fTxPendingSize,' tx=',aConnection.fTxCnt,' peer_free=',PeerFree);
{$endif}
   result:=false;
   exit;
  end;

  inc(aConnection.fTxCnt,ActualSize);
  inc(aConnection.fTxPendingOffset,ActualSize);
  dec(aConnection.fTxPendingSize,ActualSize);
{$ifdef PasRISCVDebugVirtIOVSock}
  writeln('VSock FlushTxPending sent lp=',aConnection.fLocalPort,' rp=',aConnection.fRemotePort,' requested=',ChunkSize,' actual=',ActualSize,' pending=',aConnection.fTxPendingSize,' tx=',aConnection.fTxCnt,' peer_free_before=',PeerFree);
{$endif}

 end;

 if aConnection.fTxPendingSize=0 then begin
  aConnection.fTxPendingOffset:=0;
  aConnection.fTxPendingData:=nil;
  result:=true;
{$ifdef PasRISCVDebugVirtIOVSock}
  writeln('VSock FlushTxPending done lp=',aConnection.fLocalPort,' rp=',aConnection.fRemotePort,' tx=',aConnection.fTxCnt,' peer_buf=',aConnection.fPeerBufAlloc,' peer_fwd=',aConnection.fPeerFwdCnt);
{$endif}
 end else begin
  result:=false;
 end;

end;

procedure TPasRISCV.TVirtIOVSockDevice.WriteEvent(const aEventID:TPasRISCVUInt32);
var Queue:PQueue;
    Event:TVSockEvent;
    AvailableIndex,DescriptorIndex:TPasRISCVUInt16;
    ReadSize,WriteSize:TPasRISCVUInt64;
begin
 Queue:=@fQueues[VSOCK_EVQ];
 if fDriverOK and Queue^.Ready then begin
  TPasMPMultipleReaderSingleWriterSpinLock.AcquireWrite(Queue^.Lock);
  try
   if Read16(Queue^.AvailableAddress+2,AvailableIndex) then begin
    if Queue^.ShadowAvailableIndex<>AvailableIndex then begin
     if Read16(Queue^.AvailableAddress+4+((Queue^.ShadowAvailableIndex and (Queue^.Size-1)) shl 1),DescriptorIndex) then begin
      if GetDescriptors(ReadSize,WriteSize,VSOCK_EVQ,DescriptorIndex) then begin
       if VSOCK_EVENT_SIZE<=WriteSize then begin
        Event.ID:=aEventID;
        if not (CopyMemoryToQueue(VSOCK_EVQ,DescriptorIndex,0,@Event,VSOCK_EVENT_SIZE) and
                ConsumeDescriptor(VSOCK_EVQ,DescriptorIndex,VSOCK_EVENT_SIZE) and
                UsedRingSync(VSOCK_EVQ) and
                AdvanceShadowAvailableIndex(VSOCK_EVQ)) then begin
         NotifyDeviceNeedsReset;
        end;
       end;
      end else begin
       NotifyDeviceNeedsReset;
      end;
     end else begin
      NotifyDeviceNeedsReset;
     end;
    end;
   end else begin
    NotifyDeviceNeedsReset;
   end;
  finally
   TPasMPMultipleReaderSingleWriterSpinLock.ReleaseWrite(Queue^.Lock);
  end;
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.HandleRequest(var aHeader:TVSockHeader{$ifdef PasRISCVVSockParallelThreading};const aGeneration:TPasMPUInt64{$endif});
var Connection:TVSockConnection;
    RSTHeader:TVSockHeader;
    IsNew:Boolean;
    EventItem:TEventItem;
begin
 if (aHeader.SocketType<>VIRTIO_VSOCK_TYPE_STREAM) and (aHeader.SocketType<>VIRTIO_VSOCK_TYPE_SEQPACKET) then begin
  // Unknown socket type: send RST directly without creating a connection object.
  FillChar(RSTHeader,SizeOf(TVSockHeader),#0);
  RSTHeader.SrcCID:=VSOCK_CID_HOST;
  RSTHeader.DstCID:=aHeader.SrcCID;
  RSTHeader.SrcPort:=aHeader.DstPort;
  RSTHeader.DstPort:=aHeader.SrcPort;
  RSTHeader.SocketType:=aHeader.SocketType;
  RSTHeader.Op:=VIRTIO_VSOCK_OP_RST;
  WriteRxPacket(RSTHeader,nil,0);
 end else begin
  Connection:=FindConnection(aHeader.DstPort,aHeader.SrcCID,aHeader.SrcPort{$ifdef PasRISCVVSockParallelThreading},true,aGeneration{$endif});
  if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
   try
//  Connection.fLock.Acquire;
    try
{$endif}
     // Connection already exists; reject the duplicate request.
     SendControlPacket(Connection,VIRTIO_VSOCK_OP_RST);
{$ifdef PasRISCVVSockParallelThreading}
    finally
     Connection.fLock.Release;
    end;
   finally
    Connection.DecRef;
   end;
{$endif}
  end else begin
   // CreateConnection returns with Connection.fLock held and a caller reference.
   Connection:=CreateConnection(aHeader.DstPort,aHeader.SrcCID,aHeader.SrcPort,aHeader.SocketType{$ifdef PasRISCVVSockParallelThreading},true,aGeneration{$endif},IsNew);
   if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
    try
{$endif}
     if IsNew then begin
{$ifdef PasRISCVVSockParallelThreading}
      try
{$endif}
       Connection.fState:=TVSockConnectionState.PeerConnecting;
       Connection.fPeerBufAlloc:=aHeader.BufAlloc;
       Connection.fPeerFwdCnt:=aHeader.FwdCnt;
{$ifdef PasRISCVVSockParallelThreading}
      finally
       Connection.fLock.Release;
      end;
{$endif}
      // Event is queued after releasing the connection lock; the dispatch
      // thread may safely call AcceptConnection/RejectConnection.
      EventItem.Kind:=TEventItem.TEventKind.Connect;
      EventItem.Connection:=Connection;
{$ifdef PasRISCVVSockParallelThreading}
      EventItem.Connection.AddRef;
{$endif}
      EventItem.Payload:=nil;
{$ifndef PasRISCVVSockParallelThreading}
      EventItem.DestroyConnectionAfterDispatch:=false;
      fEventQueue.Enqueue(EventItem);
{$else}
      fEventQueueThread.QueueEvent(EventItem,@aGeneration);
{$endif}
     end else begin
      // Duplicate due to race: treat as duplicate request -> RST.
{$ifdef PasRISCVVSockParallelThreading}
      try
{$endif}
       SendControlPacket(Connection,VIRTIO_VSOCK_OP_RST);
{$ifdef PasRISCVVSockParallelThreading}
      finally
       Connection.fLock.Release;
      end;
{$endif}
     end;
{$ifdef PasRISCVVSockParallelThreading}
    finally
     Connection.DecRef;
    end;
{$endif}
   end else begin
    // Connection limit reached; send RST so the guest does not hang.
    FillChar(RSTHeader,SizeOf(TVSockHeader),#0);
    RSTHeader.SrcCID:=VSOCK_CID_HOST;
    RSTHeader.DstCID:=aHeader.SrcCID;
    RSTHeader.SrcPort:=aHeader.DstPort;
    RSTHeader.DstPort:=aHeader.SrcPort;
    RSTHeader.SocketType:=aHeader.SocketType;
    RSTHeader.Op:=VIRTIO_VSOCK_OP_RST;
    WriteRxPacket(RSTHeader,nil,0);
   end;
  end;
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.HandleResponse(var aHeader:TVSockHeader{$ifdef PasRISCVVSockParallelThreading};const aGeneration:TPasMPUInt64{$endif});
var Connection:TVSockConnection;
    RSTHeader:TVSockHeader;
    Connected:Boolean;
    EventItem:TEventItem;
begin
 Connection:=FindConnection(aHeader.DstPort,aHeader.SrcCID,aHeader.SrcPort{$ifdef PasRISCVVSockParallelThreading},true,aGeneration{$endif});
 if assigned(Connection) then begin
  Connected:=false;
{$ifdef PasRISCVVSockParallelThreading}
  try
// Connection.fLock.Acquire;
   try
{$endif}
    if Connection.fState=TVSockConnectionState.Connecting then begin
     Connection.fPeerBufAlloc:=aHeader.BufAlloc;
     Connection.fPeerFwdCnt:=aHeader.FwdCnt;
     Connection.fState:=TVSockConnectionState.Connected;
     Connected:=true;
    end else begin
     SendControlPacket(Connection,VIRTIO_VSOCK_OP_RST);
    end;
{$ifdef PasRISCVVSockParallelThreading}
   finally
    Connection.fLock.Release;
   end;
{$endif}
   if Connected then begin
    EventItem.Kind:=TEventItem.TEventKind.Accept;
    EventItem.Connection:=Connection;
{$ifdef PasRISCVVSockParallelThreading}
    EventItem.Connection.AddRef;
{$endif}
    EventItem.Accepted:=true;
    EventItem.Payload:=nil;
{$ifndef PasRISCVVSockParallelThreading}
    EventItem.DestroyConnectionAfterDispatch:=false;
    fEventQueue.Enqueue(EventItem);
{$else}
    fEventQueueThread.QueueEvent(EventItem,@aGeneration);
{$endif}
   end;
{$ifdef PasRISCVVSockParallelThreading}
  finally
   Connection.DecRef;
  end;
{$endif}
 end else begin
  // No matching connection: send RST without creating a connection object.
  FillChar(RSTHeader,SizeOf(TVSockHeader),#0);
  RSTHeader.SrcCID:=VSOCK_CID_HOST;
  RSTHeader.DstCID:=aHeader.SrcCID;
  RSTHeader.SrcPort:=aHeader.DstPort;
  RSTHeader.DstPort:=aHeader.SrcPort;
  RSTHeader.SocketType:=aHeader.SocketType;
  RSTHeader.Op:=VIRTIO_VSOCK_OP_RST;
  WriteRxPacket(RSTHeader,nil,0);
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.HandleRW(var aHeader:TVSockHeader;const aPayload:Pointer{$ifdef PasRISCVVSockParallelThreading};const aGeneration:TPasMPUInt64{$endif});
var Connection:TVSockConnection;
    RSTHeader:TVSockHeader;
    WasConnected:Boolean;
    EventItem:TEventItem;
begin
 Connection:=FindConnection(aHeader.DstPort,aHeader.SrcCID,aHeader.SrcPort{$ifdef PasRISCVVSockParallelThreading},true,aGeneration{$endif});
 if assigned(Connection) then begin
  WasConnected:=false;
{$ifdef PasRISCVVSockParallelThreading}
  try
// Connection.fLock.Acquire;
   try
{$endif}
    if Connection.fState=TVSockConnectionState.Connected then begin
     WasConnected:=true;
     Connection.fPeerBufAlloc:=aHeader.BufAlloc;
     Connection.fPeerFwdCnt:=aHeader.FwdCnt;
     Connection.fFwdCnt:=Connection.fFwdCnt+aHeader.Len;
{$ifdef PasRISCVDebugVirtIOVSock}
     writeln('VSock HandleRW lp=',Connection.fLocalPort,' rp=',Connection.fRemotePort,' len=',aHeader.Len,' buf_alloc=',aHeader.BufAlloc,' fwd=',aHeader.FwdCnt,' local_fwd=',Connection.fFwdCnt,' tx=',Connection.fTxCnt,' pending=',Connection.fTxPendingSize);
{$endif}
     if (Connection.fTxPendingSize>0) and
        ((TPasRISCVInt64(Connection.fPeerBufAlloc)-TPasRISCVInt64(Connection.fTxCnt-Connection.fPeerFwdCnt))>0) then begin
      FlushTxPendingData(Connection);
     end;
     // For stream sockets, send credit update if we've consumed enough buffer space
     if (Connection.fSocketType=VIRTIO_VSOCK_TYPE_STREAM) and
        ((Connection.fFwdCnt-Connection.fLastFwdCntReported)>=(Connection.fBufAlloc shr 1)) then begin
      Connection.fLastFwdCntReported:=Connection.fFwdCnt;
      SendControlPacket(Connection,VIRTIO_VSOCK_OP_CREDIT_UPDATE);
     end;
    end else begin
     SendControlPacket(Connection,VIRTIO_VSOCK_OP_RST);
    end;
{$ifdef PasRISCVVSockParallelThreading}
   finally
    Connection.fLock.Release;
   end;
{$endif}
   if WasConnected then begin
    EventItem.Kind:=TEventItem.TEventKind.Receive;
    EventItem.Connection:=Connection;
{$ifdef PasRISCVVSockParallelThreading}
    EventItem.Connection.AddRef;
{$endif}
    EventItem.Flags:=aHeader.Flags;
    if assigned(aPayload) and (aHeader.Len>0) then begin
     SetLength(EventItem.Payload,aHeader.Len);
     Move(aPayload^,EventItem.Payload[0],aHeader.Len);
    end else begin
     EventItem.Payload:=nil;
    end;
{$ifndef PasRISCVVSockParallelThreading}
    EventItem.DestroyConnectionAfterDispatch:=false;
    fEventQueue.Enqueue(EventItem);
{$else}
    fEventQueueThread.QueueEvent(EventItem,@aGeneration);
{$endif}
   end;
{$ifdef PasRISCVVSockParallelThreading}
  finally
   Connection.DecRef;
  end;
{$endif}
 end else begin
  // No matching connection: send RST without creating a connection object.
  FillChar(RSTHeader,SizeOf(TVSockHeader),#0);
  RSTHeader.SrcCID:=VSOCK_CID_HOST;
  RSTHeader.DstCID:=aHeader.SrcCID;
  RSTHeader.SrcPort:=aHeader.DstPort;
  RSTHeader.DstPort:=aHeader.SrcPort;
  RSTHeader.SocketType:=aHeader.SocketType;
  RSTHeader.Op:=VIRTIO_VSOCK_OP_RST;
  WriteRxPacket(RSTHeader,nil,0);
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.HandleShutdown(var aHeader:TVSockHeader{$ifdef PasRISCVVSockParallelThreading};const aGeneration:TPasMPUInt64{$endif});
const ActionNone=0;
      ActionShutdown=1;
      ActionClose=2;
var Connection:TVSockConnection;
    RSTHeader:TVSockHeader;
    Action:TPasRISCVInt32;
    EventItem:TEventItem;
begin
 Connection:=FindConnection(aHeader.DstPort,aHeader.SrcCID,aHeader.SrcPort{$ifdef PasRISCVVSockParallelThreading},true,aGeneration{$endif});
 if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
  try
// Connection.fLock.Acquire;
   try
{$endif}
    if Connection.fState=TVSockConnectionState.Connected then begin
     Connection.fPeerShutdownFlags:=Connection.fPeerShutdownFlags or aHeader.Flags;
     if (Connection.fPeerShutdownFlags and (VIRTIO_VSOCK_SHUTDOWN_F_RECEIVE or VIRTIO_VSOCK_SHUTDOWN_F_SEND))=(VIRTIO_VSOCK_SHUTDOWN_F_RECEIVE or VIRTIO_VSOCK_SHUTDOWN_F_SEND) then begin
      // Both directions shut down: full close
      SendControlPacket(Connection,VIRTIO_VSOCK_OP_RST);
      Action:=ActionClose;
     end else begin
      // Half-close: peer has shut down one direction only; transition to Closing
      Connection.fState:=TVSockConnectionState.Closing;
      Action:=ActionShutdown;
     end;
    end else begin
     SendControlPacket(Connection,VIRTIO_VSOCK_OP_RST);
     Action:=ActionNone;
    end;
{$ifdef PasRISCVVSockParallelThreading}
   finally
    Connection.fLock.Release;
   end;
{$endif}
   case Action of
    ActionShutdown:begin
     EventItem.Kind:=TEventItem.TEventKind.Shutdown;
     EventItem.Connection:=Connection;
{$ifdef PasRISCVVSockParallelThreading}
     EventItem.Connection.AddRef;
{$endif}
     EventItem.Payload:=nil;
{$ifndef PasRISCVVSockParallelThreading}
     EventItem.DestroyConnectionAfterDispatch:=false;
     fEventQueue.Enqueue(EventItem);
{$else}
     fEventQueueThread.QueueEvent(EventItem,@aGeneration);
{$endif}
    end;
    ActionClose:begin
{$ifdef PasRISCVVSockParallelThreading}
     try
{$endif}
      EventItem.Kind:=TEventItem.TEventKind.Close;
      EventItem.Connection:=Connection;
{$ifdef PasRISCVVSockParallelThreading}
      EventItem.Connection.AddRef;
{$endif}
      EventItem.Payload:=nil;
{$ifndef PasRISCVVSockParallelThreading}
      EventItem.DestroyConnectionAfterDispatch:=true;
      fEventQueue.Enqueue(EventItem);
{$else}
      fEventQueueThread.QueueEvent(EventItem,@aGeneration);
     finally
      DestroyConnection(Connection);
     end;
{$endif}
    end;
    else begin
     // No event to queue
    end;
   end;
{$ifdef PasRISCVVSockParallelThreading}
  finally
   Connection.DecRef;
  end;
{$endif}
 end else begin
  // No matching connection: send RST without creating a connection object.
  FillChar(RSTHeader,SizeOf(TVSockHeader),#0);
  RSTHeader.SrcCID:=VSOCK_CID_HOST;
  RSTHeader.DstCID:=aHeader.SrcCID;
  RSTHeader.SrcPort:=aHeader.DstPort;
  RSTHeader.DstPort:=aHeader.SrcPort;
  RSTHeader.SocketType:=aHeader.SocketType;
  RSTHeader.Op:=VIRTIO_VSOCK_OP_RST;
  WriteRxPacket(RSTHeader,nil,0);
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.HandleRST(var aHeader:TVSockHeader{$ifdef PasRISCVVSockParallelThreading};const aGeneration:TPasMPUInt64{$endif});
var Connection:TVSockConnection;
    WasConnecting:Boolean;
    EventItem:TEventItem;
begin
 Connection:=FindConnection(aHeader.DstPort,aHeader.SrcCID,aHeader.SrcPort{$ifdef PasRISCVVSockParallelThreading},true,aGeneration{$endif});
 if assigned(Connection) then begin
  WasConnecting:=false;
{$ifdef PasRISCVVSockParallelThreading}
  try
// Connection.fLock.Acquire;
   try
{$endif}
    WasConnecting:=Connection.fState=TVSockConnectionState.Connecting;
{$ifdef PasRISCVVSockParallelThreading}
   finally
    Connection.fLock.Release;
   end;
   try
{$endif}
    if WasConnecting then begin
     EventItem.Kind:=TEventItem.TEventKind.Accept;
     EventItem.Accepted:=false;
    end else begin
     EventItem.Kind:=TEventItem.TEventKind.Close;
    end;
    EventItem.Connection:=Connection;
{$ifdef PasRISCVVSockParallelThreading}
    EventItem.Connection.AddRef;
{$endif}
    EventItem.Payload:=nil;
{$ifndef PasRISCVVSockParallelThreading}
    EventItem.DestroyConnectionAfterDispatch:=true;
    fEventQueue.Enqueue(EventItem);
{$else}
    fEventQueueThread.QueueEvent(EventItem,@aGeneration);
   finally
    DestroyConnection(Connection);
   end;
  finally
   Connection.DecRef;
  end;
{$endif}
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.HandleCreditUpdate(var aHeader:TVSockHeader{$ifdef PasRISCVVSockParallelThreading};const aGeneration:TPasMPUInt64{$endif});
var Connection:TVSockConnection;
begin
 Connection:=FindConnection(aHeader.DstPort,aHeader.SrcCID,aHeader.SrcPort{$ifdef PasRISCVVSockParallelThreading},true,aGeneration{$endif});
 if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
  try
// Connection.fLock.Acquire;
   try
{$endif}
    Connection.fPeerBufAlloc:=aHeader.BufAlloc;
    Connection.fPeerFwdCnt:=aHeader.FwdCnt;
{$ifdef PasRISCVDebugVirtIOVSock}
    writeln('VSock HandleCreditUpdate lp=',Connection.fLocalPort,' rp=',Connection.fRemotePort,' peer_buf=',Connection.fPeerBufAlloc,' peer_fwd=',Connection.fPeerFwdCnt,' tx=',Connection.fTxCnt,' pending=',Connection.fTxPendingSize,' peer_free=',TPasRISCVInt64(Connection.fPeerBufAlloc)-TPasRISCVInt64(Connection.fTxCnt-Connection.fPeerFwdCnt));
{$endif}
    if (Connection.fTxPendingSize>0) and
       ((TPasRISCVInt64(Connection.fPeerBufAlloc)-TPasRISCVInt64(Connection.fTxCnt-Connection.fPeerFwdCnt))>0) then begin
     FlushTxPendingData(Connection);
    end;
{$ifdef PasRISCVVSockParallelThreading}
   finally
    Connection.fLock.Release;
   end;
  finally
   Connection.DecRef;
  end;
{$endif}
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.HandleCreditRequest(var aHeader:TVSockHeader{$ifdef PasRISCVVSockParallelThreading};const aGeneration:TPasMPUInt64{$endif});
var Connection:TVSockConnection;
begin
 Connection:=FindConnection(aHeader.DstPort,aHeader.SrcCID,aHeader.SrcPort{$ifdef PasRISCVVSockParallelThreading},true,aGeneration{$endif});
 if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
  try
// Connection.fLock.Acquire;
   try
{$endif}
{$ifdef PasRISCVDebugVirtIOVSock}
    writeln('VSock HandleCreditRequest lp=',Connection.fLocalPort,' rp=',Connection.fRemotePort,' buf_alloc=',Connection.fBufAlloc,' fwd=',Connection.fFwdCnt,' tx=',Connection.fTxCnt,' pending=',Connection.fTxPendingSize);
{$endif}
    SendControlPacket(Connection,VIRTIO_VSOCK_OP_CREDIT_UPDATE);
{$ifdef PasRISCVVSockParallelThreading}
   finally
    Connection.fLock.Release;
   end;
  finally
   Connection.DecRef;
  end;
{$endif}
 end;
end;

function TPasRISCV.TVirtIOVSockDevice.ValidateHeader(const aHeader:TVSockHeader):Boolean;
begin
 result:=(aHeader.SrcCID=fGuestCID) and // Source CID must be the guest's CID
         (aHeader.DstCID=VSOCK_CID_HOST) and // Destination CID must be the host
         ( // Operation must be one of the known VSOCK operations (1..7); 0 is INVALID and must be rejected
          (aHeader.Op<>VIRTIO_VSOCK_OP_INVALID) and
          (aHeader.Op<=VIRTIO_VSOCK_OP_CREDIT_REQUEST)
         ) and
         ( // Port 0 is reserved in vsock
          (aHeader.SrcPort<>0) and
          (aHeader.DstPort<>0)
         );
end;

procedure TPasRISCV.TVirtIOVSockDevice.DispatchEvent(var aEventItem:TEventItem);
begin
 if not (assigned(fManager) and fManager.DispatchEvent(aEventItem)) then begin
  case aEventItem.Kind of
   TEventItem.TEventKind.Connect:begin
    if assigned(fOnConnect) then begin
     fOnConnect(self,aEventItem.Connection.fLocalPort,aEventItem.Connection.fRemotePort,aEventItem.Connection.fSocketType);
    end;
   end;
   TEventItem.TEventKind.Accept:begin
    if assigned(fOnConnected) then begin
     fOnConnected(self,aEventItem.Connection.fLocalPort,aEventItem.Connection.fRemotePort,aEventItem.Connection.fSocketType,aEventItem.Accepted);
    end;
   end;
   TEventItem.TEventKind.Receive:begin
    if assigned(fOnReceive) then begin
     if length(aEventItem.Payload)>0 then begin
      fOnReceive(self,aEventItem.Connection.fLocalPort,aEventItem.Connection.fRemotePort,aEventItem.Connection.fSocketType,@aEventItem.Payload[0],length(aEventItem.Payload),aEventItem.Flags);
     end else begin
      fOnReceive(self,aEventItem.Connection.fLocalPort,aEventItem.Connection.fRemotePort,aEventItem.Connection.fSocketType,nil,0,aEventItem.Flags);
     end;
    end;
   end;
   TEventItem.TEventKind.Shutdown:begin
    if assigned(fOnShutdown) then begin
     fOnShutdown(self,aEventItem.Connection.fLocalPort,aEventItem.Connection.fRemotePort);
    end;
   end;
   TEventItem.TEventKind.Close:begin
    if assigned(fOnDisconnect) then begin
     fOnDisconnect(self,aEventItem.Connection.fLocalPort,aEventItem.Connection.fRemotePort);
    end;
   end;
   else begin
    // Ignore, even though it's unlikely here, maybe spurious wakeup,
    // so ignore and just continue
   end;
  end;
 end;
end;

{$ifndef PasRISCVVSockParallelThreading}
procedure TPasRISCV.TVirtIOVSockDevice.ProcessEventQueue;
var EventItem:TEventItem;
begin
 Initialize(EventItem);
 try
  while fEventQueue.Dequeue(EventItem) do begin
   try
    DispatchEvent(EventItem);
   finally
    if EventItem.DestroyConnectionAfterDispatch and assigned(EventItem.Connection) then begin
     DestroyConnection(EventItem.Connection);
    end;
   end;
  end;
 finally
  Finalize(EventItem);
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.FlushEventQueue;
var EventItem:TEventItem;
begin
 Initialize(EventItem);
 try
  while fEventQueue.Dequeue(EventItem) do begin
  end;
 finally
  Finalize(EventItem);
 end;
end;
{$endif}

function TPasRISCV.TVirtIOVSockDevice.DeviceRecv(const aQueueIndex,aDescriptorIndex,aReadSize,aWriteSize:TPasRISCVUInt64):Boolean;
var Header:TVSockHeader;
    PayloadPtr:Pointer;
    OK:boolean;
{$ifdef PasRISCVVSockParallelThreading}
    Generation:TPasMPUInt64;
{$endif}
begin

 result:=true;

 if aQueueIndex=VSOCK_TXQ then begin

{$ifdef PasRISCVVSockParallelThreading}
  fResetMRSWLock.AcquireRead;
  try
   Generation:=fEventQueueThread.fGeneration;
{$endif}

   if aReadSize<VSOCK_HDR_SIZE then begin

    if not (ConsumeDescriptor(VSOCK_TXQ,aDescriptorIndex,0) and
            UsedRingSync(VSOCK_TXQ)) then begin
     NotifyDeviceNeedsReset;
    end;

   end else begin

    FillChar(Header,SizeOf(TVSockHeader),#0);
    if CopyMemoryFromQueue(@Header,VSOCK_TXQ,aDescriptorIndex,0,VSOCK_HDR_SIZE) then begin

     // Validate header before processing
     if ValidateHeader(Header) then begin

      if (Header.Op=VIRTIO_VSOCK_OP_RW) and (Header.Len>0) then begin
       if Header.Len>VSOCK_MAX_PKT_BUF_SIZE then begin
        Header.Len:=VSOCK_MAX_PKT_BUF_SIZE;
       end;
       if length(fRecvBuffer)<TPasRISCVSizeInt(Header.Len) then begin
        SetLength(fRecvBuffer,Header.Len+((Header.Len+1) shr 1));
       end;
       if CopyMemoryFromQueue(@fRecvBuffer[0],VSOCK_TXQ,aDescriptorIndex,VSOCK_HDR_SIZE,Header.Len) then begin
        PayloadPtr:=@fRecvBuffer[0];
        OK:=true;
       end else begin
        PayloadPtr:=nil;
        OK:=false;
       end;
      end else begin
       PayloadPtr:=nil;
       OK:=true;
      end;

      if OK then begin

       case Header.Op of
        VIRTIO_VSOCK_OP_REQUEST:begin
         HandleRequest(Header{$ifdef PasRISCVVSockParallelThreading},Generation{$endif});
        end;
        VIRTIO_VSOCK_OP_RESPONSE:begin
         HandleResponse(Header{$ifdef PasRISCVVSockParallelThreading},Generation{$endif});
        end;
        VIRTIO_VSOCK_OP_RW:begin
         HandleRW(Header,PayloadPtr{$ifdef PasRISCVVSockParallelThreading},Generation{$endif});
        end;
        VIRTIO_VSOCK_OP_SHUTDOWN:begin
         HandleShutdown(Header{$ifdef PasRISCVVSockParallelThreading},Generation{$endif});
        end;
        VIRTIO_VSOCK_OP_RST:begin
         HandleRST(Header{$ifdef PasRISCVVSockParallelThreading},Generation{$endif});
        end;
        VIRTIO_VSOCK_OP_CREDIT_UPDATE:begin
         HandleCreditUpdate(Header{$ifdef PasRISCVVSockParallelThreading},Generation{$endif});
        end;
        VIRTIO_VSOCK_OP_CREDIT_REQUEST:begin
         HandleCreditRequest(Header{$ifdef PasRISCVVSockParallelThreading},Generation{$endif});
        end;
        else begin
        end;
       end;

       if not (ConsumeDescriptor(VSOCK_TXQ,aDescriptorIndex,0) and
               UsedRingSync(VSOCK_TXQ)) then begin
        NotifyDeviceNeedsReset;
       end;

{$ifndef PasRISCVVSockParallelThreading}
       if not fDispatchAfterDrain then begin
        ProcessEventQueue;
       end;
{$endif}

      end else begin

       NotifyDeviceNeedsReset;

      end;

     end else begin

      if not (ConsumeDescriptor(VSOCK_TXQ,aDescriptorIndex,0) and
              UsedRingSync(VSOCK_TXQ)) then begin
       NotifyDeviceNeedsReset;
      end;

     end;

    end else begin

     NotifyDeviceNeedsReset;

    end;

   end;

{$ifdef PasRISCVVSockParallelThreading}
  finally
   fResetMRSWLock.ReleaseRead;
  end;
{$endif}

 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.ProcessQueueIterationCompleted;
begin
 inherited ProcessQueueIterationCompleted;
{$ifndef PasRISCVVSockParallelThreading}
 if fDispatchAfterDrain then begin
  ProcessEventQueue;
 end;
{$endif}
end;

procedure TPasRISCV.TVirtIOVSockDevice.AcceptConnection(const aRemotePort,aLocalPort:TPasRISCVUInt32);
var Connection:TVSockConnection;
begin
{$ifndef PasRISCVVSockParallelThreading}
 fVSockLock.Acquire;
{$else}
 fResetMRSWLock.AcquireRead;
{$endif}
 try
  Connection:=FindConnection(aLocalPort,fGuestCID,aRemotePort{$ifdef PasRISCVVSockParallelThreading},true,fEventQueueThread.fGeneration{$endif});
  if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
   try
 // Connection.fLock.Acquire;
    try
{$endif}
     if Connection.fState=TVSockConnectionState.PeerConnecting then begin
      Connection.fState:=TVSockConnectionState.Connected;
      SendControlPacket(Connection,VIRTIO_VSOCK_OP_RESPONSE);
     end;
{$ifdef PasRISCVVSockParallelThreading}
    finally
     Connection.fLock.Release;
    end;
   finally
    Connection.DecRef;
   end;
{$endif}
  end;
 finally
{$ifndef PasRISCVVSockParallelThreading}
  fVSockLock.Release;
{$else}
  fResetMRSWLock.ReleaseRead;
{$endif}
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.RejectConnection(const aRemotePort,aLocalPort:TPasRISCVUInt32);
var Connection:TVSockConnection;
{$ifdef PasRISCVVSockParallelThreading}
    DoDestroy:Boolean;
{$endif}
begin
{$ifndef PasRISCVVSockParallelThreading}
 fVSockLock.Acquire;
{$else}
 fResetMRSWLock.AcquireRead;
{$endif}
 try
  Connection:=FindConnection(aLocalPort,fGuestCID,aRemotePort{$ifdef PasRISCVVSockParallelThreading},true,fEventQueueThread.fGeneration{$endif});
  if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
   DoDestroy:=false;
   try
 // Connection.fLock.Acquire;
    try
{$endif}
     if Connection.fState=TVSockConnectionState.PeerConnecting then begin
      SendControlPacket(Connection,VIRTIO_VSOCK_OP_RST);
{$ifndef PasRISCVVSockParallelThreading}
      DestroyConnection(Connection);
{$else}
      DoDestroy:=true;
{$endif}
     end;
{$ifdef PasRISCVVSockParallelThreading}
    finally
     Connection.fLock.Release;
    end;
    if DoDestroy then begin
     DestroyConnection(Connection);
    end;
   finally
    Connection.DecRef;
   end;
{$endif}
  end;
 finally
{$ifndef PasRISCVVSockParallelThreading}
  fVSockLock.Release;
{$else}
  fResetMRSWLock.ReleaseRead;
{$endif}
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.Connect(const aLocalPort,aRemotePort:TPasRISCVUInt32;const aSocketType:TPasRISCVUInt16=VIRTIO_VSOCK_TYPE_STREAM);
var Connection:TVSockConnection;
    IsNew:Boolean;
{$ifdef PasRISCVVSockParallelThreading}
    Generation:TPasMPUInt64;
{$endif}
begin
{$ifndef PasRISCVVSockParallelThreading}
 fVSockLock.Acquire;
{$else}
 fResetMRSWLock.AcquireRead;
{$endif}
 try
{$ifdef PasRISCVVSockParallelThreading}
  Generation:=fEventQueueThread.fGeneration;
{$endif}
  Connection:=FindConnection(aLocalPort,fGuestCID,aRemotePort{$ifdef PasRISCVVSockParallelThreading},true,Generation{$endif});
  if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
   // Already exists: nothing to do.
   Connection.fLock.Release;
   Connection.DecRef;
{$endif}
  end else begin
   Connection:=CreateConnection(aLocalPort,fGuestCID,aRemotePort,aSocketType{$ifdef PasRISCVVSockParallelThreading},true,Generation{$endif},IsNew);
   if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
    try
{$endif}
     if IsNew then begin
      Connection.fState:=TVSockConnectionState.Connecting;
      SendControlPacket(Connection,VIRTIO_VSOCK_OP_REQUEST);
     end else begin
      // IsNew=false: another thread created this connection; nothing to do.
     end;
{$ifdef PasRISCVVSockParallelThreading}
    finally
     Connection.fLock.Release;
     Connection.DecRef;
    end;
{$endif}
   end else begin
    // If nil: connection limit reached; caller may retry later.
   end;
  end;
 finally
{$ifndef PasRISCVVSockParallelThreading}
  fVSockLock.Release;
{$else}
  fResetMRSWLock.ReleaseRead;
{$endif}
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.CloseConnection(const aRemotePort,aLocalPort:TPasRISCVUInt32);
var Connection:TVSockConnection;
    EventItem:TEventItem;
    DoDestroy,DoDisconnect:Boolean;
{$ifdef PasRISCVVSockParallelThreading}
    Generation:TPasMPUInt64;
{$endif}
begin
{$ifndef PasRISCVVSockParallelThreading}
 fVSockLock.Acquire;
{$else}
 fResetMRSWLock.AcquireRead;
{$endif}
 try
{$ifdef PasRISCVVSockParallelThreading}
  Generation:=fEventQueueThread.fGeneration;
{$endif}
  Connection:=FindConnection(aLocalPort,fGuestCID,aRemotePort{$ifdef PasRISCVVSockParallelThreading},true,Generation{$endif});
  if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
   DoDestroy:=false;
   DoDisconnect:=false;
   try
// Connection.fLock.Acquire;
    try
{$endif}
     case Connection.fState of
      TVSockConnectionState.Connected:begin
       SendControlPacket(Connection,VIRTIO_VSOCK_OP_SHUTDOWN,VIRTIO_VSOCK_SHUTDOWN_F_RECEIVE or VIRTIO_VSOCK_SHUTDOWN_F_SEND);
       Connection.fShutdownFlags:=VIRTIO_VSOCK_SHUTDOWN_F_RECEIVE or VIRTIO_VSOCK_SHUTDOWN_F_SEND;
       SendControlPacket(Connection,VIRTIO_VSOCK_OP_RST);
       DoDisconnect:=true;
       DoDestroy:=true;
      end;
      TVSockConnectionState.PeerConnecting,
      TVSockConnectionState.Connecting,
      TVSockConnectionState.Closing:begin
       SendControlPacket(Connection,VIRTIO_VSOCK_OP_RST);
       DoDestroy:=true;
      end;
      else begin
      end;
     end;
{$ifdef PasRISCVVSockParallelThreading}
    finally
     Connection.fLock.Release;
    end;
{$endif}
    try
     if DoDisconnect then begin
      EventItem.Kind:=TEventItem.TEventKind.Close;
      EventItem.Connection:=Connection;
{$ifdef PasRISCVVSockParallelThreading}
      EventItem.Connection.AddRef;
{$endif}
      EventItem.Payload:=nil;
{$ifndef PasRISCVVSockParallelThreading}
      EventItem.DestroyConnectionAfterDispatch:=false;
      DispatchEvent(EventItem);
{$else}
      fEventQueueThread.QueueEvent(EventItem,@Generation);
{$endif}
     end;
    finally
     if DoDestroy then begin
      DestroyConnection(Connection);
     end;
    end;
{$ifdef PasRISCVVSockParallelThreading}
   finally
    Connection.DecRef;
   end;
{$endif}
  end;
 finally
{$ifndef PasRISCVVSockParallelThreading}
  fVSockLock.Release;
{$else}
  fResetMRSWLock.ReleaseRead;
{$endif}
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.SendPacket(const aRemotePort,aLocalPort:TPasRISCVUInt32;const aData:Pointer;const aSize:TPasRISCVUInt32;const aFlags:TPasRISCVUInt32=0);
var Connection:TVSockConnection;
    Header:TVSockHeader;
    ActualSize,WrittenSize:TPasRISCVUInt32;
    PeerFree:TPasRISCVInt64;
begin
{$ifndef PasRISCVVSockParallelThreading}
 fVSockLock.Acquire;
{$else}
 fResetMRSWLock.AcquireRead;
{$endif}
 try
  Connection:=FindConnection(aLocalPort,fGuestCID,aRemotePort{$ifdef PasRISCVVSockParallelThreading},true,fEventQueueThread.fGeneration{$endif});
  if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
   try
 // Connection.fLock.Acquire;
    try
{$endif}
     if Connection.fState=TVSockConnectionState.Connected then begin
      ActualSize:=aSize;
      if ActualSize>VSOCK_MAX_PKT_DATA_SIZE then begin
       ActualSize:=VSOCK_MAX_PKT_DATA_SIZE;
      end;
      FillChar(Header,SizeOf(TVSockHeader),#0);
      Header.SrcCID:=VSOCK_CID_HOST;
      Header.DstCID:=fGuestCID;
      Header.SrcPort:=aLocalPort;
      Header.DstPort:=aRemotePort;
      Header.SocketType:=Connection.fSocketType;
      Header.Op:=VIRTIO_VSOCK_OP_RW;
      Header.BufAlloc:=Connection.fBufAlloc;
      Header.FwdCnt:=Connection.fFwdCnt;
      if Connection.fSocketType=VIRTIO_VSOCK_TYPE_STREAM then begin
       PeerFree:=TPasRISCVInt64(Connection.fPeerBufAlloc)-TPasRISCVInt64(Connection.fTxCnt-Connection.fPeerFwdCnt);
       if PeerFree>0 then begin
        if ActualSize>TPasRISCVUInt32(PeerFree) then begin
         ActualSize:=TPasRISCVUInt32(PeerFree);
        end;
        Header.Flags:=0;
        Header.Len:=ActualSize;
        if WriteRxDataPacket(Header,aData,ActualSize,WrittenSize) then begin
         inc(Connection.fTxCnt,WrittenSize);
        end;
       end;
      end else begin
       Header.Flags:=aFlags;
       Header.Len:=ActualSize;
       if WriteRxPacket(Header,aData,ActualSize) then begin
        inc(Connection.fTxCnt,ActualSize);
       end;
      end;
     end;
{$ifdef PasRISCVVSockParallelThreading}
    finally
     Connection.fLock.Release;
    end;
   finally
    Connection.DecRef;
   end;
{$endif}
  end;
 finally
{$ifndef PasRISCVVSockParallelThreading}
  fVSockLock.Release;
{$else}
  fResetMRSWLock.ReleaseRead;
{$endif}
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.SendData(const aRemotePort,aLocalPort:TPasRISCVUInt32;const aData:Pointer;const aSize:TPasRISCVUInt32;const aEOR:Boolean=false);
var Connection:TVSockConnection;
    Header:TVSockHeader;
    Remaining,ChunkSize,ActualSize,Offset:TPasRISCVUInt32;
    PeerFree:TPasRISCVInt64;
    Flags:TPasRISCVUInt32;
begin
{$ifndef PasRISCVVSockParallelThreading}
 fVSockLock.Acquire;
{$else}
 fResetMRSWLock.AcquireRead;
{$endif}
 try
  Connection:=FindConnection(aLocalPort,fGuestCID,aRemotePort{$ifdef PasRISCVVSockParallelThreading},true,fEventQueueThread.fGeneration{$endif});
  if assigned(Connection) then begin
{$ifdef PasRISCVVSockParallelThreading}
   try
 // Connection.fLock.Acquire;
    try
{$endif}
     if Connection.fState=TVSockConnectionState.Connected then begin
{$ifdef PasRISCVDebugVirtIOVSock}
      writeln('VSock SendData start lp=',aLocalPort,' rp=',aRemotePort,' size=',aSize,' socket=',Connection.fSocketType,' tx=',Connection.fTxCnt,' peer_buf=',Connection.fPeerBufAlloc,' peer_fwd=',Connection.fPeerFwdCnt,' pending=',Connection.fTxPendingSize);
{$endif}
      if (Connection.fSocketType=VIRTIO_VSOCK_TYPE_STREAM) and (Connection.fTxPendingSize>0) then begin
       AppendTxPendingData(Connection,aData,aSize);
       FlushTxPendingData(Connection);
      end else begin
       Remaining:=aSize;
       Offset:=0;
       while Remaining>0 do begin
        ChunkSize:=Remaining;
        if ChunkSize>VSOCK_MAX_PKT_DATA_SIZE then begin
         ChunkSize:=VSOCK_MAX_PKT_DATA_SIZE;
        end;
        FillChar(Header,SizeOf(TVSockHeader),#0);
        Header.SrcCID:=VSOCK_CID_HOST;
        Header.DstCID:=fGuestCID;
        Header.SrcPort:=aLocalPort;
        Header.DstPort:=aRemotePort;
        Header.SocketType:=Connection.fSocketType;
        Header.Op:=VIRTIO_VSOCK_OP_RW;
        Header.BufAlloc:=Connection.fBufAlloc;
        Header.FwdCnt:=Connection.fFwdCnt;
        if Connection.fSocketType=VIRTIO_VSOCK_TYPE_STREAM then begin
         PeerFree:=TPasRISCVInt64(Connection.fPeerBufAlloc)-TPasRISCVInt64(Connection.fTxCnt-Connection.fPeerFwdCnt);
         if PeerFree<=0 then begin
{$ifdef PasRISCVDebugVirtIOVSock}
          writeln('VSock SendData blocked lp=',aLocalPort,' rp=',aRemotePort,' offset=',Offset,' remaining=',Remaining,' tx=',Connection.fTxCnt,' peer_buf=',Connection.fPeerBufAlloc,' peer_fwd=',Connection.fPeerFwdCnt,' peer_free=',PeerFree);
{$endif}
          AppendTxPendingData(Connection,Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aData)+Offset)),Remaining);
          SendControlPacket(Connection,VIRTIO_VSOCK_OP_CREDIT_REQUEST);
          break;
         end;
         if ChunkSize>TPasRISCVUInt32(PeerFree) then begin
          ChunkSize:=TPasRISCVUInt32(PeerFree);
         end;
         Header.Flags:=0;
        end else begin
         // Seqpacket: set EOM (and optionally EOR) only on last fragment
         Flags:=0;
         if (Offset+ChunkSize)>=aSize then begin
          Flags:=VIRTIO_VSOCK_SEQ_EOM;
          if aEOR then begin
           Flags:=Flags or VIRTIO_VSOCK_SEQ_EOR;
          end;
         end;
         Header.Flags:=Flags;
        end;
        Header.Len:=ChunkSize;
        if Connection.fSocketType=VIRTIO_VSOCK_TYPE_STREAM then begin
         if not WriteRxDataPacket(Header,Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aData)+Offset)),ChunkSize,ActualSize) then begin
{$ifdef PasRISCVDebugVirtIOVSock}
          writeln('VSock SendData WriteRxDataPacket failed lp=',aLocalPort,' rp=',aRemotePort,' offset=',Offset,' remaining=',Remaining,' chunk=',ChunkSize,' tx=',Connection.fTxCnt);
{$endif}
          AppendTxPendingData(Connection,Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aData)+Offset)),Remaining);
          break; // RX queue full, don't advance TxCnt or offset
         end;
         inc(Connection.fTxCnt,ActualSize);
{$ifdef PasRISCVDebugVirtIOVSock}
         writeln('VSock SendData sent lp=',aLocalPort,' rp=',aRemotePort,' offset=',Offset,' requested=',ChunkSize,' actual=',ActualSize,' remaining_before=',Remaining,' tx=',Connection.fTxCnt,' peer_free_before=',PeerFree);
{$endif}
         inc(Offset,ActualSize);
         dec(Remaining,ActualSize);
        end else begin
         if not WriteRxPacket(Header,Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aData)+Offset)),ChunkSize) then begin
{$ifdef PasRISCVDebugVirtIOVSock}
          writeln('VSock SendData WriteRxPacket failed lp=',aLocalPort,' rp=',aRemotePort,' offset=',Offset,' remaining=',Remaining,' chunk=',ChunkSize,' tx=',Connection.fTxCnt);
{$endif}
          break; // RX queue full
         end;
         inc(Offset,ChunkSize);
         dec(Remaining,ChunkSize);
        end;
       end;
      end;
     end;
{$ifdef PasRISCVVSockParallelThreading}
    finally
     Connection.fLock.Release;
    end;
   finally
    Connection.DecRef;
   end;
{$endif}
  end;
 finally
{$ifndef PasRISCVVSockParallelThreading}
  fVSockLock.Release;
{$else}
  fResetMRSWLock.ReleaseRead;
{$endif}
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.SendTransportReset(const aFromCallback:Boolean);
begin
{$ifndef PasRISCVVSockParallelThreading}
 fVSockLock.Acquire;
 try
{$else}

 if aFromCallback then begin
  TPasMPMultipleReaderSingleWriterSpinLock.ReadToWrite(fEventQueueThread.fLock);
 end else begin
  TPasMPMultipleReaderSingleWriterSpinLock.AcquireWrite(fEventQueueThread.fLock);
 end;
 try

  TPasMPInterlocked.Increment(fEventQueueThread.fGeneration);

  fResetMRSWLock.AcquireWrite;
  try

   fEventQueueThread.fConditionVariableLock.Acquire;
   try
{$endif}

    WriteEvent(VIRTIO_VSOCK_EVENT_TRANSPORT_RESET);

{$ifdef PasRISCVVSockParallelThreading}
    fEventQueueThread.FlushQueue(false);
{$else}
    FlushEventQueue;
{$endif}

    DestroyAllConnections;

{$ifdef PasRISCVVSockParallelThreading}
    TPasMPInterlocked.Increment(fEventQueueThread.fGeneration);

   finally
    fEventQueueThread.fConditionVariableLock.Release;
   end;

  finally
   fResetMRSWLock.ReleaseWrite;
  end;

 finally
  if aFromCallback then begin
   TPasMPMultipleReaderSingleWriterSpinLock.WriteToRead(fEventQueueThread.fLock);
  end else begin
   TPasMPMultipleReaderSingleWriterSpinLock.ReleaseWrite(fEventQueueThread.fLock);
  end;
 end;
{$else}
 finally
  fVSockLock.Release;
 end;
{$endif}
end;

