     if LostBits64<>0 then begin
      F32Result:=F32Result or 1; // round-to-odd: force LSB
      FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Inexact);
     end;
    end else if F64BiasedExponent>=874 then begin
     // normal f64 -> subnormal f32 (f64 biased exp 874..896 maps to shift 30..52)
     ShiftAmount:=926-F64BiasedExponent;
     FullSignificand64:=(TPasRISCVUInt64(1) shl 52) or F64Mantissa;
     F32Mantissa:=TPasRISCVUInt32(FullSignificand64 shr ShiftAmount);
     LostBits64:=FullSignificand64 and ((TPasRISCVUInt64(1) shl ShiftAmount)-1);
     F32Result:=(F64Sign shl 31) or F32Mantissa;
     if LostBits64<>0 then begin
      F32Result:=F32Result or 1; // round-to-odd: force LSB
      FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Inexact) or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Underflow);
     end;
