procedure TPasRISCV.THART.TJustInTimeCompilerX8664.EmitNativeFCvtModWD(const aHostIntDest,aHostFPUSrc:TPasRISCVUInt8);
var TempReg2,TempReg3:TPasRISCVUInt8;
    NaNInf,ZeroSmall,ZeroLarge,LargeExp,FastPathDone,SignDone,LargeExpDone:TPasRISCVUInt32;
begin
 if fMachine.fJITFastFPUCodePaths then begin
  // Fast path: intentionally uses CVTTSD2SI and does not model full fcvtmod modulo/fflags semantics.
  // Fast path (no fflags): CVTTSD2SI r64, xmm + MOVSXD
  // CVTTSD2SI r64, xmm (truncate double to 64-bit int)
  EmitREX(true,aHostIntDest,0,aHostFPUSrc);
  EmitByte($f2);
  EmitByte($0f);
  EmitByte($2c);
  EmitModRM(3,aHostIntDest,aHostFPUSrc);
  // Sign-extend low 32 bits to 64 bits (MOVSXD)
  EmitMOVSXD(aHostIntDest,aHostIntDest);
 end else begin
  TempReg2:=ClaimHostIntRegister;
  TempReg3:=ClaimHostIntRegister;
  // Extract raw f64 bits to aHostIntDest
  EmitSSE2MovXMMToGPR(aHostIntDest,aHostFPUSrc,true);
  // Extract biased exponent into TempReg2
  EmitMOVRegReg(TempReg2,aHostIntDest,true);
  EmitShiftRegImm(SHIFT_SHR,TempReg2,52,true);
  EmitImmOp(ALU_AND,TempReg2,$7ff,false);
  // Branch on NaN/Inf (biased exponent = 0x7ff)
  EmitImmOp(ALU_CMP,TempReg2,$7ff,false);
  EmitJccRel32(CC_E,0);
  NaNInf:=fTemporaryCodeSize-4;
  // Branch on |value| < 1 (biased exponent < 1023)
  EmitImmOp(ALU_CMP,TempReg2,1023,false);
  EmitJccRel32(CC_B,0);
  ZeroSmall:=fTemporaryCodeSize-4;
  // Branch on |value| >= 2^84 (biased exponent >= 1107, low 32 bits are always 0)
  EmitImmOp(ALU_CMP,TempReg2,1107,false);
  EmitJccRel32(CC_AE,0);
  ZeroLarge:=fTemporaryCodeSize-4;
  // Branch on biased exponent >= 1086 (unbiased >= 63: CVTTSD2SI gives wrong modular result)
  EmitImmOp(ALU_CMP,TempReg2,1086,false);
  EmitJccRel32(CC_AE,0);
  LargeExp:=fTemporaryCodeSize-4;
  // Fast path: biased exponent in [1023..1085], CVTTSD2SI r64 gives correct truncated result
  EmitREX(true,aHostIntDest,0,aHostFPUSrc);
  EmitByte($f2);
  EmitByte($0f);
  EmitByte($2c);
  EmitModRM(3,aHostIntDest,aHostFPUSrc);
  EmitMOVSXD(aHostIntDest,aHostIntDest);
  EmitJmpRel32(0);
  FastPathDone:=fTemporaryCodeSize-4;
  // Slow path: biased exponent in [1086..1106], bit-extraction for correct modular result
  PatchJmpRel32(LargeExp);
  // Save original raw bits for sign extraction later
  EmitMOVRegReg(TempReg3,aHostIntDest,true);
  // Extract 53-bit mantissa: SHL 12 drops sign+exponent; SHR 12 restores mantissa to bits[51:0]
  EmitShiftRegImm(SHIFT_SHL,aHostIntDest,12,true);
  EmitShiftRegImm(SHIFT_SHR,aHostIntDest,12,true);
  // Add implicit leading 1 bit at position 52
  EmitMOVRegImm64(TempReg2,TPasRISCVUInt64($0010000000000000));
  Emit2RegOp(X86_OR,aHostIntDest,TempReg2,true);
  // Reload biased exponent from saved raw bits; compute shift = biased exponent - 1075 (range [11..31])
  EmitMOVRegReg(TempReg2,TempReg3,true);
  EmitShiftRegImm(SHIFT_SHR,TempReg2,52,true);
  EmitImmOp(ALU_AND,TempReg2,$7ff,false);
  EmitImmOp(ALU_SUB,TempReg2,1075,false);
  // Shift 53-bit mantissa left by shift amount to obtain 64-bit integer value
  Emit3RegShiftOp(SHIFT_SHL,aHostIntDest,aHostIntDest,TempReg2,true);
  // Apply sign: extract sign bit (bit 63) from saved raw bits; negate result if negative
  EmitShiftRegImm(SHIFT_SHR,TempReg3,63,true);
  EmitTEST(TempReg3,TempReg3,false);
  EmitJccRel32(CC_E,0);
  SignDone:=fTemporaryCodeSize-4;
  EmitNEG(aHostIntDest,true);
  PatchJmpRel32(SignDone);
  // Sign-extend low 32 bits to 64 bits (modular i32 result)
  EmitMOVSXD(aHostIntDest,aHostIntDest);
  EmitJmpRel32(0);
  LargeExpDone:=fTemporaryCodeSize-4;
  // Result = 0: NaN/Inf, |value| < 1, or |value| >= 2^84
  PatchJmpRel32(NaNInf);
  PatchJmpRel32(ZeroSmall);
  PatchJmpRel32(ZeroLarge);
  Emit2RegOp(X86_XOR,aHostIntDest,aHostIntDest,false);
  // Done:
  PatchJmpRel32(FastPathDone);
  PatchJmpRel32(LargeExpDone);
  FreeHostIntRegister(TempReg3);
  FreeHostIntRegister(TempReg2);
  // Call FCvtModWDFlagsHelper(aHART, f64bits) to set fflags
  FreeAllHostIntRegisters;
  EmitNativePush(VMPtrRegister);
{$ifdef Windows}
  EmitSSE2MovXMMToGPR(TPasRISCVUInt8(ord(TX64Register.rRDX)),aHostFPUSrc,true);
  EmitNativeSetReg64(TPasRISCVUInt8(ord(TX64Register.rR8)),GuestFCvtModWDFlagsHelperAbsoluteOffset);
  EmitNativeLoad(TPasRISCVUInt8(ord(TX64Register.rRCX)),VMPtrRegister,GuestJITHARTOffset,true);
  if (fABIReclaimCount and 1)<>0 then begin
   EmitNativeAddi(TPasRISCVUInt8(ord(TX64Register.rRSP)),TPasRISCVUInt8(ord(TX64Register.rRSP)),-8);
  end;
  EmitNativeAddi(TPasRISCVUInt8(ord(TX64Register.rRSP)),TPasRISCVUInt8(ord(TX64Register.rRSP)),-32);
  EmitCallReg(TPasRISCVUInt8(ord(TX64Register.rR8)));
  EmitNativeAddi(TPasRISCVUInt8(ord(TX64Register.rRSP)),TPasRISCVUInt8(ord(TX64Register.rRSP)),32);
  if (fABIReclaimCount and 1)<>0 then begin
   EmitNativeAddi(TPasRISCVUInt8(ord(TX64Register.rRSP)),TPasRISCVUInt8(ord(TX64Register.rRSP)),8);
  end;
{$else}
  EmitSSE2MovXMMToGPR(TPasRISCVUInt8(ord(TX64Register.rRSI)),aHostFPUSrc,true);
  EmitNativeSetReg64(TPasRISCVUInt8(ord(TX64Register.rRDX)),GuestFCvtModWDFlagsHelperAbsoluteOffset);
  EmitNativeLoad(TPasRISCVUInt8(ord(TX64Register.rRDI)),VMPtrRegister,GuestJITHARTOffset,true);
  if (fABIReclaimCount and 1)<>0 then begin
   EmitNativeAddi(TPasRISCVUInt8(ord(TX64Register.rRSP)),TPasRISCVUInt8(ord(TX64Register.rRSP)),-8);
  end;
  EmitCallReg(TPasRISCVUInt8(ord(TX64Register.rRDX)));
  if (fABIReclaimCount and 1)<>0 then begin
   EmitNativeAddi(TPasRISCVUInt8(ord(TX64Register.rRSP)),TPasRISCVUInt8(ord(TX64Register.rRSP)),8);
  end;
{$endif}
  EmitNativePop(VMPtrRegister);
 end;
end;

