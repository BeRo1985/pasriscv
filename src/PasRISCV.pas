     if (F64Bits and TPasRISCVUInt64($7fffffffffffffff))<>0 then begin
      // nonzero: RTZ gives 0, ROD forces bit 0
      F32Result:=(F64Sign shl 31) or 1;
      FFlags:=FFlags or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Inexact) or TPasRISCVUInt8(TCSR.TFPUExceptionMasks.Underflow);
     end else begin
      // zero: copy sign, no flags
