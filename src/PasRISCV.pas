 FreeAndNil(fThread);

 FreeAndNil(fWakeEvent);

 FreeAndNil(fLock);

 FreeAndNil(fRNLNetwork);
 FreeAndNil(fRNLInstance);

 inherited Destroy;
end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.Shutdown;
var Index:TPasRISCVInt32;
begin

 if assigned(fThread) then begin

  try
   fThread.Shutdown;
  finally
   FreeAndNil(fThread);
  end;

  while fSendQueueReadIndex<>fSendQueueWriteIndex do begin
   if assigned(fSendQueue[fSendQueueReadIndex].Data) then begin
    try
     FreeMem(fSendQueue[fSendQueueReadIndex].Data);
    finally
     fSendQueue[fSendQueueReadIndex].Data:=nil;
    end;
   end;
   fSendQueueReadIndex:=(fSendQueueReadIndex+1) and SendQueueMask;
  end;

 end;

 for Index:=0 to fICMPActiveCount-1 do begin
{$ifdef PasRISCVUseRNLNetworkInstance}
  fRNLNetwork.SocketDestroy(fICMPSessionArray[fICMPActiveIndices[Index]].SocketFileDescriptor);
{$else}
  RNLSocketDestroy(fICMPSessionArray[fICMPActiveIndices[Index]].SocketFileDescriptor);
{$endif}
 end;

 for Index:=0 to fUDPActiveCount-1 do begin
{$ifdef PasRISCVUseRNLNetworkInstance}
  fRNLNetwork.SocketDestroy(fUDPSessionArray[fUDPActiveIndices[Index]].SocketFileDescriptor);
{$else}
  RNLSocketDestroy(fUDPSessionArray[fUDPActiveIndices[Index]].SocketFileDescriptor);
{$endif}
 end;

 for Index:=0 to fTCPActiveCount-1 do begin
{$ifdef PasRISCVUseRNLNetworkInstance}
  fRNLNetwork.SocketDestroy(fTCPSessionArray[fTCPActiveIndices[Index]].SocketFileDescriptor);
{$else}
  RNLSocketDestroy(fTCPSessionArray[fTCPActiveIndices[Index]].SocketFileDescriptor);
{$endif}
  if assigned(fTCPSessionArray[fTCPActiveIndices[Index]].RetransmitData) then begin
   FreeMem(fTCPSessionArray[fTCPActiveIndices[Index]].RetransmitData);
   fTCPSessionArray[fTCPActiveIndices[Index]].RetransmitData:=nil;
  end;
  if assigned(fTCPSessionArray[fTCPActiveIndices[Index]].PendingData) then begin
   FreeMem(fTCPSessionArray[fTCPActiveIndices[Index]].PendingData);
   fTCPSessionArray[fTCPActiveIndices[Index]].PendingData:=nil;
   fTCPSessionArray[fTCPActiveIndices[Index]].PendingCapacity:=0;
  end;
 end;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.Reset;
begin
 // Runs on the HART thread, so it only posts the request and wakes the network thread,
 // which owns the session tables and does the actual teardown in ProcessReset.
 TPasMPInterlocked.Write(fResetPending,TPasMPUInt32(1));
 if assigned(fWakeEvent) then begin
  fWakeEvent.SetEvent;
 end;
end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.ProcessReset;
var Index:TPasRISCVInt32;
begin

 // Everything below belonged to the previous boot of the guest. A rebooted guest knows
 // nothing about the old connections, and a DHCP lease still held for its MAC makes it
 // wait for the lease to expire instead of being served right away, which is what
 // "networking only comes back after a while" after a reboot looks like.

 while fTCPActiveCount>0 do begin
  // No RST: the peer that would receive it is the guest, and it is already gone
  CloseTCPSession(fTCPActiveIndices[fTCPActiveCount-1],false);
 end;
 while fUDPActiveCount>0 do begin
  CloseUDPSession(fUDPActiveIndices[fUDPActiveCount-1]);
 end;
 while fICMPActiveCount>0 do begin
  CloseICMPSession(fICMPActiveIndices[fICMPActiveCount-1]);
 end;

 while fTCPv6ActiveCount>0 do begin
  CloseTCPv6Session(fTCPv6ActiveIndices[fTCPv6ActiveCount-1],false);
 end;
 while fUDPv6ActiveCount>0 do begin
  CloseUDPv6Session(fUDPv6ActiveIndices[fUDPv6ActiveCount-1]);
 end;
 while fICMPv6ActiveCount>0 do begin
  CloseICMPv6Session(fICMPv6ActiveIndices[fICMPv6ActiveCount-1]);
 end;

 for Index:=0 to High(fIPv6FragmentReassemblyTable) do begin
  ClearIPv6FragmentReassemblyEntry(Index);
 end;

 fToCloseCount:=0;

 FillChar(fDHCPLeases,SizeOf(fDHCPLeases),#0);
 FillChar(fGuestMAC,SizeOf(fGuestMAC),#0);

 // Frames the guest queued before the reset are stale as well
 fLock.Acquire;
 try
  while fSendQueueReadIndex<>fSendQueueWriteIndex do begin
   if assigned(fSendQueue[fSendQueueReadIndex].Data) then begin
    try
     FreeMem(fSendQueue[fSendQueueReadIndex].Data);
    finally
     fSendQueue[fSendQueueReadIndex].Data:=nil;
    end;
   end;
   fSendQueueReadIndex:=(fSendQueueReadIndex+1) and SendQueueMask;
  end;
 finally
  fLock.Release;
 end;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.Start;
begin
 if not assigned(fThread) then begin
  fThread:=TNetworkThread.Create(self);
 end;
end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.WritePacket(const aBuffer:Pointer;const aBufferSize:TPasRISCVSizeInt);
var Packet:TSendPacket;
    WriteNext:TPasRISCVInt32;
begin

 if (aBufferSize<=0) or (aBufferSize>65536) then begin
  exit;
 end;

 Packet.Data:=nil;
 Packet.Size:=aBufferSize;
 GetMem(Packet.Data,aBufferSize);
 Move(aBuffer^,Packet.Data^,aBufferSize);

 fLock.Acquire;
 try
  WriteNext:=(fSendQueueWriteIndex+1) and SendQueueMask;
  if WriteNext<>fSendQueueReadIndex then begin
   fSendQueue[fSendQueueWriteIndex]:=Packet;
   fSendQueueWriteIndex:=WriteNext;
   Packet.Data:=nil;
  end;
 finally
  fLock.Release;
 end;

 if assigned(Packet.Data) then begin
  FreeMem(Packet.Data);
 end else begin
  fWakeEvent.SetEvent;
 end;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.ThreadProc;
const AllNodesMulticastMAC:TMACAddress=($33,$33,$00,$00,$00,$01);
      AllNodesMulticastIPv6:TIPv6Address=($ff,$02,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01);
var Packet:TSendPacket;
{$ifdef PasRISCVNATSocketSelect}
    SelectReadSet:TRNLSocketSet;
    SelectWriteSet:TRNLSocketSet;
    SelectMaxSocket:TRNLSocket;
    SelectHasSockets:Boolean;
    SelectIndex:TPasRISCVInt32;
    SelectSessionIndex:TPasRISCVInt32;
    SelectCount:TPasRISCVInt32;
    SelectForwardItem:PUserModePortForward;
    SelectTCPSession:PTCPSession;
    SelectTCPv6Session:PTCPv6Session;
    MustWait:Boolean;
{$endif}
begin

 while not fThread.Terminated do begin

  // A reset posted by the guest side is serviced here, where the session tables are
  // owned, before any socket of the previous boot is looked at again
  if TPasMPInterlocked.Exchange(fResetPending,TPasMPUInt32(0))<>0 then begin
   ProcessReset;
  end;

{$ifdef PasRISCVNATSocketSelect}

  SelectReadSet.Clear;
  SelectWriteSet.Clear;
  SelectMaxSocket:=0;
  SelectHasSockets:=false;
  SelectCount:=0;
  MustWait:=false;

  for SelectIndex:=0 to fICMPActiveCount-1 do begin
   SelectSessionIndex:=fICMPActiveIndices[SelectIndex];
   if fICMPSessionArray[SelectSessionIndex].SocketFileDescriptor<>RNL_SOCKET_NULL then begin
    if SelectCount<FD_SETSIZE then begin
     inc(SelectCount);
     SelectReadSet.Add(fICMPSessionArray[SelectSessionIndex].SocketFileDescriptor);
     if fICMPSessionArray[SelectSessionIndex].SocketFileDescriptor>SelectMaxSocket then begin
      SelectMaxSocket:=fICMPSessionArray[SelectSessionIndex].SocketFileDescriptor;
     end;
     SelectHasSockets:=true;
    end else begin
     MustWait:=true;
    end;
   end;
  end;

  for SelectIndex:=0 to fUDPActiveCount-1 do begin
   SelectSessionIndex:=fUDPActiveIndices[SelectIndex];
   if fUDPSessionArray[SelectSessionIndex].SocketFileDescriptor<>RNL_SOCKET_NULL then begin
    if SelectCount<FD_SETSIZE then begin
     inc(SelectCount);
     SelectReadSet.Add(fUDPSessionArray[SelectSessionIndex].SocketFileDescriptor);
     if fUDPSessionArray[SelectSessionIndex].SocketFileDescriptor>SelectMaxSocket then begin
      SelectMaxSocket:=fUDPSessionArray[SelectSessionIndex].SocketFileDescriptor;
     end;
     SelectHasSockets:=true;
    end else begin
     MustWait:=true;
    end;
   end;
  end;

  for SelectIndex:=0 to fTCPActiveCount-1 do begin
   SelectSessionIndex:=fTCPActiveIndices[SelectIndex];
   SelectTCPSession:=@fTCPSessionArray[SelectSessionIndex];
   if SelectTCPSession^.SocketFileDescriptor<>RNL_SOCKET_NULL then begin
    if SelectCount<FD_SETSIZE then begin
     inc(SelectCount);
     if SelectTCPSession^.State=UserModeTCPStateConnecting then begin
      SelectWriteSet.Add(SelectTCPSession^.SocketFileDescriptor);
     end else begin
      SelectReadSet.Add(SelectTCPSession^.SocketFileDescriptor);
     end;
     if SelectTCPSession^.SocketFileDescriptor>SelectMaxSocket then begin
      SelectMaxSocket:=SelectTCPSession^.SocketFileDescriptor;
     end;
     SelectHasSockets:=true;
    end else begin
     MustWait:=true;
    end;
   end;
  end;

  for SelectIndex:=0 to fUDPv6ActiveCount-1 do begin
   SelectSessionIndex:=fUDPv6ActiveIndices[SelectIndex];
   if fUDPv6SessionArray[SelectSessionIndex].SocketFileDescriptor<>RNL_SOCKET_NULL then begin
    if SelectCount<FD_SETSIZE then begin
     inc(SelectCount);
     SelectReadSet.Add(fUDPv6SessionArray[SelectSessionIndex].SocketFileDescriptor);
     if fUDPv6SessionArray[SelectSessionIndex].SocketFileDescriptor>SelectMaxSocket then begin
      SelectMaxSocket:=fUDPv6SessionArray[SelectSessionIndex].SocketFileDescriptor;
     end;
     SelectHasSockets:=true;
    end else begin
     MustWait:=true;
    end;
   end;
  end;

  for SelectIndex:=0 to fTCPv6ActiveCount-1 do begin
   SelectSessionIndex:=fTCPv6ActiveIndices[SelectIndex];
   SelectTCPv6Session:=@fTCPv6SessionArray[SelectSessionIndex];
   if SelectTCPv6Session^.SocketFileDescriptor<>RNL_SOCKET_NULL then begin
    if SelectCount<FD_SETSIZE then begin
     inc(SelectCount);
     if SelectTCPv6Session^.State=UserModeTCPStateConnecting then begin
      SelectWriteSet.Add(SelectTCPv6Session^.SocketFileDescriptor);
     end else begin
      SelectReadSet.Add(SelectTCPv6Session^.SocketFileDescriptor);
     end;
     if SelectTCPv6Session^.SocketFileDescriptor>SelectMaxSocket then begin
      SelectMaxSocket:=SelectTCPv6Session^.SocketFileDescriptor;
     end;
     SelectHasSockets:=true;
    end else begin
     MustWait:=true;
    end;
   end;
  end;

  for SelectIndex:=0 to fPortForwardCount-1 do begin
   SelectForwardItem:=@fPortForwards[SelectIndex];
   if SelectForwardItem^.ListenFileDescriptor<>RNL_SOCKET_NULL then begin
    if SelectCount<FD_SETSIZE then begin
     inc(SelectCount);
     SelectReadSet.Add(SelectForwardItem^.ListenFileDescriptor);
     if SelectForwardItem^.ListenFileDescriptor>SelectMaxSocket then begin
      SelectMaxSocket:=SelectForwardItem^.ListenFileDescriptor;
     end;
     SelectHasSockets:=true;
    end else begin
     MustWait:=true;
    end;
   end;
  end;

  if MustWait then begin
   fWakeEvent.WaitFor(1);
  end else if SelectHasSockets then begin
   fRNLNetwork.SocketSelect(SelectMaxSocket,SelectReadSet,SelectWriteSet,1);
  end else begin
   fWakeEvent.WaitFor(10);
  end;

{$else}
  if (fICMPActiveCount>0) or (fUDPActiveCount>0) or (fTCPActiveCount>0) or
     (fUDPv6ActiveCount>0) or (fTCPv6ActiveCount>0) or
     (fSendQueueReadIndex<>fSendQueueWriteIndex) then begin
   fWakeEvent.WaitFor(1);
  end else begin
   fWakeEvent.WaitFor(10);
  end;
{$endif}

  repeat

   Packet.Data:=nil;
   Packet.Size:=0;

   fLock.Acquire;
   try
    if fSendQueueReadIndex<>fSendQueueWriteIndex then begin
     Packet:=fSendQueue[fSendQueueReadIndex];
     fSendQueue[fSendQueueReadIndex].Data:=nil;
     fSendQueueReadIndex:=(fSendQueueReadIndex+1) and SendQueueMask;
    end;
   finally
    fLock.Release;
   end;

   if assigned(Packet.Data) then begin
    try
     DispatchEthernetFrame(Packet.Data,Packet.Size);
    finally
     FreeMem(Packet.Data);
    end;
   end;

  until not assigned(Packet.Data);

  AdvanceUserModeTicks;

  PollICMPSockets;
  PollUDPSockets;
  PollTCPSockets;

  if fUserModeIPv6Enabled then begin
   ExpireIPv6FragmentReassemblies;
   PollICMPv6Sockets;
   PollUDPv6Sockets;
   PollTCPv6Sockets;
   inc(fIPv6RATickCount,fUserModeTickDelta);
   if fIPv6RATickCount>=20000 then begin
    fIPv6RATickCount:=0;
    SendRouterAdvertisement(AllNodesMulticastMAC,AllNodesMulticastIPv6);
   end;
  end;

 end;

end;

function TPasRISCVEthernetDeviceUserModeNetworking.UserModeIPChecksum(const aData:Pointer;const aSize:TPasRISCVSizeInt):TPasRISCVUInt16;
var Sum:TPasRISCVUInt32;
    DataPointer:PPasRISCVUInt8;
    Index:TPasRISCVSizeInt;
begin

 Sum:=0;
 DataPointer:=PPasRISCVUInt8(aData);
 Index:=0;

 while (Index+1)<aSize do begin
  Sum:=Sum+(TPasRISCVUInt32(DataPointer^) shl 8);
  inc(DataPointer);
  Sum:=Sum+DataPointer^;
  inc(DataPointer);
  inc(Index,2);
 end;

 if Index<aSize then begin
  Sum:=Sum+(TPasRISCVUInt32(DataPointer^) shl 8);
 end;

 while (Sum shr 16)<>0 do begin
  Sum:=(Sum and $ffff)+(Sum shr 16);
 end;

 result:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(not Sum));

end;

function TPasRISCVEthernetDeviceUserModeNetworking.UserModeTCPUDPChecksum(const aSourceIP,aDestinationIP:TIPv4Address;const aProtocol:TPasRISCVUInt8;const aData:Pointer;const aSize:TPasRISCVSizeInt):TPasRISCVUInt16;
var Sum:TPasRISCVUInt32;
    DataPointer:PPasRISCVUInt8;
    Index:TPasRISCVSizeInt;
begin

 Sum:=0;

 Sum:=Sum+(TPasRISCVUInt32(aSourceIP[0]) shl 8)+aSourceIP[1];
 Sum:=Sum+(TPasRISCVUInt32(aSourceIP[2]) shl 8)+aSourceIP[3];

 Sum:=Sum+(TPasRISCVUInt32(aDestinationIP[0]) shl 8)+aDestinationIP[1];
 Sum:=Sum+(TPasRISCVUInt32(aDestinationIP[2]) shl 8)+aDestinationIP[3];

 Sum:=Sum+aProtocol;

 Sum:=Sum+TPasRISCVUInt32(aSize);

 DataPointer:=PPasRISCVUInt8(aData);
 Index:=0;

 while (Index+1)<aSize do begin
  Sum:=Sum+(TPasRISCVUInt32(DataPointer^) shl 8);
  inc(DataPointer);
  Sum:=Sum+DataPointer^;
  inc(DataPointer);
  inc(Index,2);
 end;

 if Index<aSize then begin
  Sum:=Sum+(TPasRISCVUInt32(DataPointer^) shl 8);
 end;

 while (Sum shr 16)<>0 do begin
  Sum:=(Sum and $ffff)+(Sum shr 16);
 end;

 result:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(not Sum));

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.InjectToGuest(const aData:Pointer;const aSize:TPasRISCVSizeInt);
begin
 if assigned(fOnWritePacket) then begin
  fOnWritePacket(aData,aSize);
 end;
end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.DispatchEthernetFrame(const aData:Pointer;const aSize:TPasRISCVSizeInt);
var EthHeader:PEthernetHeader;
begin

 if aSize<UserModeEtherHeaderSize then begin
  exit;
 end;

 EthHeader:=PEthernetHeader(aData);

 fGuestMAC:=EthHeader^.SourceMAC;

 case TRNLEndianness.NetToHost16(EthHeader^.EthernetType) of

  EtherTypeARP:begin
   DispatchARPFrame(EthHeader,
                    Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aData)+UserModeEtherHeaderSize)),
                    aSize-UserModeEtherHeaderSize);
  end;

  EtherTypeIPv4:begin
   DispatchIPv4Frame(EthHeader,
                     Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aData)+UserModeEtherHeaderSize)),
                     aSize-UserModeEtherHeaderSize);
  end;

  EtherTypeIPv6:begin
   DispatchIPv6Frame(EthHeader,
                     Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aData)+UserModeEtherHeaderSize)),
                     aSize-UserModeEtherHeaderSize);
  end;

  else begin
  end;

 end;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.DispatchARPFrame(const aEthHeader:PEthernetHeader;const aARPData:Pointer;const aARPSize:TPasRISCVSizeInt);
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
      GatewayIP:TIPv4Address=(10,0,2,2);
      DNSIP:TIPv4Address=(10,0,2,3);
var ARPPacket:PARPPacket;
    ResponseEthernet:PEthernetHeader;
    ResponseARP:PARPPacket;
begin

 if aARPSize<UserModeARPPacketSize then begin
  exit;
 end;

 ARPPacket:=PARPPacket(aARPData);

 if (TRNLEndianness.NetToHost16(ARPPacket^.HType)<>1) or
    (TRNLEndianness.NetToHost16(ARPPacket^.PType)<>$0800) or
    (ARPPacket^.HLen<>6) or
    (ARPPacket^.PLen<>4) or
    (TRNLEndianness.NetToHost16(ARPPacket^.Operation)<>1) then begin
  exit;
 end;

 if not (CompareMem(@ARPPacket^.TargetIP,@GatewayIP,4) or
         CompareMem(@ARPPacket^.TargetIP,@DNSIP,4)) then begin
  exit;
 end;

 FillChar(fFrameBuffer[0],UserModeEtherHeaderSize+UserModeARPPacketSize,0);

 ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);
 ResponseARP:=PARPPacket(@fFrameBuffer[UserModeEtherHeaderSize]);

 ResponseEthernet^.DestinationMAC:=aEthHeader^.SourceMAC;
 ResponseEthernet^.SourceMAC:=GatewayMAC;
 ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeARP);

 ResponseARP^.HType:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(1));
 ResponseARP^.PType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);
 ResponseARP^.HLen:=6;
 ResponseARP^.PLen:=4;
 ResponseARP^.Operation:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(2));
 ResponseARP^.SenderMAC:=GatewayMAC;
 ResponseARP^.SenderIP:=ARPPacket^.TargetIP;
 ResponseARP^.TargetMAC:=aEthHeader^.SourceMAC;
 ResponseARP^.TargetIP:=ARPPacket^.SenderIP;

 InjectToGuest(@fFrameBuffer[0],UserModeEtherHeaderSize+UserModeARPPacketSize);

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.DispatchIPv4Frame(const aEthHeader:PEthernetHeader;const aIPData:Pointer;const aIPSize:TPasRISCVSizeInt);
const TracerouteGatewayIP:TIPv4Address=(10,0,2,2);
      TracerouteDNSIP:TIPv4Address=(10,0,2,3);
var IPHeader:PIPv4Header;
    HeaderLength:TPasRISCVSizeInt;
    TotalLength:TPasRISCVSizeInt;
    PayloadData:Pointer;
    PayloadSize:TPasRISCVSizeInt;
    FlagsFragment:TPasRISCVUInt16;
begin

 if aIPSize<UserModeIPv4HeaderSize then begin
  exit;
 end;

 IPHeader:=PIPv4Header(aIPData);

 if (IPHeader^.VersionIHL shr 4)<>4 then begin
  exit;
 end;

 HeaderLength:=TPasRISCVSizeInt(IPHeader^.VersionIHL and $f) shl 2;

 if (HeaderLength<UserModeIPv4HeaderSize) or (aIPSize<HeaderLength) then begin
  exit;
 end;

 if UserModeIPChecksum(IPHeader,HeaderLength)<>0 then begin
  exit;
 end;

 TotalLength:=TRNLEndianness.NetToHost16(IPHeader^.TotalLength);
 if (TotalLength<HeaderLength) or (TotalLength>aIPSize) then begin
  exit;
 end;

 FlagsFragment:=TRNLEndianness.NetToHost16(IPHeader^.FlagsFragment);
 if ((FlagsFragment and $2000)<>0) or
    ((FlagsFragment and $1fff)<>0) then begin
  exit;
 end;

 PayloadData:=Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aIPData)+TPasRISCVPtrUInt(HeaderLength)));
 PayloadSize:=TotalLength-HeaderLength;

 if (IPHeader^.DestinationIP[0]>=224) and (IPHeader^.DestinationIP[0]<=239) then begin
  exit;
 end;

 // A router decrements the TTL of what it forwards and reports an expiry back to
 // the sender; this NAT does neither, because it terminates every connection at
 // the host and there are no hops of its own. With the option on we answer the
 // TTL ladder as the gateway, which is what makes traceroute show anything at
 // all. Packets addressed to the gateway or the DNS server are for us, not
 // forwarded, so they keep passing regardless of their TTL.
 if fUserModeTracerouteEnabled and
    (IPHeader^.TTL<=1) and
    not (CompareMem(@IPHeader^.DestinationIP,@TracerouteGatewayIP,4) or
         CompareMem(@IPHeader^.DestinationIP,@TracerouteDNSIP,4)) then begin
  SendICMPTimeExceeded(IPHeader,PayloadData,PayloadSize);
  exit;
 end;

 case IPHeader^.Protocol of

  IPProtocolICMP:begin
   HandleICMP(aEthHeader,IPHeader,PayloadData,PayloadSize);
  end;

  IPProtocolUDP:begin
   HandleUDP(aEthHeader,IPHeader,PayloadData,PayloadSize);
  end;

  IPProtocolTCP:begin
   HandleTCP(aEthHeader,IPHeader,PayloadData,PayloadSize);
  end;

 end;

end;

function TPasRISCVEthernetDeviceUserModeNetworking.FindOrCreateICMPSession(const aGuestIdentifier:TPasRISCVUInt16;const aGuestSourceIP:TIPv4Address;const aOriginalIPHeader:PIPv4Header;const aICMPData:Pointer;const aICMPSize:TPasRISCVSizeInt):TRNLSocket;
var ICMPKey:TUserModeICMPKey;
    SessionIndex:TPasRISCVInt32;
    ExtraIndex:TPasRISCVInt32;
    ActiveArrayIndex:TPasRISCVInt32;
    OldestSessionIndex:TPasRISCVInt32;
    OldestTickCount:TPasRISCVUInt32;
    SessionItem:PICMPSession;
    BindAddress:TRNLAddress;
begin

 FillChar(ICMPKey,SizeOf(TUserModeICMPKey),#0);
 ICMPKey.GuestSourceIP:=aGuestSourceIP;
 ICMPKey.GuestIdentifier:=aGuestIdentifier;

 if fICMPSessions.TryGet(ICMPKey,SessionIndex) then begin
  fICMPSessionArray[SessionIndex].GuestSourceIP:=aGuestSourceIP;
  fICMPSessionArray[SessionIndex].OriginalIPHeader:=aOriginalIPHeader^;
  if aICMPSize>=UserModeICMPHeaderSize then begin
   Move(aICMPData^,fICMPSessionArray[SessionIndex].OriginalICMPHeader,UserModeICMPHeaderSize);
  end;
  fICMPSessionArray[SessionIndex].TickCount:=0;
  result:=fICMPSessionArray[SessionIndex].SocketFileDescriptor;
  exit;
 end;

 if (UserModeICMPMaxSessions>0) and (fICMPActiveCount>=UserModeICMPMaxSessions) then begin
  OldestSessionIndex:=-1;
  OldestTickCount:=0;
  for ActiveArrayIndex:=0 to fICMPActiveCount-1 do begin
   SessionIndex:=fICMPActiveIndices[ActiveArrayIndex];
   if (OldestSessionIndex<0) or (fICMPSessionArray[SessionIndex].TickCount>OldestTickCount) then begin
    OldestSessionIndex:=SessionIndex;
    OldestTickCount:=fICMPSessionArray[SessionIndex].TickCount;
   end;
  end;
  if OldestSessionIndex<0 then begin
   result:=RNL_SOCKET_NULL;
   exit;
  end;
  CloseICMPSession(OldestSessionIndex);
 end;

 if not fICMPFreeList.Dequeue(SessionIndex) then begin
  SessionIndex:=length(fICMPSessionArray);
  SetLength(fICMPSessionArray,TPasRISCVInt32(SessionIndex+1)*2);
  for ExtraIndex:=SessionIndex+1 to length(fICMPSessionArray)-1 do begin
   fICMPFreeList.Enqueue(ExtraIndex);
  end;
 end;

 SessionItem:=@fICMPSessionArray[SessionIndex];
 FillChar(SessionItem^,SizeOf(TICMPSession),#0);

{$if defined(Windows)}
{$ifdef PasRISCVUseRNLNetworkInstance}
 SessionItem^.SocketFileDescriptor:=fRNLNetwork.SocketCreateWithProtocol(RNL_SOCKET_TYPE_RAW,RNL_IPV4,IPPROTO_ICMP);
{$else}
 SessionItem^.SocketFileDescriptor:=RNLSocketCreateWithProtocol(RNL_SOCKET_TYPE_RAW,RNL_IPV4,IPPROTO_ICMP);
{$endif}
{$else}
{$ifdef PasRISCVUseRNLNetworkInstance}
 SessionItem^.SocketFileDescriptor:=fRNLNetwork.SocketCreateWithProtocol(RNL_SOCKET_TYPE_DATAGRAM,RNL_IPV4,IPPROTO_ICMP);
{$else}
 SessionItem^.SocketFileDescriptor:=RNLSocketCreateWithProtocol(RNL_SOCKET_TYPE_DATAGRAM,RNL_IPV4,IPPROTO_ICMP);
{$endif}
{$ifend}
 if SessionItem^.SocketFileDescriptor=RNL_SOCKET_NULL then begin
  fICMPSocketAvailable:=false;
  fICMPFreeList.Enqueue(SessionIndex);
  result:=RNL_SOCKET_NULL;
  exit;
 end;

{$ifdef PasRISCVUseRNLNetworkInstance}
 fRNLNetwork.SocketSetOption(SessionItem^.SocketFileDescriptor,RNL_SOCKET_OPTION_NONBLOCK,1);
{$else}
 RNLSocketSetNonBlock(SessionItem^.SocketFileDescriptor);
{$endif}

 BindAddress:=RNL_ADDRESS_EMPTY;
 BindAddress.Port:=TRNLEndianness.NetToHost16(aGuestIdentifier);
 if not {$ifdef PasRISCVUseRNLNetworkInstance}fRNLNetwork.SocketBind(SessionItem^.SocketFileDescriptor,@BindAddress,RNL_IPV4){$else}RNLSocketBind(SessionItem^.SocketFileDescriptor,@BindAddress,RNL_IPV4){$endif} then begin
{$ifdef PasRISCVUseRNLNetworkInstance}
  fRNLNetwork.SocketDestroy(SessionItem^.SocketFileDescriptor);
{$else}
  RNLSocketDestroy(SessionItem^.SocketFileDescriptor);
{$endif}
  fICMPFreeList.Enqueue(SessionIndex);
  result:=RNL_SOCKET_NULL;
  exit;
 end;

 SessionItem^.Active:=true;
 SessionItem^.GuestIdentifier:=aGuestIdentifier;
 SessionItem^.GuestSourceIP:=aGuestSourceIP;
 SessionItem^.OriginalIPHeader:=aOriginalIPHeader^;
 if aICMPSize>=UserModeICMPHeaderSize then begin
  Move(aICMPData^,SessionItem^.OriginalICMPHeader,UserModeICMPHeaderSize);
 end;

 if fICMPActiveCount>=fICMPActiveCapacity then begin
  if fICMPActiveCapacity=0 then begin
   fICMPActiveCapacity:=8;
  end else begin
   fICMPActiveCapacity:=fICMPActiveCapacity*2;
  end;
  SetLength(fICMPActiveIndices,fICMPActiveCapacity);
 end;
 SessionItem^.ActiveIndex:=fICMPActiveCount;
 fICMPActiveIndices[fICMPActiveCount]:=SessionIndex;
 inc(fICMPActiveCount);

 fICMPSessions.Add(ICMPKey,SessionIndex);

 result:=SessionItem^.SocketFileDescriptor;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.EmulateICMPEchoReply(const aIPHeader:PIPv4Header;const aICMPData:Pointer;const aICMPSize:TPasRISCVSizeInt);
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
var TotalSize:TPasRISCVSizeInt;
    ResponseEthernet:PEthernetHeader;
    ResponseIP:PIPv4Header;
    ResponseICMP:PICMPHeader;
begin

 TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+aICMPSize;

 FillChar(fFrameBuffer[0],TotalSize,#0);

 ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);

 ResponseIP:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));

 ResponseICMP:=PICMPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize)));

 ResponseEthernet^.DestinationMAC:=fGuestMAC;
 ResponseEthernet^.SourceMAC:=GatewayMAC;
 ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

 ResponseIP^.VersionIHL:=$45;
 ResponseIP^.DSCP_ECN:=0;
 ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+aICMPSize));

 inc(fIPIDCounter);

 ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
 ResponseIP^.FlagsFragment:=0;
 ResponseIP^.TTL:=64;
 ResponseIP^.Protocol:=IPProtocolICMP;
 ResponseIP^.HeaderChecksum:=0;
 ResponseIP^.SourceIP:=aIPHeader^.DestinationIP;
 ResponseIP^.DestinationIP:=aIPHeader^.SourceIP;
 ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);

 Move(aICMPData^,fFrameBuffer[UserModeEtherHeaderSize+UserModeIPv4HeaderSize],aICMPSize);

 ResponseICMP^.ICMPType:=ICMPTypeEchoReply;
 ResponseICMP^.Code:=0;
 ResponseICMP^.Checksum:=0;
 ResponseICMP^.Checksum:=UserModeIPChecksum(ResponseICMP,aICMPSize);

 InjectToGuest(@fFrameBuffer[0],TotalSize);

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.SendICMPDestinationUnreachable(const aIPHeader:PIPv4Header;const aICMPData:Pointer;const aICMPSize:TPasRISCVSizeInt);
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
var OrigDataSize:TPasRISCVSizeInt;
    ICMPPayloadSize:TPasRISCVSizeInt;
    TotalSize:TPasRISCVSizeInt;
    ResponseEthernet:PEthernetHeader;
    ResponseIP:PIPv4Header;
    ResponseICMP:PICMPHeader;
    OrigIPCopy:PIPv4Header;
begin

 OrigDataSize:=aICMPSize;
 if OrigDataSize>8 then begin
  OrigDataSize:=8;
 end;

 ICMPPayloadSize:=UserModeICMPHeaderSize+UserModeIPv4HeaderSize+OrigDataSize;

 TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+ICMPPayloadSize;

 FillChar(fFrameBuffer[0],TotalSize,#0);

 ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);

 ResponseIP:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));

 ResponseICMP:=PICMPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize)));

 OrigIPCopy:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeICMPHeaderSize)));

 ResponseEthernet^.DestinationMAC:=fGuestMAC;
 ResponseEthernet^.SourceMAC:=GatewayMAC;
 ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

 ResponseIP^.VersionIHL:=$45;
 ResponseIP^.DSCP_ECN:=0;
 ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+ICMPPayloadSize));

 inc(fIPIDCounter);

 ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
 ResponseIP^.FlagsFragment:=0;
 ResponseIP^.TTL:=64;
 ResponseIP^.Protocol:=IPProtocolICMP;
 ResponseIP^.HeaderChecksum:=0;
 ResponseIP^.SourceIP:=aIPHeader^.DestinationIP;
 ResponseIP^.DestinationIP:=aIPHeader^.SourceIP;
 ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);

 ResponseICMP^.ICMPType:=ICMPTypeDestinationUnreachable;
 ResponseICMP^.Code:=ICMPCodeHostUnreachable;
 ResponseICMP^.Checksum:=0;
 ResponseICMP^.Identifier:=0;
 ResponseICMP^.Sequence:=0;

 Move(aIPHeader^,OrigIPCopy^,UserModeIPv4HeaderSize);

 Move(aICMPData^,Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OrigIPCopy)+UserModeIPv4HeaderSize))^,OrigDataSize);

 ResponseICMP^.Checksum:=UserModeIPChecksum(ResponseICMP,ICMPPayloadSize);

 InjectToGuest(@fFrameBuffer[0],TotalSize);

end;

// Answers an expired TTL as the gateway would. The source is the gateway address,
// because that is the hop that dropped it - using the original destination here
// would make traceroute print the target for every hop.
procedure TPasRISCVEthernetDeviceUserModeNetworking.SendICMPTimeExceeded(const aIPHeader:PIPv4Header;const aPayload:Pointer;const aPayloadSize:TPasRISCVSizeInt);
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
      GatewayIP:TIPv4Address=(10,0,2,2);
var OrigDataSize:TPasRISCVSizeInt;
    ICMPPayloadSize:TPasRISCVSizeInt;
    TotalSize:TPasRISCVSizeInt;
    ResponseEthernet:PEthernetHeader;
    ResponseIP:PIPv4Header;
    ResponseICMP:PICMPHeader;
    OrigIPCopy:PIPv4Header;
begin

 // RFC 792: the original IP header plus the first 8 bytes of its payload, which is
 // what the sender needs to match the reply to the probe it sent
 OrigDataSize:=aPayloadSize;
 if OrigDataSize>8 then begin
  OrigDataSize:=8;
 end;
 if OrigDataSize<0 then begin
  OrigDataSize:=0;
 end;

 ICMPPayloadSize:=UserModeICMPHeaderSize+UserModeIPv4HeaderSize+OrigDataSize;

 TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+ICMPPayloadSize;

 FillChar(fFrameBuffer[0],TotalSize,#0);

 ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);

 ResponseIP:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));

 ResponseICMP:=PICMPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize)));

 OrigIPCopy:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeICMPHeaderSize)));

 ResponseEthernet^.DestinationMAC:=fGuestMAC;
 ResponseEthernet^.SourceMAC:=GatewayMAC;
 ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

 ResponseIP^.VersionIHL:=$45;
 ResponseIP^.DSCP_ECN:=0;
 ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+ICMPPayloadSize));

 inc(fIPIDCounter);

 ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
 ResponseIP^.FlagsFragment:=0;
 ResponseIP^.TTL:=64;
 ResponseIP^.Protocol:=IPProtocolICMP;
 ResponseIP^.HeaderChecksum:=0;
 ResponseIP^.SourceIP:=GatewayIP;
 ResponseIP^.DestinationIP:=aIPHeader^.SourceIP;
 ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);

 ResponseICMP^.ICMPType:=ICMPTypeTimeExceeded;
 ResponseICMP^.Code:=ICMPCodeTTLExceededInTransit;
 ResponseICMP^.Checksum:=0;
 ResponseICMP^.Identifier:=0;
 ResponseICMP^.Sequence:=0;

 Move(aIPHeader^,OrigIPCopy^,UserModeIPv4HeaderSize);

 if OrigDataSize>0 then begin
  Move(aPayload^,Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OrigIPCopy)+UserModeIPv4HeaderSize))^,OrigDataSize);
 end;

 ResponseICMP^.Checksum:=UserModeIPChecksum(ResponseICMP,ICMPPayloadSize);

 InjectToGuest(@fFrameBuffer[0],TotalSize);

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.HandleICMP(const aEthHeader:PEthernetHeader;const aIPHeader:PIPv4Header;const aICMPData:Pointer;const aICMPSize:TPasRISCVSizeInt);
var ICMPHeader:PICMPHeader;
    SocketFileDescriptor:TRNLSocket;
    SendAddress:TRNLAddress;
begin

 if aICMPSize<UserModeICMPHeaderSize then begin
  exit;
 end;

 if UserModeIPChecksum(aICMPData,aICMPSize)<>0 then begin
  exit;
 end;

 ICMPHeader:=PICMPHeader(aICMPData);

 if ICMPHeader^.ICMPType<>ICMPTypeEchoRequest then begin
  exit;
 end;

 if (aIPHeader^.DestinationIP[0]=0) or
    ((aIPHeader^.DestinationIP[0]=255) and (aIPHeader^.DestinationIP[1]=255) and (aIPHeader^.DestinationIP[2]=255) and (aIPHeader^.DestinationIP[3]=255)) then begin
  exit;
 end;

 if fIsolated or not fICMPSocketAvailable then begin
  SendICMPDestinationUnreachable(aIPHeader,aICMPData,aICMPSize);
//EmulateICMPEchoReply(aIPHeader,aICMPData,aICMPSize);
  exit;
 end;

 SocketFileDescriptor:=FindOrCreateICMPSession(ICMPHeader^.Identifier,aIPHeader^.SourceIP,aIPHeader,aICMPData,aICMPSize);
 if SocketFileDescriptor=RNL_SOCKET_NULL then begin
  SendICMPDestinationUnreachable(aIPHeader,aICMPData,aICMPSize);
//EmulateICMPEchoReply(aIPHeader,aICMPData,aICMPSize);
  exit;
 end;

 SendAddress.Host:=TRNLHostAddress.CreateFromIPV4(TRNLUInt32(TRNLPointer(@aIPHeader^.DestinationIP[0])^));
 SendAddress.Port:=0;
 SendAddress.ScopeID:=0;
{$ifdef PasRISCVUseRNLNetworkInstance}
 fRNLNetwork.Send(SocketFileDescriptor,@SendAddress,aICMPData^,aICMPSize,RNL_IPV4);
{$else}
 RNLSocketSend(SocketFileDescriptor,@SendAddress,aICMPData^,aICMPSize,RNL_IPV4);
{$endif}

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.HandleUDP(const aEthHeader:PEthernetHeader;const aIPHeader:PIPv4Header;const aUDPData:Pointer;const aUDPSize:TPasRISCVSizeInt);
var UDPHeader:PUDPHeader;
    UDPLength:TPasRISCVSizeInt;
    PayloadData:Pointer;
    PayloadSize:TPasRISCVSizeInt;
begin

 if aUDPSize<UserModeUDPHeaderSize then begin
  exit;
 end;

 UDPHeader:=PUDPHeader(aUDPData);

 UDPLength:=TRNLEndianness.NetToHost16(UDPHeader^.Length);
 if (UDPLength<UserModeUDPHeaderSize) or (UDPLength>aUDPSize) then begin
  exit;
 end;

 if (UDPHeader^.Checksum<>0) and
    (UserModeTCPUDPChecksum(aIPHeader^.SourceIP,aIPHeader^.DestinationIP,IPProtocolUDP,aUDPData,UDPLength)<>0) then begin
  exit;
 end;

 PayloadData:=Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aUDPData)+UserModeUDPHeaderSize));
 PayloadSize:=UDPLength-UserModeUDPHeaderSize;

 case TRNLEndianness.NetToHost16(UDPHeader^.DestinationPort) of
  DHCPServerPort:begin
   HandleDHCP(aEthHeader,aIPHeader,UDPHeader,PayloadData,PayloadSize);
  end;
  else begin
   ForwardUDP(aEthHeader,aIPHeader,UDPHeader,PayloadData,PayloadSize);
  end;
 end;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.HandleDHCP(const aEthHeader:PEthernetHeader;const aIPHeader:PIPv4Header;const aUDPHeader:PUDPHeader;const aDHCPData:Pointer;const aDHCPSize:TPasRISCVSizeInt);
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
      GatewayIP:TIPv4Address=(10,0,2,2);
//    GuestIP:TIPv4Address=(10,0,2,15);
      DNSIP:TIPv4Address=(10,0,2,3);
      SubnetMask:TIPv4Address=(255,255,255,0);
var InDHCP:PDHCPHeader;
    MessageType:TPasRISCVUInt8;
    OptionCode:TPasRISCVUInt8;
    OptionLength:TPasRISCVUInt8;
    RemainingSize:TPasRISCVSizeInt;
    OptionsPointer:PPasRISCVUInt8;
    OptionsSize:TPasRISCVSizeInt;
    TotalSize:TPasRISCVSizeInt;
    ResponseEthernet:PEthernetHeader;
    ResponseIP:PIPv4Header;
    ResponseUDP:PUDPHeader;
    ResponseDHCP:PDHCPHeader;
    ClientMAC:TMACAddress;
    LeaseIP:TIPv4Address;
    ResponseDestinationIP:TIPv4Address;
    RequestedIP:TIPv4Address;
    LeaseIndex:TPasRISCVInt32;
    SelectedLeaseIndex:TPasRISCVInt32;
    RequestedLeaseIndex:TPasRISCVInt32;
    DeclinedLeaseIndex:TPasRISCVInt32;
    OldestLeaseIndex:TPasRISCVInt32;
    OldestLeaseAge:TPasRISCVUInt32;
    LeaseAge:TPasRISCVUInt32;
    HasRequestedIP:Boolean;
    RenewalRequest:Boolean;
begin

 if aDHCPSize<UserModeDHCPHeaderSize then begin
  exit;
 end;

 InDHCP:=PDHCPHeader(aDHCPData);

 if (InDHCP^.Opcode<>1) or (TRNLEndianness.NetToHost32(InDHCP^.MagicCookie)<>DHCPMagicCookie) then begin
  exit;
 end;

 MessageType:=0;
 HasRequestedIP:=false;
 FillChar(RequestedIP,SizeOf(RequestedIP),#0);
 OptionsPointer:=PPasRISCVUInt8(TPasRISCVPtrUInt(aDHCPData)+UserModeDHCPHeaderSize);
 RemainingSize:=aDHCPSize-UserModeDHCPHeaderSize;

 while RemainingSize>0 do begin
  OptionCode:=OptionsPointer^;
  inc(OptionsPointer);
  dec(RemainingSize);
  if OptionCode=DHCPOptEnd then begin
   break;
  end;
  if OptionCode=0 then begin
   continue;
  end;
  if RemainingSize<1 then begin
   break;
  end;
  OptionLength:=OptionsPointer^;
  inc(OptionsPointer);
  dec(RemainingSize);
  if TPasRISCVSizeInt(OptionLength)>RemainingSize then begin
   break;
  end;
  case OptionCode of
   DHCPOptMsgType:begin
    if OptionLength>=1 then begin
     MessageType:=OptionsPointer^;
    end;
   end;
   DHCPOptRequestedIP:begin
    if OptionLength=4 then begin
     RequestedIP[0]:=PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OptionsPointer)+0)))^;
     RequestedIP[1]:=PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OptionsPointer)+1)))^;
     RequestedIP[2]:=PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OptionsPointer)+2)))^;
     RequestedIP[3]:=PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OptionsPointer)+3)))^;
     HasRequestedIP:=true;
    end;
   end;
  end;
  inc(OptionsPointer,OptionLength);
  dec(RemainingSize,OptionLength);
 end;

 if MessageType=DHCPMsgNAK then begin
  exit;
 end;

 if (MessageType<>DHCPMsgDiscover) and (MessageType<>DHCPMsgRequest) and (MessageType<>DHCPMsgDecline) then begin
  exit;
 end;

 FillChar(ClientMAC,SizeOf(ClientMAC),#0);
 Move(InDHCP^.ClientHWAddr[0],ClientMAC[0],SizeOf(TMACAddress));
 RenewalRequest:=(MessageType=DHCPMsgRequest) and
                 ((InDHCP^.ClientIP[0]<>0) or (InDHCP^.ClientIP[1]<>0) or
                  (InDHCP^.ClientIP[2]<>0) or (InDHCP^.ClientIP[3]<>0));
 RequestedLeaseIndex:=-1;
 if HasRequestedIP and (RequestedIP[0]=10) and (RequestedIP[1]=0) and (RequestedIP[2]=2) and
    (RequestedIP[3]>=UserModeDHCPLeaseStartHost) and (RequestedIP[3]<(UserModeDHCPLeaseStartHost+UserModeDHCPLeaseCount)) then begin
  RequestedLeaseIndex:=RequestedIP[3]-UserModeDHCPLeaseStartHost;
 end;

 if MessageType=DHCPMsgDecline then begin
  DeclinedLeaseIndex:=-1;
  if HasRequestedIP and (RequestedIP[0]=10) and (RequestedIP[1]=0) and (RequestedIP[2]=2) and
     (RequestedIP[3]>=UserModeDHCPLeaseStartHost) and (RequestedIP[3]<(UserModeDHCPLeaseStartHost+UserModeDHCPLeaseCount)) then begin
   DeclinedLeaseIndex:=RequestedIP[3]-UserModeDHCPLeaseStartHost;
  end;
  if DeclinedLeaseIndex<0 then begin
   for LeaseIndex:=0 to UserModeDHCPLeaseCount-1 do begin
    if fDHCPLeases[LeaseIndex].Active and CompareMem(@fDHCPLeases[LeaseIndex].MAC[0],@ClientMAC[0],SizeOf(TMACAddress)) then begin
     DeclinedLeaseIndex:=LeaseIndex;
     break;
    end;
   end;
  end;
  if DeclinedLeaseIndex>=0 then begin
   fDHCPLeases[DeclinedLeaseIndex].Active:=false;
   fDHCPLeases[DeclinedLeaseIndex].Conflicted:=true;
   fDHCPLeases[DeclinedLeaseIndex].MAC:=ClientMAC;
   if HasRequestedIP then begin
    fDHCPLeases[DeclinedLeaseIndex].IP:=RequestedIP;
   end else begin
    fDHCPLeases[DeclinedLeaseIndex].IP[0]:=10;
    fDHCPLeases[DeclinedLeaseIndex].IP[1]:=0;
    fDHCPLeases[DeclinedLeaseIndex].IP[2]:=2;
    fDHCPLeases[DeclinedLeaseIndex].IP[3]:=TPasRISCVUInt8(UserModeDHCPLeaseStartHost+DeclinedLeaseIndex);
   end;
   fDHCPLeases[DeclinedLeaseIndex].ExpiryTick:=fUserModeTickCount+UserModeDHCPConflictTicks;
  end;
  exit;
 end;

 SelectedLeaseIndex:=-1;
 for LeaseIndex:=0 to UserModeDHCPLeaseCount-1 do begin
  if (fDHCPLeases[LeaseIndex].Active or fDHCPLeases[LeaseIndex].Conflicted) and
     (TPasRISCVInt32(fUserModeTickCount-fDHCPLeases[LeaseIndex].ExpiryTick)>=0) then begin
   fDHCPLeases[LeaseIndex].Active:=false;
   fDHCPLeases[LeaseIndex].Conflicted:=false;
  end;
  if fDHCPLeases[LeaseIndex].Active and (not fDHCPLeases[LeaseIndex].Conflicted) and
     CompareMem(@fDHCPLeases[LeaseIndex].MAC[0],@ClientMAC[0],SizeOf(TMACAddress)) then begin
   if SelectedLeaseIndex<0 then begin
    SelectedLeaseIndex:=LeaseIndex;
   end;
  end;
 end;

 if RenewalRequest then begin

  if (SelectedLeaseIndex<0) or
     (not CompareMem(@fDHCPLeases[SelectedLeaseIndex].IP[0],@InDHCP^.ClientIP[0],SizeOf(TIPv4Address))) then begin
   exit;
  end;

 end else begin

  if (MessageType=DHCPMsgDiscover) and (RequestedLeaseIndex>=0) and
     (not fDHCPLeases[RequestedLeaseIndex].Conflicted) and
     ((not fDHCPLeases[RequestedLeaseIndex].Active) or
      CompareMem(@fDHCPLeases[RequestedLeaseIndex].MAC[0],@ClientMAC[0],SizeOf(TMACAddress))) then begin
   if (SelectedLeaseIndex>=0) and (SelectedLeaseIndex<>RequestedLeaseIndex) then begin
    fDHCPLeases[SelectedLeaseIndex].Active:=false;
   end;
   SelectedLeaseIndex:=RequestedLeaseIndex;
  end;

  if SelectedLeaseIndex<0 then begin
   for LeaseIndex:=0 to UserModeDHCPLeaseCount-1 do begin
    if not (fDHCPLeases[LeaseIndex].Active or fDHCPLeases[LeaseIndex].Conflicted) then begin
     SelectedLeaseIndex:=LeaseIndex;
     break;
    end;
   end;
  end;

  if SelectedLeaseIndex<0 then begin
   OldestLeaseIndex:=-1;
   OldestLeaseAge:=0;
   for LeaseIndex:=0 to UserModeDHCPLeaseCount-1 do begin
    if not fDHCPLeases[LeaseIndex].Conflicted then begin
     LeaseAge:=fUserModeTickCount-fDHCPLeases[LeaseIndex].ExpiryTick;
     if (OldestLeaseIndex<0) or (LeaseAge>OldestLeaseAge) then begin
      OldestLeaseAge:=LeaseAge;
      OldestLeaseIndex:=LeaseIndex;
     end;
    end;
   end;
   if OldestLeaseIndex<0 then begin
    OldestLeaseIndex:=0;
    OldestLeaseAge:=fUserModeTickCount-fDHCPLeases[0].ExpiryTick;
    for LeaseIndex:=1 to UserModeDHCPLeaseCount-1 do begin
     LeaseAge:=fUserModeTickCount-fDHCPLeases[LeaseIndex].ExpiryTick;
     if LeaseAge>OldestLeaseAge then begin
      OldestLeaseAge:=LeaseAge;
      OldestLeaseIndex:=LeaseIndex;
     end;
    end;
   end;
   SelectedLeaseIndex:=OldestLeaseIndex;
  end;
 end;

 LeaseIP[0]:=10;
 LeaseIP[1]:=0;
 LeaseIP[2]:=2;
 LeaseIP[3]:=TPasRISCVUInt8(UserModeDHCPLeaseStartHost+SelectedLeaseIndex);

 fDHCPLeases[SelectedLeaseIndex].Active:=true;
 fDHCPLeases[SelectedLeaseIndex].Conflicted:=false;
 fDHCPLeases[SelectedLeaseIndex].MAC:=ClientMAC;
 fDHCPLeases[SelectedLeaseIndex].IP:=LeaseIP;
 fDHCPLeases[SelectedLeaseIndex].ExpiryTick:=fUserModeTickCount+UserModeDHCPLeaseTimeTicks;

 ResponseDestinationIP[0]:=255;
 ResponseDestinationIP[1]:=255;
 ResponseDestinationIP[2]:=255;
 ResponseDestinationIP[3]:=255;
 if RenewalRequest and ((TRNLEndianness.NetToHost16(InDHCP^.Flags) and $8000)=0) then begin
  ResponseDestinationIP:=LeaseIP;
 end;

 FillChar(fFrameBuffer[0],UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize+UserModeDHCPHeaderSize,0);

 ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);
 ResponseIP:=PIPv4Header(@fFrameBuffer[UserModeEtherHeaderSize]);
 ResponseUDP:=PUDPHeader(@fFrameBuffer[UserModeEtherHeaderSize+UserModeIPv4HeaderSize]);
 ResponseDHCP:=PDHCPHeader(@fFrameBuffer[UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize]);
 ResponseDHCP^.Opcode:=2;
 ResponseDHCP^.HType:=InDHCP^.HType;
 ResponseDHCP^.HLen:=InDHCP^.HLen;
 ResponseDHCP^.Hops:=0;
 ResponseDHCP^.XID:=InDHCP^.XID;
 ResponseDHCP^.Seconds:=0;
 ResponseDHCP^.Flags:=InDHCP^.Flags;
 ResponseDHCP^.ClientIP:=InDHCP^.ClientIP;
 ResponseDHCP^.YourIP:=LeaseIP; // GuestIP;
 ResponseDHCP^.NextServerIP:=GatewayIP;
 ResponseDHCP^.RelayAgentIP:=InDHCP^.RelayAgentIP;
 Move(InDHCP^.ClientHWAddr,ResponseDHCP^.ClientHWAddr,16);
 ResponseDHCP^.MagicCookie:=InDHCP^.MagicCookie;

 OptionsPointer:=PPasRISCVUInt8(@fFrameBuffer[UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize+UserModeDHCPHeaderSize]);

 OptionsPointer^:=DHCPOptMsgType;
 inc(OptionsPointer);
 OptionsPointer^:=1;
 inc(OptionsPointer);
 if MessageType=DHCPMsgDiscover then begin
  OptionsPointer^:=DHCPMsgOffer;
 end else begin
  OptionsPointer^:=DHCPMsgACK;
 end;
 inc(OptionsPointer);

 OptionsPointer^:=DHCPOptServerID;
 inc(OptionsPointer);
 OptionsPointer^:=4;
 inc(OptionsPointer);
 OptionsPointer^:=GatewayIP[0];
 inc(OptionsPointer);
 OptionsPointer^:=GatewayIP[1];
 inc(OptionsPointer);
 OptionsPointer^:=GatewayIP[2];
 inc(OptionsPointer);
 OptionsPointer^:=GatewayIP[3];
 inc(OptionsPointer);

 OptionsPointer^:=DHCPOptLeaseTime;
 inc(OptionsPointer);
 OptionsPointer^:=4;
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8((UserModeDHCPLeaseTimeSeconds shr 24) and $ff);
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8((UserModeDHCPLeaseTimeSeconds shr 16) and $ff);
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8((UserModeDHCPLeaseTimeSeconds shr 8) and $ff);
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(UserModeDHCPLeaseTimeSeconds and $ff);
 inc(OptionsPointer);

 OptionsPointer^:=DHCPOptSubnetMask;
 inc(OptionsPointer);
 OptionsPointer^:=4;
 inc(OptionsPointer);
 OptionsPointer^:=SubnetMask[0];
 inc(OptionsPointer);
 OptionsPointer^:=SubnetMask[1];
 inc(OptionsPointer);
 OptionsPointer^:=SubnetMask[2];
 inc(OptionsPointer);
 OptionsPointer^:=SubnetMask[3];
 inc(OptionsPointer);

 OptionsPointer^:=DHCPOptRouter;
 inc(OptionsPointer);
 OptionsPointer^:=4;
 inc(OptionsPointer);
 OptionsPointer^:=GatewayIP[0];
 inc(OptionsPointer);
 OptionsPointer^:=GatewayIP[1];
 inc(OptionsPointer);
 OptionsPointer^:=GatewayIP[2];
 inc(OptionsPointer);
 OptionsPointer^:=GatewayIP[3];
 inc(OptionsPointer);

 OptionsPointer^:=DHCPOptDNS;
 inc(OptionsPointer);
 OptionsPointer^:=4;
 inc(OptionsPointer);
 OptionsPointer^:=DNSIP[0];
 inc(OptionsPointer);
 OptionsPointer^:=DNSIP[1];
 inc(OptionsPointer);
 OptionsPointer^:=DNSIP[2];
 inc(OptionsPointer);
 OptionsPointer^:=DNSIP[3];
 inc(OptionsPointer);

 OptionsPointer^:=DHCPOptDomainName;
 inc(OptionsPointer);
 OptionsPointer^:=5;
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('l'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('o'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('c'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('a'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('l'));
 inc(OptionsPointer);

 OptionsPointer^:=DHCPOptDomainSearch;
 inc(OptionsPointer);
 OptionsPointer^:=7;
 inc(OptionsPointer);
 OptionsPointer^:=5;
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('l'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('o'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('c'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('a'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('l'));
 inc(OptionsPointer);
 OptionsPointer^:=0;
 inc(OptionsPointer);

{$ifdef PasRISCVNATDHCPTFTPServerName}
 OptionsPointer^:=DHCPOptTFTPServerName;
 inc(OptionsPointer);
 OptionsPointer^:=8;
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('1'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('0'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('.'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('0'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('.'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('2'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('.'));
 inc(OptionsPointer);
 OptionsPointer^:=TPasRISCVUInt8(ord('2'));
 inc(OptionsPointer);
{$endif}

 OptionsPointer^:=DHCPOptEnd;
 inc(OptionsPointer);

 OptionsSize:=TPasRISCVPtrUInt(OptionsPointer)-TPasRISCVPtrUInt(@fFrameBuffer[UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize+UserModeDHCPHeaderSize]);
 TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize+UserModeDHCPHeaderSize+OptionsSize;

 ResponseUDP^.SourcePort:=TRNLEndianness.HostToNet16(DHCPServerPort);
 ResponseUDP^.DestinationPort:=TRNLEndianness.HostToNet16(DHCPClientPort);
 ResponseUDP^.Length:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeUDPHeaderSize+UserModeDHCPHeaderSize+OptionsSize));
 ResponseUDP^.Checksum:=0;

 ResponseIP^.VersionIHL:=$45;
 ResponseIP^.DSCP_ECN:=0;
 ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+UserModeUDPHeaderSize+UserModeDHCPHeaderSize+OptionsSize));
 inc(fIPIDCounter);
 ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
 ResponseIP^.FlagsFragment:=0;
 ResponseIP^.TTL:=64;
 ResponseIP^.Protocol:=IPProtocolUDP;
 ResponseIP^.HeaderChecksum:=0;
 ResponseIP^.SourceIP:=GatewayIP;
 ResponseIP^.DestinationIP:=ResponseDestinationIP;
 ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);

 ResponseEthernet^.DestinationMAC:=aEthHeader^.SourceMAC;
 ResponseEthernet^.SourceMAC:=GatewayMAC;
 ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

 InjectToGuest(@fFrameBuffer[0],TotalSize);

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.ParseTCPOptions(const aOptions:Pointer;const aOptionsSize:TPasRISCVSizeInt;out aResult:TUserModeTCPParsedOptions);
var CurrentOption:PPasRISCVUInt8;
    Remaining:TPasRISCVSizeInt;
    OptionKind,OptionLength:TPasRISCVUInt8;
begin
 FillChar(aResult,SizeOf(TUserModeTCPParsedOptions),#0);
 if (aOptions=nil) or (aOptionsSize<=0) then begin
  exit;
 end;
 CurrentOption:=PPasRISCVUInt8(aOptions);
 Remaining:=aOptionsSize;
 while Remaining>0 do begin
  OptionKind:=CurrentOption^;
  if OptionKind=0 then begin
   exit;
  end;
  if OptionKind=1 then begin
   inc(CurrentOption);
   dec(Remaining);
   continue;
  end;
  if Remaining<2 then begin
   exit;
  end;
  OptionLength:=PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(CurrentOption)+1)))^;
  if (OptionLength<2) or (OptionLength>Remaining) then begin
   exit;
  end;
  if (OptionKind=2) and (OptionLength=4) then begin
   aResult.MSS:=(TPasRISCVUInt16(PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(CurrentOption)+2)))^) shl 8) or
                 TPasRISCVUInt16(PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(CurrentOption)+3)))^);
  end else begin
   if (OptionKind=3) and (OptionLength=3) then begin
    aResult.WindowScale:=PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(CurrentOption)+2)))^;
    if aResult.WindowScale>14 then begin
     aResult.WindowScale:=14;
    end;
   end else begin
    if (OptionKind=4) and (OptionLength=2) then begin
     aResult.SACKPermitted:=true;
    end else begin
     if (OptionKind=8) and (OptionLength=10) then begin
      aResult.TimestampEnabled:=true;
      aResult.TimestampValue:=(TPasRISCVUInt32(PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(CurrentOption)+2)))^) shl 24) or
                              (TPasRISCVUInt32(PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(CurrentOption)+3)))^) shl 16) or
                              (TPasRISCVUInt32(PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(CurrentOption)+4)))^) shl 8) or
                              (TPasRISCVUInt32(PPasRISCVUInt8(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(CurrentOption)+5)))^) shl 0);
     end;
    end;
   end;
  end;
  inc(CurrentOption,OptionLength);
  dec(Remaining,OptionLength);
 end;
end;

class function TPasRISCVEthernetDeviceUserModeNetworking.UserModeTCPSequenceLessThan(const a,b:TPasRISCVUInt32):Boolean;
begin
 result:=TPasRISCVInt32(a-b)<0;
end;

class function TPasRISCVEthernetDeviceUserModeNetworking.UserModeTCPSequenceInRangeInclusive(const aValue,aFirst,aLast:TPasRISCVUInt32):Boolean;
begin
 result:=(not UserModeTCPSequenceLessThan(aValue,aFirst)) and
         (not UserModeTCPSequenceLessThan(aLast,aValue));
end;

// Tells the guest that a connection is gone. Without it a session the NAT has
// dropped - on its idle timeout, or because it no longer knows the tuple - simply
// goes quiet: the guest keeps the socket open and waits for its own TCP timeout,
// which turns a clean error into a hang. RFC 793 picks the sequence numbers by
// whether the offending segment carried an ACK.
procedure TPasRISCVEthernetDeviceUserModeNetworking.SendTCPResetToGuest(const aIPHeader:PIPv4Header;const aTCPHeader:PTCPHeader;const aSegmentPayloadSize:TPasRISCVSizeInt);
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
var TotalSize:TPasRISCVSizeInt;
    ResponseEthernet:PEthernetHeader;
    ResponseIP:PIPv4Header;
    ResponseTCP:PTCPHeader;
    ConsumedSequenceNumbers:TPasRISCVUInt32;
begin

 // Never answer a reset with a reset, that is how two ends end up shouting at each other
 if (aTCPHeader^.Flags and TCPFlagRST)<>0 then begin
  exit;
 end;

 TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeTCPHeaderSize;

 FillChar(fFrameBuffer[0],TotalSize,#0);

 ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);
 ResponseIP:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));
 ResponseTCP:=PTCPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize)));

 ResponseEthernet^.DestinationMAC:=fGuestMAC;
 ResponseEthernet^.SourceMAC:=GatewayMAC;
 ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

 ResponseIP^.VersionIHL:=$45;
 ResponseIP^.DSCP_ECN:=0;
 ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+UserModeTCPHeaderSize));

 inc(fIPIDCounter);

 ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
 ResponseIP^.FlagsFragment:=0;
 ResponseIP^.TTL:=64;
 ResponseIP^.Protocol:=IPProtocolTCP;
 ResponseIP^.HeaderChecksum:=0;
 ResponseIP^.SourceIP:=aIPHeader^.DestinationIP;
 ResponseIP^.DestinationIP:=aIPHeader^.SourceIP;
 ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);

 ResponseTCP^.SourcePort:=aTCPHeader^.DestinationPort;
 ResponseTCP^.DestinationPort:=aTCPHeader^.SourcePort;
 ResponseTCP^.DataOffset:=$50;
 ResponseTCP^.WindowSize:=0;
 ResponseTCP^.Checksum:=0;
 ResponseTCP^.UrgentPtr:=0;

 if (aTCPHeader^.Flags and TCPFlagACK)<>0 then begin
  // The segment told us where it thinks we are, so answer from exactly there
  ResponseTCP^.SequenceNumber:=aTCPHeader^.AcknowledgmentNumber;
  ResponseTCP^.AcknowledgmentNumber:=0;
  ResponseTCP^.Flags:=TCPFlagRST;
 end else begin
  // Nothing to go on, so acknowledge everything it sent and reset from zero
  ConsumedSequenceNumbers:=TPasRISCVUInt32(aSegmentPayloadSize);
  if (aTCPHeader^.Flags and (TCPFlagSYN or TCPFlagFIN))<>0 then begin
   inc(ConsumedSequenceNumbers);
  end;
  ResponseTCP^.SequenceNumber:=0;
  ResponseTCP^.AcknowledgmentNumber:=TRNLEndianness.HostToNet32(TRNLEndianness.NetToHost32(aTCPHeader^.SequenceNumber)+ConsumedSequenceNumbers);
  ResponseTCP^.Flags:=TCPFlagRST or TCPFlagACK;
 end;

 ResponseTCP^.Checksum:=UserModeTCPUDPChecksum(aIPHeader^.DestinationIP,aIPHeader^.SourceIP,IPProtocolTCP,ResponseTCP,UserModeTCPHeaderSize);

 InjectToGuest(@fFrameBuffer[0],TotalSize);

end;

// The IPv6 twin of the above, for the same reason and with the same sequence number
// rules - everything about a reset that is built without a session is identical, only
// the two headers it is wrapped in differ.
procedure TPasRISCVEthernetDeviceUserModeNetworking.SendTCPv6ResetToGuest(const aIPv6Header:PIPv6Header;const aTCPHeader:PTCPHeader;const aSegmentPayloadSize:TPasRISCVSizeInt);
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
var TotalSize:TPasRISCVSizeInt;
    ResponseEthernet:PEthernetHeader;
    ResponseIPv6:PIPv6Header;
    ResponseTCP:PTCPHeader;
    ConsumedSequenceNumbers:TPasRISCVUInt32;
begin

 // Never answer a reset with a reset, that is how two ends end up shouting at each other
 if (aTCPHeader^.Flags and TCPFlagRST)<>0 then begin
  exit;
 end;

 TotalSize:=UserModeEtherHeaderSize+UserModeIPv6HeaderSize+UserModeTCPHeaderSize;

 FillChar(fFrameBuffer[0],TotalSize,#0);

 ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);
 ResponseIPv6:=PIPv6Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));
 ResponseTCP:=PTCPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv6HeaderSize)));

 ResponseEthernet^.DestinationMAC:=fGuestMAC;
 ResponseEthernet^.SourceMAC:=GatewayMAC;
 ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv6);

 ResponseIPv6^.VersionTrafficClassFlow:=TRNLEndianness.HostToNet32(TPasRISCVUInt32($60000000));
 ResponseIPv6^.PayloadLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeTCPHeaderSize));
 ResponseIPv6^.NextHeader:=IPProtocolTCP;
 ResponseIPv6^.HopLimit:=64;
 ResponseIPv6^.SourceAddress:=aIPv6Header^.DestinationAddress;
 ResponseIPv6^.DestinationAddress:=aIPv6Header^.SourceAddress;

 ResponseTCP^.SourcePort:=aTCPHeader^.DestinationPort;
 ResponseTCP^.DestinationPort:=aTCPHeader^.SourcePort;
 ResponseTCP^.DataOffset:=$50;
 ResponseTCP^.WindowSize:=0;
 ResponseTCP^.Checksum:=0;
 ResponseTCP^.UrgentPtr:=0;

 if (aTCPHeader^.Flags and TCPFlagACK)<>0 then begin
  // The segment told us where it thinks we are, so answer from exactly there
  ResponseTCP^.SequenceNumber:=aTCPHeader^.AcknowledgmentNumber;
  ResponseTCP^.AcknowledgmentNumber:=0;
  ResponseTCP^.Flags:=TCPFlagRST;
 end else begin
  // Nothing to go on, so acknowledge everything it sent and reset from zero
  ConsumedSequenceNumbers:=TPasRISCVUInt32(aSegmentPayloadSize);
  if (aTCPHeader^.Flags and (TCPFlagSYN or TCPFlagFIN))<>0 then begin
   inc(ConsumedSequenceNumbers);
  end;
  ResponseTCP^.SequenceNumber:=0;
  ResponseTCP^.AcknowledgmentNumber:=TRNLEndianness.HostToNet32(TRNLEndianness.NetToHost32(aTCPHeader^.SequenceNumber)+ConsumedSequenceNumbers);
  ResponseTCP^.Flags:=TCPFlagRST or TCPFlagACK;
 end;

 ResponseTCP^.Checksum:=UserModeIPv6PseudoHeaderChecksum(aIPv6Header^.DestinationAddress,aIPv6Header^.SourceAddress,IPProtocolTCP,ResponseTCP,UserModeTCPHeaderSize);

 InjectToGuest(@fFrameBuffer[0],TotalSize);

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.HandleTCP(const aEthHeader:PEthernetHeader;const aIPHeader:PIPv4Header;const aTCPData:Pointer;const aTCPSize:TPasRISCVSizeInt);
{$if defined(Windows)}
const UserModeMsgNoSigPipe=0;
      GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
{$elseif defined(Darwin)}
const UserModeMsgNoSigPipe=$20000;
      GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
{$else}
const UserModeMsgNoSigPipe=$4000;
      GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
{$ifend}
var TCPHeader:PTCPHeader;
    DataOffsetBytes:TPasRISCVSizeInt;
    PayloadPointer:Pointer;
    PayloadSize:TPasRISCVSizeInt;
    Flags:TPasRISCVUInt8;
    SequenceNumber:TPasRISCVUInt32;
    GuestAcknowledgmentNumber:TPasRISCVUInt32;
    SessionIndex:TPasRISCVInt32;
    Index:TPasRISCVInt32;
    ExtraIndex:TPasRISCVInt32;
    EvictionIndex:TPasRISCVInt32;
    SentBytes:TPasRISCVSizeInt;
    TrimLength:TPasRISCVSizeInt;
    AcceptedBytes:TPasRISCVSizeInt;
    TCPSession:PTCPSession;
    TCPKey:TUserModeTCPKey;
    ResponseEthernet:PEthernetHeader;
    ResponseIP:PIPv4Header;
    ResponseTCP:PTCPHeader;
    TotalSize:TPasRISCVSizeInt;
    EffectiveDestinationIP:TIPv4Address;
    DestinationAddress:TRNLAddress;
    HasValidAcknowledgment:Boolean;
    HasPayloadOrFIN:Boolean;
    OutOfOrderQueueItem:PUserModeTCPOutOfOrderEntry;
    RTTSample:TPasRISCVUInt32;
    RTTDelta:TPasRISCVInt32;
    RTTAbsDelta:TPasRISCVUInt32;
    ParsedOptions:TUserModeTCPParsedOptions;
begin

 if aTCPSize<UserModeTCPHeaderSize then begin
  exit;
 end;

 if UserModeTCPUDPChecksum(aIPHeader^.SourceIP,aIPHeader^.DestinationIP,IPProtocolTCP,aTCPData,aTCPSize)<>0 then begin
  exit;
 end;

 TCPHeader:=PTCPHeader(aTCPData);

 DataOffsetBytes:=(TCPHeader^.DataOffset shr 4) shl 2;

 if (DataOffsetBytes<UserModeTCPHeaderSize) or (DataOffsetBytes>aTCPSize) then begin
  exit;
 end;

 PayloadPointer:=Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aTCPData)+DataOffsetBytes));
 PayloadSize:=aTCPSize-DataOffsetBytes;
 Flags:=TCPHeader^.Flags;
 SequenceNumber:=TRNLEndianness.NetToHost32(TCPHeader^.SequenceNumber);
 GuestAcknowledgmentNumber:=TRNLEndianness.NetToHost32(TCPHeader^.AcknowledgmentNumber);

 EffectiveDestinationIP:=aIPHeader^.DestinationIP;
 if EffectiveDestinationIP[0]=127 then begin
  EffectiveDestinationIP[0]:=10;
  EffectiveDestinationIP[1]:=0;
  EffectiveDestinationIP[2]:=2;
  EffectiveDestinationIP[3]:=2;
 end;

 if (Flags and TCPFlagRST)<>0 then begin
  Index:=FindTCPSession(aIPHeader^.SourceIP,TCPHeader^.SourcePort,EffectiveDestinationIP,TCPHeader^.DestinationPort);
  if Index>=0 then begin
   // Validate RST sequence number against expected guest sequence (RFC 5961)
   if SequenceNumber=fTCPSessionArray[Index].ServerAck then begin
    CloseTCPSession(Index,false);
   end;
  end;
  exit;
 end;

 if (Flags and (TCPFlagSYN or TCPFlagACK))=TCPFlagSYN then begin

  if fIsolated then begin
   TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeTCPHeaderSize;
   FillChar(fFrameBuffer[0],TotalSize,#0);
   ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);
   ResponseIP:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));
   ResponseTCP:=PTCPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize)));
   ResponseEthernet^.DestinationMAC:=fGuestMAC;
   ResponseEthernet^.SourceMAC:=GatewayMAC;
   ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);
   ResponseIP^.VersionIHL:=$45;
   ResponseIP^.DSCP_ECN:=0;
   ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+UserModeTCPHeaderSize));
   inc(fIPIDCounter);
   ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
   ResponseIP^.FlagsFragment:=0;
   ResponseIP^.TTL:=64;
   ResponseIP^.Protocol:=IPProtocolTCP;
   ResponseIP^.HeaderChecksum:=0;
   ResponseIP^.SourceIP:=aIPHeader^.DestinationIP;
   ResponseIP^.DestinationIP:=aIPHeader^.SourceIP;
   ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);
   ResponseTCP^.SourcePort:=TCPHeader^.DestinationPort;
   ResponseTCP^.DestinationPort:=TCPHeader^.SourcePort;
   ResponseTCP^.SequenceNumber:=0;
   ResponseTCP^.AcknowledgmentNumber:=TRNLEndianness.HostToNet32(TRNLEndianness.NetToHost32(TCPHeader^.SequenceNumber)+1);
   ResponseTCP^.DataOffset:=$50;
   ResponseTCP^.Flags:=TCPFlagRST or TCPFlagACK;
   ResponseTCP^.WindowSize:=0;
   ResponseTCP^.Checksum:=0;
   ResponseTCP^.UrgentPtr:=0;
   ResponseTCP^.Checksum:=UserModeTCPUDPChecksum(aIPHeader^.DestinationIP,aIPHeader^.SourceIP,IPProtocolTCP,ResponseTCP,UserModeTCPHeaderSize);
   InjectToGuest(@fFrameBuffer[0],TotalSize);
   exit;
  end;

  if (EffectiveDestinationIP[0]=0) or
     ((EffectiveDestinationIP[0]=255) and (EffectiveDestinationIP[1]=255) and (EffectiveDestinationIP[2]=255) and (EffectiveDestinationIP[3]=255)) then begin
   exit;
  end;

  if fFilterLAN then begin
   if (EffectiveDestinationIP[0]=10) or
      ((EffectiveDestinationIP[0]=172) and (EffectiveDestinationIP[1]>=16) and (EffectiveDestinationIP[1]<=31)) or
      ((EffectiveDestinationIP[0]=192) and (EffectiveDestinationIP[1]=168)) or
      ((EffectiveDestinationIP[0]=169) and (EffectiveDestinationIP[1]=254)) then begin
    exit;
   end;
  end;

  Index:=FindTCPSession(aIPHeader^.SourceIP,TCPHeader^.SourcePort,EffectiveDestinationIP,TCPHeader^.DestinationPort);
  if Index>=0 then begin
   // If session is in SynAckSent state, retransmit SYN-ACK instead of reconnecting
   if fTCPSessionArray[Index].State=UserModeTCPStateSynAckSent then begin
    SendTCPToGuest(Index,TCPFlagSYN or TCPFlagACK,nil,0);
    fTCPSessionArray[Index].IdleTickCount:=0;
    exit;
   end;
   CloseTCPSession(Index,true);
  end;

  if (UserModeTCPMaxSessions>0) and (fTCPActiveCount>=UserModeTCPMaxSessions) then begin
   EvictionIndex:=FindEvictableTCPSession;
   if EvictionIndex>=0 then begin
    // The evicted guest gets an RST, so it finds out at once instead of waiting for
    // a connection that no longer exists on this side
    CloseTCPSession(EvictionIndex,true);
   end else begin
    // Everything in the table is genuinely in use, so refuse the new connection out
    // loud - connect() then fails immediately rather than after the guest's own
    // timeout, and the difference between "busy" and "black hole" stays visible
    SendTCPResetToGuest(aIPHeader,TCPHeader,PayloadSize);
    exit;
   end;
  end;

  if not fTCPFreeList.Dequeue(SessionIndex) then begin
   SessionIndex:=length(fTCPSessionArray);
   SetLength(fTCPSessionArray,TPasRISCVInt32(SessionIndex+1)*2);
   for ExtraIndex:=SessionIndex+1 to length(fTCPSessionArray)-1 do begin
    fTCPFreeList.Enqueue(ExtraIndex);
   end;
  end;

  TCPSession:=@fTCPSessionArray[SessionIndex];
  FillChar(TCPSession^,SizeOf(TTCPSession),#0);

{$ifdef PasRISCVUseRNLNetworkInstance}
  TCPSession^.SocketFileDescriptor:=fRNLNetwork.SocketCreate(RNL_SOCKET_TYPE_STREAM,RNL_IPV4);
{$else}
  TCPSession^.SocketFileDescriptor:=RNLSocketCreate(RNL_SOCKET_TYPE_STREAM,RNL_IPV4);
{$endif}
  if TCPSession^.SocketFileDescriptor=RNL_SOCKET_NULL then begin
   // Out of host descriptors, almost always EMFILE. Every session in the table holds
   // one of those descriptors, including the ones that are finished or have not been
   // touched in minutes, and nothing else ever reclaims them for this reason: the
   // eviction used to be reachable only when the session table itself was full, which
   // at 65536 entries happens long after the descriptors have run out. So take one
   // back and ask again before giving up.
   EvictionIndex:=FindEvictableTCPSession;
   if EvictionIndex>=0 then begin
    CloseTCPSession(EvictionIndex,true);
{$ifdef PasRISCVUseRNLNetworkInstance}
    TCPSession^.SocketFileDescriptor:=fRNLNetwork.SocketCreate(RNL_SOCKET_TYPE_STREAM,RNL_IPV4);
{$else}
    TCPSession^.SocketFileDescriptor:=RNLSocketCreate(RNL_SOCKET_TYPE_STREAM,RNL_IPV4);
{$endif}
   end;
   if TCPSession^.SocketFileDescriptor=RNL_SOCKET_NULL then begin
    // Nothing was spare, or freeing one still was not enough. The guest cannot be
    // given the connection, but it can be told so: without the reset it waits out its
    // connect timer for every attempt, and a host that has run out of file descriptors
    // is exactly the situation in which the guest is retrying hardest.
    SendTCPResetToGuest(aIPHeader,TCPHeader,PayloadSize);
    fTCPFreeList.Enqueue(SessionIndex);
    exit;
   end;
  end;

{$ifdef PasRISCVUseRNLNetworkInstance}
  fRNLNetwork.SocketSetOption(TCPSession^.SocketFileDescriptor,RNL_SOCKET_OPTION_NONBLOCK,1);
{$else}
  RNLSocketSetNonBlock(TCPSession^.SocketFileDescriptor);
{$endif}

  DestinationAddress.Host:=TRNLHostAddress.CreateFromIPV4(TRNLUInt32(TRNLPointer(@EffectiveDestinationIP[0])^));
  DestinationAddress.Port:=TRNLEndianness.NetToHost16(TCPHeader^.DestinationPort);
  DestinationAddress.ScopeID:=0;

  if not {$ifdef PasRISCVUseRNLNetworkInstance}fRNLNetwork.SocketConnect(TCPSession^.SocketFileDescriptor,DestinationAddress,RNL_IPV4){$else}RNLSocketConnect(TCPSession^.SocketFileDescriptor,DestinationAddress,RNL_IPV4){$endif} then begin
{$ifdef PasRISCVUseRNLNetworkInstance}
   fRNLNetwork.SocketDestroy(TCPSession^.SocketFileDescriptor);
{$else}
   RNLSocketDestroy(TCPSession^.SocketFileDescriptor);
{$endif}
   // The connect failed outright rather than going pending, so there is a definite
   // answer to give instead of silence
   SendTCPResetToGuest(aIPHeader,TCPHeader,PayloadSize);
   fTCPFreeList.Enqueue(SessionIndex);
   exit;
  end;

  TCPSession^.State:=UserModeTCPStateConnecting;
  TCPSession^.GuestSourceIP:=aIPHeader^.SourceIP;
  TCPSession^.GuestSourcePort:=TCPHeader^.SourcePort;
  TCPSession^.DestinationIP:=EffectiveDestinationIP;
  TCPSession^.GuestDestinationIP:=aIPHeader^.DestinationIP;
  TCPSession^.DestinationPort:=TCPHeader^.DestinationPort;
  TCPSession^.ServerSeq:=fTCPISNCounter;

  inc(fTCPISNCounter,$10001);

  TCPSession^.ServerAck:=SequenceNumber+1;
  TCPSession^.PendingData:=nil;
  TCPSession^.PendingSize:=0;
  TCPSession^.PendingCapacity:=0;
  TCPSession^.TickCount:=0;
  TCPSession^.GuestWindowSize:=TRNLEndianness.NetToHost16(TCPHeader^.WindowSize);
  if DataOffsetBytes>UserModeTCPHeaderSize then begin
   ParseTCPOptions(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aTCPData)+UserModeTCPHeaderSize)),DataOffsetBytes-UserModeTCPHeaderSize,ParsedOptions);
  end else begin
   FillChar(ParsedOptions,SizeOf(TUserModeTCPParsedOptions),#0);
  end;
  TCPSession^.GuestWindowShift:=ParsedOptions.WindowScale;
  if ParsedOptions.MSS>0 then begin
   TCPSession^.GuestMSS:=ParsedOptions.MSS;
  end else begin
   TCPSession^.GuestMSS:=UserModeTCPMaxDataPayload;
  end;
  TCPSession^.GuestSACKPermitted:=ParsedOptions.SACKPermitted;
  TCPSession^.GuestTimestampEnabled:=ParsedOptions.TimestampEnabled;
  TCPSession^.LastGuestTimestampValue:=ParsedOptions.TimestampValue;
  TCPSession^.RetransmitData:=nil;
  TCPSession^.RetransmitSize:=0;
  TCPSession^.RetransmitCapacity:=0;
  TCPSession^.RetransmitSeqBase:=TCPSession^.ServerSeq;

  TCPSession^.Active:=true;
  TCPKey.GuestSourceIP:=aIPHeader^.SourceIP;
  TCPKey.GuestSourcePort:=TCPHeader^.SourcePort;
  TCPKey.DestinationIP:=EffectiveDestinationIP;
  TCPKey.DestinationPort:=TCPHeader^.DestinationPort;
  fTCPSessions.Add(TCPKey,SessionIndex);

  if fTCPActiveCount>=fTCPActiveCapacity then begin
   if fTCPActiveCapacity=0 then begin
    fTCPActiveCapacity:=8;
   end else begin
    fTCPActiveCapacity:=fTCPActiveCapacity*2;
   end;
   SetLength(fTCPActiveIndices,fTCPActiveCapacity);
  end;
  TCPSession^.ActiveIndex:=fTCPActiveCount;
  fTCPActiveIndices[fTCPActiveCount]:=SessionIndex;
  inc(fTCPActiveCount);

  exit;

 end;

 SessionIndex:=FindTCPSession(aIPHeader^.SourceIP,TCPHeader^.SourcePort,EffectiveDestinationIP,TCPHeader^.DestinationPort);
 if SessionIndex<0 then begin
  // A segment for a tuple we no longer know. Dropping it silently leaves the guest
  // waiting on a connection that is never coming back, so say so instead.
  SendTCPResetToGuest(aIPHeader,TCPHeader,PayloadSize);
  exit;
 end;

 TCPSession:=@fTCPSessionArray[SessionIndex];

 if TCPSession^.GuestTimestampEnabled and (DataOffsetBytes>UserModeTCPHeaderSize) then begin
  ParseTCPOptions(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(aTCPData)+UserModeTCPHeaderSize)),DataOffsetBytes-UserModeTCPHeaderSize,ParsedOptions);
  if ParsedOptions.TimestampEnabled then begin
   TCPSession^.LastGuestTimestampValue:=ParsedOptions.TimestampValue;
  end;
 end;

 HasPayloadOrFIN:=(PayloadSize>0) or ((Flags and TCPFlagFIN)<>0);

 if (Flags and TCPFlagSYN)<>0 then begin
  TCPSession^.GuestWindowSize:=TRNLEndianness.NetToHost16(TCPHeader^.WindowSize);
 end else begin
  TCPSession^.GuestWindowSize:=TPasRISCVUInt32(TRNLEndianness.NetToHost16(TCPHeader^.WindowSize)) shl TCPSession^.GuestWindowShift;
 end;

 HasValidAcknowledgment:=((Flags and TCPFlagACK)=0) or
                         UserModeTCPSequenceInRangeInclusive(GuestAcknowledgmentNumber,TCPSession^.RetransmitSeqBase,TCPSession^.ServerSeq);

 if HasValidAcknowledgment and ((Flags and TCPFlagACK)<>0) then begin

  TrimLength:=TPasRISCVInt32(GuestAcknowledgmentNumber-TCPSession^.RetransmitSeqBase);

  if TrimLength>0 then begin

   if TrimLength>TPasRISCVInt32(TCPSession^.RetransmitSize) then begin
    TrimLength:=TCPSession^.RetransmitSize;
   end;

   if TrimLength>=TCPSession^.RetransmitSize then begin
    TCPSession^.RetransmitSize:=0;
    inc(TCPSession^.RetransmitSeqBase,TrimLength);
   end else begin
    Move(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(TCPSession^.RetransmitData)+TPasRISCVPtrUInt(TrimLength)))^,
         TCPSession^.RetransmitData^,
         TCPSession^.RetransmitSize-TrimLength);
    dec(TCPSession^.RetransmitSize,TrimLength);
    inc(TCPSession^.RetransmitSeqBase,TrimLength);
   end;

   TCPSession^.TickCount:=0;
   TCPSession^.IdleTickCount:=0;

   if TCPSession^.RTTSentTick<>0 then begin

    RTTSample:=fUserModeTickCount-TCPSession^.RTTSentTick;
    if RTTSample=0 then begin
     RTTSample:=1;
    end;

    TCPSession^.RTTSentTick:=0;

    if TCPSession^.SRTT8=0 then begin

     TCPSession^.SRTT8:=RTTSample shl 3;
     TCPSession^.RTTVAR4:=RTTSample shl 1;

    end else begin

     RTTDelta:=TPasRISCVInt32(RTTSample)-TPasRISCVInt32(TCPSession^.SRTT8 shr 3);

     TCPSession^.SRTT8:=TPasRISCVUInt32(TPasRISCVInt32(TCPSession^.SRTT8)+RTTDelta);

     if RTTDelta<0 then begin
      RTTAbsDelta:=TPasRISCVUInt32(-RTTDelta);
     end else begin
      RTTAbsDelta:=TPasRISCVUInt32(RTTDelta);
     end;

     RTTDelta:=TPasRISCVInt32(RTTAbsDelta)-TPasRISCVInt32(TCPSession^.RTTVAR4 shr 2);

     TCPSession^.RTTVAR4:=TPasRISCVUInt32(TPasRISCVInt32(TCPSession^.RTTVAR4)+RTTDelta);

    end;

    if TCPSession^.RTTVAR4>1 then begin
     TCPSession^.RTO:=(TCPSession^.SRTT8 shr 3)+TCPSession^.RTTVAR4;
    end else begin
     TCPSession^.RTO:=(TCPSession^.SRTT8 shr 3)+1;
    end;

    if TCPSession^.RTO<UserModeTCPMinRTO then begin
     TCPSession^.RTO:=UserModeTCPMinRTO;
    end;

    if TCPSession^.RTO>UserModeTCPMaxRTO then begin
     TCPSession^.RTO:=UserModeTCPMaxRTO;
    end;

   end;

  end;

 end;

 case TCPSession^.State of

  UserModeTCPStateSynAckSent:begin

   if ((Flags and TCPFlagACK)=0) or (GuestAcknowledgmentNumber<>TCPSession^.ServerSeq) then begin
    exit;
   end;

   if (Flags and TCPFlagACK)<>0 then begin
    TrimLength:=TPasRISCVInt32(GuestAcknowledgmentNumber-TCPSession^.RetransmitSeqBase);
    if TrimLength>0 then begin
     if TrimLength>TPasRISCVInt32(TCPSession^.RetransmitSize) then begin
      TrimLength:=TCPSession^.RetransmitSize;
     end;
     if TrimLength>=TCPSession^.RetransmitSize then begin
      TCPSession^.RetransmitSize:=0;
      inc(TCPSession^.RetransmitSeqBase,TrimLength);
     end else begin
      Move(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(TCPSession^.RetransmitData)+TPasRISCVPtrUInt(TrimLength)))^,
           TCPSession^.RetransmitData^,
           TCPSession^.RetransmitSize-TrimLength);
      dec(TCPSession^.RetransmitSize,TrimLength);
      inc(TCPSession^.RetransmitSeqBase,TrimLength);
     end;
     TCPSession^.TickCount:=0;
     TCPSession^.IdleTickCount:=0;
    end;
   end;

   if HasPayloadOrFIN and (SequenceNumber<>TCPSession^.ServerAck) then begin
    SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
    exit;
   end;

   if (Flags and TCPFlagACK)<>0 then begin

    TCPSession^.State:=UserModeTCPStateEstablished;
    TCPSession^.TickCount:=0;
    TCPSession^.IdleTickCount:=0;

    if PayloadSize>0 then begin

     AcceptedBytes:=0;

{$ifdef PasRISCVUseRNLNetworkInstance}
     SentBytes:=fRNLNetwork.SendStream(TCPSession^.SocketFileDescriptor,PayloadPointer^,PayloadSize);
{$else}
     SentBytes:=RNLSocketSendStream(TCPSession^.SocketFileDescriptor,PayloadPointer^,PayloadSize);
{$endif}

     if SentBytes<0 then begin
      SentBytes:=0;
     end;
     if SentBytes>=PayloadSize then begin
      AcceptedBytes:=PayloadSize;
     end else begin
      if AppendTCPPendingData(TCPSession,Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(PayloadPointer)+SentBytes)),PayloadSize-SentBytes) then begin
       AcceptedBytes:=PayloadSize;
      end else begin
       AcceptedBytes:=SentBytes;
      end;
     end;
     if AcceptedBytes>0 then begin
      inc(TCPSession^.ServerAck,AcceptedBytes);
      TCPSession^.IdleTickCount:=0;
      SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
     end;
    end;
   end;
  end;

  UserModeTCPStateEstablished,UserModeTCPStateGuestFinSent,UserModeTCPStateCloseWait:begin

   if ((Flags and TCPFlagACK)=0) or (not HasValidAcknowledgment) then begin
    if HasPayloadOrFIN then begin
     SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
    end;
    exit;
   end;

   if HasPayloadOrFIN and (SequenceNumber<>TCPSession^.ServerAck) then begin
    // Out-of-order segment: store in OutOfOrder queue if it arrives after expected seq
    if (PayloadSize>0) and
       UserModeTCPSequenceLessThan(TCPSession^.ServerAck,SequenceNumber) and
       (TCPSession^.OutOfOrderCount<UserModeTCPOutOfOrderQueueSize) and
       (PayloadSize<=UserModeTCPMaxDataPayload) then begin
     // Check not already in queue
     Index:=0;
     while Index<TPasRISCVInt32(TCPSession^.OutOfOrderCount) do begin
      if TCPSession^.OutOfOrderQueue[Index].SeqNo=SequenceNumber then begin
       break;
      end;
      inc(Index);
     end;
     if Index=TPasRISCVInt32(TCPSession^.OutOfOrderCount) then begin
      OutOfOrderQueueItem:=@TCPSession^.OutOfOrderQueue[TCPSession^.OutOfOrderCount];
      OutOfOrderQueueItem^.SeqNo:=SequenceNumber;
      OutOfOrderQueueItem^.Size:=PayloadSize;
      Move(PayloadPointer^,OutOfOrderQueueItem^.Data[0],PayloadSize);
      inc(TCPSession^.OutOfOrderCount);
     end;
    end;
    SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
    exit;
   end;

   if (PayloadSize>0) and (TCPSession^.State=UserModeTCPStateEstablished) then begin

    AcceptedBytes:=0;

    if TCPSession^.PendingSize=0 then begin

{$ifdef PasRISCVUseRNLNetworkInstance}
     SentBytes:=fRNLNetwork.SendStream(TCPSession^.SocketFileDescriptor,PayloadPointer^,PayloadSize);
{$else}
     SentBytes:=RNLSocketSendStream(TCPSession^.SocketFileDescriptor,PayloadPointer^,PayloadSize);
{$endif}

     if SentBytes<0 then begin
      SentBytes:=0;
     end;

     if SentBytes>=PayloadSize then begin
      AcceptedBytes:=PayloadSize;
     end else begin
      if AppendTCPPendingData(TCPSession,Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(PayloadPointer)+SentBytes)),PayloadSize-SentBytes) then begin
       AcceptedBytes:=PayloadSize;
      end else begin
       AcceptedBytes:=SentBytes;
      end;
     end;

    end else begin

     if AppendTCPPendingData(TCPSession,PayloadPointer,PayloadSize) then begin
      AcceptedBytes:=PayloadSize;
     end;

    end;

    if AcceptedBytes>0 then begin
     inc(TCPSession^.ServerAck,AcceptedBytes);
     TCPSession^.IdleTickCount:=0;
     SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
    end else begin
     // Nothing fit, so the guest sent past the window it was given - answer anyway,
     // both to carry the current (closed) window back and to serve as the reply to a
     // window probe, instead of leaving the guest to its retransmit timer.
     SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
    end;

    // Flush OutOfOrder queue: deliver any now-contiguous buffered segments
    if TCPSession^.OutOfOrderCount>0 then begin
     Index:=0;
     while Index<TPasRISCVInt32(TCPSession^.OutOfOrderCount) do begin
      ExtraIndex:=0;
      while ExtraIndex<TPasRISCVInt32(TCPSession^.OutOfOrderCount) do begin
       OutOfOrderQueueItem:=@TCPSession^.OutOfOrderQueue[ExtraIndex];
       if OutOfOrderQueueItem^.SeqNo=TCPSession^.ServerAck then begin
        AcceptedBytes:=0;
        if TCPSession^.PendingSize=0 then begin
{$ifdef PasRISCVUseRNLNetworkInstance}
         SentBytes:=fRNLNetwork.SendStream(TCPSession^.SocketFileDescriptor,OutOfOrderQueueItem^.Data[0],OutOfOrderQueueItem^.Size);
{$else}
         SentBytes:=RNLSocketSendStream(TCPSession^.SocketFileDescriptor,OutOfOrderQueueItem^.Data[0],OutOfOrderQueueItem^.Size);
{$endif}
         if SentBytes<0 then begin
          SentBytes:=0;
         end;
         if SentBytes>=OutOfOrderQueueItem^.Size then begin
          AcceptedBytes:=OutOfOrderQueueItem^.Size;
         end else begin
          if AppendTCPPendingData(TCPSession,@OutOfOrderQueueItem^.Data[SentBytes],OutOfOrderQueueItem^.Size-SentBytes) then begin
           AcceptedBytes:=OutOfOrderQueueItem^.Size;
          end else begin
           AcceptedBytes:=SentBytes;
          end;
         end;
        end else begin
         if AppendTCPPendingData(TCPSession,@OutOfOrderQueueItem^.Data[0],OutOfOrderQueueItem^.Size) then begin
          AcceptedBytes:=OutOfOrderQueueItem^.Size;
         end;
        end;
        if AcceptedBytes>0 then begin
         inc(TCPSession^.ServerAck,AcceptedBytes);
         TCPSession^.IdleTickCount:=0;
        end;
        // Remove flushed entry from queue
        if ExtraIndex<TPasRISCVInt32(TCPSession^.OutOfOrderCount)-1 then begin
         Move(TCPSession^.OutOfOrderQueue[ExtraIndex+1],TCPSession^.OutOfOrderQueue[ExtraIndex],(TPasRISCVInt32(TCPSession^.OutOfOrderCount)-ExtraIndex-1)*SizeOf(TUserModeTCPOutOfOrderEntry));
        end;
        dec(TCPSession^.OutOfOrderCount);
        // Restart scan since queue changed
        break;
       end;
       inc(ExtraIndex);
      end;
      if ExtraIndex=TPasRISCVInt32(TCPSession^.OutOfOrderCount) then begin
       // No match in this pass — queue is not contiguous; stop
       break;
      end;
      inc(Index);
     end;
     if AcceptedBytes>0 then begin
      SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
     end;
    end;

   end;

   if (Flags and TCPFlagFIN)<>0 then begin

    inc(TCPSession^.ServerAck);
    TCPSession^.IdleTickCount:=0;

{$ifdef PasRISCVUseRNLNetworkInstance}
    fRNLNetwork.SocketShutdown(TCPSession^.SocketFileDescriptor,RNL_SOCKET_SHUTDOWN_WRITE);
{$else}
    RNLSocketShutdownWrite(TCPSession^.SocketFileDescriptor);
{$endif}

    if TCPSession^.State=UserModeTCPStateEstablished then begin
     TCPSession^.State:=UserModeTCPStateCloseWait;
     SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
    end else begin
     // FIN retransmit in CloseWait/GuestFinSent: resend ACK
     SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
    end;

   end;

  end;

  UserModeTCPStateLastAck:begin
   if ((Flags and TCPFlagACK)<>0) and
      (GuestAcknowledgmentNumber=TCPSession^.ServerSeq) then begin
    CloseTCPSession(SessionIndex,false);
   end;
  end;

  UserModeTCPStateInboundSynSent:begin
   // Guest responded with SYN-ACK to our synthetic inbound SYN
   if ((Flags and (TCPFlagSYN or TCPFlagACK))=(TCPFlagSYN or TCPFlagACK)) and
      (GuestAcknowledgmentNumber=TCPSession^.ServerSeq) then begin
    TCPSession^.ServerAck:=SequenceNumber+1;
    TCPSession^.State:=UserModeTCPStateEstablished;
    TCPSession^.TickCount:=0;
    TCPSession^.IdleTickCount:=0;
    SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
   end;
  end;

  UserModeTCPStateFINWait1:begin
   // Active close: we sent FIN to guest, waiting for ACK and guest's FIN.
   if (Flags and TCPFlagFIN)<>0 then begin
    inc(TCPSession^.ServerAck);
    if ((Flags and TCPFlagACK)<>0) and (GuestAcknowledgmentNumber=TCPSession^.ServerSeq) then begin
     // FIN+ACK covers our FIN → skip FINWait2, go straight to TimeWait
     SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
     TCPSession^.State:=UserModeTCPStateTimeWait;
     TCPSession^.TimeWaitTickCount:=0;
    end else begin
     // Simultaneous FIN (does not yet ACK our FIN) → Closing
     SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
     TCPSession^.State:=UserModeTCPStateClosing;
    end;
   end else if ((Flags and TCPFlagACK)<>0) and (GuestAcknowledgmentNumber=TCPSession^.ServerSeq) then begin
    // Pure ACK of our FIN → FINWait2
    TCPSession^.State:=UserModeTCPStateFINWait2;
    TCPSession^.IdleTickCount:=0;
   end;
  end;

  UserModeTCPStateFINWait2:begin
   // Active close: guest ACK'd our FIN, waiting for guest's FIN.
   if (Flags and TCPFlagFIN)<>0 then begin
    inc(TCPSession^.ServerAck);
    SendTCPToGuest(SessionIndex,TCPFlagACK,nil,0);
    TCPSession^.State:=UserModeTCPStateTimeWait;
    TCPSession^.TimeWaitTickCount:=0;
   end;
  end;

  UserModeTCPStateClosing:begin
   // Simultaneous close: both sides sent FIN, waiting for guest to ACK our FIN.
   if ((Flags and TCPFlagACK)<>0) and (GuestAcknowledgmentNumber=TCPSession^.ServerSeq) then begin
    TCPSession^.State:=UserModeTCPStateTimeWait;
    TCPSession^.TimeWaitTickCount:=0;
   end;
  end;

 end;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.CloseICMPSession(const aSessionIndex:TPasRISCVInt32);
var ICMPSession:PICMPSession;
    Key:TUserModeICMPKey;
    Position,LastSessionIndex:TPasRISCVInt32;
begin

 ICMPSession:=@fICMPSessionArray[aSessionIndex];

{$ifdef PasRISCVUseRNLNetworkInstance}
 fRNLNetwork.SocketDestroy(ICMPSession^.SocketFileDescriptor);
{$else}
 RNLSocketDestroy(ICMPSession^.SocketFileDescriptor);
{$endif}

 FillChar(Key,SizeOf(TUserModeICMPKey),#0);
 Key.GuestSourceIP:=ICMPSession^.GuestSourceIP;
 Key.GuestIdentifier:=ICMPSession^.GuestIdentifier;

 fICMPSessions.Delete(Key);

 fICMPFreeList.Enqueue(aSessionIndex);

 Position:=ICMPSession^.ActiveIndex;

 dec(fICMPActiveCount);

 if Position<fICMPActiveCount then begin
  LastSessionIndex:=fICMPActiveIndices[fICMPActiveCount];
  fICMPActiveIndices[Position]:=LastSessionIndex;
  fICMPSessionArray[LastSessionIndex].ActiveIndex:=Position;
 end;

 ICMPSession^.Active:=false;

 FillChar(ICMPSession^,SizeOf(TICMPSession),#0);

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.CloseUDPSession(const aSessionIndex:TPasRISCVInt32);
var UDPSession:PUDPSession;
    Key:TUserModeUDPKey;
    Position,LastSessionIndex:TPasRISCVInt32;
begin

 UDPSession:=@fUDPSessionArray[aSessionIndex];

{$ifdef PasRISCVUseRNLNetworkInstance}
 fRNLNetwork.SocketDestroy(UDPSession^.SocketFileDescriptor);
{$else}
 RNLSocketDestroy(UDPSession^.SocketFileDescriptor);
{$endif}

 FillChar(Key,SizeOf(TUserModeUDPKey),#0);
 Key.GuestSourceIP:=UDPSession^.GuestSourceIP;
 Key.GuestSourcePort:=UDPSession^.GuestSourcePort;
 Key.DestinationIP:=UDPSession^.OriginalDestinationIP;
 Key.DestinationPort:=UDPSession^.OriginalDestinationPort;

 fUDPSessions.Delete(Key);

 fUDPFreeList.Enqueue(aSessionIndex);

 Position:=UDPSession^.ActiveIndex;

 dec(fUDPActiveCount);

 if Position<fUDPActiveCount then begin
  LastSessionIndex:=fUDPActiveIndices[fUDPActiveCount];
  fUDPActiveIndices[Position]:=LastSessionIndex;
  fUDPSessionArray[LastSessionIndex].ActiveIndex:=Position;
 end;

 UDPSession^.Active:=false;

 FillChar(UDPSession^,SizeOf(TUDPSession),#0);

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.PollICMPSockets;
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
var SessionIndex:TPasRISCVInt32;
    SessionItem:PICMPSession;
    ReceiveLength:TPasRISCVSizeInt;
    ActiveArrayIndex:TPasRISCVInt32;
    CloseIndex:TPasRISCVInt32;
    SenderAddress:TRNLAddress;
    ResponseEthernet:PEthernetHeader;
    ResponseIP:PIPv4Header;
    ReceivedICMP:PICMPHeader;
    ResponseICMP:PICMPHeader;
    OrigIPCopy:PIPv4Header;
    OrigICMPHeader:PICMPHeader;
    ICMPPayloadSize:TPasRISCVSizeInt;
    TotalSize:TPasRISCVSizeInt;
begin

 fToCloseCount:=0;

 for ActiveArrayIndex:=0 to fICMPActiveCount-1 do begin

  SessionIndex:=fICMPActiveIndices[ActiveArrayIndex];

  SessionItem:=@fICMPSessionArray[SessionIndex];

  if SessionItem^.Active then begin

   SenderAddress:=RNL_ADDRESS_EMPTY;
{$ifdef PasRISCVUseRNLNetworkInstance}
   ReceiveLength:=fRNLNetwork.Receive(SessionItem^.SocketFileDescriptor,@SenderAddress,fReceiveBuffer[0],SizeOf(fReceiveBuffer),RNL_IPV4);
{$else}
   ReceiveLength:=RNLSocketReceive(SessionItem^.SocketFileDescriptor,@SenderAddress,fReceiveBuffer[0],SizeOf(fReceiveBuffer),RNL_IPV4);
{$endif}

   if ReceiveLength>=UserModeICMPHeaderSize then begin

{$if defined(Windows)}
    // Windows raw ICMP sockets include the IP header in the received data
    if ReceiveLength>UserModeIPv4HeaderSize then begin
     ReceiveLength:=ReceiveLength-UserModeIPv4HeaderSize;
     Move(fReceiveBuffer[UserModeIPv4HeaderSize],fReceiveBuffer[0],ReceiveLength);
    end else begin
     ReceiveLength:=0;
    end;
{$ifend}

    if ReceiveLength>=UserModeICMPHeaderSize then begin

     ReceivedICMP:=PICMPHeader(@fReceiveBuffer[0]);

     if (ReceivedICMP^.ICMPType=ICMPTypeDestinationUnreachable) or
        (ReceivedICMP^.ICMPType=ICMPTypeTimeExceeded) then begin

      ICMPPayloadSize:=UserModeICMPHeaderSize+UserModeIPv4HeaderSize+UserModeICMPHeaderSize;

      TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+ICMPPayloadSize;

      FillChar(fFrameBuffer[0],TotalSize,#0);

      ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);

      ResponseIP:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));

      ResponseICMP:=PICMPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize)));

      OrigIPCopy:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeICMPHeaderSize)));

      OrigICMPHeader:=PICMPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OrigIPCopy)+UserModeIPv4HeaderSize)));

      ResponseEthernet^.DestinationMAC:=fGuestMAC;
      ResponseEthernet^.SourceMAC:=GatewayMAC;
      ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

      ResponseIP^.VersionIHL:=$45;
      ResponseIP^.DSCP_ECN:=0;
      ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+ICMPPayloadSize));

      inc(fIPIDCounter);

      ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
      ResponseIP^.FlagsFragment:=0;
      ResponseIP^.TTL:=64;
      ResponseIP^.Protocol:=IPProtocolICMP;
      ResponseIP^.HeaderChecksum:=0;
      Move(SenderAddress.Host.Addr[12],ResponseIP^.SourceIP[0],4);
      ResponseIP^.DestinationIP:=SessionItem^.GuestSourceIP;
      ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);

      ResponseICMP^.ICMPType:=ReceivedICMP^.ICMPType;
      ResponseICMP^.Code:=ReceivedICMP^.Code;
      ResponseICMP^.Checksum:=0;
      ResponseICMP^.Identifier:=ReceivedICMP^.Identifier;
      ResponseICMP^.Sequence:=ReceivedICMP^.Sequence;

      OrigIPCopy^:=SessionItem^.OriginalIPHeader;
      OrigICMPHeader^:=SessionItem^.OriginalICMPHeader;

      ResponseICMP^.Checksum:=UserModeIPChecksum(ResponseICMP,ICMPPayloadSize);

      InjectToGuest(@fFrameBuffer[0],TotalSize);

      SessionItem^.TickCount:=0;

     end else begin

      if ReceiveLength>(SizeOf(fFrameBuffer)-(UserModeEtherHeaderSize+UserModeIPv4HeaderSize)) then begin
       ReceiveLength:=SizeOf(fFrameBuffer)-(UserModeEtherHeaderSize+UserModeIPv4HeaderSize);
      end;

      TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+ReceiveLength;

      FillChar(fFrameBuffer[0],TotalSize,#0);

      ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);

      ResponseIP:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));

      ResponseEthernet^.DestinationMAC:=fGuestMAC;
      ResponseEthernet^.SourceMAC:=GatewayMAC;
      ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

      ResponseIP^.VersionIHL:=$45;
      ResponseIP^.DSCP_ECN:=0;
      ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+ReceiveLength));

      inc(fIPIDCounter);

      ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
      ResponseIP^.FlagsFragment:=0;
      ResponseIP^.TTL:=64;
      ResponseIP^.Protocol:=IPProtocolICMP;
      ResponseIP^.HeaderChecksum:=0;

      Move(SenderAddress.Host.Addr[12],ResponseIP^.SourceIP[0],4);

      ResponseIP^.DestinationIP:=SessionItem^.GuestSourceIP;
      ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);

      Move(fReceiveBuffer[0],fFrameBuffer[UserModeEtherHeaderSize+UserModeIPv4HeaderSize],ReceiveLength);

      InjectToGuest(@fFrameBuffer[0],TotalSize);

      SessionItem^.TickCount:=0;

     end; // if ReceivedICMP^.ICMPType

    end; // inner if ReceiveLength>=UserModeICMPHeaderSize

   end else begin

    inc(SessionItem^.TickCount,fUserModeTickDelta);
    if SessionItem^.TickCount>=UserModeICMPIdleTimeoutTicks then begin
     if length(fToClose)<=fToCloseCount then begin
      if length(fToClose)=0 then begin
       SetLength(fToClose,8);
      end else begin
       SetLength(fToClose,length(fToClose)*2);
      end;
     end;
     fToClose[fToCloseCount]:=SessionIndex;
     inc(fToCloseCount);
    end;

   end;

  end;

 end;

 for CloseIndex:=0 to fToCloseCount-1 do begin
  CloseICMPSession(fToClose[CloseIndex]);
 end;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.InitHostDNS;
var IPString:AnsiString;
    DotPosition:TPasRISCVInt32;
    Part:AnsiString;
    Octets:array[0..3] of TPasRISCVInt32;
    OctetIndex:TPasRISCVInt32;
    Value:TPasRISCVInt32;
    Valid:Boolean;
    ParsedRNLAddress:TRNLAddress;
    FoundIPv4DNS:Boolean;
    IPv6AddressHasNonZeroByte:Boolean;
    ByteIndex:TPasRISCVInt32;
{$if defined(Unix) or (defined(Posix) and not defined(fpc))}
    LineIndex:TPasRISCVInt32;
    Line:AnsiString;
    Lines:TStringList;
    SpacePosition:TPasRISCVInt32;
{$elseif defined(Windows)}
    FixedInfoBuffer:array[0..4095] of Byte;
    FixedInfo:PFixedInfo;
    InfoSize:ULONG;
    AdapterSize:ULONG;
    Adapters,Adapter:PIP_ADAPTER_ADDRESSES;
    AdapterDNSAddress:PIP_ADAPTER_DNS_SERVER_ADDRESS;
    SockAddrIn6:PSockAddrIn6;
{$ifend}
begin

 // 9.9.9.9
 fHostDNSIP[0]:=9;
 fHostDNSIP[1]:=9;
 fHostDNSIP[2]:=9;
 fHostDNSIP[3]:=9;

 FillChar(fHostDNSIPv6,SizeOf(TIPv6Address),#0);
 fHostDNSIPv6Available:=false;
 FoundIPv4DNS:=false;

{$if defined(Unix) or (defined(Posix) and not defined(fpc))}

 if not FileExists('/etc/resolv.conf') then begin
  exit;
 end;

 Lines:=TStringList.Create;
 try

  Lines.LoadFromFile('/etc/resolv.conf');

  for LineIndex:=0 to Lines.Count-1 do begin

   Line:=Trim(AnsiString(Lines[LineIndex]));

   if Pos(AnsiString('nameserver'),Line)=1 then begin

    Line:=Trim(Copy(Line,Length('nameserver')+1,Length(Line)));

    SpacePosition:=Pos(AnsiString(' '),Line);

    if SpacePosition>0 then begin
     Line:=Trim(Copy(Line,1,SpacePosition-1));
    end;

    IPString:=Line;

    if not fHostDNSIPv6Available then begin
     ParsedRNLAddress:=TRNLAddress.CreateFromString(String(Line));
     if (ParsedRNLAddress.ScopeID=0) and
        (ParsedRNLAddress.GetAddressFamily=RNL_IPV6) and
        (not ((ParsedRNLAddress.Host.Addr[0]=$fe) and ((ParsedRNLAddress.Host.Addr[1] and $c0)=$80))) and
        (ParsedRNLAddress.Host.Addr[0]<>$ff) then begin
      IPv6AddressHasNonZeroByte:=false;
      for ByteIndex:=0 to 15 do begin
       if ParsedRNLAddress.Host.Addr[ByteIndex]<>0 then begin
        IPv6AddressHasNonZeroByte:=true;
        break;
       end;
      end;
      if IPv6AddressHasNonZeroByte then begin
       Move(ParsedRNLAddress.Host.Addr[0],fHostDNSIPv6[0],16);
       fHostDNSIPv6Available:=true;
      end;
     end;
    end;

    if not FoundIPv4DNS then begin

     Valid:=true;

     OctetIndex:=0;

     while (Length(IPString)>0) and (OctetIndex<4) do begin

      DotPosition:=Pos(AnsiString('.'),IPString);

      if DotPosition>0 then begin
       Part:=Copy(IPString,1,DotPosition-1);
       IPString:=Copy(IPString,DotPosition+1,Length(IPString));
      end else begin
       Part:=IPString;
       IPString:='';
      end;

      Value:=0;

      if not TryStrToInt(string(Part),Value) or (Value<0) or (Value>255) then begin
       Valid:=false;
       break;
      end;

      Octets[OctetIndex]:=Value;
      inc(OctetIndex);

     end;

     if Valid and (OctetIndex=4) then begin
      fHostDNSIP[0]:=Octets[0];
      fHostDNSIP[1]:=Octets[1];
      fHostDNSIP[2]:=Octets[2];
      fHostDNSIP[3]:=Octets[3];
      FoundIPv4DNS:=true;
     end;

    end;

    if FoundIPv4DNS and fHostDNSIPv6Available then begin
     break;
    end;

   end;

  end;

 finally
  FreeAndNil(Lines);
 end;

{$elseif defined(Windows)}

 InfoSize:=SizeOf(FixedInfoBuffer);

 FixedInfo:=@FixedInfoBuffer[0];

 if GetNetworkParams(FixedInfo,InfoSize)=ERROR_SUCCESS then begin

  IPString:=AnsiString(FixedInfo^.DnsServerList.IpAddress.S);

  Valid:=true;

  OctetIndex:=0;

  while (Length(IPString)>0) and (OctetIndex<4) do begin
   DotPosition:=Pos(AnsiString('.'),IPString);

   if DotPosition>0 then begin
    Part:=Copy(IPString,1,DotPosition-1);
    IPString:=Copy(IPString,DotPosition+1,Length(IPString));
   end else begin
    Part:=IPString;
    IPString:='';
   end;

   Value:=0;

   if not TryStrToInt(string(Part),Value) or (Value<0) or (Value>255) then begin
    Valid:=false;
    break;
   end;

   Octets[OctetIndex]:=Value;
   inc(OctetIndex);

  end;

  if Valid and (OctetIndex=4) then begin
   fHostDNSIP[0]:=Octets[0];
   fHostDNSIP[1]:=Octets[1];
   fHostDNSIP[2]:=Octets[2];
   fHostDNSIP[3]:=Octets[3];
  end;

 end;

 AdapterSize:=20000;
 Adapters:=nil;
 try

  repeat

   GetMem(Adapters,AdapterSize);
   case GetAdaptersAddresses(AF_UNSPEC,GAA_FLAG_INCLUDE_PREFIX,nil,Adapters,@AdapterSize) of
    ERROR_BUFFER_OVERFLOW:begin
     FreeMem(Adapters);
     Adapters:=nil;
    end;
    ERROR_SUCCESS:begin
     break;
    end;
    else begin
     FreeMem(Adapters);
     Adapters:=nil;
     break;
    end;
   end;
  until assigned(Adapters);

  Adapter:=Adapters;
  while assigned(Adapter) and not fHostDNSIPv6Available do begin

   if (Adapter^.IfType<>24{IF_TYPE_SOFTWARE_LOOPBACK}) and (Adapter^.OperStatus=IfOperStatusUp) then begin

    AdapterDNSAddress:=Adapter^.FirstDnsServerAddress;
    while assigned(AdapterDNSAddress) and not fHostDNSIPv6Available do begin

     if assigned(AdapterDNSAddress^.Address.lpSockaddr) and (AdapterDNSAddress^.Address.lpSockaddr^.sa_family=AF_INET6) then begin

      SockAddrIn6:=PSockAddrIn6(AdapterDNSAddress^.Address.lpSockaddr);
      if (SockAddrIn6^.sin6_scope_id=0) and
         (not ((SockAddrIn6^.sin6_addr.s6_addr[0]=$fe) and ((SockAddrIn6^.sin6_addr.s6_addr[1] and $c0)=$80))) and
         (SockAddrIn6^.sin6_addr.s6_addr[0]<>$ff) then begin

       IPv6AddressHasNonZeroByte:=false;
       for ByteIndex:=0 to 15 do begin
        if SockAddrIn6^.sin6_addr.s6_addr[ByteIndex]<>0 then begin
         IPv6AddressHasNonZeroByte:=true;
         break;
        end;
       end;

       if IPv6AddressHasNonZeroByte then begin
        Move(SockAddrIn6^.sin6_addr.s6_addr[0],fHostDNSIPv6[0],16);
        fHostDNSIPv6Available:=true;
        break;
       end;

      end;

     end;

     AdapterDNSAddress:=AdapterDNSAddress^.Next;

    end;

   end;

   Adapter:=Adapter^.Next;

  end;

 finally
  if assigned(Adapters) then begin
   FreeMem(Adapters);
  end;
 end;

{$ifend}

 if not fHostDNSIPv6Available then begin
  // 2620:fe::9
  FillChar(fHostDNSIPv6,SizeOf(TIPv6Address),#0);
  fHostDNSIPv6[0]:=$26;
  fHostDNSIPv6[1]:=$20;
  fHostDNSIPv6[2]:=$00;
  fHostDNSIPv6[3]:=$fe;
  fHostDNSIPv6[15]:=$09;
  fHostDNSIPv6Available:=true;
 end;

end;

function TPasRISCVEthernetDeviceUserModeNetworking.FindOrCreateUDPSession(const aGuestSourcePort:TPasRISCVUInt16;const aGuestSourceIP:TIPv4Address;const aOriginalDestinationIP:TIPv4Address;const aOriginalDestinationPort:TPasRISCVUInt16):TPasRISCVInt32;
var UDPKey:TUserModeUDPKey;
    Index:TPasRISCVInt32;
    ExtraIndex:TPasRISCVInt32;
    ActiveArrayIndex:TPasRISCVInt32;
    OldestSessionIndex:TPasRISCVInt32;
    OldestTickCount:TPasRISCVUInt32;
    SessionItem:PUDPSession;
begin

 FillChar(UDPKey,SizeOf(TUserModeUDPKey),#0);
 UDPKey.GuestSourceIP:=aGuestSourceIP;
 UDPKey.GuestSourcePort:=aGuestSourcePort;
 UDPKey.DestinationIP:=aOriginalDestinationIP;
 UDPKey.DestinationPort:=aOriginalDestinationPort;

 if fUDPSessions.TryGet(UDPKey,Index) then begin
  fUDPSessionArray[Index].OriginalDestinationIP:=aOriginalDestinationIP;
  fUDPSessionArray[Index].OriginalDestinationPort:=aOriginalDestinationPort;
  fUDPSessionArray[Index].TickCount:=0;
  result:=Index;
  exit;
 end;

 if (UserModeUDPMaxSessions>0) and (fUDPActiveCount>=UserModeUDPMaxSessions) then begin
  OldestSessionIndex:=-1;
  OldestTickCount:=0;
  for ActiveArrayIndex:=0 to fUDPActiveCount-1 do begin
   Index:=fUDPActiveIndices[ActiveArrayIndex];
   if (OldestSessionIndex<0) or (fUDPSessionArray[Index].TickCount>OldestTickCount) then begin
    OldestSessionIndex:=Index;
    OldestTickCount:=fUDPSessionArray[Index].TickCount;
   end;
  end;
  if OldestSessionIndex<0 then begin
   result:=-1;
   exit;
  end;
  CloseUDPSession(OldestSessionIndex);
 end;

 if not fUDPFreeList.Dequeue(Index) then begin
  Index:=length(fUDPSessionArray);
  SetLength(fUDPSessionArray,TPasRISCVInt32(Index+1)*2);
  for ExtraIndex:=Index+1 to length(fUDPSessionArray)-1 do begin
   fUDPFreeList.Enqueue(ExtraIndex);
  end;
 end;

 SessionItem:=@fUDPSessionArray[Index];
 FillChar(SessionItem^,SizeOf(TUDPSession),#0);

{$ifdef PasRISCVUseRNLNetworkInstance}
 SessionItem^.SocketFileDescriptor:=fRNLNetwork.SocketCreate(RNL_SOCKET_TYPE_DATAGRAM,RNL_IPV4);
{$else}
 SessionItem^.SocketFileDescriptor:=RNLSocketCreate(RNL_SOCKET_TYPE_DATAGRAM,RNL_IPV4);
{$endif}
 if SessionItem^.SocketFileDescriptor=RNL_SOCKET_NULL then begin
  fUDPFreeList.Enqueue(Index);
  result:=-1;
  exit;
 end;
{$ifdef PasRISCVUseRNLNetworkInstance}
 fRNLNetwork.SocketSetOption(SessionItem^.SocketFileDescriptor,RNL_SOCKET_OPTION_NONBLOCK,1);
{$else}
 RNLSocketSetNonBlock(SessionItem^.SocketFileDescriptor);
{$endif}
 if fUserModeTracerouteEnabled then begin
  // Without this Linux drops ICMP errors for an unconnected datagram socket, so the
  // port unreachable that ends a UDP traceroute would never become visible. Only
  // requested when the option is on, so ordinary UDP keeps its previous behaviour.
{$ifdef PasRISCVUseRNLNetworkInstance}
  fRNLNetwork.SocketSetOption(SessionItem^.SocketFileDescriptor,RNL_SOCKET_OPTION_RECVERR,1);
{$else}
  RNLSocketSetRecvErr(SessionItem^.SocketFileDescriptor);
{$endif}
 end;

 SessionItem^.GuestSourcePort:=aGuestSourcePort;
 SessionItem^.Active:=true;
 SessionItem^.GuestSourceIP:=aGuestSourceIP;
 SessionItem^.OriginalDestinationIP:=aOriginalDestinationIP;
 SessionItem^.OriginalDestinationPort:=aOriginalDestinationPort;

 if fUDPActiveCount>=fUDPActiveCapacity then begin
  if fUDPActiveCapacity=0 then begin
   fUDPActiveCapacity:=8;
  end else begin
   fUDPActiveCapacity:=fUDPActiveCapacity*2;
  end;
  SetLength(fUDPActiveIndices,fUDPActiveCapacity);
 end;
 SessionItem^.ActiveIndex:=fUDPActiveCount;
 fUDPActiveIndices[fUDPActiveCount]:=Index;
 inc(fUDPActiveCount);

 fUDPSessions.Add(UDPKey,Index);

 result:=Index;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.ForwardUDP(const aEthHeader:PEthernetHeader;const aIPHeader:PIPv4Header;const aUDPHeader:PUDPHeader;const aPayload:Pointer;const aPayloadSize:TPasRISCVSizeInt);
const DNSProxyIP:TIPv4Address=($0a,$00,$02,$03);
      GatewayIP:TIPv4Address=($0a,$00,$02,$02);
var ActualDestinationIP:TIPv4Address;
    ActualDestinationPort:TPasRISCVUInt16;
    SessionIndex:TPasRISCVInt32;
    SessionItem:PUDPSession;
    ForwardIndex:TPasRISCVInt32;
    PortForwardItem:PUserModePortForward;
    DestinationAddress:TRNLAddress;
    ReturnAddress:TRNLAddress;
    ReturnDestinationIP:TPasRISCVUInt32;
    ReturnDestinationPort:TPasRISCVUInt16;
begin

 if aPayloadSize<=0 then begin
  exit;
 end;

 if fIsolated then begin
  exit;
 end;

 if CompareMem(@aIPHeader^.DestinationIP,@GatewayIP,4) then begin
  exit;
 end;

 // Check if this is a reply from the guest for a UDP port-forward (return path)
 for ForwardIndex:=0 to fPortForwardCount-1 do begin

  PortForwardItem:=@fPortForwards[ForwardIndex];

  if (PortForwardItem^.Protocol=IPProtocolUDP) and
     CompareMem(@aIPHeader^.SourceIP,@PortForwardItem^.GuestIP,4) and
     (aUDPHeader^.SourcePort=TRNLEndianness.HostToNet16(PortForwardItem^.GuestPort)) then begin
   ReturnDestinationIP:=TRNLUInt32(TRNLPointer(@aIPHeader^.DestinationIP[0])^);
   ReturnDestinationPort:=TRNLEndianness.NetToHost16(aUDPHeader^.DestinationPort);
   if FindUDPPortForwardPeer(ForwardIndex,ReturnDestinationIP,ReturnDestinationPort)>=0 then begin
    ReturnAddress.Host:=TRNLHostAddress.CreateFromIPV4(ReturnDestinationIP);
    ReturnAddress.Port:=ReturnDestinationPort;
    ReturnAddress.ScopeID:=0;
{$ifdef PasRISCVUseRNLNetworkInstance}
    fRNLNetwork.Send(PortForwardItem^.ListenFileDescriptor,@ReturnAddress,aPayload^,aPayloadSize,RNL_IPV4);
{$else}
    RNLSocketSend(PortForwardItem^.ListenFileDescriptor,@ReturnAddress,aPayload^,aPayloadSize,RNL_IPV4);
{$endif}
    exit;
   end;
  end;

 end;

 ActualDestinationIP:=aIPHeader^.DestinationIP;
 ActualDestinationPort:=TRNLEndianness.NetToHost16(aUDPHeader^.DestinationPort);

 if CompareMem(@aIPHeader^.DestinationIP,@DNSProxyIP,4) then begin
  ActualDestinationIP:=fHostDNSIP;
 end;

 if ActualDestinationIP[0]=127 then begin
  ActualDestinationIP:=GatewayIP;
 end;

 if (ActualDestinationIP[0]=0) or
    ((ActualDestinationIP[0]=255) and (ActualDestinationIP[1]=255) and (ActualDestinationIP[2]=255) and (ActualDestinationIP[3]=255)) then begin
  exit;
 end;

 if fFilterLAN then begin
  if (ActualDestinationIP[0]=10) or
     ((ActualDestinationIP[0]=172) and (ActualDestinationIP[1]>=16) and (ActualDestinationIP[1]<=31)) or
     ((ActualDestinationIP[0]=192) and (ActualDestinationIP[1]=168)) or
     ((ActualDestinationIP[0]=169) and (ActualDestinationIP[1]=254)) then begin
   exit;
  end;
 end;

 SessionIndex:=FindOrCreateUDPSession(TRNLEndianness.NetToHost16(aUDPHeader^.SourcePort),aIPHeader^.SourceIP,aIPHeader^.DestinationIP,ActualDestinationPort);

 if SessionIndex<0 then begin
  exit;
 end;

 SessionItem:=@fUDPSessionArray[SessionIndex];

 DestinationAddress.Host:=TRNLHostAddress.CreateFromIPV4(TRNLUInt32(TRNLPointer(@ActualDestinationIP[0])^));
 DestinationAddress.Port:=ActualDestinationPort;
 DestinationAddress.ScopeID:=0;
{$ifdef PasRISCVUseRNLNetworkInstance}
 fRNLNetwork.Send(SessionItem^.SocketFileDescriptor,@DestinationAddress,aPayload^,aPayloadSize,RNL_IPV4);
{$else}
 RNLSocketSend(SessionItem^.SocketFileDescriptor,@DestinationAddress,aPayload^,aPayloadSize,RNL_IPV4);
{$endif}
end;

// The destination of a UDP probe answers an unused port with an ICMP port
// unreachable, but that reply lands on the host's stack, not on the guest's. This
// rebuilds it for the guest from what the session already knows, which is what
// lets a UDP traceroute recognise that it has arrived instead of running to its
// hop limit.
procedure TPasRISCVEthernetDeviceUserModeNetworking.SendICMPUDPPortUnreachable(const aUDPSession:PUDPSession);
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
var ICMPPayloadSize:TPasRISCVSizeInt;
    TotalSize:TPasRISCVSizeInt;
    ResponseEthernet:PEthernetHeader;
    ResponseIP:PIPv4Header;
    ResponseICMP:PICMPHeader;
    OrigIPCopy:PIPv4Header;
    OrigUDPCopy:PUDPHeader;
begin

 // RFC 792 wants the offending IP header plus its first 8 bytes, which for UDP is
 // exactly the UDP header. traceroute matches the probe by the port in there.
 ICMPPayloadSize:=UserModeICMPHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize;

 TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+ICMPPayloadSize;

 FillChar(fFrameBuffer[0],TotalSize,#0);

 ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);
 ResponseIP:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));
 ResponseICMP:=PICMPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize)));
 OrigIPCopy:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeICMPHeaderSize)));
 OrigUDPCopy:=PUDPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OrigIPCopy)+UserModeIPv4HeaderSize)));

 ResponseEthernet^.DestinationMAC:=fGuestMAC;
 ResponseEthernet^.SourceMAC:=GatewayMAC;
 ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

 ResponseIP^.VersionIHL:=$45;
 ResponseIP^.DSCP_ECN:=0;
 ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+ICMPPayloadSize));

 inc(fIPIDCounter);

 ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
 ResponseIP^.FlagsFragment:=0;
 ResponseIP^.TTL:=64;
 ResponseIP^.Protocol:=IPProtocolICMP;
 ResponseIP^.HeaderChecksum:=0;
 // The host that refused the port is the one reporting it
 ResponseIP^.SourceIP:=aUDPSession^.OriginalDestinationIP;
 ResponseIP^.DestinationIP:=aUDPSession^.GuestSourceIP;
 ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);

 ResponseICMP^.ICMPType:=ICMPTypeDestinationUnreachable;
 ResponseICMP^.Code:=ICMPCodePortUnreachable;
 ResponseICMP^.Checksum:=0;
 ResponseICMP^.Identifier:=0;
 ResponseICMP^.Sequence:=0;

 // Rebuild the probe as the guest sent it
 OrigIPCopy^.VersionIHL:=$45;
 OrigIPCopy^.DSCP_ECN:=0;
 OrigIPCopy^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+UserModeUDPHeaderSize));
 OrigIPCopy^.Identification:=0;
 OrigIPCopy^.FlagsFragment:=0;
 OrigIPCopy^.TTL:=1;
 OrigIPCopy^.Protocol:=IPProtocolUDP;
 OrigIPCopy^.HeaderChecksum:=0;
 OrigIPCopy^.SourceIP:=aUDPSession^.GuestSourceIP;
 OrigIPCopy^.DestinationIP:=aUDPSession^.OriginalDestinationIP;
 OrigIPCopy^.HeaderChecksum:=UserModeIPChecksum(OrigIPCopy,UserModeIPv4HeaderSize);

 OrigUDPCopy^.SourcePort:=TRNLEndianness.HostToNet16(aUDPSession^.GuestSourcePort);
 OrigUDPCopy^.DestinationPort:=TRNLEndianness.HostToNet16(aUDPSession^.OriginalDestinationPort);
 OrigUDPCopy^.Length:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeUDPHeaderSize));
 OrigUDPCopy^.Checksum:=0;

 ResponseICMP^.Checksum:=UserModeIPChecksum(ResponseICMP,ICMPPayloadSize);

 InjectToGuest(@fFrameBuffer[0],TotalSize);

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.PollUDPSockets;
const GatewayMAC:TMACAddress=($52,$54,$00,$12,$34,$02);
      DNSProxyIP:TIPv4Address=($0a,$00,$02,$03);
var SessionIndex:TPasRISCVInt32;
    SessionItem:PUDPSession;
    ReceiveLength:TPasRISCVSizeInt;
    ActiveArrayIndex:TPasRISCVInt32;
    ForwardIndex:TPasRISCVInt32;
    InjectTotalSize:TPasRISCVSizeInt;
    InjectEthernetHeader:PEthernetHeader;
    InjectIPHeader:PIPv4Header;
    InjectUDPHeader:PUDPHeader;
    InjectSenderIPBytes:TIPv4Address;
    PortForwardItem:PUserModePortForward;
    CloseIndex:TPasRISCVInt32;
    InjectSenderAddress:TRNLAddress;
    InjectReceiveLength:TPasRISCVSizeInt;
    ResponseEthernet:PEthernetHeader;
    ResponseIP:PIPv4Header;
    ResponseUDP:PUDPHeader;
    TotalSize:TPasRISCVSizeInt;
    ReplySourceIP:TIPv4Address;
    ReplySourcePort:TPasRISCVUInt16;
    SenderAddress:TRNLAddress;
    SenderIPBytes:TIPv4Address;
    UDPSocketError:TPasRISCVInt32;
begin

 fToCloseCount:=0;

 for ActiveArrayIndex:=0 to fUDPActiveCount-1 do begin

  SessionIndex:=fUDPActiveIndices[ActiveArrayIndex];

  SessionItem:=@fUDPSessionArray[SessionIndex];

  if SessionItem^.Active then begin

   // With IP_RECVERR the kernel records an incoming ICMP error in SO_ERROR, where
   // reading it also clears it. Only asked for when the option is on, and only a
   // refused port is turned into something the guest can see.
   if fUserModeTracerouteEnabled then begin
    UDPSocketError:=0;
    if {$ifdef PasRISCVUseRNLNetworkInstance}
       fRNLNetwork.SocketGetOption(SessionItem^.SocketFileDescriptor,RNL_SOCKET_OPTION_ERROR,UDPSocketError)
       {$else}
       RNLSocketGetError(SessionItem^.SocketFileDescriptor,UDPSocketError)
       {$endif} and
       (UDPSocketError=UserModeErrnoConnectionRefused) then begin
     SendICMPUDPPortUnreachable(SessionItem);
    end;
   end;

   SenderAddress:=RNL_ADDRESS_EMPTY;
{$ifdef PasRISCVUseRNLNetworkInstance}
   ReceiveLength:=fRNLNetwork.Receive(SessionItem^.SocketFileDescriptor,@SenderAddress,fReceiveBuffer[0],SizeOf(fReceiveBuffer),RNL_IPV4);
{$else}
   ReceiveLength:=RNLSocketReceive(SessionItem^.SocketFileDescriptor,@SenderAddress,fReceiveBuffer[0],SizeOf(fReceiveBuffer),RNL_IPV4);
{$endif}

   if ReceiveLength>0 then begin

    // Validate sender address against session destination to prevent spoofing
    TRNLUInt32(TRNLPointer(@SenderIPBytes[0])^):=SenderAddress.Host.Addr[12];
    if (not CompareMem(@SenderIPBytes[0],@SessionItem^.OriginalDestinationIP[0],4)) or
       (SenderAddress.Port<>SessionItem^.OriginalDestinationPort) then begin
     // Allow DNS replies from host resolver, dns proxy IP and port 53 which may come from
     // a different resolver
     if (SessionItem^.OriginalDestinationPort=53) or
        CompareMem(@SessionItem^.OriginalDestinationIP,@DNSProxyIP,4) or
        CompareMem(@SessionItem^.OriginalDestinationIP,@fHostDNSIP,4) then begin
      // Allow
     end else begin
      // Otherwise reject
      continue;
     end;
    end;

    if ReceiveLength>(SizeOf(fFrameBuffer)-(UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize)) then begin
     ReceiveLength:=SizeOf(fFrameBuffer)-(UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize);
    end;

    TotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize+ReceiveLength;

    FillChar(fFrameBuffer[0],TotalSize,#0);

    ResponseEthernet:=PEthernetHeader(@fFrameBuffer[0]);

    ResponseIP:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));

    ResponseUDP:=PUDPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize)));

    ReplySourcePort:=SessionItem^.OriginalDestinationPort;
    ReplySourceIP:=SessionItem^.OriginalDestinationIP;

    if CompareMem(@SessionItem^.OriginalDestinationIP,@fHostDNSIP,4) then begin
     ReplySourceIP:=DNSProxyIP;
    end;

    ResponseEthernet^.DestinationMAC:=fGuestMAC;
    ResponseEthernet^.SourceMAC:=GatewayMAC;
    ResponseEthernet^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

    ResponseIP^.VersionIHL:=$45;
    ResponseIP^.DSCP_ECN:=0;
    ResponseIP^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+UserModeUDPHeaderSize+ReceiveLength));

    inc(fIPIDCounter);

    ResponseIP^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
    ResponseIP^.FlagsFragment:=0;
    ResponseIP^.TTL:=64;
    ResponseIP^.Protocol:=IPProtocolUDP;
    ResponseIP^.HeaderChecksum:=0;
    ResponseIP^.SourceIP:=ReplySourceIP;
    ResponseIP^.DestinationIP:=SessionItem^.GuestSourceIP;
    ResponseIP^.HeaderChecksum:=UserModeIPChecksum(ResponseIP,UserModeIPv4HeaderSize);

    ResponseUDP^.SourcePort:=TRNLEndianness.HostToNet16(ReplySourcePort);
    ResponseUDP^.DestinationPort:=TRNLEndianness.HostToNet16(SessionItem^.GuestSourcePort);
    ResponseUDP^.Length:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeUDPHeaderSize+ReceiveLength));
    ResponseUDP^.Checksum:=0;

    Move(fReceiveBuffer[0],Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize))^,ReceiveLength);

    ResponseUDP^.Checksum:=UserModeTCPUDPChecksum(ReplySourceIP,SessionItem^.GuestSourceIP,IPProtocolUDP,ResponseUDP,UserModeUDPHeaderSize+ReceiveLength);
    if ResponseUDP^.Checksum=0 then begin
     ResponseUDP^.Checksum:=$ffff;
    end;

    InjectToGuest(@fFrameBuffer[0],TotalSize);

    SessionItem^.TickCount:=0;

   end else begin

    inc(SessionItem^.TickCount,fUserModeTickDelta);
    if SessionItem^.TickCount>=IfThen(SessionItem^.OriginalDestinationPort=53,UserModeUDPDNSIdleTimeoutTicks,UserModeUDPIdleTimeoutTicks) then begin
     if length(fToClose)<=fToCloseCount then begin
      if length(fToClose)=0 then begin
       SetLength(fToClose,8);
      end else begin
       SetLength(fToClose,length(fToClose)*2);
      end;
     end;
     fToClose[fToCloseCount]:=SessionIndex;
     inc(fToCloseCount);
    end;

   end;

  end;

 end;

 for CloseIndex:=0 to fToCloseCount-1 do begin
  CloseUDPSession(fToClose[CloseIndex]);
 end;

 for ForwardIndex:=0 to fPortForwardCount-1 do begin

  PortForwardItem:=@fPortForwards[ForwardIndex];

  if (PortForwardItem^.Protocol=IPProtocolUDP) and not PortForwardItem^.IsIPv6 then begin

   AgeUDPPortForwardPeers(ForwardIndex);

   InjectSenderAddress:=RNL_ADDRESS_EMPTY;
{$ifdef PasRISCVUseRNLNetworkInstance}
   InjectReceiveLength:=fRNLNetwork.Receive(PortForwardItem^.ListenFileDescriptor,@InjectSenderAddress,fReceiveBuffer[0],SizeOf(fReceiveBuffer),RNL_IPV4);
{$else}
   InjectReceiveLength:=RNLSocketReceive(PortForwardItem^.ListenFileDescriptor,@InjectSenderAddress,fReceiveBuffer[0],SizeOf(fReceiveBuffer),RNL_IPV4);
{$endif}

   if InjectReceiveLength>0 then begin

    TouchUDPPortForwardPeer(ForwardIndex,
                            TRNLUInt32(TRNLPointer(@InjectSenderAddress.Host.Addr[12])^),
                            InjectSenderAddress.Port);

    if InjectReceiveLength>(SizeOf(fFrameBuffer)-(UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize)) then begin
     InjectReceiveLength:=SizeOf(fFrameBuffer)-(UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize);
    end;

    InjectTotalSize:=UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize+InjectReceiveLength;
    FillChar(fFrameBuffer[0],InjectTotalSize,#0);
    InjectEthernetHeader:=PEthernetHeader(@fFrameBuffer[0]);
    InjectIPHeader:=PIPv4Header(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize)));
    InjectUDPHeader:=PUDPHeader(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize)));
    Move(InjectSenderAddress.Host.Addr[12],InjectSenderIPBytes[0],4);

    InjectEthernetHeader^.DestinationMAC:=fGuestMAC;
    InjectEthernetHeader^.SourceMAC:=GatewayMAC;
    InjectEthernetHeader^.EthernetType:=TRNLEndianness.HostToNet16(EtherTypeIPv4);

    InjectIPHeader^.VersionIHL:=$45;
    InjectIPHeader^.DSCP_ECN:=0;
    InjectIPHeader^.TotalLength:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeIPv4HeaderSize+UserModeUDPHeaderSize+InjectReceiveLength));
    inc(fIPIDCounter);
    InjectIPHeader^.Identification:=TRNLEndianness.HostToNet16(fIPIDCounter);
    InjectIPHeader^.FlagsFragment:=0;
    InjectIPHeader^.TTL:=64;
    InjectIPHeader^.Protocol:=IPProtocolUDP;
    InjectIPHeader^.HeaderChecksum:=0;
    InjectIPHeader^.SourceIP:=InjectSenderIPBytes;
    InjectIPHeader^.DestinationIP:=PortForwardItem^.GuestIP;
    InjectIPHeader^.HeaderChecksum:=UserModeIPChecksum(InjectIPHeader,UserModeIPv4HeaderSize);

    InjectUDPHeader^.SourcePort:=TRNLEndianness.HostToNet16(InjectSenderAddress.Port);
    InjectUDPHeader^.DestinationPort:=TRNLEndianness.HostToNet16(PortForwardItem^.GuestPort);
    InjectUDPHeader^.Length:=TRNLEndianness.HostToNet16(TPasRISCVUInt16(UserModeUDPHeaderSize+InjectReceiveLength));
    InjectUDPHeader^.Checksum:=0;
    Move(fReceiveBuffer[0],Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@fFrameBuffer[0])+UserModeEtherHeaderSize+UserModeIPv4HeaderSize+UserModeUDPHeaderSize))^,InjectReceiveLength);
    InjectUDPHeader^.Checksum:=UserModeTCPUDPChecksum(InjectSenderIPBytes,PortForwardItem^.GuestIP,IPProtocolUDP,InjectUDPHeader,UserModeUDPHeaderSize+InjectReceiveLength);
    if InjectUDPHeader^.Checksum=0 then begin
     InjectUDPHeader^.Checksum:=$ffff;
    end;

    InjectToGuest(@fFrameBuffer[0],InjectTotalSize);

   end;

  end;

 end;

end;

procedure TPasRISCVEthernetDeviceUserModeNetworking.AdvanceUserModeTicks;
var CurrentTickTime,ElapsedTicks:TPasRISCVUInt64;
begin

 CurrentTickTime:=GetCurrentFrequencyTime(UserModeTickFrequency);

 if fUserModeTickTime=0 then begin
  // First round, so there is nothing to measure against yet
  fUserModeTickTime:=CurrentTickTime;
  fUserModeTickDelta:=0;
  exit;
 end;

 if CurrentTickTime<=fUserModeTickTime then begin
  // The loop is running faster than the tick, which is the normal case while there
  // is traffic: nothing has aged yet, so nothing steps
  fUserModeTickDelta:=0;
  exit;
 end;

 ElapsedTicks:=CurrentTickTime-fUserModeTickTime;
 if ElapsedTicks>UserModeMaximumTickAdvance then begin
  ElapsedTicks:=UserModeMaximumTickAdvance;
 end;

 inc(fUserModeTickTime,ElapsedTicks);
 fUserModeTickDelta:=TPasRISCVUInt32(ElapsedTicks);
 inc(fUserModeTickCount,fUserModeTickDelta);

end;

function TPasRISCVEthernetDeviceUserModeNetworking.FindEvictableTCPSession:TPasRISCVInt32;
var Index,Position,ScanCount,SessionIndex,Rank,BestRank:TPasRISCVInt32;
    BestIdleTickCount:TPasRISCVUInt32;
    TCPSession:PTCPSession;
begin

 // Picks the entry the guest will miss least, in three tiers: a session that is
 // already tearing down has nothing left to lose, a half-open connect that has been
 // waiting long enough is most likely never going to complete, and only then a real
 // connection - and that one only after it has been silent for a good while. Within
 // a tier the least recently used wins, which is what IdleTickCount already tracks
 // since every segment in either direction resets it.

 result:=-1;

 if fTCPActiveCount<=0 then begin
  exit;
 end;

 ScanCount:=fTCPActiveCount;
 if ScanCount>UserModeTCPEvictionScanLimit then begin
  ScanCount:=UserModeTCPEvictionScanLimit;
 end;

 BestRank:=high(TPasRISCVInt32);
 BestIdleTickCount:=0;

 for Index:=0 to ScanCount-1 do begin

  Position:=(fTCPEvictionCursor+Index) mod fTCPActiveCount;
  SessionIndex:=fTCPActiveIndices[Position];
  TCPSession:=@fTCPSessionArray[SessionIndex];

  case TCPSession^.State of
   UserModeTCPStateClosed,
   UserModeTCPStateTimeWait,
   UserModeTCPStateClosing,
   UserModeTCPStateLastAck,
   UserModeTCPStateFINWait1,
   UserModeTCPStateFINWait2:begin
    Rank:=0;
   end;
   UserModeTCPStateConnecting,
   UserModeTCPStateSynAckSent,
   UserModeTCPStateInboundSynSent:begin
    if TCPSession^.IdleTickCount>=(UserModeTCPConnectTimeoutTicks shr 1) then begin
     Rank:=1;
    end else begin
     Rank:=-1;
    end;
   end;
   else begin
    if TCPSession^.IdleTickCount>=UserModeTCPEvictionMinimumIdleTicks then begin
     Rank:=2;
    end else begin
     Rank:=-1;
    end;
   end;
  end;

  if Rank>=0 then begin
   if (Rank<BestRank) or
      ((Rank=BestRank) and (TCPSession^.IdleTickCount>BestIdleTickCount)) then begin
    BestRank:=Rank;
    BestIdleTickCount:=TCPSession^.IdleTickCount;
    result:=SessionIndex;
   end;
  end;

 end;

 fTCPEvictionCursor:=(fTCPEvictionCursor+ScanCount) mod fTCPActiveCount;

end;

