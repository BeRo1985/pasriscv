function TPasRISCV.TSnapshot.TNode.AddElement:TNode;
begin
 if fChildCount>=length(fChildren) then begin
  if length(fChildren)=0 then begin
   SetLength(fChildren,4);
  end else begin
   SetLength(fChildren,length(fChildren)*2);
  end;
 end;
 result:=TNode.Create;
 result.fType:=TType.None;
 result.fKey:='';
 fChildren[fChildCount]:=result;
 inc(fChildCount);
end;

