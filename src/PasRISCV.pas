procedure TPasRISCV.TAPLICDevice.LoadSnapshot(const aNode:TSnapshot.TNode);
var ArrayNode:TSnapshot.TNode;
    IRQIndex:TPasRISCVInt32;
    m:TAIARegFileMode;
begin
 inherited LoadSnapshot(aNode);

 // Domain configuration per AIA mode
 ArrayNode:=aNode.FindNode('DomainCfg');
 if Assigned(ArrayNode) then begin
  for m:=Low(TAIARegFileMode) to High(TAIARegFileMode) do begin
   fDomainCfg[m]:=ArrayNode.GetUInt32(TPasRISCVRawByteString(IntToStr(ord(m))),fDomainCfg[m]);
  end;
 end;

 // Delegated interrupt sources
 ArrayNode:=aNode.FindNode('Delegated');
 if Assigned(ArrayNode) then begin
  for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
   fDelegated[IRQIndex]:=ArrayNode.GetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fDelegated[IRQIndex]);
  end;
 end;

{$if defined(PasRISCVAPLICAtomicIRQState)}
 // IRQ state per source (atomic)
 ArrayNode:=aNode.FindNode('IRQState');
 if Assigned(ArrayNode) then begin
  for IRQIndex:=0 to APLIC_SRC_LIMIT-1 do begin
   fIRQState[IRQIndex]:=ArrayNode.GetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fIRQState[IRQIndex]);
  end;
 end;
{$elseif defined(PasRISCVAPLICOptimizedAtomicIRQState)}
 // IRQ states (optimized words)
 ArrayNode:=aNode.FindNode('IRQStates');
 if Assigned(ArrayNode) then begin
  for IRQIndex:=0 to IRQ_STATE_WORD_COUNT-1 do begin
   fIRQStates[IRQIndex]:=ArrayNode.GetUInt64(TPasRISCVRawByteString(IntToStr(IRQIndex)),fIRQStates[IRQIndex]);
  end;
 end;
{$else}
 // Raised interrupt bits
 ArrayNode:=aNode.FindNode('Raised');
 if Assigned(ArrayNode) then begin
  for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
   fRaised[IRQIndex]:=ArrayNode.GetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fRaised[IRQIndex]);
  end;
 end;
{$ifend}

 // Interrupt invert configuration
 ArrayNode:=aNode.FindNode('Invert');
 if Assigned(ArrayNode) then begin
  for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
   fInvert[IRQIndex]:=ArrayNode.GetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fInvert[IRQIndex]);
  end;
 end;

 // Pending interrupts
 ArrayNode:=aNode.FindNode('Pending');
 if Assigned(ArrayNode) then begin
  for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
   fPending[IRQIndex]:=ArrayNode.GetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fPending[IRQIndex]);
  end;
 end;

 // Enabled interrupts
 ArrayNode:=aNode.FindNode('Enabled');
 if Assigned(ArrayNode) then begin
  for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
   fEnabled[IRQIndex]:=ArrayNode.GetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fEnabled[IRQIndex]);
  end;
 end;

 // Interrupt source configuration
 ArrayNode:=aNode.FindNode('Source');
 if Assigned(ArrayNode) then begin
  for IRQIndex:=0 to APLIC_SRC_LIMIT-1 do begin
   fSource[IRQIndex]:=ArrayNode.GetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fSource[IRQIndex]);
  end;
 end;

 // Interrupt targets
 ArrayNode:=aNode.FindNode('Target');
 if Assigned(ArrayNode) then begin
  for IRQIndex:=0 to APLIC_SRC_LIMIT-1 do begin
   fTarget[IRQIndex]:=ArrayNode.GetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fTarget[IRQIndex]);
  end;
 end;
end;

procedure TPasRISCV.TAPLICDevice.SaveSnapshot(const aNode:TSnapshot.TNode);
var ArrayNode:TSnapshot.TNode;
    IRQIndex:TPasRISCVInt32;
    m:TAIARegFileMode;
begin
 inherited SaveSnapshot(aNode);

 // Domain configuration per AIA mode
 ArrayNode:=aNode.AddObject('DomainCfg');
 for m:=Low(TAIARegFileMode) to High(TAIARegFileMode) do begin
  ArrayNode.SetUInt32(TPasRISCVRawByteString(IntToStr(ord(m))),fDomainCfg[m]);
 end;

 // Delegated interrupt sources
 ArrayNode:=aNode.AddObject('Delegated');
 for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
  ArrayNode.SetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fDelegated[IRQIndex]);
 end;

{$if defined(PasRISCVAPLICAtomicIRQState)}
 // IRQ state per source (atomic)
 ArrayNode:=aNode.AddObject('IRQState');
 for IRQIndex:=0 to APLIC_SRC_LIMIT-1 do begin
  ArrayNode.SetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fIRQState[IRQIndex]);
 end;
{$elseif defined(PasRISCVAPLICOptimizedAtomicIRQState)}
 // IRQ states (optimized words)
 ArrayNode:=aNode.AddObject('IRQStates');
 for IRQIndex:=0 to IRQ_STATE_WORD_COUNT-1 do begin
  ArrayNode.SetUInt64(TPasRISCVRawByteString(IntToStr(IRQIndex)),fIRQStates[IRQIndex]);
 end;
{$else}
 // Raised interrupt bits
 ArrayNode:=aNode.AddObject('Raised');
 for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
  ArrayNode.SetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fRaised[IRQIndex]);
 end;
{$ifend}

 // Interrupt invert configuration
 ArrayNode:=aNode.AddObject('Invert');
 for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
  ArrayNode.SetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fInvert[IRQIndex]);
 end;

 // Pending interrupts
 ArrayNode:=aNode.AddObject('Pending');
 for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
  ArrayNode.SetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fPending[IRQIndex]);
 end;

 // Enabled interrupts
 ArrayNode:=aNode.AddObject('Enabled');
 for IRQIndex:=0 to APLIC_SRC_REGS-1 do begin
  ArrayNode.SetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fEnabled[IRQIndex]);
 end;

 // Interrupt source configuration
 ArrayNode:=aNode.AddObject('Source');
 for IRQIndex:=0 to APLIC_SRC_LIMIT-1 do begin
  ArrayNode.SetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fSource[IRQIndex]);
 end;

 // Interrupt targets
 ArrayNode:=aNode.AddObject('Target');
 for IRQIndex:=0 to APLIC_SRC_LIMIT-1 do begin
  ArrayNode.SetUInt32(TPasRISCVRawByteString(IntToStr(IRQIndex)),fTarget[IRQIndex]);
 end;
end;

