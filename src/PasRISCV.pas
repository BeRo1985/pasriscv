procedure TPasRISCV.TSnapshot.TNode.SetBinary(const aKey:TPasRISCVRawByteString;const aData:Pointer;const aSize:TPasRISCVUInt64);
var Node:TNode;
begin
 Node:=FindOrAddNode(aKey,TType.Binary);
 if assigned(Node.fValue.ValueBinaryData) then begin
  FreeMem(Node.fValue.ValueBinaryData);
 end;
 Node.fValue.ValueBinarySize:=aSize;
 if aSize>0 then begin
  GetMem(Node.fValue.ValueBinaryData,aSize);
  Move(aData^,Node.fValue.ValueBinaryData^,aSize);
 end else begin
  Node.fValue.ValueBinaryData:=nil;
 end;
end;

function TPasRISCV.TSnapshot.TNode.GetBool(const aKey:TPasRISCVRawByteString;const aDefault:Boolean):Boolean;
var Node:TNode;
begin
 Node:=FindNode(aKey);
 if assigned(Node) and (Node.fType=TType.Bool) then begin
  result:=Node.fValue.ValueBool<>0;
 end else begin
  result:=aDefault;
 end;
end;

function TPasRISCV.TSnapshot.TNode.GetUInt8(const aKey:TPasRISCVRawByteString;const aDefault:TPasRISCVUInt8):TPasRISCVUInt8;
var Node:TNode;
begin
 Node:=FindNode(aKey);
 if assigned(Node) and (Node.fType=TType.UInt8) then begin
  result:=Node.fValue.ValueUInt8;
 end else begin
  result:=aDefault;
