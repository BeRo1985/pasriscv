begin
 fCount:=aFrom.fCount;
 if fAllocated<fCount then begin
  fAllocated:=fCount;
  SetLength(fItems,fCount);
 end;
 for Index:=0 to fCount-1 do begin
  fItems[Index]:=aFrom.fItems[Index];
 end;
end;

