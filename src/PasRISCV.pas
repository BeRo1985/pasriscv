var rs1,rs2:TPasRISCVUInt32;
begin
 rs1:=ReadNormalizedFloatUI32(aRS1);
 rs2:=ReadNormalizedFloatUI32(aRS2);
 result:=(CheckF32IsInfinity(rs1) and CheckF32IsZero(rs2)) or
         (CheckF32IsZero(rs1) and CheckF32IsInfinity(rs2));
end;

