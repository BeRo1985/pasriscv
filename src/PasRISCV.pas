function MULHU(a,b:TPasRISCVUInt64):TPasRISCVUInt64; assembler; {$if defined(fpc)}nostackframe; {$if defined(Windows)}ms_abi_default;{$else}sysv_abi_default;{$ifend}{$ifend}
asm
{$if not defined(fpc)}
 .noframe
{$ifend}
{$if defined(Windows)}
