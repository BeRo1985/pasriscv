 fUDPActiveCapacity:=0;

 fICMPFreeList.Finalize;
 FreeAndNil(fICMPSessions);
 fICMPSessionArray:=nil;
 fICMPActiveIndices:=nil;
 fICMPActiveCount:=0;
 fICMPActiveCapacity:=0;

