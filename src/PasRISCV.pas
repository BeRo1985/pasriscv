function SoftFloatBits128Shl(const aValue:TSoftFloatBits128;const aShift:TPasRISCVInt32):TSoftFloatBits128;
begin
 if aShift<=0 then begin
  result:=aValue;
 end else if aShift>=128 then begin
  result:=SoftFloatBits128Zero;
 end else if aShift=64 then begin
  result.Lo:=0;
  result.Hi:=aValue.Lo;
 end else if aShift>64 then begin
  result.Lo:=0;
  result.Hi:=aValue.Lo shl (aShift-64);
 end else begin
  result.Lo:=aValue.Lo shl aShift;
  result.Hi:=(aValue.Hi shl aShift) or (aValue.Lo shr (64-aShift));
 end;
end;

function SoftFloatBits128Shr(const aValue:TSoftFloatBits128;const aShift:TPasRISCVInt32):TSoftFloatBits128;
