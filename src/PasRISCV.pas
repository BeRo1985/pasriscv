   end;
   if assigned(fWatchdogDevice) then begin
    fWatchdogDevice.LoadSnapshot(Snapshot.Root.FindNode('SP805Watchdog'));
   end;
   // Global state
   DeviceNode:=Snapshot.Root.FindNode('GlobalState');
   if assigned(DeviceNode) then begin
