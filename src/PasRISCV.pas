procedure TPasRISCV.TSnapshot.TNode.GetBinary(const aKey:TPasRISCVRawByteString;const aData:Pointer;const aSize:TPasRISCVUInt64);
var Node:TNode;
    CopySize:TPasRISCVUInt64;
begin
 Node:=FindNode(aKey);
 if assigned(Node) and (Node.fType=TType.Binary) and assigned(Node.fValue.ValueBinaryData) then begin
  CopySize:=Node.fValue.ValueBinarySize;
  if CopySize>aSize then begin
   CopySize:=aSize;
  end;
  Move(Node.fValue.ValueBinaryData^,aData^,CopySize);
  if CopySize<aSize then begin
   FillChar(PAnsiChar(aData)[CopySize],aSize-CopySize,0);
  end;
 end;
end;

