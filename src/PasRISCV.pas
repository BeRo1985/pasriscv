        end;
        if BestMatchLength<MatchLength then begin
         BestMatchDistance:={%H-}TPasRISCVPtrUInt({%H-}TPasRISCVPtrUInt(CurrentPointer)-{%H-}TPasRISCVPtrUInt(CurrentPossibleMatch));
         BestMatchLength:=MatchLength;
        end;
       end;
      end else if (Difference and TPasRISCVUInt32({$if defined(FPC_BIG_ENDIAN)}$ffff0000{$else}$0000ffff{$ifend}))=0 then begin
       MatchLength:=2;
       if BestMatchLength<MatchLength then begin
        BestMatchDistance:={%H-}TPasRISCVPtrUInt({%H-}TPasRISCVPtrUInt(CurrentPointer)-{%H-}TPasRISCVPtrUInt(CurrentPossibleMatch));
        BestMatchLength:=MatchLength;
       end;
      end;
      inc(Step);
      if Step<MaxSteps then begin
       CurrentPossibleMatch:=ChainTable^[({%H-}TPasRISCVPtrUInt(CurrentPossibleMatch)-{%H-}TPasRISCVPtrUInt(aInData)) and WindowMask];
      end else begin
       break;
      end;
     end;
     if (BestMatchDistance>0) and (BestMatchLength>1) then begin
      DoOutputCopy(BestMatchDistance,BestMatchLength);
     end else begin
      if (SkipStrength>31) and (BestMatchLength=1) then begin
       DoOutputLiteral(CurrentPointer);
      end else begin
       BestMatchLength:=1;
       if BestMatchLength=1 then begin
        Step:=UnsuccessfulFindMatchAttempts shr SkipStrength;
       end else begin
        Step:=BestMatchLength;
       end;
       Offset:=0;
       while Offset<Step do begin
        if ({%H-}TPasRISCVPtrUInt(CurrentPointer)+Offset)<{%H-}TPasRISCVPtrUInt(EndSearchPointer) then begin
         DoOutputLiteral(@PPasRISCVUInt8Array(CurrentPointer)^[Offset]);
         inc(Offset);
        end else begin
         BestMatchLength:=Offset; // Because we reached EndSearchPointer, so that the tail remaining literal stuff is processing the right remaining offset then
         break;
        end;
       end;
       if BestMatchLength=1 then begin
        BestMatchLength:=Offset;
        inc(UnsuccessfulFindMatchAttempts,ord(UnsuccessfulFindMatchAttempts<TPasRISCVUInt32($ffffffff)) and 1);
       end;
      end;
     end;
     HashTableItem^:=CurrentPointer;
     ChainTable^[({%H-}TPasRISCVPtrUInt(CurrentPointer)-{%H-}TPasRISCVPtrUInt(aInData)) and WindowMask]:=Head;
     if Greedy then begin
      inc(CurrentPointer);
      dec(BestMatchLength);
      while (BestMatchLength>0) and ({%H-}TPasRISCVPtrUInt(CurrentPointer)<{%H-}TPasRISCVPtrUInt(EndSearchPointer)) do begin
       HashTableItem:=@HashTable[((((PPasRISCVUInt32(Pointer(CurrentPointer))^ and TPasRISCVUInt32({$if defined(FPC_BIG_ENDIAN)}$ffffff00{$else}$00ffffff{$ifend}){$if defined(FPC_BIG_ENDIAN)}shr 8{$ifend}))*TPasRISCVUInt32($1e35a7bd)) shr HashShift) and HashMask];
       Head:=HashTableItem^;
       HashTableItem^:=CurrentPointer;
       ChainTable^[({%H-}TPasRISCVPtrUInt(CurrentPointer)-{%H-}TPasRISCVPtrUInt(aInData)) and WindowMask]:=Head;
       inc(CurrentPointer);
       dec(BestMatchLength);
      end;
     end;
     inc(CurrentPointer,BestMatchLength);
    end;
    while {%H-}TPasRISCVPtrUInt(CurrentPointer)<{%H-}TPasRISCVPtrUInt(EndPointer) do begin
     DoOutputLiteral(CurrentPointer);
     inc(CurrentPointer);
    end;
   finally
    FreeMem(ChainTable);
   end;
  finally
   FreeMem(HashTable);
  end;
  OutputEndBlock;
 finally
  if aDestLen>0 then begin
   ReallocMem(aDestData,aDestLen);
   result:=true;
  end else if assigned(aDestData) then begin
   FreeMem(aDestData);
   aDestData:=nil;
  end;
 end;
end;

function LZBRSFDecompress(const aInData:Pointer;aInLen:TPasRISCVUInt64;var aDestData:Pointer;out aDestLen:TPasRISCVUInt64;const aOutputSize:TPasRISCVInt64;const aWithSize:boolean):boolean;
type TBlock1=TPasRISCVUInt8;
     TBlock2=TPasRISCVUInt16;
     TBlock3=array[0..2] of TPasRISCVUInt8;
     TBlock4=TPasRISCVUInt32;
     TBlock5=array[0..4] of TPasRISCVUInt8;
     TBlock6=array[0..5] of TPasRISCVUInt8;
     TBlock7=array[0..6] of TPasRISCVUInt8;
     TBlock8=TPasRISCVUInt64;
     TBlock16=array[0..1] of TPasRISCVUInt64;
     TBlock32=array[0..3] of TPasRISCVUInt64;
     TBlock64=array[0..7] of TPasRISCVUInt64;
     PBlock1=^TBlock1;
     PBlock2=^TBlock2;
     PBlock3=^TBlock3;
     PBlock4=^TBlock4;
     PBlock5=^TBlock5;
     PBlock6=^TBlock6;
     PBlock7=^TBlock7;
     PBlock8=^TBlock8;
     PBlock16=^TBlock16;
     PBlock32=^TBlock32;
     PBlock64=^TBlock64;
var InputPointer,InputEnd,OutputPointer,OutputEnd,CopyFromPointer:PPasRISCVUInt8;
    Len,Offset,Tag:TPasRISCVUInt32;
    OutputSize:TPasRISCVUInt64;
    Allocated:boolean;
begin

 // If the input size is too small, then exit early
 if (aWithSize and (aInLen<SizeOf(TPasRISCVUInt64))) or ((not aWithSize) and (aInLen=0)) then begin
  result:=false;
  exit;
 end;

 // Setup stuff
 InputPointer:=aInData;
 InputEnd:=@PPasRISCVUInt8Array(InputPointer)^[aInLen];

 if aWithSize then begin
  OutputSize:=PPasRISCVUInt64(InputPointer)^;
{$ifdef BIG_ENDIAN}
  OutputSize:=((OutputSize and TPasRISCVUInt64($ff00000000000000)) shr 56) or
              ((OutputSize and TPasRISCVUInt64($00ff000000000000)) shr 40) or
              ((OutputSize and TPasRISCVUInt64($0000ff0000000000)) shr 24) or
              ((OutputSize and TPasRISCVUInt64($000000ff00000000)) shr 8) or
              ((OutputSize and TPasRISCVUInt64($00000000ff000000)) shl 8) or
              ((OutputSize and TPasRISCVUInt64($0000000000ff0000)) shl 24) or
              ((OutputSize and TPasRISCVUInt64($000000000000ff00)) shl 40) or
              ((OutputSize and TPasRISCVUInt64($00000000000000ff)) shl 56);
{$endif}
  inc(PPasRISCVUInt64(InputPointer));
 end else begin
  if aOutputSize>=0 then begin
   OutputSize:=aOutputSize;
  end else begin
   OutputSize:=0;
  end;
 end;

 if OutputSize=0 then begin
  result:=true;
  exit;
 end;

 aDestLen:=OutputSize;

 if (aOutputSize>=0) and (aDestLen<>TPasRISCVUInt64(aOutputSize)) then begin
  result:=false;
  aDestLen:=0;
  exit;
 end;

 Allocated:=not assigned(aDestData);
 if Allocated then begin
  if ((not aWithSize) and (aOutputSize<=0)) or (OutputSize=0) then begin
   result:=false;
   aDestLen:=0;
   exit;
  end;
  GetMem(aDestData,OutputSize);
 end;

 OutputPointer:=aDestData;
 OutputEnd:=@PPasRISCVUInt8Array(OutputPointer)^[OutputSize];

 result:=true;

 while TPasRISCVPtrUInt(InputPointer)<TPasRISCVPtrUInt(InputEnd) do begin

  Tag:=TPasRISCVUInt8(pointer(InputPointer)^);
  inc(InputPointer);

  case Tag and 3 of
   {b00}0:begin
    // Literal(s)
    case Tag shr 2 of
     0..59:begin
      Len:=(Tag shr 2)+1;
     end;
     60:begin
      if TPasRISCVPtrUInt(InputPointer)>=TPasRISCVPtrUInt(InputEnd) then begin
       result:=false;
       break;
      end;
      Len:=TPasRISCVUInt8(Pointer(InputPointer)^)+1;
      inc(InputPointer);
     end;
     61:begin
      if (TPasRISCVPtrUInt(InputPointer)+SizeOf(TPasRISCVUInt16))>TPasRISCVPtrUInt(InputEnd) then begin
       result:=false;
       break;
      end;
{$ifdef LITTLE_ENDIAN}
      Len:=TPasRISCVUInt16(Pointer(InputPointer)^)+1;
      inc(InputPointer,SizeOf(TPasRISCVUInt16));
{$else}
      Len:=TPasRISCVUInt16(Pointer(InputPointer)^);
      inc(InputPointer,SizeOf(TPasRISCVUInt16));
      Len:=((((Len and $ff00) shr 8) or ((Len and $ff) shl 8))+1;
{$endif}
     end;
     62:begin
      if (TPasRISCVPtrUInt(InputPointer)+(SizeOf(TPasRISCVUInt16)+SizeOf(TPasRISCVUInt8)))>TPasRISCVPtrUInt(InputEnd) then begin
       result:=false;
       break;
      end;
{$ifdef LITTLE_ENDIAN}
      Len:=TPasRISCVUInt16(Pointer(InputPointer)^);
      inc(InputPointer,SizeOf(TPasRISCVUInt16));
      Len:=(Len or (TPasRISCVUInt8(pointer(InputPointer)^) shl 16))+1;
      inc(InputPointer);
{$else}
      Len:=TPasRISCVUInt8(pointer(InputPointer)^);
      inc(InputPointer);
      Len:=(Len or (TPasRISCVUInt8(pointer(InputPointer)^) shl 8));
      inc(InputPointer);
      Len:=(Len or (TPasRISCVUInt8(pointer(InputPointer)^) shl 16))+1;
      inc(InputPointer);
{$endif}
     end;
     else {63:}begin
      if (TPasRISCVPtrUInt(InputPointer)+SizeOf(TPasRISCVUInt32))>TPasRISCVPtrUInt(InputEnd) then begin
       result:=false;
       break;
      end;
{$ifdef LITTLE_ENDIAN}
      Len:=TPasRISCVUInt32(pointer(InputPointer)^)+1;
      inc(InputPointer,SizeOf(TPasRISCVUInt32));
{$else}
      Len:=TPasRISCVUInt32(pointer(InputPointer)^);
      inc(InputPointer,SizeOf(TPasRISCVUInt32));
      Len:=(((Len and TPasRISCVUInt32($ff000000)) shr 24) or
            ((Len and TPasRISCVUInt32($00ff0000)) shr 8) or
            ((Len and TPasRISCVUInt32($0000ff00)) shl 8) or
            ((Len and TPasRISCVUInt32($000000ff)) shl 24))+1;
{$endif}
     end;
    end;
    CopyFromPointer:=InputPointer;
    inc(InputPointer,Len);
   end;
   {b01}1:begin
    // Short match
    if TPasRISCVPtrUInt(InputPointer)>=TPasRISCVPtrUInt(InputEnd) then begin
     result:=false;
     break;
    end;
    Len:=((Tag shr 2) and 7)+4;
    Offset:=((Tag shr 5) or (TPasRISCVUInt8(pointer(InputPointer)^) shl 3))+1;
    inc(InputPointer);
    CopyFromPointer:=pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OutputPointer)-TPasRISCVPtrUInt(Offset)));
    if TPasRISCVPtrUInt(CopyFromPointer)<TPasRISCVPtrUInt(aDestData) then begin
     result:=false;
     break;
    end;
   end;
   {b10}2:begin
    // Medium match
    if (TPasRISCVPtrUInt(InputPointer)+SizeOf(TPasRISCVUInt16))>TPasRISCVPtrUInt(InputEnd) then begin
     result:=false;
     break;
    end;
    Len:=(Tag shr 2)+1;
{$ifdef LITTLE_ENDIAN}
    Offset:=TPasRISCVUInt16(pointer(InputPointer)^)+1;
    inc(InputPointer,SizeOf(TPasRISCVUInt16));
{$else}
    Offset:=TPasRISCVUInt16(Pointer(InputPointer)^);
    inc(InputPointer,SizeOf(TPasRISCVUInt16));
    Offset:=((((Offset and $ff00) shr 8) or ((Offset and $ff) shl 8))+1;
{$endif}
    CopyFromPointer:=pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OutputPointer)-TPasRISCVPtrUInt(Offset)));
    if TPasRISCVPtrUInt(CopyFromPointer)<TPasRISCVPtrUInt(aDestData) then begin
     result:=false;
     break;
    end;
   end;
   else {b11}{3:}begin
    if Tag=$ff then begin
     // End code
     break;
    end else if (Tag and 4)<>0 then begin
     // {b111}7 - Huge match
     if (TPasRISCVPtrUInt(InputPointer)+(SizeOf(TPasRISCVUInt32)+SizeOf(TPasRISCVUInt32)))>TPasRISCVPtrUInt(InputEnd) then begin
      result:=false;
      break;
     end;
     Len:=TPasRISCVUInt32(pointer(InputPointer)^);
     inc(InputPointer,SizeOf(TPasRISCVUInt32));
     Offset:=TPasRISCVUInt32(pointer(InputPointer)^);
     inc(InputPointer,SizeOf(TPasRISCVUInt32));
{$ifdef BIG_ENDIAN}
     Len:=((Len and TPasRISCVUInt32($ff000000)) shr 24) or
          ((Len and TPasRISCVUInt32($00ff0000)) shr 8) or
          ((Len and TPasRISCVUInt32($0000ff00)) shl 8) or
          ((Len and TPasRISCVUInt32($000000ff)) shl 24);
     Offset:=((Offset and TPasRISCVUInt32($ff000000)) shr 24) or
             ((Offset and TPasRISCVUInt32($00ff0000)) shr 8) or
             ((Offset and TPasRISCVUInt32($0000ff00)) shl 8) or
             ((Offset and TPasRISCVUInt32($000000ff)) shl 24);
{$endif}
     inc(Len);
     inc(Offset);
    end else begin
     // {b011}3 - Long match
     if (TPasRISCVPtrUInt(InputPointer)+(SizeOf(TPasRISCVUInt8)+SizeOf(TPasRISCVUInt32)))>TPasRISCVPtrUInt(InputEnd) then begin
      result:=false;
      break;
     end;
     Len:=((Tag shr 3) or (TPasRISCVUInt8(pointer(InputPointer)^) shl (8-3)))+1;
     inc(InputPointer,SizeOf(TPasRISCVUInt8));
     Offset:=TPasRISCVUInt32(pointer(InputPointer)^);
     inc(InputPointer,SizeOf(TPasRISCVUInt32));
{$ifdef BIG_ENDIAN}
     Offset:=((Offset and TPasRISCVUInt32($ff000000)) shr 24) or
             ((Offset and TPasRISCVUInt32($00ff0000)) shr 8) or
             ((Offset and TPasRISCVUInt32($0000ff00)) shl 8) or
             ((Offset and TPasRISCVUInt32($000000ff)) shl 24);
{$endif}
     inc(Offset);
    end;
    CopyFromPointer:=pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(OutputPointer)-TPasRISCVPtrUInt(Offset)));
    if TPasRISCVPtrUInt(CopyFromPointer)<TPasRISCVPtrUInt(aDestData) then begin
     result:=false;
     break;
    end;
   end;
  end;

  if (TPasRISCVPtrUInt(OutputPointer)+TPasRISCVPtrUInt(Len))>TPasRISCVPtrUInt(OutputEnd) then begin
   result:=false;
   break;
  end;

  if (TPasRISCVPtrUInt(CopyFromPointer)<TPasRISCVPtrUInt(OutputPointer)) and (TPasRISCVPtrUInt(OutputPointer)<(TPasRISCVPtrUInt(CopyFromPointer)+TPasRISCVPtrUInt(Len))) then begin

   // Overlapping

   while Len>0 do begin
    OutputPointer^:=CopyFromPointer^;
    inc(OutputPointer);
    inc(CopyFromPointer);
    dec(Len);
   end;

  end else begin

   // Non-overlapping

   if Len>SizeOf(TBlock8) then begin

    while Len>=SizeOf(TBlock64) do begin
     PBlock64(pointer(OutputPointer))^:=PBlock64(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock64));
     inc(CopyFromPointer,SizeOf(TBlock64));
     dec(Len,SizeOf(TBlock64));
    end;

    while Len>=SizeOf(TBlock32) do begin
     PBlock32(pointer(OutputPointer))^:=PBlock32(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock32));
     inc(CopyFromPointer,SizeOf(TBlock32));
     dec(Len,SizeOf(TBlock32));
    end;

    while Len>=SizeOf(TBlock16) do begin
     PBlock16(pointer(OutputPointer))^:=PBlock16(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock16));
     inc(CopyFromPointer,SizeOf(TBlock16));
     dec(Len,SizeOf(TBlock16));
    end;

    while Len>=SizeOf(TBlock8) do begin
     PBlock8(pointer(OutputPointer))^:=PBlock8(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock8));
     inc(CopyFromPointer,SizeOf(TBlock8));
     dec(Len,SizeOf(TBlock8));
    end;

   end;

   case Len of

    0:begin

     // Do nothing in this case

    end;

    1:begin

     PBlock1(pointer(OutputPointer))^:=PBlock1(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock1));

    end;

    2:begin

     PBlock2(pointer(OutputPointer))^:=PBlock2(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock2));

    end;

    3:begin

     PBlock3(pointer(OutputPointer))^:=PBlock3(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock3));

    end;

    4:begin

     PBlock4(pointer(OutputPointer))^:=PBlock4(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock4));

    end;

    5:begin

     PBlock5(pointer(OutputPointer))^:=PBlock5(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock5));

    end;

    6:begin

     PBlock6(pointer(OutputPointer))^:=PBlock6(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock6));

    end;

    7:begin

     PBlock7(pointer(OutputPointer))^:=PBlock7(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock7));

    end;

    8:begin

     PBlock8(pointer(OutputPointer))^:=PBlock8(pointer(CopyFromPointer))^;
     inc(OutputPointer,SizeOf(TBlock8));

    end;

    else begin

     Assert(false);

    end;

   end;

  end;

 end;

 OutputSize:=TPasRISCVPtrUInt(TPasRISCVPtrUInt(OutputPointer)-TPasRISCVPtrUInt(aDestData));

 if (not aWithSize) and (aOutputSize<0) then begin
  aDestLen:=OutputSize;
 end;

 if not (result and (aDestLen=OutputSize)) then begin
  result:=false;
  aDestLen:=0;
  if Allocated then begin
   FreeMem(aDestData);
   aDestData:=nil;
  end;
 end;

end;

{ TPasRISCV.TSnapshot.TNode }

destructor TPasRISCV.TSnapshot.TNode.Destroy;
var Index:TPasRISCVInt32;
begin
 for Index:=0 to fChildCount-1 do begin
  FreeAndNil(fChildren[Index]);
 end;
 fChildren:=nil;
 fChildCount:=0;
 fValue.ValueString:='';
 if assigned(fValue.ValueBinaryData) then begin
  FreeMem(fValue.ValueBinaryData);
  fValue.ValueBinaryData:=nil;
 end;
 inherited Destroy;
end;

function TPasRISCV.TSnapshot.TNode.GetChild(const aIndex:TPasRISCVInt32):TNode;
begin
 if (aIndex>=0) and (aIndex<fChildCount) then begin
  result:=fChildren[aIndex];
 end else begin
  result:=nil;
 end;
end;

function TPasRISCV.TSnapshot.TNode.FindOrAddNode(const aKey:TPasRISCVRawByteString;const aType:TType):TNode;
var Index:TPasRISCVInt32;
begin
 for Index:=0 to fChildCount-1 do begin
  if fChildren[Index].fKey=aKey then begin
   result:=fChildren[Index];
   result.fType:=aType;
   exit;
  end;
 end;
 if fChildCount>=length(fChildren) then begin
  if length(fChildren)=0 then begin
   SetLength(fChildren,4);
  end else begin
   SetLength(fChildren,length(fChildren)*2);
  end;
 end;
 result:=TNode.Create;
 result.fType:=aType;
 result.fKey:=aKey;
 fChildren[fChildCount]:=result;
 inc(fChildCount);
end;

function TPasRISCV.TSnapshot.TNode.FindNode(const aKey:TPasRISCVRawByteString):TNode;
var Index:TPasRISCVInt32;
begin
 for Index:=0 to fChildCount-1 do begin
  if fChildren[Index].fKey=aKey then begin
   result:=fChildren[Index];
   exit;
  end;
 end;
 result:=nil;
end;

procedure TPasRISCV.TSnapshot.TNode.SetNull(const aKey:TPasRISCVRawByteString);
begin
 FindOrAddNode(aKey,TType.Null);
end;

procedure TPasRISCV.TSnapshot.TNode.SetBool(const aKey:TPasRISCVRawByteString;const aValue:Boolean);
var Node:TNode;
begin
 Node:=FindOrAddNode(aKey,TType.Bool);
 if aValue then begin
  Node.fValue.ValueBool:=1;
 end else begin
  Node.fValue.ValueBool:=0;
 end;
end;

