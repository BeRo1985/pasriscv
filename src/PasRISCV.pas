procedure TPasRISCV.TVirtIOGPUDevice.HandleResourceCreate3D(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCommand:PVirtIOGPUResourceCreate3D);
var GPUResource:TGPUResource;
    Args:TVirglRendererResourceCreateArgs;
begin
 if fVirglInitialized then begin
  fVirglLock.Acquire;
  try
   DestroyResource(aCommand^.ResourceID);
   GPUResource:=TGPUResource.Create;
   GPUResource.fID:=aCommand^.ResourceID;
   GPUResource.fWidth:=aCommand^.Width;
   GPUResource.fHeight:=aCommand^.Height;
   GPUResource.fFormat:=aCommand^.Format;
   GPUResource.fBytesPerPixel:=GetFormatBytesPerPixel(aCommand^.Format);
   GPUResource.fIs3D:=true;
   GPUResource.fTarget:=aCommand^.Target;
   GPUResource.fBind:=aCommand^.Bind;
   GPUResource.fDepth:=aCommand^.Depth;
   GPUResource.fArraySize:=aCommand^.ArraySize;
   GPUResource.fLastLevel:=aCommand^.LastLevel;
   GPUResource.fNrSamples:=aCommand^.NrSamples;
   if assigned(virgl_renderer_resource_create) then begin
    FillChar(Args,SizeOf(TVirglRendererResourceCreateArgs),#0);
    Args.handle:=aCommand^.ResourceID;
    Args.target:=aCommand^.Target;
    Args.format:=aCommand^.Format;
    Args.bind:=aCommand^.Bind;
    Args.width:=aCommand^.Width;
    Args.height:=aCommand^.Height;
    Args.depth:=aCommand^.Depth;
    Args.array_size:=aCommand^.ArraySize;
    Args.last_level:=aCommand^.LastLevel;
    Args.nr_samples:=aCommand^.NrSamples;
    Args.flags:=aCommand^.Flags;
    virgl_renderer_resource_create(@Args,nil,0);
   end;
   if length(fResources)<=fCountResources then begin
    SetLength(fResources,(fCountResources+1)*2);
   end;
   fResources[fCountResources]:=GPUResource;
   inc(fCountResources);
   SendOKNoData(aQueueIndex,aDescriptorIndex,@aCommand^.Header);
  finally
   fVirglLock.Release;
  end;
 end else begin
  SendError(aQueueIndex,aDescriptorIndex,@aCommand^.Header,VIRTIO_GPU_RESP_ERR_UNSPEC);
 end;
end;

