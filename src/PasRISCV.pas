class procedure TPasRISCV.THART.TJustInTimeCompiler.FCvtModWDFlagsHelper(aHART:Pointer;aF64Bits:TPasRISCVUInt64);
var Address,Offset:TPasRISCVUInt64;
    SFFFlags:TPasRISCVUInt8;
begin
 SFFFlags:=0;
 if (aF64Bits and $7ff0000000000000)=$7ff0000000000000 then begin
  SFFFlags:=SFFFlags or SoftFloatFF_NV;
 end else begin
  Address:=(aF64Bits shr 52) and $7ff;
  if Address<1023 then begin
   if (aF64Bits and $7fffffffffffffff)<>0 then begin
    SFFFlags:=SFFFlags or SoftFloatFF_NX;
   end;
  end else begin
   Address:=Address-1023;
   Offset:=aF64Bits and $fffffffffffff;
   if Address>=84 then begin
    SFFFlags:=SFFFlags or SoftFloatFF_NV;
   end else begin
    if (aF64Bits shr 63)=0 then begin
     if Address>=31 then begin
      SFFFlags:=SFFFlags or SoftFloatFF_NV;
     end;
    end else begin
     if (Address>31) or ((Address=31) and (Offset<>0)) then begin
      SFFFlags:=SFFFlags or SoftFloatFF_NV;
     end;
    end;
    if (Address<52) and ((SFFFlags and SoftFloatFF_NV)=0) then begin
     if (Offset and ((TPasRISCVUInt64(1) shl (52-Address))-1))<>0 then begin
      SFFFlags:=SFFFlags or SoftFloatFF_NX;
     end;
    end;
   end;
  end;
 end;
 if SFFFlags<>0 then begin
  THART(aHART).fState.CSR.SetFPUException(SFFFlags);
 end;
end;

