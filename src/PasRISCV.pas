 movsd qword ptr [rsp+8],xmm1
 movsd qword ptr [rsp+16],xmm2
 fld qword ptr [rsp]
 fld qword ptr [rsp+8]
 fmulp st(1),st(0)
 fld qword ptr [rsp+16]
 faddp st(1),st(0)
 fstp qword ptr [rsp]
