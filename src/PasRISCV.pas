{ TPasRISCV.TVirtIOVSockDevice.TEventQueueThread }

constructor TPasRISCV.TVirtIOVSockDevice.TEventQueueThread.Create(const aVirtIOVSockDevice:TVirtIOVSockDevice);
begin
 fVirtIOVSockDevice:=aVirtIOVSockDevice;
 fQueue.Initialize;
 fConditionVariableLock:=TPasMPConditionVariableLock.Create;
 fConditionVariable:=TPasMPConditionVariable.Create;
 fLock:=0;
 fGeneration:=0;
 inherited Create(false);
end;

destructor TPasRISCV.TVirtIOVSockDevice.TEventQueueThread.Destroy;
begin

 Shutdown;

 FlushQueue(false);

 fQueue.Finalize;

 FreeAndNil(fConditionVariable);
 FreeAndNil(fConditionVariableLock);

 inherited Destroy;
end;

procedure TPasRISCV.TVirtIOVSockDevice.TEventQueueThread.Shutdown;
begin

 if not Terminated then begin

  fConditionVariableLock.Acquire;
  try
   Terminate;
   fConditionVariable.Broadcast;
  finally
   fConditionVariableLock.Release;
  end;

  WaitFor;

 end;

end;

procedure TPasRISCV.TVirtIOVSockDevice.TEventQueueThread.FlushQueue(const aLock:Boolean);
var EventItem:TEventItem;
begin
 if aLock then begin
  fConditionVariableLock.Acquire;
 end;
 try
  while fQueue.Dequeue(EventItem) do begin
   if EventItem.Kind<>TPasRISCV.TVirtIOVSockDevice.TEventItem.TEventKind.None then begin
    EventItem.Kind:=TPasRISCV.TVirtIOVSockDevice.TEventItem.TEventKind.None;
    if assigned(EventItem.Connection) then begin
     try
      EventItem.Connection.DecRef;
     finally
      EventItem.Connection:=nil;
     end;
    end;
    EventItem.Payload:=nil;
   end;
  end;
 finally
  if aLock then begin
   fConditionVariableLock.Release;
  end;
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.TEventQueueThread.QueueEvent(var aEventItem:TPasRISCV.TVirtIOVSockDevice.TEventItem;const aGeneration:PPasMPUInt64=nil);
begin
 if aEventItem.Kind<>TPasRISCV.TVirtIOVSockDevice.TEventItem.TEventKind.None then begin
  fConditionVariableLock.Acquire;
  try
   if Terminated then begin
    if assigned(aEventItem.Connection) then begin
     try
      aEventItem.Connection.DecRef;
     finally
      aEventItem.Connection:=nil;
     end;
    end;
   end else begin
    if assigned(aGeneration) Then begin
     aEventItem.Generation:=aGeneration^;
    end else begin
     aEventItem.Generation:=fGeneration;
    end;
    fQueue.Enqueue(aEventItem);
    fConditionVariable.Broadcast;
   end;
  finally
   fConditionVariableLock.Release;
  end;
 end;
end;

procedure TPasRISCV.TVirtIOVSockDevice.TEventQueueThread.Execute;
var EventItem:TEventItem;
    Generation:TPasMPUInt64;
begin

 NameThreadForDebugging('TPasRISCV.TVirtIOVSockDevice.TEventQueueThread');

 Initialize(EventItem);
 try

  EventItem.Kind:=TPasRISCV.TVirtIOVSockDevice.TEventItem.TEventKind.None;
  EventItem.Connection:=nil;
  EventItem.Payload:=nil;

  while not Terminated do begin

   fConditionVariableLock.Acquire;
   try
    while (not Terminated) and not fQueue.Dequeue(EventItem) do begin
     fConditionVariable.Wait(fConditionVariableLock);
    end;
   finally
    fConditionVariableLock.Release;
   end;

   TPasMPMultipleReaderSingleWriterSpinLock.AcquireRead(fLock);
   try

    Generation:=fGeneration;

    try

     if ((Generation and 1)=0) and (EventItem.Generation=Generation) and not Terminated then begin

      fVirtIOVSockDevice.fManager.DispatchEvent(EventItem);

     end;

    finally

     if EventItem.Kind<>TPasRISCV.TVirtIOVSockDevice.TEventItem.TEventKind.None then begin

      EventItem.Kind:=TPasRISCV.TVirtIOVSockDevice.TEventItem.TEventKind.None;

      if assigned(EventItem.Connection) then begin
       try
        EventItem.Connection.DecRef;
       finally
        EventItem.Connection:=nil;
       end;
      end;

      EventItem.Payload:=nil;

     end;

    end;

   finally
    TPasMPMultipleReaderSingleWriterSpinLock.ReleaseRead(fLock);
   end;

  end;

 finally
  Finalize(EventItem);
 end;

end;

