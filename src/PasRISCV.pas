     // POSIX metadata persistence mode for the host-side 9P / VirtIO-FS back-ends (target-OS neutral):
     //  None    = no POSIX metadata persistence; the host filesystem's own semantics are used as-is
     //  SideCar = metadata kept in hidden per-file sidecars (works on any host filesystem)
     //  Native  = host-native mechanism (Windows: NTFS extended attributes + WSL-compatible reparse
     //            points; POSIX: the real filesystem), auto-falling back to SideCar where the native
     //            mechanism is unavailable (e.g. FAT/exFAT/network shares without EA support)
     TPasRISCVPosixMetadataMode=
      (
       None,
       SideCar,
       Native
      );

