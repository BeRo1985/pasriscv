  exit;
 end;
 if ExponentA=TPasRISCVInt32(aInfiniteExponent) then begin
  if ExponentB=TPasRISCVInt32(aInfiniteExponent) then begin
   if SignA=SignB then begin
    result:=SoftFloatInf(SignA,aSignShift,aMantissaBits,aInfiniteExponent);
   end else begin
    aFFlags:=aFFlags or SoftFloatFF_NV;
    result:=aCanonicalNaN;
   end;
  end else begin
   result:=SoftFloatInf(SignA,aSignShift,aMantissaBits,aInfiniteExponent);
  end;
  exit;
 end;
 if ExponentB=TPasRISCVInt32(aInfiniteExponent) then begin
  result:=SoftFloatInf(SignB,aSignShift,aMantissaBits,aInfiniteExponent);
  exit;
 end;
 if (ExponentA=0) and (MantissaA=0) and (ExponentB=0) and (MantissaB=0) then begin
  if SignA=SignB then begin
   result:=SoftFloatZero(SignA,aSignShift);
  end else if aRM=SoftFloatRM_RDN then begin
   result:=SoftFloatZero(true,aSignShift);
  end else begin
   result:=0;
  end;
