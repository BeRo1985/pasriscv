constructor TPasRISCV.TPCIDevice.Create(const aBus:TPasRISCV.TPCIBusDevice);
begin
 inherited Create;
 fMachine:=aBus.fMachine;
 fBus:=aBus;
end;

destructor TPasRISCV.TPCIDevice.Destroy;
begin
 inherited Destroy;
end;

procedure TPasRISCV.TPCIDevice.Reset;
begin
end;

procedure TPasRISCV.TPCIDevice.SendIRQ(const aFuncID,aMSIID:TPasRISCVUInt32);
var Func:TPasRISCV.TPCIFunc;
begin
 Func:=fFuncs[aFuncID];
 if assigned(Func) then begin
  Func.SendIRQ(aMSIID,false);
 end;
end;

procedure TPasRISCV.TPCIDevice.RaiseIRQ(const aFuncID,aMSIID:TPasRISCVUInt32);
var Func:TPasRISCV.TPCIFunc;
begin
 Func:=fFuncs[aFuncID];
 if assigned(Func) then begin
  Func.SendIRQ(aMSIID,true);
 end;
end;

procedure TPasRISCV.TPCIDevice.LowerIRQ(const aFuncID:TPasRISCVUInt32);
var Func:TPasRISCV.TPCIFunc;
begin
 Func:=fFuncs[aFuncID];
 if assigned(Func) then begin
  Func.LowerIRQ;
 end;
end;

function TPasRISCV.TPCIDevice.GetGlobalDirectMemoryAccessPointer(const aAddress:TPasRISCVUInt64;const aSize:TPasRISCVUInt64;const aWrite:Boolean;const aBounce:Pointer):Pointer;
begin
 result:=fBus.fMachine.fBus.GetDirectMemoryAccessPointer(nil,aAddress,aSize,aWrite,aBounce);
end;

procedure TPasRISCV.TPCIDevice.LoadSnapshot(const aNode:TSnapshot.TNode);
var FuncIndex:TPasRISCVInt32;
    FuncNode:TSnapshot.TNode;
    Func:TPCIFunc;
    MSIXNode:TSnapshot.TNode;
    MSIXIndex:TPasRISCVInt32;
begin
 // Device ID
 fDeviceID:=aNode.GetUInt16('DeviceID',fDeviceID);

 // PCI functions
 for FuncIndex:=0 to TPCI.PCI_DEV_FUNCS-1 do begin
  Func:=fFuncs[FuncIndex];
  if assigned(Func) then begin
   FuncNode:=aNode.FindNode('Func'+TPasRISCVRawByteString(IntToStr(FuncIndex)));
   if assigned(FuncNode) then begin
    Func.fStatus:=FuncNode.GetUInt32('Status',Func.fStatus);
    Func.fCommand:=FuncNode.GetUInt32('Command',Func.fCommand);
    Func.fIRQLine:=FuncNode.GetUInt32('IRQLine',Func.fIRQLine);
    Func.fVendorID:=FuncNode.GetUInt16('VendorID',Func.fVendorID);
    Func.fDeviceID:=FuncNode.GetUInt16('DeviceID',Func.fDeviceID);
    Func.fSubsystemVendorID:=FuncNode.GetUInt16('SubsystemVendorID',Func.fSubsystemVendorID);
    Func.fSubsystemDeviceID:=FuncNode.GetUInt16('SubsystemDeviceID',Func.fSubsystemDeviceID);
    Func.fClassCode:=FuncNode.GetUInt16('ClassCode',Func.fClassCode);
    Func.fProgIF:=FuncNode.GetUInt8('ProgIF',Func.fProgIF);
    Func.fRevisionID:=FuncNode.GetUInt8('RevisionID',Func.fRevisionID);
    Func.fBridgeIO:=FuncNode.GetUInt32('BridgeIO',Func.fBridgeIO);
    Func.fBridgeMem:=FuncNode.GetUInt32('BridgeMem',Func.fBridgeMem);
    Func.fIRQPin:=FuncNode.GetUInt8('IRQPin',Func.fIRQPin);

    // MSI
    Func.fMSIControl:=FuncNode.GetUInt32('MSIControl',Func.fMSIControl);
    Func.fMSIAddressLow:=FuncNode.GetUInt32('MSIAddressLow',Func.fMSIAddressLow);
    Func.fMSIAddressHigh:=FuncNode.GetUInt32('MSIAddressHigh',Func.fMSIAddressHigh);
    Func.fMSIData:=FuncNode.GetUInt32('MSIData',Func.fMSIData);
    Func.fMSIMask:=FuncNode.GetUInt32('MSIMask',Func.fMSIMask);
    Func.fMSIPending:=FuncNode.GetUInt32('MSIPending',Func.fMSIPending);

    // MSI-X
    Func.fMSIXControl:=FuncNode.GetUInt32('MSIXControl',Func.fMSIXControl);
    Func.fMSIXBAR:=FuncNode.GetUInt32('MSIXBAR',Func.fMSIXBAR);
    MSIXNode:=FuncNode.FindNode('MSIXTable');
    if Assigned(MSIXNode) then begin
     for MSIXIndex:=0 to TPCI.PCI_MSIX_BAR_SIZE-1 do begin
      Func.fMSIXTable[MSIXIndex]:=MSIXNode.GetUInt32(TPasRISCVRawByteString(IntToStr(MSIXIndex)),Func.fMSIXTable[MSIXIndex]);
     end;
    end;
   end;
  end;
 end;
end;

procedure TPasRISCV.TPCIDevice.SaveSnapshot(const aNode:TSnapshot.TNode);
var FuncIndex:TPasRISCVInt32;
    FuncNode:TSnapshot.TNode;
    Func:TPCIFunc;
    MSIXNode:TSnapshot.TNode;
    MSIXIndex:TPasRISCVInt32;
begin
 // Device ID
 aNode.SetUInt16('DeviceID',fDeviceID);

 // PCI functions
 for FuncIndex:=0 to TPCI.PCI_DEV_FUNCS-1 do begin
  Func:=fFuncs[FuncIndex];
  if assigned(Func) then begin
   FuncNode:=aNode.AddObject('Func'+TPasRISCVRawByteString(IntToStr(FuncIndex)));
   FuncNode.SetUInt32('Status',Func.fStatus);
   FuncNode.SetUInt32('Command',Func.fCommand);
   FuncNode.SetUInt32('IRQLine',Func.fIRQLine);
   FuncNode.SetUInt16('VendorID',Func.fVendorID);
   FuncNode.SetUInt16('DeviceID',Func.fDeviceID);
   FuncNode.SetUInt16('SubsystemVendorID',Func.fSubsystemVendorID);
   FuncNode.SetUInt16('SubsystemDeviceID',Func.fSubsystemDeviceID);
   FuncNode.SetUInt16('ClassCode',Func.fClassCode);
   FuncNode.SetUInt8('ProgIF',Func.fProgIF);
   FuncNode.SetUInt8('RevisionID',Func.fRevisionID);
   FuncNode.SetUInt32('BridgeIO',Func.fBridgeIO);
   FuncNode.SetUInt32('BridgeMem',Func.fBridgeMem);
   FuncNode.SetUInt8('IRQPin',Func.fIRQPin);

   // MSI
   FuncNode.SetUInt32('MSIControl',Func.fMSIControl);
   FuncNode.SetUInt32('MSIAddressLow',Func.fMSIAddressLow);
   FuncNode.SetUInt32('MSIAddressHigh',Func.fMSIAddressHigh);
   FuncNode.SetUInt32('MSIData',Func.fMSIData);
   FuncNode.SetUInt32('MSIMask',Func.fMSIMask);
   FuncNode.SetUInt32('MSIPending',Func.fMSIPending);

   // MSI-X
   FuncNode.SetUInt32('MSIXControl',Func.fMSIXControl);
   FuncNode.SetUInt32('MSIXBAR',Func.fMSIXBAR);
   MSIXNode:=FuncNode.AddObject('MSIXTable');
   for MSIXIndex:=0 to TPCI.PCI_MSIX_BAR_SIZE-1 do begin
    MSIXNode.SetUInt32(TPasRISCVRawByteString(IntToStr(MSIXIndex)),Func.fMSIXTable[MSIXIndex]);
   end;
  end;
 end;
end;

