 inherited Destroy;
end;

procedure TPasRISCV.TVirtIOGPUDevice.TGPUContext.AttachResource(const aResourceID:TPasRISCVUInt32);
var Index:TPasRISCVSizeInt;
begin
 for Index:=0 to fCountAttachedResources-1 do begin
  if fAttachedResources[Index]=aResourceID then begin
   exit;
  end;
 end;
 if length(fAttachedResources)<=fCountAttachedResources then begin
  SetLength(fAttachedResources,(fCountAttachedResources+1)*2);
 end;
 fAttachedResources[fCountAttachedResources]:=aResourceID;
 inc(fCountAttachedResources);
end;

procedure TPasRISCV.TVirtIOGPUDevice.TGPUContext.DetachResource(const aResourceID:TPasRISCVUInt32);
var Index:TPasRISCVSizeInt;
begin
 for Index:=0 to fCountAttachedResources-1 do begin
  if fAttachedResources[Index]=aResourceID then begin
   if (Index+1)<fCountAttachedResources then begin
    fAttachedResources[Index]:=fAttachedResources[fCountAttachedResources-1];
   end;
   dec(fCountAttachedResources);
   exit;
  end;
 end;
end;
{$endif}

{ TPasRISCV.TVirtIOGPUDevice }

constructor TPasRISCV.TVirtIOGPUDevice.Create(const aMachine:TPasRISCV);
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
const EGLCfgAttr:array[0..7] of TPasRISCVInt32=($3033,$0001,$3040,$0004,$3038,0,0,0);
      EGLCtxAttr:array[0..3] of TPasRISCVInt32=($3098,2,$3038,0);
      EGLPbAttr:array[0..5] of TPasRISCVInt32=($3057,1,$3056,1,$3038,0);
{$endif}
var Scanout:PGPUScanout;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
    EGLCfg:Pointer;
    EGLNCfg:TPasRISCVInt32;
    VirglCreateFlags:TPasRISCVUInt32;
{$endif}
begin

 inherited Create(aMachine,aMachine.fConfiguration.fVirtIOGPUBase,aMachine.fConfiguration.fVirtIOGPUSize,TVirtIODevice.TKind.MMIO);

 fIRQ:=aMachine.fConfiguration.fVirtIOGPUIRQ;

 fUseQueueDescriptorCaching:=true;

 fDeviceID:=TVirtIOGPUDevice.DeviceID;

 fFrameBuffer:=aMachine.fFrameBufferDevice;
 fFrameBuffer.fAutomaticRefresh:=true;
 fFrameBuffer.fSwapColorChannels:=true;
 fFrameBuffer.fCursorCompositing:=true;
 fFrameBuffer.fIgnoreDirty:=false;

 fGPUConfig.EventsRead:=0;
 fGPUConfig.EventsClear:=0;
 fGPUConfig.NumScanouts:=VIRTIO_GPU_MAX_SCANOUTS;
 fGPUConfig.NumCapsets:=0;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 if fMachine.fConfiguration.fVirtIOGPUVirGL then begin
  fGPUConfig.NumCapsets:=Max(fGPUConfig.NumCapsets,VIRTIO_GPU_NUM_CAPSETS);
 end;
{$endif}

 fConfigSpaceSize:=SizeOf(TVirtIOGPUConfig);
 Move(fGPUConfig,fConfigSpace[0],SizeOf(TVirtIOGPUConfig));

 fDeviceFeatures:=TPasRISCV.TVirtIODevice.VIRTIO_F_VERSION_1 or
                  {$ifdef VirtIOEventIndex}TPasRISCV.TVirtIODevice.VIRTIO_F_EVENT_IDX or{$endif}
                  VIRTIO_GPU_F_EDID or
                  0;

{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 if fMachine.fConfiguration.fVirtIOGPUVirGL then begin
  fDeviceFeatures:=fDeviceFeatures or
                   VIRTIO_GPU_F_VIRGL or
                   VIRTIO_GPU_F_RESOURCE_BLOB or
                   VIRTIO_GPU_F_CONTEXT_INIT;
 end;
{$endif}

 fQueues[VIRTIO_GPU_VQ_CONTROL].ManualRecv:=false;
 fQueues[VIRTIO_GPU_VQ_CONTROL].Asynchronous:=false;

 fQueues[VIRTIO_GPU_VQ_CURSOR].ManualRecv:=false;
 fQueues[VIRTIO_GPU_VQ_CURSOR].Asynchronous:=false;

 fResources:=nil;
 fCountResources:=0;

 FillChar(fScanouts,SizeOf(TGPUScanouts),#0);
 Scanout:=@fScanouts[0];
 Scanout^.Rect.Width:=fFrameBuffer.fWidth;
 Scanout^.Rect.Height:=fFrameBuffer.fHeight;
 Scanout^.Enabled:=true;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 Scanout^.IsBlob:=false;
 Scanout^.Is3D:=false;
{$endif}

 fRecvBuffer:=nil;
 SetLength(fRecvBuffer,65536);

 fSendBuffer:=nil;
 SetLength(fSendBuffer,65536);

{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 fVulkanDevice:=nil;
 fEGLDisplay:=nil;
 fEGLContext:=nil;
 fEGLSurface:=nil;
 fVirglInitialized:=false;
 fVirglLock:=TPasMPCriticalSection.Create;
 if fMachine.fConfiguration.fVirtIOGPUVirGL then begin
  if EGLLibLoaded then begin
   fEGLDisplay:=eglGetDisplay(nil);
   if fEGLDisplay<>nil then begin
    eglInitialize(fEGLDisplay,nil,nil);
    eglBindAPI($30a0);
    EGLCfg:=nil;
    EGLNCfg:=0;
    eglChooseConfig(fEGLDisplay,@EGLCfgAttr[0],@EGLCfg,1,@EGLNCfg);
    if (EGLCfg<>nil) and (EGLNCfg>0) then begin
     fEGLContext:=eglCreateContext(fEGLDisplay,EGLCfg,nil,@EGLCtxAttr[0]);
     fEGLSurface:=eglCreatePbufferSurface(fEGLDisplay,EGLCfg,@EGLPbAttr[0]);
     eglMakeCurrent(fEGLDisplay,fEGLSurface,fEGLSurface,fEGLContext);
    end;
   end;
  end;
  if VirglRendererLibLoaded then begin
   VirglCreateFlags:=VIRGL_RENDERER_USE_VENUS;
   if EGLLibLoaded and assigned(fEGLContext) and assigned(fEGLSurface) then begin
    VirglCreateFlags:=VirglCreateFlags or VIRGL_RENDERER_USE_EGL;
   end;
   virgl_renderer_init(Self,VirglCreateFlags,@VirglCallbacks);
   fVirglInitialized:=true;
  end;
 end;
{$endif}

end;

destructor TPasRISCV.TVirtIOGPUDevice.Destroy;
begin
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 if fVirglInitialized then begin
  DestroyAllContexts;
  virgl_renderer_cleanup(Self);
  fVirglInitialized:=false;
 end;
 if EGLLibLoaded then begin
  if fEGLDisplay<>nil then begin
   eglMakeCurrent(fEGLDisplay,nil,nil,nil);
   if fEGLContext<>nil then begin
    eglDestroyContext(fEGLDisplay,fEGLContext);
    fEGLContext:=nil;
   end;
   if fEGLSurface<>nil then begin
    eglDestroySurface(fEGLDisplay,fEGLSurface);
    fEGLSurface:=nil;
   end;
   eglTerminate(fEGLDisplay);
   fEGLDisplay:=nil;
  end;
 end;
{$endif}
 DestroyAllResources;
 fResources:=nil;
 fRecvBuffer:=nil;
 fSendBuffer:=nil;
 fFrameBuffer:=nil;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 fVulkanDevice:=nil;
 FreeAndNil(fVirglLock);
{$endif}
 inherited Destroy;
end;

procedure TPasRISCV.TVirtIOGPUDevice.DeviceReset;
var Scanout:PGPUScanout;
begin
 DestroyAllResources;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 DestroyAllContexts;
{$endif}
 FillChar(fScanouts,SizeOf(TGPUScanouts),#0);
 if assigned(fFrameBuffer) then begin
  Scanout:=@fScanouts[0];
  Scanout^.Rect.Width:=fFrameBuffer.fWidth;
  Scanout^.Rect.Height:=fFrameBuffer.fHeight;
  Scanout^.Enabled:=true;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
  Scanout^.IsBlob:=false;
  Scanout^.Is3D:=false;
{$endif}
 end;
 fGPUConfig.EventsRead:=0;
 Move(fGPUConfig,fConfigSpace[0],SizeOf(TVirtIOGPUConfig));
 inherited DeviceReset;
end;

function TPasRISCV.TVirtIOGPUDevice.FindResource(const aResourceID:TPasRISCVUInt32):TGPUResource;
var Index:TPasRISCVSizeInt;
begin
 result:=nil;
 for Index:=0 to fCountResources-1 do begin
  if fResources[Index].fID=aResourceID then begin
   result:=fResources[Index];
   exit;
  end;
 end;
end;

function TPasRISCV.TVirtIOGPUDevice.CreateResource(const aResourceID,aWidth,aHeight,aFormat:TPasRISCVUInt32):TGPUResource;
var BPP:TPasRISCVUInt32;
begin
 BPP:=GetFormatBytesPerPixel(aFormat);
 result:=TGPUResource.Create;
 result.fID:=aResourceID;
 result.fWidth:=aWidth;
 result.fHeight:=aHeight;
 result.fFormat:=aFormat;
 result.fBytesPerPixel:=BPP;
 SetLength(result.fData,aWidth*aHeight*BPP);
 FillChar(result.fData[0],length(result.fData),#0);
 if length(fResources)<=fCountResources then begin
  SetLength(fResources,(fCountResources+1)*2);
 end;
 fResources[fCountResources]:=result;
 inc(fCountResources);
end;

procedure TPasRISCV.TVirtIOGPUDevice.DestroyResource(const aResourceID:TPasRISCVUInt32);
var Index,ScanoutIndex:TPasRISCVSizeInt;
    Scanout:PGPUScanout;
begin
 for Index:=0 to fCountResources-1 do begin
  if fResources[Index].fID=aResourceID then begin
   for ScanoutIndex:=0 to VIRTIO_GPU_MAX_SCANOUTS-1 do begin
    Scanout:=@fScanouts[ScanoutIndex];
    if Scanout^.ResourceID=aResourceID then begin
     Scanout^.ResourceID:=0;
     Scanout^.Enabled:=false;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
     Scanout^.IsBlob:=false;
     Scanout^.Is3D:=false;
{$endif}
    end;
   end;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
   if fVirglInitialized and assigned(virgl_renderer_resource_unref) then begin
    virgl_renderer_resource_unref(aResourceID);
   end;
{$endif}
   FreeAndNil(fResources[Index]);
   dec(fCountResources);
   if Index<fCountResources then begin
    Move(fResources[Index+1],fResources[Index],(fCountResources-Index)*SizeOf(TGPUResource));
   end;
   fResources[fCountResources]:=nil;
   exit;
  end;
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.DestroyAllResources;
var Index:TPasRISCVSizeInt;
begin
 for Index:=0 to fCountResources-1 do begin
  FreeAndNil(fResources[Index]);
 end;
 fCountResources:=0;
end;

{$ifdef PasRISCVVirtIOGPUVulkanVenus}
function TPasRISCV.TVirtIOGPUDevice.FindContext(const aContextID:TPasRISCVUInt32):TGPUContext;
var Index:TPasRISCVSizeInt;
begin
 result:=nil;
 for Index:=0 to fCountContexts-1 do begin
  if fContexts[Index].fID=aContextID then begin
   result:=fContexts[Index];
   exit;
  end;
 end;
end;

function TPasRISCV.TVirtIOGPUDevice.CreateContext(const aContextID,aCapsetID:TPasRISCVUInt32;const aDebugName:string):TGPUContext;
var Context:TGPUContext;
begin
 result:=FindContext(aContextID);
 if assigned(result) then begin
  exit;
 end;
 Context:=TGPUContext.Create;
 Context.fID:=aContextID;
 Context.fCapsetID:=aCapsetID;
 Context.fDebugName:=aDebugName;
 if length(fContexts)<=fCountContexts then begin
  SetLength(fContexts,(fCountContexts+1)*2);
 end;
 fContexts[fCountContexts]:=Context;
 inc(fCountContexts);
 result:=Context;
end;

procedure TPasRISCV.TVirtIOGPUDevice.DestroyContext(const aContextID:TPasRISCVUInt32);
var Index:TPasRISCVSizeInt;
begin
 for Index:=0 to fCountContexts-1 do begin
  if fContexts[Index].fID=aContextID then begin
   FreeAndNil(fContexts[Index]);
   if (Index+1)<fCountContexts then begin
    fContexts[Index]:=fContexts[fCountContexts-1];
   end;
   dec(fCountContexts);
   fContexts[fCountContexts]:=nil;
   exit;
  end;
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.DestroyAllContexts;
var Index:TPasRISCVSizeInt;
begin
 for Index:=0 to fCountContexts-1 do begin
  FreeAndNil(fContexts[Index]);
 end;
 fCountContexts:=0;
end;

procedure TPasRISCV.TVirtIOGPUDevice.SetVulkanDevice(const aVulkanDevice:TObject);
begin
 fVulkanDevice:=aVulkanDevice;
end;
{$endif}

function TPasRISCV.TVirtIOGPUDevice.GetFormatBytesPerPixel(const aFormat:TPasRISCVUInt32):TPasRISCVUInt32;
begin
 case aFormat of
  VIRTIO_GPU_FORMAT_B8G8R8A8_UNORM,
  VIRTIO_GPU_FORMAT_B8G8R8X8_UNORM,
  VIRTIO_GPU_FORMAT_A8R8G8B8_UNORM,
  VIRTIO_GPU_FORMAT_X8R8G8B8_UNORM,
  VIRTIO_GPU_FORMAT_R8G8B8A8_UNORM,
  VIRTIO_GPU_FORMAT_X8B8G8R8_UNORM,
  VIRTIO_GPU_FORMAT_A8B8G8R8_UNORM,
  VIRTIO_GPU_FORMAT_R8G8B8X8_UNORM:begin
   result:=4;
  end;
  else begin
   result:=4;
  end;
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.SendResponse(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aData:Pointer;const aSize:TPasRISCVUInt64);
begin
 if not (CopyMemoryToQueue(aQueueIndex,aDescriptorIndex,0,aData,aSize) and
         ConsumeDescriptor(aQueueIndex,aDescriptorIndex,aSize) and
         UsedRingSync(aQueueIndex)) then begin
  NotifyDeviceNeedsReset;
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.SendOKNoData(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aHeader:PVirtIOGPUCtrlHeader);
var Response:TVirtIOGPUCtrlHeader;
begin
 FillChar(Response,SizeOf(TVirtIOGPUCtrlHeader),#0);
 Response.CtrlType:=VIRTIO_GPU_RESP_OK_NODATA;
 Response.Flags:=aHeader^.Flags;
 Response.FenceID:=aHeader^.FenceID;
 Response.ContextID:=aHeader^.ContextID;
 SendResponse(aQueueIndex,aDescriptorIndex,@Response,SizeOf(TVirtIOGPUCtrlHeader));
end;

procedure TPasRISCV.TVirtIOGPUDevice.SendError(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aHeader:PVirtIOGPUCtrlHeader;const aErrorCode:TPasRISCVUInt32);
var Response:TVirtIOGPUCtrlHeader;
begin
 FillChar(Response,SizeOf(TVirtIOGPUCtrlHeader),#0);
 Response.CtrlType:=aErrorCode;
 Response.Flags:=aHeader^.Flags;
 Response.FenceID:=aHeader^.FenceID;
 Response.ContextID:=aHeader^.ContextID;
 SendResponse(aQueueIndex,aDescriptorIndex,@Response,SizeOf(TVirtIOGPUCtrlHeader));
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleGetDisplayInfo(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aHeader:PVirtIOGPUCtrlHeader);
var Response:TVirtIOGPURespDisplayInfo;
    Index:TPasRISCVSizeInt;
begin
 FillChar(Response,SizeOf(TVirtIOGPURespDisplayInfo),#0);
 Response.Header.CtrlType:=VIRTIO_GPU_RESP_OK_DISPLAY_INFO;
 Response.Header.Flags:=aHeader^.Flags;
 Response.Header.FenceID:=aHeader^.FenceID;
 Response.Header.ContextID:=aHeader^.ContextID;
 for Index:=0 to VIRTIO_GPU_MAX_SCANOUTS-1 do begin
  Response.PModes[Index].Rect:=fScanouts[Index].Rect;
  Response.PModes[Index].Enabled:=ord(fScanouts[Index].Enabled);
  Response.PModes[Index].Flags:=0;
 end;
 SendResponse(aQueueIndex,aDescriptorIndex,@Response,SizeOf(TVirtIOGPURespDisplayInfo));
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleResourceCreate2D(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUResourceCreate2D);
var Resource:TGPUResource;
begin
 if (aCmd^.ResourceID=0) or assigned(FindResource(aCmd^.ResourceID)) then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
  exit;
 end;
 if (aCmd^.Width=0) or (aCmd^.Height=0) then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER);
  exit;
 end;
 Resource:=CreateResource(aCmd^.ResourceID,aCmd^.Width,aCmd^.Height,aCmd^.Format);
 if assigned(Resource) then begin
  SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
 end else begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_OUT_OF_MEMORY);
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleResourceUnref(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUResourceUnref);
begin
 if not assigned(FindResource(aCmd^.ResourceID)) then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
  exit;
 end;
 DestroyResource(aCmd^.ResourceID);
 SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleSetScanout(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUSetScanout);
var Resource:TGPUResource;
    Scanout:PGPUScanout;
begin
 if aCmd^.ScanoutID>=VIRTIO_GPU_MAX_SCANOUTS then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_SCANOUT_ID);
  exit;
 end;
 Scanout:=@fScanouts[aCmd^.ScanoutID];
 if aCmd^.ResourceID=0 then begin
  // Disable scanout
  Scanout^.ResourceID:=0;
  Scanout^.Enabled:=false;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
  Scanout^.IsBlob:=false;
  Scanout^.Is3D:=false;
{$endif}
  SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
  exit;
 end;
 Resource:=FindResource(aCmd^.ResourceID);
 if not assigned(Resource) then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
  exit;
 end;
 Scanout^.ResourceID:=aCmd^.ResourceID;
 Scanout^.Rect:=aCmd^.Rect;
 Scanout^.Enabled:=true;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 Scanout^.IsBlob:=Resource.fIsBlob;
 Scanout^.Is3D:=Resource.fIs3D;
 if Resource.fIsBlob or Resource.fIs3D then begin
  SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
  exit;
 end;
{$endif}
 // Set format swap flag: R-first formats are already RGBA, cancel base swap via XOR
 if aCmd^.ScanoutID=0 then begin
  case Resource.fFormat of
   VIRTIO_GPU_FORMAT_R8G8B8A8_UNORM,
   VIRTIO_GPU_FORMAT_R8G8B8X8_UNORM,
   VIRTIO_GPU_FORMAT_X8B8G8R8_UNORM,
   VIRTIO_GPU_FORMAT_A8B8G8R8_UNORM:begin
    fFrameBuffer.fFormatSwapColorChannels:=true;
   end;
   else begin
    fFrameBuffer.fFormatSwapColorChannels:=false;
   end;
  end;
 end;
 // Resize framebuffer to match scanout if needed
 if (aCmd^.ScanoutID=0) and
    ((fFrameBuffer.fWidth<>aCmd^.Rect.Width) or
     (fFrameBuffer.fHeight<>aCmd^.Rect.Height)) then begin
  fFrameBuffer.ResizeFrameBuffer(aCmd^.Rect.Width,aCmd^.Rect.Height,Resource.fBytesPerPixel);
 end;
 SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleResourceFlush(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUResourceFlush);
var Resource:TGPUResource;
    ScanoutIndex:TPasRISCVSizeInt;
    Scanout:PGPUScanout;
    SrcX,SrcY,DstX,DstY,CopyWidth,CopyHeight:TPasRISCVUInt32;
    SrcStride,DstStride:TPasRISCVUInt32;
    Row:TPasRISCVUInt32;
    SrcOffset,DstOffset:TPasRISCVUInt64;
begin
 Resource:=FindResource(aCmd^.ResourceID);
 if not assigned(Resource) then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
  exit;
 end;
 // Copy resource data to framebuffer for each scanout using this resource
 for ScanoutIndex:=0 to VIRTIO_GPU_MAX_SCANOUTS-1 do begin
  Scanout:=@fScanouts[ScanoutIndex];
  if Scanout^.Enabled and (Scanout^.ResourceID=aCmd^.ResourceID) then begin
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
   if Scanout^.IsBlob then begin
    if assigned(fOnScanoutUpdate) and assigned(Resource.fMappedPointer) then begin
     fOnScanoutUpdate(ScanoutIndex,Resource.fMappedPointer,Resource.fWidth,Resource.fHeight,Resource.fWidth*Resource.fBytesPerPixel,Resource.fFormat);
    end;
   end else if Scanout^.Is3D then begin
    // Classic 3D: no host-side readback available without additional FFI; skip CPU blit
   end else begin
{$endif}
    fFrameBuffer.fLock.AcquireWrite;
    try
{$ifdef VirtIOGPUDirectScanout}
     if (Scanout^.Rect.X=0) and
        (Scanout^.Rect.Y=0) and
        (Resource.fWidth=fFrameBuffer.fWidth) and
        (Resource.fHeight=fFrameBuffer.fHeight) and
        (Resource.fBytesPerPixel=fFrameBuffer.fBytesPerPixel) and
        (TPasRISCVUInt64(length(Resource.fData))>=(TPasRISCVUInt64(fFrameBuffer.fWidth)*fFrameBuffer.fHeight*fFrameBuffer.fBytesPerPixel)) then begin
      Move(Resource.fData[0],fFrameBuffer.fData[0],TPasRISCVUInt64(fFrameBuffer.fWidth)*fFrameBuffer.fHeight*fFrameBuffer.fBytesPerPixel);
     end else{$endif}begin
      SrcX:=aCmd^.Rect.X;
      SrcY:=aCmd^.Rect.Y;
      DstX:=Scanout^.Rect.X+aCmd^.Rect.X;
      DstY:=Scanout^.Rect.Y+aCmd^.Rect.Y;
      CopyWidth:=aCmd^.Rect.Width;
      CopyHeight:=aCmd^.Rect.Height;
      // Clamp
      if (SrcX+CopyWidth)>Resource.fWidth then begin
       CopyWidth:=Resource.fWidth-SrcX;
      end;
      if (SrcY+CopyHeight)>Resource.fHeight then begin
       CopyHeight:=Resource.fHeight-SrcY;
      end;
      if (DstX+CopyWidth)>fFrameBuffer.fWidth then begin
       CopyWidth:=fFrameBuffer.fWidth-DstX;
      end;
      if (DstY+CopyHeight)>fFrameBuffer.fHeight then begin
       CopyHeight:=fFrameBuffer.fHeight-DstY;
      end;
      SrcStride:=Resource.fWidth*Resource.fBytesPerPixel;
      DstStride:=fFrameBuffer.fWidth*fFrameBuffer.fBytesPerPixel;
      for Row:=0 to CopyHeight-1 do begin
       SrcOffset:=TPasRISCVUInt64(SrcY+Row)*SrcStride+TPasRISCVUInt64(SrcX)*Resource.fBytesPerPixel;
       DstOffset:=TPasRISCVUInt64(DstY+Row)*DstStride+TPasRISCVUInt64(DstX)*fFrameBuffer.fBytesPerPixel;
       if (SrcOffset+(TPasRISCVUInt64(CopyWidth)*Resource.fBytesPerPixel))<=length(Resource.fData) then begin
        if (DstOffset+(TPasRISCVUInt64(CopyWidth)*fFrameBuffer.fBytesPerPixel))<=length(fFrameBuffer.fData) then begin
         Move(Resource.fData[SrcOffset],fFrameBuffer.fData[DstOffset],CopyWidth*Resource.fBytesPerPixel);
        end;
       end;
      end;
     end;
     fFrameBuffer.fDirty:=true;
    finally
     fFrameBuffer.fLock.ReleaseWrite;
    end;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
   end;
{$endif}
  end;
 end;
 // VSync: Notify host that a new frame is ready
{fFrameBuffer.UpdateOutputData;
 if assigned(fMachine.OnNewFrame) then begin
  fMachine.OnNewFrame();
 end;}
 SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleTransferToHost2D(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUTransferToHost2D);
var Resource:TGPUResource;
{$ifdef VirtIOGPUFastTransfer}
    PageIndex,SavedPageIndex:TPasRISCVSizeInt;
{$else}
    PageIndex:TPasRISCVSizeInt;
{$endif}
    {SrcRow,}DstRow:TPasRISCVUInt32;
    {SrcStride,}DstStride:TPasRISCVUInt32;
{$ifdef VirtIOGPUFastTransfer}
    Offset,PageOffset,SavedPageOffset,CopyLen,PageRemain:TPasRISCVUInt64;
{$else}
    Offset,PageOffset,CopyLen,PageRemain:TPasRISCVUInt64;
{$endif}
    DstOffset:TPasRISCVUInt64;
    ResourceDataSize:TPasRISCVUInt64;
begin
 Resource:=FindResource(aCmd^.ResourceID);
 if not assigned(Resource) then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
  exit;
 end;
 if length(Resource.fBackingPages)=0 then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_UNSPEC);
  exit;
 end;
 // Copy from guest backing pages to resource pixel data
 DstStride:=Resource.fWidth*Resource.fBytesPerPixel;
 ResourceDataSize:=length(Resource.fData);
 Offset:=aCmd^.Offset;
{$ifdef VirtIOGPUFastTransfer}
 // Find initial page position once
 PageOffset:=Offset;
 PageIndex:=0;
 while (PageIndex<length(Resource.fBackingPages)) and (PageOffset>=Resource.fBackingPages[PageIndex].Length) do begin
  dec(PageOffset,Resource.fBackingPages[PageIndex].Length);
  inc(PageIndex);
 end;
{$endif}
 for DstRow:=0 to aCmd^.Rect.Height-1 do begin
  DstOffset:=TPasRISCVUInt64(aCmd^.Rect.Y+DstRow)*DstStride+TPasRISCVUInt64(aCmd^.Rect.X)*Resource.fBytesPerPixel;
  CopyLen:=TPasRISCVUInt64(aCmd^.Rect.Width)*Resource.fBytesPerPixel;
  if (DstOffset+CopyLen)>ResourceDataSize then begin
   break;
  end;
{$ifdef VirtIOGPUFastTransfer}
  // Save page position before copy (copy may modify PageIndex in span case)
  SavedPageIndex:=PageIndex;
  SavedPageOffset:=PageOffset;
{$else}
  // Walk backing pages to find source data at Offset
  PageOffset:=Offset;
  PageIndex:=0;
  while (PageIndex<length(Resource.fBackingPages)) and (PageOffset>=Resource.fBackingPages[PageIndex].Length) do begin
   dec(PageOffset,Resource.fBackingPages[PageIndex].Length);
   inc(PageIndex);
  end;
{$endif}
  if PageIndex<length(Resource.fBackingPages) then begin
   PageRemain:=Resource.fBackingPages[PageIndex].Length-PageOffset;
   if PageRemain>=CopyLen then begin
    CopyMemoryFromRAM(@Resource.fData[DstOffset],Resource.fBackingPages[PageIndex].Addr+PageOffset,CopyLen);
   end else begin
    // Span across pages
    CopyMemoryFromRAM(@Resource.fData[DstOffset],Resource.fBackingPages[PageIndex].Addr+PageOffset,PageRemain);
    inc(PageIndex);
    if PageIndex<length(Resource.fBackingPages) then begin
     CopyMemoryFromRAM(@Resource.fData[DstOffset+PageRemain],Resource.fBackingPages[PageIndex].Addr,CopyLen-PageRemain);
    end;
   end;
  end;
{$ifdef VirtIOGPUFastTransfer}
  // Advance page position by DstStride from saved row-start position
  PageIndex:=SavedPageIndex;
  PageOffset:=SavedPageOffset+DstStride;
  while (PageIndex<length(Resource.fBackingPages)) and (PageOffset>=Resource.fBackingPages[PageIndex].Length) do begin
   dec(PageOffset,Resource.fBackingPages[PageIndex].Length);
   inc(PageIndex);
  end;
{$else}
  inc(Offset,DstStride);
{$endif}
 end;
 SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleResourceAttachBacking(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aReadSize:TPasRISCVUInt64);
var Cmd:TVirtIOGPUResourceAttachBacking;
    Resource:TGPUResource;
    MemEntries:array of TVirtIOGPUMemEntry;
    Index:TPasRISCVSizeInt;
    EntriesSize:TPasRISCVUInt64;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
    Iovs:TVirglIovecArray;
    MemBase:TPasRISCVUInt64;
    MemOffset:TPasRISCVUInt64;
{$endif}
begin
 if not CopyMemoryFromQueue(@Cmd,aQueueIndex,aDescriptorIndex,0,SizeOf(TVirtIOGPUResourceAttachBacking)) then begin
  NotifyDeviceNeedsReset;
  exit;
 end;
 Resource:=FindResource(Cmd.ResourceID);
 if not assigned(Resource) then begin
  SendError(aQueueIndex,aDescriptorIndex,@Cmd.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
  exit;
 end;
 MemEntries:=nil;
 SetLength(MemEntries,Cmd.NrEntries);
 EntriesSize:=TPasRISCVUInt64(Cmd.NrEntries)*SizeOf(TVirtIOGPUMemEntry);
 if not CopyMemoryFromQueue(@MemEntries[0],aQueueIndex,aDescriptorIndex,SizeOf(TVirtIOGPUResourceAttachBacking),EntriesSize) then begin
  MemEntries:=nil;
  NotifyDeviceNeedsReset;
  exit;
 end;
 SetLength(Resource.fBackingPages,Cmd.NrEntries);
 for Index:=0 to Cmd.NrEntries-1 do begin
  Resource.fBackingPages[Index].Addr:=MemEntries[Index].Addr;
  Resource.fBackingPages[Index].Length:=MemEntries[Index].Length;
 end;
 MemEntries:=nil;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 if fVirglInitialized and assigned(virgl_renderer_resource_attach_iov) then begin
  MemBase:=fMachine.fMemoryDevice.fBase;
  SetLength(Iovs,Cmd.NrEntries);
  for Index:=0 to Cmd.NrEntries-1 do begin
   MemOffset:=Resource.fBackingPages[Index].Addr-MemBase;
   Iovs[Index].iov_base:=Pointer(PByte(fMachine.fMemoryDevice.fData)+MemOffset);
   Iovs[Index].iov_len:=Resource.fBackingPages[Index].Length;
  end;
  virgl_renderer_resource_attach_iov(Cmd.ResourceID,@Iovs[0],Cmd.NrEntries);
 end;
{$endif}
 SendOKNoData(aQueueIndex,aDescriptorIndex,@Cmd.Header);
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleResourceDetachBacking(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUResourceDetachBacking);
var Resource:TGPUResource;
begin
 Resource:=FindResource(aCmd^.ResourceID);
 if not assigned(Resource) then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
  exit;
 end;
{$ifdef PasRISCVVirtIOGPUVulkanVenus}
 if fVirglInitialized and assigned(virgl_renderer_resource_detach_iov) then begin
  virgl_renderer_resource_detach_iov(aCmd^.ResourceID,nil,nil);
 end;
{$endif}
 Resource.fBackingPages:=nil;
 SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleGetEDID(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUGetEDID);
var Response:TVirtIOGPURespEDID;
    CheckSum:TPasRISCVUInt8;
    Index:TPasRISCVSizeInt;
    Width,Height:TPasRISCVUInt32;
begin
 if aCmd^.Scanout>=VIRTIO_GPU_MAX_SCANOUTS then begin
  SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_SCANOUT_ID);
  exit;
 end;
 FillChar(Response,SizeOf(TVirtIOGPURespEDID),#0);
 Response.Header.CtrlType:=VIRTIO_GPU_RESP_OK_EDID;
 Response.Header.Flags:=aCmd^.Header.Flags;
 Response.Header.FenceID:=aCmd^.Header.FenceID;
 Response.Header.ContextID:=aCmd^.Header.ContextID;
 Response.Size:=128; // Standard EDID block size
 Width:=fScanouts[aCmd^.Scanout].Rect.Width;
 Height:=fScanouts[aCmd^.Scanout].Rect.Height;
 if Width=0 then begin
  Width:=fFrameBuffer.fWidth;
 end;
 if Height=0 then begin
  Height:=fFrameBuffer.fHeight;
 end;
 // Build minimal EDID v1.3
 // Header
 Response.EDID[0]:=$00;
 Response.EDID[1]:=$ff;
 Response.EDID[2]:=$ff;
 Response.EDID[3]:=$ff;
 Response.EDID[4]:=$ff;
 Response.EDID[5]:=$ff;
 Response.EDID[6]:=$ff;
 Response.EDID[7]:=$00;
 // Manufacturer ID "PRC" (PasRISCV)
 Response.EDID[8]:=$3e; // 'P'=16, 'R'=18 compressed: ((16 shl 10) or (18 shl 5) or 3) = $40a3 -> bytes $40, $a3
 Response.EDID[9]:=$a3;
 // Product code
 Response.EDID[10]:=$01;
 Response.EDID[11]:=$00;
 // Serial
 Response.EDID[12]:=$01;
 Response.EDID[13]:=$00;
 Response.EDID[14]:=$00;
 Response.EDID[15]:=$00;
 // Week / Year
 Response.EDID[16]:=1;
 Response.EDID[17]:=26; // 2016+10 = year offset
 // Version 1.3
 Response.EDID[18]:=1;
 Response.EDID[19]:=3;
 // Digital input
 Response.EDID[20]:=$80;
 // Max horizontal/vertical image size in cm
 Response.EDID[21]:=TPasRISCVUInt8((Width*254) div 10000);  // ~cm at 96dpi
 Response.EDID[22]:=TPasRISCVUInt8((Height*254) div 10000);
 // Gamma 2.2
 Response.EDID[23]:=120;
 // Features: RGB, preferred timing in DTD 1
 Response.EDID[24]:=$0a;
 // Chromaticity skip (bytes 25-34)
 // Established timings (bytes 35-37)
 // Standard timings (bytes 38-53) - not used
 FillChar(Response.EDID[38],16,$01);
 // Detailed Timing Descriptor #1 (bytes 54-71): preferred mode
 // Pixel clock in 10 kHz units (e.g. 25175 for 640x480@60 => 2517)
 // Simplified: just set width/height, minimal valid structure
 Response.EDID[54]:=((Width*60*125) div 100000) and $ff;
 Response.EDID[55]:=(((Width*60*125) div 100000) shr 8) and $ff;
 Response.EDID[56]:=Width and $ff;
 Response.EDID[57]:=0; // H blanking low
 Response.EDID[58]:=((Width shr 4) and $f0); // H active high nibble
 Response.EDID[59]:=Height and $ff;
 Response.EDID[60]:=0; // V blanking low
 Response.EDID[61]:=((Height shr 4) and $f0); // V active high nibble
 // Bytes 62-71: various timing, keep zero
 // Monitor descriptor blocks (bytes 72-125): fill with dummy descriptors
 // Block 2: Monitor name
 Response.EDID[72]:=0;
 Response.EDID[73]:=0;
 Response.EDID[74]:=0;
 Response.EDID[75]:=$fc; // Monitor name tag
 Response.EDID[76]:=0;
 Response.EDID[77]:=ord('P');
 Response.EDID[78]:=ord('a');
 Response.EDID[79]:=ord('s');
 Response.EDID[80]:=ord('R');
 Response.EDID[81]:=ord('I');
 Response.EDID[82]:=ord('S');
 Response.EDID[83]:=ord('C');
 Response.EDID[84]:=ord('V');
 Response.EDID[85]:=$0a;
 // Block 3: Monitor range
 Response.EDID[90]:=0;
 Response.EDID[91]:=0;
 Response.EDID[92]:=0;
 Response.EDID[93]:=$fd; // Monitor range tag
 Response.EDID[94]:=0;
 Response.EDID[95]:=50; // Min V freq
 Response.EDID[96]:=75; // Max V freq
 Response.EDID[97]:=30; // Min H freq kHz
 Response.EDID[98]:=80; // Max H freq kHz
 Response.EDID[99]:=25; // Max pixel clock / 10 MHz
 Response.EDID[100]:=0; // GTF
 // Checksum
 CheckSum:=0;
 for Index:=0 to 126 do begin
  inc(CheckSum,Response.EDID[Index]);
 end;
 Response.EDID[127]:=TPasRISCVUInt8(256-CheckSum);
 SendResponse(aQueueIndex,aDescriptorIndex,@Response,SizeOf(TVirtIOGPURespEDID));
end;

