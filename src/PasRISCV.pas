procedure InitializeX86ToRISCVFPUExceptionLookUpTable;
var Exceptions,Mask:TPasRISCVUInt32;
begin
 for Exceptions:=0 to TPasRISCV.FE_ALL_EXCEPT do begin
  Mask:=0;
