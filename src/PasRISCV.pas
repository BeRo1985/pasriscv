function SoftFloatCompareLECore(const aA,aB:TPasRISCVUInt64;const aMantissaBits,aSignShift:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32;var aFFlags:TPasRISCVUInt8):boolean;
