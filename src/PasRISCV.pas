  Emit2RegOp(X86_ADD,TempReg1,aHostSrc2,true);
  if aHostDest<>TempReg1 then begin
   EmitMOVRegReg(aHostDest,TempReg1,true);
  end;
  FreeHostIntRegister(TempReg1);
 end;
end;

