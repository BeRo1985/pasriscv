{$ifdef VirtIOEventIndex}
  Queue^.SignalledUsed:=0;
  Queue^.SignalledUsedValid:=false;
{$endif}
  Queue^.DescriptorAddress:=0;
  Queue^.AvailableAddress:=0;
  Queue^.UsedAddress:=0;
 end;
