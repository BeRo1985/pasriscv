function TPasRISCV9PFileSystemPOSIX.POSIXErrorCodeToP9ErrorCode(const aErrorCode:TPasRISCVInt32):TPasRISCVInt32;
begin
 case aErrorCode of
  0:begin
   result:=0;
  end;
  ESysEPERM:begin
   result:=P9_EPERM;
  end;
  ESysENOENT:begin
   result:=P9_ENOENT;
  end;
  ESysEIO:begin
   result:=P9_EIO;
  end;
  ESysEEXIST:begin
   result:=P9_EEXIST;
  end;
  ESysEINVAL:begin
   result:=P9_EINVAL;
  end;
  ESysENOSPC:begin
   result:=P9_ENOSPC;
  end;
  ESysENOTEMPTY:begin
   result:=P9_ENOTEMPTY;
  end;
  ESysEPROTO:begin
   result:=P9_EPROTO;
  end;
  ESysEOPNOTSUPP:begin
   result:=P9_ENOTSUP;
  end;
  else begin
   result:=P9_EINVAL;
  end;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.P9OpenFlagsToPOSIXOpenFlags(const aFlags:TPasRISCVUInt32):TPasRISCVUInt32;
begin
 result:=aFlags and P9_O_NOACCESS;
 if (aFlags and P9_O_CREAT)<>0 then begin
  result:=result or O_CREAT;
 end;
 if (aFlags and P9_O_EXCL)<>0 then begin
  result:=result or O_EXCL;
 end;
{if (aFlags and P9_O_NOCTTY)<>0 then begin
  result:=result or O_NOCTTY;
 end;}
 if (aFlags and P9_O_TRUNC)<>0 then begin
  result:=result or O_TRUNC;
 end;
 if (aFlags and P9_O_APPEND)<>0 then begin
  result:=result or O_APPEND;
 end;
 if (aFlags and P9_O_NONBLOCK)<>0 then begin
  result:=result or O_NONBLOCK;
 end;
 if (aFlags and P9_O_DSYNC)<>0 then begin
  result:=result or O_SYNC; //O_DSYNC
 end;
{if (aFlags and P9_O_FASYNC)<>0 then begin
  result:=result or O_FASYNC;
 end;
 if (aFlags and P9_O_DIRECT)<>0 then begin
  result:=result or O_DIRECT;
 end;
 if (aFlags and P9_O_LARGEFILE)<>0 then begin
  result:=result or O_LARGEFILE;
 end;
 if (aFlags and P9_O_DIRECTORY)<>0 then begin
  result:=result or O_DIRECTORY;
 end;}
 if (aFlags and P9_O_NOFOLLOW)<>0 then begin
  result:=result or O_NOFOLLOW;
 end;
{if (aFlags and P9_O_NOATIME)<>0 then begin
  result:=result or O_NOATIME;
 end;
 if (aFlags and P9_O_CLOEXEC)<>0 then begin
  result:=result or O_CLOEXEC;
 end;}
 if (aFlags and P9_O_SYNC)<>0 then begin
  result:=result or O_SYNC;
 end;
end;

procedure TPasRISCV9PFileSystemPOSIX.StatToQID(const aQID:TPasRISCV9PFileSystem.PFSQID;const aStat:PStat);
begin
 aQID^.Type_:=0;
 if (aStat.st_mode and S_IFDIR)<>0 then begin
  aQID^.Type_:=aQID^.Type_ or P9_QTDIR;
 end;
 if (aStat.st_mode and S_IFLNK)<>0 then begin
  aQID^.Type_:=aQID^.Type_ or P9_QTSYMLINK;
 end;
 aQID^.Version:=0; // no caching on client
 aQID^.Path:=aStat.st_ino;
end;

function TPasRISCV9PFileSystemPOSIX.ComposePath(const aPath,aName:TPasRISCVRawByteString):TPasRISCVRawByteString;
const DirectorySeparator='/';
begin
 result:=aPath;
 if (length(result)>0) and (result[length(result)]<>DirectorySeparator) then begin
  result:=result+DirectorySeparator;
 end;
 result:=result+aName;
end;

function TPasRISCV9PFileSystemPOSIX.CreateFileObject(const aPath:TPasRISCVRawByteString;const aUID:TPasRISCVUInt32):TPasRISCV9PFileSystem.TFSFile;
begin
 result:=TFSFile.Create;
 result.fPath:=aPath;
 result.fUID:=aUID;
 result.fIsOpened:=false;
 result.fIsDirectory:=false;
 result.fStream:=nil;
 result.fFile:=-1;
 result.fDirectory:=nil;
end;

procedure TPasRISCV9PFileSystemPOSIX.Delete(const aFile:TPasRISCV9PFileSystem.TFSFile);
begin
 if assigned(aFile) then begin
  if aFile.fIsOpened then begin
   Close(aFile);
  end;
  aFile.fIsOpened:=false;
  aFile.fIsDirectory:=false;
  aFile.fPath:='';
  if assigned(aFile.fStream) then begin
   FreeAndNil(aFile.fStream);
  end;
  if assigned(aFile.fDirectory) then begin
   try
    FreeMem(aFile.fDirectory);
   finally
    aFile.fDirectory:=nil;
   end;
  end;
  aFile.Free;
 end;
end;

procedure TPasRISCV9PFileSystemPOSIX.StatFS(out aStatFS:TPasRISCV9PFileSystem.TFSStatFS);
var StatFSData:TStatFS;
begin
 if fpStatFS(PAnsiChar(fRootPath),@StatFSData)=0 then begin
  aStatFS.BSize:=StatFSData.bsize;
  aStatFS.Blocks:=StatFSData.blocks;
  aStatFS.BFree:=StatFSData.bfree;
  aStatFS.BAvail:=StatFSData.bavail;
  aStatFS.Files:=StatFSData.files;
  aStatFS.FFree:=StatFSData.ffree;
 end else begin
  FillChar(aStatFS,SizeOf(TFSStatFS),#0);
 end;
end;

function TPasRISCV9PFileSystemPOSIX.Attach(out aFile:TPasRISCV9PFileSystem.TFSFile;const aQID:TPasRISCV9PFileSystem.PFSQID;const aUID:TPasRISCVUInt32;const aUName,aAName:TPasRISCVRawByteString):TPasRISCVInt32;
var StatData:TStat;
begin
 if fpLStat(PAnsiChar(fRootPath),@StatData)=0 then begin
  aFile:=CreateFileObject(fRootPath,aUID);
  StatToQID(aQID,@StatData);
  result:=0;
 end else begin
  aFile:=nil;
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end;
end;

function TPasRISCV9PFileSystemPOSIX.Walk(out aFiles:TPasRISCV9PFileSystem.TFSFile;const aQIDs:TPasRISCV9PFileSystem.PFSQIDArray;const aFile:TPasRISCV9PFileSystem.TFSFile;const aCount:TPasRISCVSizeInt;const aNames:array of TPasRISCVRawByteString):TPasRISCVInt32;
var Path,Path1:TPasRISCVRawByteString;
    StatData:TStat;
    Index:TPasRISCVSizeInt;
begin
 Path:=aFile.fPath;
 result:=0;
 for Index:=0 to aCount-1 do begin
  Path1:=ComposePath(Path,aNames[Index]);
  if fpLStat(PAnsiChar(Path1),@StatData)=0 then begin
   Path:=Path1;
   StatToQID(@aQIDs[Index],@StatData);
   inc(result);
  end else begin
   break;
  end;
 end;
 aFiles:=CreateFileObject(Path,aFile.fUID);
end;

function TPasRISCV9PFileSystemPOSIX.MkDir(const aQID:TPasRISCV9PFileSystem.PFSQID;const aFile:TPasRISCV9PFileSystem.TFSFile;const aName:TPasRISCVRawByteString;const aMode,aGID:TPasRISCVUInt32):TPasRISCVInt32;
var CreateMode:TPasRISCVUInt32;
    Path:TPasRISCVRawByteString;
    StatData:TStat;
begin
 Path:=ComposePath(aFile.fPath,aName);
 CreateMode:=aMode and (P9_S_IRWXUGO or P9_S_ISUID or P9_S_ISGID or P9_S_ISVTX);
 if fpMkDir(PAnsiChar(Path),CreateMode)<0 then begin
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end else begin
  fpChmod(PAnsiChar(Path),CreateMode);
  if fpLStat(PAnsiChar(Path),@StatData)=0 then begin
   StatToQID(aQID,@StatData);
   result:=0;
  end else begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
  end;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.Open(const aQID:TPasRISCV9PFileSystem.PFSQID;const aFile:TPasRISCV9PFileSystem.TFSFile;const aFlags:TPasRISCVUInt32;const aOnOpenCompletion:TPasRISCV9PFileSystem.TOnOpenCompletion;const aOpaque:Pointer):TPasRISCVInt32;
var StatData:TStat;
    Flags:TPasRISCVUInt32;
begin
 if fpLStat(PAnsiChar(aFile.fPath),@StatData)=0 then begin
  StatToQID(aQID,@StatData);
  Flags:=P9OpenFlagsToPOSIXOpenFlags(aFlags);
  if ((aFlags and P9_O_DIRECTORY)<>0) or ((StatData.st_mode and S_IFMT)=S_IFDIR) then begin
   aFile.fDirectory:=FpOpenDir(PAnsiChar(aFile.fPath));
   if assigned(aFile.fDirectory) then begin
    aFile.fIsOpened:=true;
    aFile.fIsDirectory:=true;
    result:=0;
   end else begin
    result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
   end;
  end else begin
   aFile.fFile:=fpOpen(PAnsiChar(aFile.fPath),Flags and not O_CREAT);
   if aFile.fFile>=0 then begin
    aFile.fIsOpened:=true;
    aFile.fIsDirectory:=false;
    result:=0;
   end else begin
    result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
   end;
  end;
 end else begin
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end;
end;

function TPasRISCV9PFileSystemPOSIX.Create_(const aQID:TPasRISCV9PFileSystem.PFSQID;const aFile:TPasRISCV9PFileSystem.TFSFile;const aName:TPasRISCVRawByteString;const aFlags:TPasRISCVUInt32;const aMode,aGID:TPasRISCVUInt32):TPasRISCVInt32;
var StatData:TStat;
    ret,fd:cint;
    CreateMode,Flags:TPasRISCVUInt32;
    Path:TPasRISCVRawByteString;
begin
 Close(aFile);
 Path:=ComposePath(aFile.fPath,aName);
 Flags:=P9OpenFlagsToPOSIXOpenFlags(aFlags);
 CreateMode:=aMode and (P9_S_IRWXUGO or P9_S_ISUID or P9_S_ISGID or P9_S_ISVTX);
 fd:=fpOpen(PAnsiChar(Path),Flags or O_CREAT,CreateMode);
 if fd<0 then begin
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end else begin
  fpChmod(PAnsiChar(Path),CreateMode);
  ret:=fpLStat(PAnsiChar(Path),@StatData);
  if ret=0 then begin
   StatToQID(aQID,@StatData);
   aFile.fPath:=Path;
   aFile.fIsOpened:=true;
   aFile.fIsDirectory:=false;
   aFile.fFile:=fd;
   result:=0;
  end else begin
   fpClose(fd);
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
  end;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.ReadDir(const aFile:TPasRISCV9PFileSystem.TFSFile;const aOffset:TPasRISCVUInt64;const aBuffer:Pointer;const aSize:TPasRISCVInt64):TPasRISCVInt64;
var de:Pdirent;
    len,pos,name_len:TPasRISCVSizeInt;
    qid_type,dtype:TPasRISCVUInt8;
    StatData:TStat;
    Path:TPasRISCVRawByteString;
    Offset:TPasRISCVUInt64;
    Skip:TPasRISCVInt32;
begin
 if (not aFile.fIsOpened) or (not aFile.fIsDirectory) then begin
  result:=-P9_EPROTO;
 end else begin
  result:=0;
  { if aOffset=0 then begin
   RewindDir(aFile.fDirectory);
  end else begin
   SeekDir(aFile.fDirectory,aOffset);
  end;}
  //SeekDir(aFile.fDirectory,aOffset);
  // TellDir/SeekDir is broken on many Linux filesystems (returns LONG_MAX for all
  // entries), so we use simple index-based offsets instead: rewind to start and skip.
  SeekDir(aFile.fDirectory,0);
  Skip:=TPasRISCVInt32(aOffset);
  while Skip>0 do begin
   de:=fpReadDir(aFile.fDirectory^);
   if not assigned(de) then begin
    exit;
   end;
   dec(Skip);
  end;
  Offset:=aOffset;
  pos:=0;
  repeat
   de:=fpReadDir(aFile.fDirectory^);
   if assigned(de) then begin
    name_len:=StrLen(de^.d_name);
    Len:=13+8+1+2+name_len;
    if (pos+len)<=aSize then begin
     inc(Offset);
     qid_type:=P9_QTFILE;
     dtype:=DT_REG;
     if de^.d_type=DT_UNKNOWN then begin
      Path:=ComposePath(aFile.fPath,de^.d_name);
      if fpLStat(PAnsiChar(Path),@StatData)=0 then begin
       case StatData.st_mode and S_IFMT of
        S_IFDIR:begin
         qid_type:=P9_QTDIR;
         dtype:=DT_DIR;
        end;
        S_IFLNK:begin
         qid_type:=P9_QTSYMLINK;
         dtype:=DT_LNK;
        end;
        S_IFREG:begin
         qid_type:=P9_QTFILE;
         dtype:=DT_REG;
        end;
        S_IFBLK:begin
         qid_type:=P9_QTFILE;
         dtype:=DT_BLK;
        end;
        S_IFCHR:begin
         qid_type:=P9_QTFILE;
         dtype:=DT_CHR;
        end;
        S_IFIFO:begin
         qid_type:=P9_QTFILE;
         dtype:=DT_FIFO;
        end;
        S_IFSOCK:begin
         qid_type:=P9_QTFILE;
         dtype:=DT_SOCK;
        end;
       end;
      end;
     end else begin
      case de^.d_type of
       DT_DIR:begin
        qid_type:=P9_QTDIR;
        dtype:=DT_DIR;
       end;
       DT_LNK:begin
        qid_type:=P9_QTSYMLINK;
        dtype:=DT_LNK;
       end;
       DT_REG:begin
        qid_type:=P9_QTFILE;
        dtype:=DT_REG;
       end;
       DT_BLK:begin
        qid_type:=P9_QTFILE;
        dtype:=DT_BLK;
       end;
       DT_CHR:begin
        qid_type:=P9_QTFILE;
        dtype:=DT_CHR;
       end;
       DT_FIFO:begin
        qid_type:=P9_QTFILE;
        dtype:=DT_FIFO;
       end;
       DT_SOCK:begin
        qid_type:=P9_QTFILE;
        dtype:=DT_SOCK;
       end;
       else begin
        qid_type:=P9_QTFILE;
        dtype:=DT_UNKNOWN;
       end;
      end;
     end;
     PPasRISCVUInt8Array(aBuffer)^[pos]:=qid_type; inc(pos);
     PPasRISCVUInt32(@PPasRISCVUInt8Array(aBuffer)^[pos])^:=0; inc(pos,SizeOf(TPasRISCVUInt32));
     PPasRISCVUInt64(@PPasRISCVUInt8Array(aBuffer)^[pos])^:=de^.d_fileno; inc(pos,SizeOf(TPasRISCVUInt64));
     PPasRISCVUInt64(@PPasRISCVUInt8Array(aBuffer)^[pos])^:=Offset; inc(pos,SizeOf(TPasRISCVUInt64));
     PPasRISCVUInt8Array(aBuffer)^[pos]:=dtype; inc(pos);
     PPasRISCVUInt16(@PPasRISCVUInt8Array(aBuffer)^[pos])^:=name_len; inc(pos,SizeOf(TPasRISCVUInt16));
     Move(de^.d_name,PPasRISCVUInt8Array(aBuffer)^[pos],name_len); inc(pos,name_len);
    end else begin
     break;
    end;
   end else begin
    break;
   end;
  until false;
  result:=pos;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.Read(const aFile:TPasRISCV9PFileSystem.TFSFile;const aOffset:TPasRISCVUInt64;const aBuffer:Pointer;const aSize:TPasRISCVInt64):TPasRISCVInt64;
begin
 if (not aFile.fIsOpened) or (aFile.fIsDirectory) then begin
  result:=-P9_EPROTO;
 end else begin
  result:=fpPRead(aFile.fFile,aBuffer,aSize,aOffset);
  if result<0 then begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
  end;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.Write(const aFile:TPasRISCV9PFileSystem.TFSFile;const aOffset:TPasRISCVUInt64;const aBuffer:Pointer;const aSize:TPasRISCVInt64):TPasRISCVInt64;
begin
 if (not aFile.fIsOpened) or (aFile.fIsDirectory) then begin
  result:=-P9_EPROTO;
 end else begin
  result:=fpPWrite(aFile.fFile,aBuffer,aSize,aOffset);
  if result<0 then begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
  end;
 end;
end;

procedure TPasRISCV9PFileSystemPOSIX.Close(const aFile:TPasRISCV9PFileSystem.TFSFile);
begin
 if aFile.fIsOpened then begin
  if aFile.fIsDirectory then begin
   fpCloseDir(aFile.fDirectory^);
  end else begin
   fpClose(aFile.fFile);
  end;
  aFile.fIsOpened:=false;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.Stat(const aFile:TPasRISCV9PFileSystem.TFSFile;out aStat:TPasRISCV9PFileSystem.TFSStat):TPasRISCVInt32;
var StatData:TStat;
begin
 if fpLStat(PAnsiChar(aFile.fPath),@StatData)=0 then begin
  StatToQID(@aStat.qid,@StatData);
  aStat.Mode:=StatData.st_mode;
  aStat.UID:=StatData.st_uid;
  aStat.GID:=StatData.st_gid;
  aStat.NLink:=StatData.st_nlink;
  aStat.RDev:=StatData.st_rdev;
  aStat.Size:=StatData.st_size;
  aStat.BlkSize:=StatData.st_blksize;
  aStat.Blocks:=StatData.st_blocks;
  aStat.ATimeSec:=StatData.st_atime;
  aStat.ATimeNSec:=StatData.st_atime_nsec;
  aStat.MTimeSec:=StatData.st_mtime;
  aStat.MTimeNSec:=StatData.st_mtime_nsec;
  aStat.CTimeSec:=StatData.st_ctime;
  aStat.CTimeNSec:=StatData.st_ctime_nsec;
  result:=0;
 end else begin
  result:=-P9_ENOENT;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.SetAttr(const aFile:TPasRISCV9PFileSystem.TFSFile;const aMask,aMode,aUID,aGID:TPasRISCVUInt32;const aSize,aATimeSec,aATimeNSec,aMTimeSec,aMTimeNSec,aCTimeSec,aCTimeNSec:TPasRISCVUInt64):TPasRISCVInt32;
var //StatData:TStat;
    ts:tkernel_timespecs;
    ctime_updated:boolean;
    UID,GID:TPasRISCVInt32;
    fd:cint;
begin

 if (aMask and (P9_SETATTR_UID or P9_SETATTR_GID))<>0 then begin
  if (aMask and P9_SETATTR_UID)<>0 then begin
   UID:=aUID;
  end else begin
   UID:=-1;
  end;
  if (aMask and P9_SETATTR_GID)<>0 then begin
   GID:=aGID;
  end else begin
   GID:=-1;
  end;
  if LChOwn(PAnsiChar(aFile.fPath),UID,GID)<0 then begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
   exit;
  end;
  ctime_updated:=true;
 end else begin
  ctime_updated:=false;
 end;

 if (aMask and P9_SETATTR_MODE)<>0 then begin
  if fpChMod(PAnsiChar(aFile.fPath),aMode)<0 then begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
   exit;
  end;
  ctime_updated:=true;
 end;

 if (aMask and P9_SETATTR_SIZE)<>0 then begin
  if aFile.fIsOpened then begin
   if fpFTruncate(aFile.fFile,aSize)<0 then begin
    result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
    exit;
   end;
  end else begin
   fd:=fpOpen(PAnsiChar(aFile.fPath),O_WRONLY);
   if fd<0 then begin
    result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
    exit;
   end;
   if fpFTruncate(fd,aSize)<0 then begin
    fpClose(fd);
    result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
    exit;
   end;
   fpClose(fd);
  end;
{if fpTruncate(PAnsiChar(aFile.fPath),aSize)<0 then begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
   exit;
  end;}
  ctime_updated:=true;
 end;

 if (aMask and (P9_SETATTR_ATIME or P9_SETATTR_MTIME))<>0 then begin
  if (aMask and P9_SETATTR_ATIME)<>0 then begin
   if (aMask and P9_SETATTR_ATIME_SET)<>0 then begin
    ts[0].tv_sec:=aATimeSec;
    ts[0].tv_nsec:=aATimeNSec;
   end else begin
    ts[0].tv_sec:=0;
    ts[0].tv_nsec:=UTIME_NOW;
   end;
  end else begin
   ts[0].tv_sec:=0;
   ts[0].tv_nsec:=UTIME_OMIT;
  end;
  if (aMask and P9_SETATTR_MTIME)<>0 then begin
   if (aMask and P9_SETATTR_MTIME_SET)<>0 then begin
    ts[1].tv_sec:=aMTimeSec;
    ts[1].tv_nsec:=aMTimeNSec;
   end else begin
    ts[1].tv_sec:=0;
    ts[1].tv_nsec:=UTIME_NOW;
   end;
  end else begin
   ts[1].tv_sec:=0;
   ts[1].tv_nsec:=UTIME_OMIT;
  end;
  if utimensat(AT_FDCWD,PAnsiChar(aFile.fPath),ts,AT_SYMLINK_NOFOLLOW)<0 then begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
   exit;
  end;
  ctime_updated:=true;
 end;

 if ((aMask and P9_SETATTR_CTIME)<>0) and not ctime_updated then begin
  if LChown(PAnsiChar(aFile.fPath),TUID(-1),TGID(-1))<0 then begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
   exit;
  end;
 end;

 result:=0;

end;

function TPasRISCV9PFileSystemPOSIX.Link(const aDestFile,aFile:TPasRISCV9PFileSystem.TFSFile;const aName:TPasRISCVRawByteString):TPasRISCVInt32;
var Path:TPasRISCVRawByteString;
begin
 Path:=ComposePath(aDestFile.fPath,aName);
 if fpLink(PAnsiChar(aFile.fPath),PAnsiChar(Path))<0 then begin
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end else begin
  result:=0;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.SymLink(const aQID:TPasRISCV9PFileSystem.PFSQID;const aFile:TPasRISCV9PFileSystem.TFSFile;const aName,aTarget:TPasRISCVRawByteString;const aGID:TPasRISCVUInt32):TPasRISCVInt32;
var Path:TPasRISCVRawByteString;
    StatData:TStat;
begin
 Path:=ComposePath(aFile.fPath,aName);
 if fpSymLink(PAnsiChar(aTarget),PAnsiChar(Path))<0 then begin
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end else begin
  if fpLStat(PAnsiChar(Path),@StatData)=0 then begin
   StatToQID(aQID,@StatData);
   result:=0;
  end else begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
  end;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.MkNod(const aQID:TPasRISCV9PFileSystem.PFSQID;const aFile:TPasRISCV9PFileSystem.TFSFile;const aName:TPasRISCVRawByteString;const aMode,aMajor,aMinor,aGID:TPasRISCVUInt32):TPasRISCVInt32;
var NodeMode:TPasRISCVUInt32;
    Path:TPasRISCVRawByteString;
    StatData:TStat;
begin
 Path:=ComposePath(aFile.fPath,aName);
 NodeMode:=aMode and (P9_S_IFMT or P9_S_IRWXUGO or P9_S_ISUID or P9_S_ISGID or P9_S_ISVTX);
 if MkNod_(PAnsiChar(Path),NodeMode,((aMajor and $fff) shl 8) or (aMinor and $ff))<0 then begin
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end else begin
  fpChmod(PAnsiChar(Path),NodeMode and (P9_S_IRWXUGO or P9_S_ISUID or P9_S_ISGID or P9_S_ISVTX));
  if fpLStat(PAnsiChar(Path),@StatData)=0 then begin
   StatToQID(aQID,@StatData);
   result:=0;
  end else begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
  end;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.ReadLink(const aBuffer:Pointer;const aSize:TPasRISCVInt64;const aFile:TPasRISCV9PFileSystem.TFSFile):TPasRISCVInt64;
begin
 result:=fpReadLink(PAnsiChar(aFile.fPath),aBuffer,aSize-1);
 if result<0 then begin
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end else begin
  PPasRISCVUInt8Array(aBuffer)^[result]:=0;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.RenameAt(const aFile:TPasRISCV9PFileSystem.TFSFile;const aName:TPasRISCVRawByteString;const aNewFile:TPasRISCV9PFileSystem.TFSFile;const aNewName:TPasRISCVRawByteString):TPasRISCVInt32;
var Path,NewPath:TPasRISCVRawByteString;
begin
 Path:=ComposePath(aFile.fPath,aName);
 NewPath:=ComposePath(aNewFile.fPath,aNewName);
 if fpRename(PAnsiChar(Path),PAnsiChar(NewPath))<0 then begin
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end else begin
  result:=0;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.UnlinkAt(const aFile:TPasRISCV9PFileSystem.TFSFile;const aName:TPasRISCVRawByteString):TPasRISCVInt32;
var Path:TPasRISCVRawByteString;
begin
 Path:=ComposePath(aFile.fPath,aName);
 if Remove_(PAnsiChar(Path))<0 then begin
  result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
 end else begin
  result:=0;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.Lock(const aFile:TPasRISCV9PFileSystem.TFSFile;const aLock:TPasRISCV9PFileSystem.PFSLock):TPasRISCVInt32;
var fl:FLock;
    errno:cint;
begin
 if (not aFile.fIsOpened) or (aFile.fIsDirectory) then begin
  result:=-P9_EPROTO;
 end else begin
  fl.l_type:=aLock^.Type_;
  fl.l_whence:=SEEK_SET;
  fl.l_start:=aLock^.Start;
  fl.l_len:=aLock^.Length;
  if fpFcntl(aFile.fFile,F_SETLK,fl)=0 then begin
   result:=P9_LOCK_SUCCESS;
  end else begin
   errno:=fpGetErrNo;
   if (errno=ESysEAGAIN) or (errno=ESysEACCES) then begin
    result:=P9_LOCK_BLOCKED;
   end else begin
    result:=-POSIXErrorCodeToP9ErrorCode(errno);
   end;
  end;
 end;
end;

function TPasRISCV9PFileSystemPOSIX.GetLock(const aFile:TPasRISCV9PFileSystem.TFSFile;const aLock:TPasRISCV9PFileSystem.PFSLock):TPasRISCVInt32;
var fl:Flock;
begin
 if (not aFile.fIsOpened) or (aFile.fIsDirectory) then begin
  result:=-P9_EPROTO;
 end else begin
  fl.l_type:=aLock^.Type_;
  fl.l_whence:=SEEK_SET;
  fl.l_start:=aLock^.Start;
  fl.l_len:=aLock^.Length;
  if fpFcntl(aFile.fFile,F_GETLK,fl)=0 then begin
   aLock^.Type_:=fl.l_type;
   aLock^.Start:=fl.l_start;
   aLock^.Length:=fl.l_len;
   result:=0;
  end else begin
   result:=-POSIXErrorCodeToP9ErrorCode(fpGetErrNo);
  end;
 end;
end;

{$elseif defined(Windows)}

// Reads WSL-compatible POSIX metadata extended attributes ($LXUID/$LXGID/$LXMOD/$LXDEV) from an
// already-open file handle (which must grant FILE_READ_EA; GENERIC_READ implies it). Returns true
// if at least one of the EAs was present; each out value is only meaningful when its matching aHas*
// flag is true. $LXMOD carries the full POSIX st_mode (including the file-type bits), like WSL/DrvFs.
// Shared by the VirtIO 9P and VirtIO FS Windows back-ends.
function PasRISCVWindowsReadPosixMetaEA(const aHandle:THandle;
                                        out aHasMode:boolean;out aMode:TPasRISCVUInt32;
                                        out aHasUID:boolean;out aUID:TPasRISCVUInt32;
                                        out aHasGID:boolean;out aGID:TPasRISCVUInt32;
                                        out aHasDev:boolean;out aDev:TPasRISCVUInt64):boolean;
var Buffer:array[0..1023] of TPasRISCVUInt8;
    IoStatusBlock:TPasRISCVIoStatusBlock;
    Status:LONG;
    Index,NameOffset,ValueOffset,NameLength,ValueLength,CharIndex:TPasRISCVSizeInt;
    Entry:PPasRISCVFileFullEaInformation;
    Name:TPasRISCVRawByteString;
    NextEntryOffset,ValueUInt32:TPasRISCVUInt32;
    ValueUInt64:TPasRISCVUInt64;
begin

 result:=false;

 aHasMode:=false;
 aMode:=0;

 aHasUID:=false;
 aUID:=0;

 aHasGID:=false;
 aGID:=0;

 aHasDev:=false;
 aDev:=0;

 if (not PasRISCVWindowsPosixMetaEAAvailable) or (aHandle=INVALID_HANDLE_VALUE) then begin
  exit;
 end;

 IoStatusBlock.Status:=0;
 IoStatusBlock.Information:=0;

 // ReturnSingleEntry=false, EaList=nil, EaIndex=nil, RestartScan=true => return all EAs at once
 Status:=NtQueryEaFile(aHandle,IoStatusBlock,@Buffer[0],ULONG(SizeOf(Buffer)),ByteBool(false),nil,0,nil,ByteBool(true));
 if Status<>PasRISCVWinSTATUS_SUCCESS then begin
  exit; // STATUS_NO_EAS_ON_FILE or any error => no metadata; caller keeps its synthetic values
 end;

 Index:=0;

 while (Index+TPasRISCVSizeInt(SizeOf(TPasRISCVFileFullEaInformation)))<=TPasRISCVSizeInt(SizeOf(Buffer)) do begin

  Entry:=PPasRISCVFileFullEaInformation(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@Buffer[0])+TPasRISCVPtrUInt(Index))));

  NameLength:=Entry^.EaNameLength;

  ValueLength:=Entry^.EaValueLength;

  NextEntryOffset:=Entry^.NextEntryOffset;

  NameOffset:=Index+TPasRISCVSizeInt(SizeOf(TPasRISCVFileFullEaInformation));

  ValueOffset:=NameOffset+NameLength+1; // skip the name plus its terminating #0

  if (NameLength>0) and ((ValueOffset+ValueLength)<=TPasRISCVSizeInt(SizeOf(Buffer))) then begin

   SetLength(Name,NameLength);

   Move(Buffer[NameOffset],Name[1],NameLength);

   for CharIndex:=1 to NameLength do begin // EA names are case-insensitive; uppercase ASCII for comparison
    if (Name[CharIndex]>='a') and (Name[CharIndex]<='z') then begin
     Name[CharIndex]:=TPasRISCVRawByteChar(TPasRISCVUInt8(TPasRISCVUInt8(ord(Name[CharIndex]))-TPasRISCVUInt8(32)));
    end;
   end;

   ValueUInt32:=0;
   if ValueLength>=4 then begin
    Move(Buffer[ValueOffset],ValueUInt32,4); // little-endian on all supported targets
   end;

   ValueUInt64:=0;
   if ValueLength>=8 then begin
    Move(Buffer[ValueOffset],ValueUInt64,8);
   end else begin
    ValueUInt64:=ValueUInt32;
   end;

   if Name=PasRISCVWinEAName_LXMOD then begin
    if ValueLength>=4 then begin
     aMode:=ValueUInt32;
     aHasMode:=true;
    end;
   end else if Name=PasRISCVWinEAName_LXUID then begin
    if ValueLength>=4 then begin
     aUID:=ValueUInt32;
     aHasUID:=true;
    end;
   end else if Name=PasRISCVWinEAName_LXGID then begin
    if ValueLength>=4 then begin
     aGID:=ValueUInt32;
     aHasGID:=true;
    end;
   end else if Name=PasRISCVWinEAName_LXDEV then begin
    aDev:=ValueUInt64;
    aHasDev:=true;
   end;
  end;

  if NextEntryOffset=0 then begin
   break;
  end;

  inc(Index,TPasRISCVSizeInt(NextEntryOffset));
  if Index<=0 then begin
   break; // guard against malformed offsets
  end;

 end;

 result:=aHasMode or aHasUID or aHasGID or aHasDev;

end;

// Writes the requested WSL-compatible POSIX metadata EAs to an already-open handle (which must grant
// FILE_WRITE_EA). Only the EAs whose aSet* flag is true are written. The FILE_FULL_EA_INFORMATION
// entries are built into a byte buffer with packed-record casts + Move (no pointer arithmetic beyond
// the project's Pointer(TPasRISCVPtrUInt(...)) idiom, no {$POINTERMATH ON}). Returns true on success.
function PasRISCVWindowsWritePosixMetaEA(const aHandle:THandle;
                                         const aSetMode:boolean;const aMode:TPasRISCVUInt32;
                                         const aSetUID:boolean;const aUID:TPasRISCVUInt32;
                                         const aSetGID:boolean;const aGID:TPasRISCVUInt32;
                                         const aSetDev:boolean;const aDev:TPasRISCVUInt64):boolean;
var Buffer:array[0..255] of TPasRISCVUInt8;
    Cursor,PreviousEntryStart,Count:TPasRISCVSizeInt;
    IoStatusBlock:TPasRISCVIoStatusBlock;
    Status:LONG;
    ModeValue,UIDValue,GIDValue:TPasRISCVUInt32;
    DeviceValue:TPasRISCVUInt64;
 procedure AppendEA(const aName:TPasRISCVRawByteString;const aValuePointer:Pointer;const aValueLength:TPasRISCVSizeInt);
 var NameLength,EntryStart,HeaderSize:TPasRISCVSizeInt;
     Entry:PPasRISCVFileFullEaInformation;
 begin

  HeaderSize:=TPasRISCVSizeInt(SizeOf(TPasRISCVFileFullEaInformation));

  NameLength:=Length(aName);

  EntryStart:=(Cursor+3) and not TPasRISCVSizeInt(3); // entries must start 4-byte aligned

  if EntryStart>Cursor then begin
   FillChar(Buffer[Cursor],EntryStart-Cursor,#0);
  end;

  if (EntryStart+HeaderSize+NameLength+1+aValueLength)>TPasRISCVSizeInt(SizeOf(Buffer)) then begin
   exit; // defensive: never happens for our tiny fixed EAs
  end;

  if PreviousEntryStart>=0 then begin // patch the previous entry to point here
   Entry:=PPasRISCVFileFullEaInformation(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@Buffer[0])+TPasRISCVPtrUInt(PreviousEntryStart))));
   Entry^.NextEntryOffset:=TPasRISCVUInt32(EntryStart-PreviousEntryStart);
  end;

  Entry:=PPasRISCVFileFullEaInformation(Pointer(TPasRISCVPtrUInt(TPasRISCVPtrUInt(@Buffer[0])+TPasRISCVPtrUInt(EntryStart))));
  Entry^.NextEntryOffset:=0; // last entry for now
  Entry^.Flags:=0;
  Entry^.EaNameLength:=TPasRISCVUInt8(NameLength);
  Entry^.EaValueLength:=TPasRISCVUInt16(aValueLength);

  Move(aName[1],Buffer[EntryStart+HeaderSize],NameLength);

  Buffer[EntryStart+HeaderSize+NameLength]:=0; // terminating #0

  if aValueLength>0 then begin
   Move(aValuePointer^,Buffer[EntryStart+HeaderSize+NameLength+1],aValueLength);
  end;

  Cursor:=EntryStart+HeaderSize+NameLength+1+aValueLength;

  PreviousEntryStart:=EntryStart;

  inc(Count);

 end;
begin

 result:=false;

 if (not PasRISCVWindowsPosixMetaEAAvailable) or (aHandle=INVALID_HANDLE_VALUE) then begin
  exit;
 end;

 if not (aSetMode or aSetUID or aSetGID or aSetDev) then begin
  result:=true; // nothing requested
  exit;
 end;

 Cursor:=0;

 PreviousEntryStart:=-1;

 Count:=0;

 if aSetMode then begin
  ModeValue:=aMode;
  AppendEA(PasRISCVWinEAName_LXMOD,@ModeValue,4);
 end;

 if aSetUID then begin
  UIDValue:=aUID;
  AppendEA(PasRISCVWinEAName_LXUID,@UIDValue,4);
 end;

 if aSetGID then begin
  GIDValue:=aGID;
  AppendEA(PasRISCVWinEAName_LXGID,@GIDValue,4);
 end;

 if aSetDev then begin
  DeviceValue:=aDev;
  AppendEA(PasRISCVWinEAName_LXDEV,@DeviceValue,8);
 end;

 if Count=0 then begin
  result:=true;
  exit;
 end;

 IoStatusBlock.Status:=0;
 IoStatusBlock.Information:=0;
 Status:=NtSetEaFile(aHandle,IoStatusBlock,@Buffer[0],ULONG(Cursor));

 result:=Status=PasRISCVWinSTATUS_SUCCESS;

end;

// kernel32 imports bound with uniform pointer signatures, sidestepping the Delphi (var/typed) vs
// FreePascal (LPDWORD/Pointer) parameter differences for these functions (same idea as the existing
// CreateHardLinkA / GetFinalPathNameByHandleA externals further below).
function PasRISCVWinDeviceIoControl(hDevice:THandle;dwIoControlCode:DWORD;lpInBuffer:Pointer;nInBufferSize:DWORD;lpOutBuffer:Pointer;nOutBufferSize:DWORD;lpBytesReturned:Pointer;lpOverlapped:Pointer):BOOL; {$ifdef cpu386}stdcall;{$endif} external 'kernel32.dll' name 'DeviceIoControl';
function PasRISCVWinReadFile(hFile:THandle;lpBuffer:Pointer;nNumberOfBytesToRead:DWORD;lpNumberOfBytesRead:Pointer;lpOverlapped:Pointer):BOOL; {$ifdef cpu386}stdcall;{$endif} external 'kernel32.dll' name 'ReadFile';
function PasRISCVWinWriteFile(hFile:THandle;lpBuffer:Pointer;nNumberOfBytesToWrite:DWORD;lpNumberOfBytesWritten:Pointer;lpOverlapped:Pointer):BOOL; {$ifdef cpu386}stdcall;{$endif} external 'kernel32.dll' name 'WriteFile';

// --- Sidecar metadata fallback (QEMU mapped-file style) for filesystems without extended-attribute
// support (FAT/exFAT/network shares). Metadata lives in a hidden ".pasriscv_meta" subdirectory next
// to each file, one text file per entry with "mode=/uid=/gid=/dev=" lines. Used only when the EA
// path is unavailable; the subdirectory is hidden from the guest in ReadDir. ---

// Returns the sidecar metadata file path for aPath and, via aMetaDir, the hidden directory holding it.
function PasRISCVWindowsSidecarMetaPath(const aPath:TPasRISCVRawByteString;
                                        out aMetaDir:TPasRISCVRawByteString):TPasRISCVRawByteString;
var SeparatorPosition,CharIndex:TPasRISCVSizeInt;
    Directory,Name:TPasRISCVRawByteString;
begin

 SeparatorPosition:=0;
 for CharIndex:=length(aPath) downto 1 do begin
  if (aPath[CharIndex]='\') or (aPath[CharIndex]='/') then begin
   SeparatorPosition:=CharIndex;
   break;
  end;
 end;

 if SeparatorPosition>0 then begin
  Directory:=Copy(aPath,1,SeparatorPosition); // keeps the trailing separator
  Name:=Copy(aPath,SeparatorPosition+1,length(aPath)-SeparatorPosition);
 end else begin
  Directory:='';
  Name:=aPath;
 end;

 aMetaDir:=Directory+'.pasriscv_meta';

 result:=aMetaDir+'\'+Name;

end;

// True if aName is the reserved sidecar directory name, so ReadDir can hide it from the guest.
function PasRISCVWindowsIsSidecarName(const aName:TPasRISCVRawByteString):boolean;
begin
 result:=aName='.pasriscv_meta';
end;

// Parses the unsigned decimal value of the "aKey=" line from the sidecar text (one key=value pair
// per line, '\n' or '\r' terminated). Hand-rolled to avoid the TStringList overhead.
function PasRISCVWindowsParseMetaValue(const aText,aKey:TPasRISCVRawByteString;out aValue:TPasRISCVUInt64):boolean;
var TextLength,KeyLength,LineStart,LineEnd,EqualPosition,CharIndex:TPasRISCVSizeInt;
    Matches:boolean;
begin

 result:=false;

 aValue:=0;

 TextLength:=length(aText);

 KeyLength:=length(aKey);

 LineStart:=1;

 while LineStart<=TextLength do begin

  LineEnd:=LineStart;
  while (LineEnd<=TextLength) and (aText[LineEnd]<>#10) and (aText[LineEnd]<>#13) do begin
   inc(LineEnd);
  end;

  EqualPosition:=LineStart;
  while (EqualPosition<LineEnd) and (aText[EqualPosition]<>'=') do begin
   inc(EqualPosition);
  end;

  if (EqualPosition<LineEnd) and ((EqualPosition-LineStart)=KeyLength) then begin

   Matches:=true;

   for CharIndex:=0 to KeyLength-1 do begin
    if aText[LineStart+CharIndex]<>aKey[1+CharIndex] then begin
     Matches:=false;
     break;
    end;
   end;

   if Matches then begin

    for CharIndex:=EqualPosition+1 to LineEnd-1 do begin
     if (aText[CharIndex]>='0') and (aText[CharIndex]<='9') then begin
      aValue:=(aValue*10)+TPasRISCVUInt64(TPasRISCVUInt8(ord(aText[CharIndex])-ord('0')));
     end;
    end;

    result:=true;

    exit;

   end;

  end;

  LineStart:=LineEnd;

  while (LineStart<=TextLength) and ((aText[LineStart]=#10) or (aText[LineStart]=#13)) do begin
   inc(LineStart);
  end;

 end;

end;

function PasRISCVWindowsReadPosixMetaSidecar(const aPath:TPasRISCVRawByteString;
                                             out aHasMode:boolean;out aMode:TPasRISCVUInt32;
                                             out aHasUID:boolean;out aUID:TPasRISCVUInt32;
                                             out aHasGID:boolean;out aGID:TPasRISCVUInt32;
                                             out aHasDev:boolean;out aDev:TPasRISCVUInt64):boolean;
var Handle:THandle;
    Buffer:array[0..1023] of AnsiChar;
    BytesRead:DWORD;
    Text,MetaDirectory,SidecarFileName:TPasRISCVRawByteString;
    ParsedValue:TPasRISCVUInt64;
begin

 result:=false;

 aHasMode:=false;
 aMode:=0;

 aHasUID:=false;
 aUID:=0;

 aHasGID:=false;
 aGID:=0;

 aHasDev:=false;
 aDev:=0;

 SidecarFileName:=PasRISCVWindowsSidecarMetaPath(aPath,MetaDirectory);
 Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(SidecarFileName)),
                             GENERIC_READ,
                             FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                             nil,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,0);
 if Handle=INVALID_HANDLE_VALUE then begin
  exit;
 end;
 Text:='';
 try
  BytesRead:=0;
  if PasRISCVWinReadFile(Handle,@Buffer[0],DWORD(SizeOf(Buffer)),@BytesRead,nil) and (BytesRead>0) then begin
   SetLength(Text,BytesRead);
   Move(Buffer[0],Text[1],BytesRead);
  end;
 finally
  Windows.CloseHandle(Handle);
 end;

 if PasRISCVWindowsParseMetaValue(Text,'mode',ParsedValue) then begin
  aMode:=TPasRISCVUInt32(ParsedValue);
  aHasMode:=true;
 end;
 if PasRISCVWindowsParseMetaValue(Text,'uid',ParsedValue) then begin
  aUID:=TPasRISCVUInt32(ParsedValue);
  aHasUID:=true;
 end;
 if PasRISCVWindowsParseMetaValue(Text,'gid',ParsedValue) then begin
  aGID:=TPasRISCVUInt32(ParsedValue);
  aHasGID:=true;
 end;
 if PasRISCVWindowsParseMetaValue(Text,'dev',ParsedValue) then begin
  aDev:=ParsedValue;
  aHasDev:=true;
 end;

 result:=aHasMode or aHasUID or aHasGID or aHasDev;

end;

function PasRISCVWindowsWritePosixMetaSidecar(const aPath:TPasRISCVRawByteString;
                                              const aSetMode:boolean;const aMode:TPasRISCVUInt32;
                                              const aSetUID:boolean;const aUID:TPasRISCVUInt32;
                                              const aSetGID:boolean;const aGID:TPasRISCVUInt32;
                                              const aSetDev:boolean;const aDev:TPasRISCVUInt64):boolean;
var Handle:THandle;
    HasMode,HasUID,HasGID,HasDev:boolean;
    ModeValue,UIDValue,GIDValue:TPasRISCVUInt32;
    DeviceValue:TPasRISCVUInt64;
    Text,MetaDirectory,SidecarFileName:TPasRISCVRawByteString;
    BytesWritten:DWORD;
begin

 result:=false;

 // read-modify-write: preserve the fields that are not being changed
 PasRISCVWindowsReadPosixMetaSidecar(aPath,HasMode,ModeValue,HasUID,UIDValue,HasGID,GIDValue,HasDev,DeviceValue);
 if aSetMode then begin
  HasMode:=true;
  ModeValue:=aMode;
 end;
 if aSetUID then begin
  HasUID:=true;
  UIDValue:=aUID;
 end;
 if aSetGID then begin
  HasGID:=true;
  GIDValue:=aGID;
 end;
 if aSetDev then begin
  HasDev:=true;
  DeviceValue:=aDev;
 end;

 Text:='';
 if HasMode then begin
  Text:=Text+'mode='+IntToStr(Int64(ModeValue))+#10;
 end;
 if HasUID then begin
  Text:=Text+'uid='+IntToStr(Int64(UIDValue))+#10;
 end;
 if HasGID then begin
  Text:=Text+'gid='+IntToStr(Int64(GIDValue))+#10;
 end;
 if HasDev then begin
  Text:=Text+'dev='+IntToStr(Int64(DeviceValue))+#10;
 end;

 SidecarFileName:=PasRISCVWindowsSidecarMetaPath(aPath,MetaDirectory);
 CreateDirectoryA(PAnsiChar(RawByteString(MetaDirectory)),nil); // ignore failure (already exists)
 SetFileAttributesA(PAnsiChar(RawByteString(MetaDirectory)),FILE_ATTRIBUTE_HIDDEN or FILE_ATTRIBUTE_SYSTEM);

 Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(SidecarFileName)),
                             GENERIC_WRITE,
                             FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                             nil,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,0);
 if Handle=INVALID_HANDLE_VALUE then begin
  exit;
 end;
 try
  BytesWritten:=0;
  if length(Text)>0 then begin
   PasRISCVWinWriteFile(Handle,@Text[1],DWORD(length(Text)),@BytesWritten,nil);
  end;
  result:=true;
 finally
  Windows.CloseHandle(Handle);
 end;
end;

procedure PasRISCVWindowsDeleteSidecar(const aPath:TPasRISCVRawByteString);
var MetaDirectory,SidecarFileName:TPasRISCVRawByteString;
begin
 SidecarFileName:=PasRISCVWindowsSidecarMetaPath(aPath,MetaDirectory);
 DeleteFileA(PAnsiChar(RawByteString(SidecarFileName))); // best-effort; ignore failure
end;

procedure PasRISCVWindowsRenameSidecar(const aOldPath,aNewPath:TPasRISCVRawByteString);
var OldMetaDirectory,OldSidecarFileName,NewMetaDirectory,NewSidecarFileName:TPasRISCVRawByteString;
begin
 OldSidecarFileName:=PasRISCVWindowsSidecarMetaPath(aOldPath,OldMetaDirectory);
 if FileExists(String(OldSidecarFileName)) then begin
  NewSidecarFileName:=PasRISCVWindowsSidecarMetaPath(aNewPath,NewMetaDirectory);
  CreateDirectoryA(PAnsiChar(RawByteString(NewMetaDirectory)),nil);
  SetFileAttributesA(PAnsiChar(RawByteString(NewMetaDirectory)),FILE_ATTRIBUTE_HIDDEN or FILE_ATTRIBUTE_SYSTEM);
  MoveFileExA(PAnsiChar(RawByteString(OldSidecarFileName)),PAnsiChar(RawByteString(NewSidecarFileName)),MOVEFILE_REPLACE_EXISTING);
 end;
end;

// Reads POSIX metadata for aPath: extended attributes first (when available), then the sidecar.
function PasRISCVWindowsReadPosixMeta(const aMetadataMode:TPasRISCVPosixMetadataMode;
                                      const aPath:TPasRISCVRawByteString;
                                      out aHasMode:boolean;out aMode:TPasRISCVUInt32;
                                      out aHasUID:boolean;out aUID:TPasRISCVUInt32;
                                      out aHasGID:boolean;out aGID:TPasRISCVUInt32;
                                      out aHasDev:boolean;out aDev:TPasRISCVUInt64):boolean;
var Handle:THandle;
begin

 result:=false;

 aHasMode:=false;
 aMode:=0;

 aHasUID:=false;
 aUID:=0;

 aHasGID:=false;
 aGID:=0;

 aHasDev:=false;
 aDev:=0;

 if aMetadataMode=TPasRISCVPosixMetadataMode.None then begin
  exit;
 end;

 // Native mode prefers the host-native extended attributes; SideCar mode skips them.
 if (aMetadataMode=TPasRISCVPosixMetadataMode.Native) and PasRISCVWindowsPosixMetaEAAvailable then begin
  Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(aPath)),
                              DWORD(PasRISCVWinFILE_READ_EA),
                              FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                              nil,OPEN_EXISTING,
                              DWORD(PasRISCVWinFILE_FLAG_BACKUP_SEMANTICS) or DWORD(PasRISCVWinFILE_FLAG_OPEN_REPARSE_POINT),
                              0);
  if Handle<>INVALID_HANDLE_VALUE then begin
   try
    result:=PasRISCVWindowsReadPosixMetaEA(Handle,aHasMode,aMode,aHasUID,aUID,aHasGID,aGID,aHasDev,aDev);
   finally
    Windows.CloseHandle(Handle);
   end;
  end;
 end;

 // SideCar mode, or the Native auto-fallback when no native metadata was found.
 if not result then begin
  result:=PasRISCVWindowsReadPosixMetaSidecar(aPath,aHasMode,aMode,aHasUID,aUID,aHasGID,aGID,aHasDev,aDev);
 end;

end;

// Writes the requested $LX* metadata to aPath: extended attributes when available, otherwise the
// sidecar fallback. Best-effort. Used by chmod/chown and special-file creation.
function PasRISCVWindowsWriteMetaEAByPath(const aMetadataMode:TPasRISCVPosixMetadataMode;
                                          const aPath:TPasRISCVRawByteString;
                                          const aSetMode:boolean;const aMode:TPasRISCVUInt32;
                                          const aSetUID:boolean;const aUID:TPasRISCVUInt32;
                                          const aSetGID:boolean;const aGID:TPasRISCVUInt32;
                                          const aSetDev:boolean;const aDev:TPasRISCVUInt64):boolean;
var Handle:THandle;
begin
 result:=false;
 if aMetadataMode=TPasRISCVPosixMetadataMode.None then begin
  exit;
 end;
 // Native mode writes the host-native extended attributes; SideCar mode skips them.
 if (aMetadataMode=TPasRISCVPosixMetadataMode.Native) and PasRISCVWindowsPosixMetaEAAvailable then begin
  Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(aPath)),
                              DWORD(PasRISCVWinFILE_WRITE_EA),
                              FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                              nil,OPEN_EXISTING,
                              DWORD(PasRISCVWinFILE_FLAG_BACKUP_SEMANTICS) or DWORD(PasRISCVWinFILE_FLAG_OPEN_REPARSE_POINT),
                              0);
  if Handle<>INVALID_HANDLE_VALUE then begin
   try
    result:=PasRISCVWindowsWritePosixMetaEA(Handle,aSetMode,aMode,aSetUID,aUID,aSetGID,aGID,aSetDev,aDev);
   finally
    Windows.CloseHandle(Handle);
   end;
  end;
 end;
 // SideCar mode, or the Native auto-fallback when the native write did not succeed.
 if not result then begin
  result:=PasRISCVWindowsWritePosixMetaSidecar(aPath,aSetMode,aMode,aSetUID,aUID,aSetGID,aGID,aSetDev,aDev);
 end;
end;

// chmod: persists the POSIX permission/special bits in $LXMOD (or sidecar) while preserving the
// file-type bits (read-modify-write). Best-effort.
function PasRISCVWindowsChmodEAByPath(const aMetadataMode:TPasRISCVPosixMetadataMode;const aPath:TPasRISCVRawByteString;const aMode:TPasRISCVUInt32):boolean;
var HasMode,HasUID,HasGID,HasDev:boolean;
    CurrentMode,IgnoredValue:TPasRISCVUInt32;
    IgnoredDevice:TPasRISCVUInt64;
    Attributes,TypeBits,NewMode:TPasRISCVUInt32;
begin
 if PasRISCVWindowsReadPosixMeta(aMetadataMode,aPath,HasMode,CurrentMode,HasUID,IgnoredValue,HasGID,IgnoredValue,HasDev,IgnoredDevice) and HasMode then begin
  TypeBits:=CurrentMode and TPasRISCVUInt32(PasRISCVWinLX_S_IFMT);
 end else begin
  Attributes:=GetFileAttributesA(PAnsiChar(RawByteString(aPath)));
  if (Attributes<>INVALID_FILE_ATTRIBUTES) and ((Attributes and FILE_ATTRIBUTE_DIRECTORY)<>0) then begin
   TypeBits:=TPasRISCVUInt32(PasRISCVWinLX_S_IFDIR);
  end else if (Attributes<>INVALID_FILE_ATTRIBUTES) and ((Attributes and FILE_ATTRIBUTE_REPARSE_POINT)<>0) then begin
   TypeBits:=TPasRISCVUInt32(PasRISCVWinLX_S_IFLNK);
  end else begin
   TypeBits:=TPasRISCVUInt32(PasRISCVWinLX_S_IFREG);
  end;
 end;
 NewMode:=TypeBits or (aMode and not TPasRISCVUInt32(PasRISCVWinLX_S_IFMT));
 result:=PasRISCVWindowsWriteMetaEAByPath(aMetadataMode,aPath,true,NewMode,false,0,false,0,false,0);
end;

// chown: persists uid/gid in $LXUID/$LXGID (or sidecar). Best-effort.
function PasRISCVWindowsChownEAByPath(const aMetadataMode:TPasRISCVPosixMetadataMode;const aPath:TPasRISCVRawByteString;const aSetUID:boolean;const aUID:TPasRISCVUInt32;const aSetGID:boolean;const aGID:TPasRISCVUInt32):boolean;
begin
 result:=false;
 if not (aSetUID or aSetGID) then begin
  exit;
 end;
 result:=PasRISCVWindowsWriteMetaEAByPath(aMetadataMode,aPath,false,0,aSetUID,aUID,aSetGID,aGID,false,0);
end;

// Sets a reparse point (any tag) on an existing file. Builds the REPARSE_DATA_BUFFER
// (ReparseTag:u32, ReparseDataLength:u16, Reserved:u16, then the data). Best-effort.
function PasRISCVWindowsSetReparsePoint(const aPath:TPasRISCVRawByteString;
                                        const aTag:TPasRISCVUInt32;
                                        const aDataPointer:Pointer;
                                        const aDataLength:TPasRISCVSizeInt):boolean;
var Handle:THandle;
    Buffer:array[0..4111] of TPasRISCVUInt8;
    TagValue:TPasRISCVUInt32;
    DataLengthValue,ReservedValue:TPasRISCVUInt16;
    TotalLength:TPasRISCVSizeInt;
    BytesReturned:DWORD;
begin

 result:=false;

 if (aDataLength<0) or ((8+aDataLength)>TPasRISCVSizeInt(SizeOf(Buffer))) then begin
  exit;
 end;

 Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(aPath)),
                             GENERIC_WRITE,
                             FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                             nil,OPEN_EXISTING,
                             DWORD(PasRISCVWinFILE_FLAG_BACKUP_SEMANTICS) or DWORD(PasRISCVWinFILE_FLAG_OPEN_REPARSE_POINT),
                             0);

 if Handle=INVALID_HANDLE_VALUE then begin
  exit;
 end;

 try

  FillChar(Buffer[0],SizeOf(Buffer),#0);

  TagValue:=aTag;

  DataLengthValue:=TPasRISCVUInt16(aDataLength);

  ReservedValue:=0;

  Move(TagValue,Buffer[0],4);        // ReparseTag
  Move(DataLengthValue,Buffer[4],2); // ReparseDataLength
  Move(ReservedValue,Buffer[6],2);   // Reserved

  if aDataLength>0 then begin
   Move(aDataPointer^,Buffer[8],aDataLength);
  end;

  TotalLength:=8+aDataLength;

  BytesReturned:=0;

  if PasRISCVWinDeviceIoControl(Handle,DWORD(PasRISCVWinFSCTL_SET_REPARSE_POINT),@Buffer[0],DWORD(TotalLength),nil,0,@BytesReturned,nil) then begin
   result:=true;
  end;

 finally
  Windows.CloseHandle(Handle);
 end;
end;

// Reads the reparse tag (and raw data payload) of a file. Returns false if it is not a reparse point.
function PasRISCVWindowsGetReparsePoint(const aPath:TPasRISCVRawByteString;
                                        out aTag:TPasRISCVUInt32;
                                        const aDataBuffer:Pointer;
                                        const aDataBufferSize:TPasRISCVSizeInt;
                                        out aDataLength:TPasRISCVSizeInt):boolean;
var Handle:THandle;
    Buffer:array[0..16383] of TPasRISCVUInt8; // MAXIMUM_REPARSE_DATA_BUFFER_SIZE
    DataLengthValue:TPasRISCVUInt16;
    BytesReturned:DWORD;
begin

 result:=false;

 aTag:=0;

 aDataLength:=0;

 Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(aPath)),
                             GENERIC_READ,
                             FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                             nil,OPEN_EXISTING,
                             DWORD(PasRISCVWinFILE_FLAG_BACKUP_SEMANTICS) or DWORD(PasRISCVWinFILE_FLAG_OPEN_REPARSE_POINT),
                             0);

 if Handle=INVALID_HANDLE_VALUE then begin
  exit;
 end;

 try

  BytesReturned:=0;

  if PasRISCVWinDeviceIoControl(Handle,DWORD(PasRISCVWinFSCTL_GET_REPARSE_POINT),nil,0,@Buffer[0],DWORD(SizeOf(Buffer)),@BytesReturned,nil) and (BytesReturned>=8) then begin

   Move(Buffer[0],aTag,4);

   DataLengthValue:=0;
   Move(Buffer[4],DataLengthValue,2);

   aDataLength:=DataLengthValue;

   if aDataLength>(TPasRISCVSizeInt(BytesReturned)-8) then begin
    aDataLength:=TPasRISCVSizeInt(BytesReturned)-8;
   end;

   if (aDataBuffer<>nil) and (aDataBufferSize>0) and (aDataLength>0) then begin
    if aDataLength>aDataBufferSize then begin
     aDataLength:=aDataBufferSize;
    end;
    Move(Buffer[8],aDataBuffer^,aDataLength);
   end;

   result:=true;

  end;

 finally
  Windows.CloseHandle(Handle);
 end;

end;

// Creates a WSL-compatible LX symlink at aLinkPath. Tries the LX_SYMLINK reparse point first
// ([u32 version=2][UTF-8 target]); if that is rejected (e.g. on filesystems that forbid setting LX
// reparse tags from a normal process), it falls back to storing the target as the file's content.
// Either way the POSIX mode (S_IFLNK + permission bits) is recorded in $LXMOD. Best-effort.
function PasRISCVWindowsCreateLxSymlink(const aMetadataMode:TPasRISCVPosixMetadataMode;
                                        const aLinkPath,aTargetUTF8:TPasRISCVRawByteString;
                                        const aMode:TPasRISCVUInt32):boolean;
var Handle:THandle;
    DataBuffer:array[0..4111] of TPasRISCVUInt8;
    VersionValue:TPasRISCVUInt32;
    TargetLength,DataLength:TPasRISCVSizeInt;
    BytesWritten:DWORD;
    ReparseSucceeded:boolean;
begin

 result:=false;

 // 1. create the empty placeholder (must not already exist)
 Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(aLinkPath)),
                             GENERIC_WRITE,
                             FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                             nil,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,0);
 if Handle=INVALID_HANDLE_VALUE then begin
  exit;
 end;
 Windows.CloseHandle(Handle);

 // 2. best-effort LX_SYMLINK reparse point (preferred, WSL-compatible) -- Native mode only
 TargetLength:=length(aTargetUTF8);
 ReparseSucceeded:=false;
 if aMetadataMode=TPasRISCVPosixMetadataMode.Native then begin
  DataLength:=4+TargetLength;
  if DataLength<=TPasRISCVSizeInt(SizeOf(DataBuffer)) then begin
   VersionValue:=2;
   Move(VersionValue,DataBuffer[0],4);
   if TargetLength>0 then begin
    Move(aTargetUTF8[1],DataBuffer[4],TargetLength);
   end;
   ReparseSucceeded:=PasRISCVWindowsSetReparsePoint(aLinkPath,PasRISCVWinIO_REPARSE_TAG_LX_SYMLINK,@DataBuffer[0],DataLength);
  end;
 end;

 // 3. fallback: store the target as the file content when no reparse point could be set
 if (not ReparseSucceeded) and (TargetLength>0) then begin
  Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(aLinkPath)),
                              GENERIC_WRITE,
                              FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                              nil,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,0);
  if Handle<>INVALID_HANDLE_VALUE then begin
   try
    BytesWritten:=0;
    PasRISCVWinWriteFile(Handle,@aTargetUTF8[1],DWORD(TargetLength),@BytesWritten,nil);
   finally
    Windows.CloseHandle(Handle);
   end;
  end;
 end;

 // 4. record the POSIX mode (forcing the S_IFLNK type bit) so the guest sees a symlink
 PasRISCVWindowsWriteMetaEAByPath(aMetadataMode,aLinkPath,
                                  true,(aMode and not TPasRISCVUInt32(PasRISCVWinLX_S_IFMT)) or TPasRISCVUInt32(PasRISCVWinLX_S_IFLNK),
                                  false,0,false,0,false,0);

 result:=true;

end;

// Creates a special file (char/block device, FIFO or unix socket) as an empty placeholder, marks it
// with the matching best-effort LX reparse tag, and records its full mode in $LXMOD (and the device
// number in $LXDEV for char/block devices). The $LXMOD type bits are the authoritative source for
// the guest; the reparse tag is for WSL interop and fast readdir typing. Best-effort.
function PasRISCVWindowsCreateLxSpecial(const aMetadataMode:TPasRISCVPosixMetadataMode;
                                        const aPath:TPasRISCVRawByteString;
                                        const aMode:TPasRISCVUInt32;
                                        const aDev:TPasRISCVUInt64):boolean;
var Handle:THandle;
    Tag,TypeBits:TPasRISCVUInt32;
    HasDevice:boolean;
begin

 result:=false;

 // 1. create the empty placeholder
 Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(aPath)),
                             GENERIC_WRITE,
                             FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                             nil,CREATE_NEW,FILE_ATTRIBUTE_NORMAL,0);
 if Handle=INVALID_HANDLE_VALUE then begin
  exit;
 end;
 Windows.CloseHandle(Handle);

 // 2. pick the WSL reparse tag from the POSIX type bits
 TypeBits:=aMode and TPasRISCVUInt32(PasRISCVWinLX_S_IFMT);
 HasDevice:=false;
 case TypeBits of
  PasRISCVWinLX_S_IFCHR:begin
   Tag:=PasRISCVWinIO_REPARSE_TAG_LX_CHR;
   HasDevice:=true;
  end;
  PasRISCVWinLX_S_IFBLK:begin
   Tag:=PasRISCVWinIO_REPARSE_TAG_LX_BLK;
   HasDevice:=true;
  end;
  PasRISCVWinLX_S_IFIFO:begin
   Tag:=PasRISCVWinIO_REPARSE_TAG_LX_FIFO;
  end;
  PasRISCVWinLX_S_IFSOCK:begin
   Tag:=PasRISCVWinIO_REPARSE_TAG_AF_UNIX;
  end;
  else begin
   Tag:=0;
  end;
 end;

 // 3. best-effort reparse tag (empty payload) for WSL interop -- Native mode only
 if (aMetadataMode=TPasRISCVPosixMetadataMode.Native) and (Tag<>0) then begin
  PasRISCVWindowsSetReparsePoint(aPath,Tag,nil,0);
 end;

 // 4. authoritative metadata: $LXMOD (type+perm) and, for devices, $LXDEV
 result:=PasRISCVWindowsWriteMetaEAByPath(aMetadataMode,aPath,true,aMode,false,0,false,0,HasDevice,aDev);
end;

// Reads an LX symlink target: first the LX_SYMLINK reparse buffer ([u32 version][UTF-8 target]),
// then the file content fallback. Returns false if neither yields a target.
function PasRISCVWindowsReadLxSymlink(const aPath:TPasRISCVRawByteString;
                                      out aTargetUTF8:TPasRISCVRawByteString):boolean;
var Tag:TPasRISCVUInt32;
    DataBuffer:array[0..4111] of TPasRISCVUInt8;
    ContentBuffer:array[0..4111] of AnsiChar;
    DataLength:TPasRISCVSizeInt;
    Handle:THandle;
    BytesRead:DWORD;
begin

 result:=false;

 aTargetUTF8:='';

 // 1. LX_SYMLINK reparse point
 if PasRISCVWindowsGetReparsePoint(aPath,Tag,@DataBuffer[0],TPasRISCVSizeInt(SizeOf(DataBuffer)),DataLength) then begin
  if (Tag=PasRISCVWinIO_REPARSE_TAG_LX_SYMLINK) and (DataLength>=4) then begin
   SetLength(aTargetUTF8,DataLength-4);
   if (DataLength-4)>0 then begin
    Move(DataBuffer[4],aTargetUTF8[1],DataLength-4);
   end;
   result:=true;
   exit;
  end;
 end;

 // 2. content fallback (our symlink-as-file representation)
 Handle:=Windows.CreateFileA(PAnsiChar(RawByteString(aPath)),
                             GENERIC_READ,
                             FILE_SHARE_READ or FILE_SHARE_WRITE or FILE_SHARE_DELETE,
                             nil,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,0);
 if Handle<>INVALID_HANDLE_VALUE then begin
  try
   BytesRead:=0;
   if PasRISCVWinReadFile(Handle,@ContentBuffer[0],DWORD(SizeOf(ContentBuffer)),@BytesRead,nil) and (BytesRead>0) then begin
    SetLength(aTargetUTF8,BytesRead);
    Move(ContentBuffer[0],aTargetUTF8[1],BytesRead);
    result:=true;
   end;
  finally
   Windows.CloseHandle(Handle);
  end;
 end;

end;

