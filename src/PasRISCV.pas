procedure TPasRISCV.THART.SoftFloatExecVVAdd16(const aVS2,aVS1,aVD:TPasRISCVUInt32;const aVSTART,aEVL:TPasRISCVUInt32;const aUnmasked:Boolean);
var Index:TPasRISCVUInt32;
    FFlags:TPasRISCVUInt8;
    SFA,SFB,SFResult:TPasRISCVSoftFloat16;
    RM:TPasRISCVUInt8;
begin
 FFlags:=0;
 RM:=fState.CSR.fData[TCSR.TAddress.FRM] and $7;
 if aVSTART<aEVL then begin
  for Index:=aVSTART to aEVL-1 do begin
   if aUnmasked or VectorGetMaskBit(Index) then begin
    SFA.ui16:=TPasRISCVUInt16(VectorGetElement(aVS2,Index,16));
    SFB.ui16:=TPasRISCVUInt16(VectorGetElement(aVS1,Index,16));
    SFResult:=TPasRISCVSoftFloat16.Add(SFA,SFB,RM,FFlags);
    VectorSetElement(aVD,Index,16,SFResult.ui16);
   end;
  end;
 end;
 fState.CSR.SetFPUException(FFlags);
end;

