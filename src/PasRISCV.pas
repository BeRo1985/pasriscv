 PatchJmpRel32(DoneFixup1);
 PatchJmpRel32(DoneFixup2);
 PatchJmpRel32(OverflowFixup);
 // Sign-extend 32 to 64
 EmitMOVSXD(aHostIntDest,aHostIntDest);
 FreeHostIntRegister(TempReg1);
end;

