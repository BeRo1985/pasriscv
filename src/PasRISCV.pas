procedure TPasRISCVDynamicArrayList<T>.FastAssign(const aFrom:{$ifdef fpc}{$endif}TPasRISCVDynamicArrayList<T>);
var Index:TPasRISCVSizeInt;
begin
 fCount:=aFrom.fCount;
 if fAllocated<fCount then begin
  fAllocated:=fCount;
  SetLength(fItems,fCount);
 end;
 if fCount>0 then begin
  Move(aFrom.fItems[0],fItems[0],fCount*SizeOf(T));
 end;
end;

