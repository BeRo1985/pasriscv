procedure TPasRISCV.TVirtIOGPUDevice.HandleSetScanoutBlob(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUSetScanoutBlob);
var Resource:TGPUResource;
    Scanout:PGPUScanout;
begin
 fVirglLock.Acquire;
 try
  if aCmd^.ScanoutID<VIRTIO_GPU_MAX_SCANOUTS then begin
   Scanout:=@fScanouts[aCmd^.ScanoutID];
   if aCmd^.ResourceID=0 then begin
    Scanout^.ResourceID:=0;
    Scanout^.Enabled:=false;
    Scanout^.IsBlob:=false;
    Scanout^.Is3D:=false;
    SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
   end else begin
    Resource:=FindResource(aCmd^.ResourceID);
    if assigned(Resource) then begin
     Scanout^.ResourceID:=aCmd^.ResourceID;
     Scanout^.Rect:=aCmd^.Rect;
     Scanout^.Enabled:=true;
     Scanout^.IsBlob:=true;
     Scanout^.Is3D:=false;
     SendOKNoData(aQueueIndex,aDescriptorIndex,@aCmd^.Header);
    end else begin
     SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
    end;
   end;
  end else begin
   SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_SCANOUT_ID);
  end;
 finally
  fVirglLock.Release;
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleResourceAssignUUID(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCmd:PVirtIOGPUResourceUnref);
var Response:TVirtIOGPUResponseResourceUUID;
begin
 fVirglLock.Acquire;
 try
  if assigned(FindResource(aCmd^.ResourceID)) then begin
   FillChar(Response,SizeOf(TVirtIOGPUResponseResourceUUID),#0);
   Response.Header.CtrlType:=VIRTIO_GPU_RESP_OK_RESOURCE_UUID;
   Response.Header.Flags:=aCmd^.Header.Flags;
   Response.Header.FenceID:=aCmd^.Header.FenceID;
   Response.Header.ContextID:=aCmd^.Header.ContextID;
   // Deterministic UUID: resource ID as little-endian in first 4 bytes
   Response.UUID[0]:=TPasRISCVUInt8(aCmd^.ResourceID);
   Response.UUID[1]:=TPasRISCVUInt8(aCmd^.ResourceID shr 8);
   Response.UUID[2]:=TPasRISCVUInt8(aCmd^.ResourceID shr 16);
   Response.UUID[3]:=TPasRISCVUInt8(aCmd^.ResourceID shr 24);
   SendResponse(aQueueIndex,aDescriptorIndex,@Response,SizeOf(TVirtIOGPUResponseResourceUUID));
  end else begin
   SendError(aQueueIndex,aDescriptorIndex,@aCmd^.Header,VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID);
  end;
 finally
  fVirglLock.Release;
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.AddPendingFence(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aHeader:PVirtIOGPUCtrlHeader);
begin
 if length(fPendingFences)<=fCountPendingFences then begin
  SetLength(fPendingFences,(fCountPendingFences+1)*2);
 end;
 fPendingFences[fCountPendingFences].QueueIndex:=aQueueIndex;
 fPendingFences[fCountPendingFences].DescriptorIndex:=aDescriptorIndex;
 fPendingFences[fCountPendingFences].FenceID:=aHeader^.FenceID;
 fPendingFences[fCountPendingFences].ContextID:=aHeader^.ContextID;
 fPendingFences[fCountPendingFences].Header:=aHeader^;
 inc(fCountPendingFences);
end;

procedure TPasRISCV.TVirtIOGPUDevice.RetireFences(const aContextID:TPasRISCVUInt32;const aFenceID:TPasRISCVUInt64;const aContextFence:Boolean);
var i,WriteIndex:TPasRISCVSizeInt;
begin
 WriteIndex:=0;
 for i:=0 to fCountPendingFences-1 do begin
  if aContextFence then begin
   if (fPendingFences[i].ContextID=aContextID) and (fPendingFences[i].FenceID<=aFenceID) then begin
    SendOKNoData(fPendingFences[i].QueueIndex,fPendingFences[i].DescriptorIndex,@fPendingFences[i].Header);
    continue;
   end;
  end else begin
   if (fPendingFences[i].ContextID=0) and (fPendingFences[i].FenceID<=aFenceID) then begin
    SendOKNoData(fPendingFences[i].QueueIndex,fPendingFences[i].DescriptorIndex,@fPendingFences[i].Header);
    continue;
   end;
  end;
  fPendingFences[WriteIndex]:=fPendingFences[i];
  inc(WriteIndex);
 end;
 fCountPendingFences:=WriteIndex;
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleGetCapsetInfo(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aHeader:PVirtIOGPUCtrlHeader);
var Command:TVirtIOGPUGetCapsetInfo;
    Response:TVirtIOGPUResponseCapsetInfo;
    MaxVersion,MaxSize:TPasRISCVUInt32;
begin
 if fVirglInitialized then begin
  fVirglLock.Acquire;
  try
   Move(fRecvBuffer[0],Command,SizeOf(TVirtIOGPUGetCapsetInfo));
   FillChar(Response,SizeOf(TVirtIOGPUResponseCapsetInfo),#0);
   Response.Header.CtrlType:=VIRTIO_GPU_RESP_OK_CAPSET_INFO;
   Response.Header.Flags:=aHeader^.Flags;
   Response.Header.FenceID:=aHeader^.FenceID;
   Response.Header.ContextID:=aHeader^.ContextID;
   if Command.CapsetIndex=0 then begin
    Response.CapsetID:=VIRTIO_GPU_CAPSET_VENUS;
    if assigned(virgl_renderer_get_cap_set) then begin
     MaxVersion:=0;
     MaxSize:=0;
     virgl_renderer_get_cap_set(VIRTIO_GPU_CAPSET_VENUS,@MaxVersion,@MaxSize);
     Response.CapsetMaxVersion:=MaxVersion;
     Response.CapsetMaxSize:=MaxSize;
    end else begin
     Response.CapsetMaxVersion:=1;
     Response.CapsetMaxSize:=4096;
    end;
   end else if Command.CapsetIndex=1 then begin
    Response.CapsetID:=VIRTIO_GPU_CAPSET_VIRGL2;
    if assigned(virgl_renderer_get_cap_set) then begin
     MaxVersion:=0;
     MaxSize:=0;
     virgl_renderer_get_cap_set(VIRTIO_GPU_CAPSET_VIRGL2,@MaxVersion,@MaxSize);
     Response.CapsetMaxVersion:=MaxVersion;
     Response.CapsetMaxSize:=MaxSize;
    end;
   end else begin
    Response.Header.CtrlType:=VIRTIO_GPU_RESP_ERR_INVALID_PARAMETER;
   end;
   SendResponse(aQueueIndex,aDescriptorIndex,@Response,SizeOf(TVirtIOGPUResponseCapsetInfo));
  finally
   fVirglLock.Release;
  end;
 end else begin
  SendError(aQueueIndex,aDescriptorIndex,aHeader,VIRTIO_GPU_RESP_ERR_UNSPEC);
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleGetCapset(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aHeader:PVirtIOGPUCtrlHeader);
var Command:TVirtIOGPUGetCapset;
    MaxVersion,MaxSize:TPasRISCVUInt32;
    ResponseBuf:TPasRISCVUInt8DynamicArray;
    ResponseHdr:PVirtIOGPUResponseCapset;
begin
 if fVirglInitialized then begin
  fVirglLock.Acquire;
  try
   Move(fRecvBuffer[0],Command,SizeOf(TVirtIOGPUGetCapset));
   MaxVersion:=0;
   MaxSize:=0;
   if assigned(virgl_renderer_get_cap_set) then begin
    virgl_renderer_get_cap_set(Command.CapsetID,@MaxVersion,@MaxSize);
   end;
   SetLength(ResponseBuf,SizeOf(TVirtIOGPUResponseCapset)+MaxSize);
   FillChar(ResponseBuf[0],length(ResponseBuf),#0);
   ResponseHdr:=PVirtIOGPUResponseCapset(@ResponseBuf[0]);
   ResponseHdr^.Header.CtrlType:=VIRTIO_GPU_RESP_OK_CAPSET;
   ResponseHdr^.Header.Flags:=aHeader^.Flags;
   ResponseHdr^.Header.FenceID:=aHeader^.FenceID;
   ResponseHdr^.Header.ContextID:=aHeader^.ContextID;
   ResponseHdr^.Version:=Min(Command.CapsetVersion,MaxVersion);
   ResponseHdr^.Length:=MaxSize;
   if (MaxSize>0) and assigned(virgl_renderer_fill_caps) then begin
    virgl_renderer_fill_caps(Command.CapsetID,ResponseHdr^.Version,@ResponseBuf[SizeOf(TVirtIOGPUResponseCapset)]);
   end;
   SendResponse(aQueueIndex,aDescriptorIndex,@ResponseBuf[0],SizeOf(TVirtIOGPUResponseCapset)+MaxSize);
  finally
   fVirglLock.Release;
  end;
 end else begin
  SendError(aQueueIndex,aDescriptorIndex,aHeader,VIRTIO_GPU_RESP_ERR_UNSPEC);
 end;
end;

procedure TPasRISCV.TVirtIOGPUDevice.HandleContextCreate(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aCommand:PVirtIOGPUContextCreate);
var CapsetID:TPasRISCVUInt32;
    DebugName:string;
    GPUContext:TGPUContext;
    NLen:TPasRISCVUInt32;
begin
 if fVirglInitialized then begin
  fVirglLock.Acquire;
  try
   CapsetID:=aCommand^.ContextInit and $ff;
   NLen:=Min(aCommand^.NLen,64);
   if NLen>0 then begin
    SetLength(DebugName,NLen);
    Move(aCommand^.DebugName[0],DebugName[1],NLen);
   end;
   DestroyContext(aCommand^.Header.ContextID);
   if assigned(virgl_renderer_context_destroy) then begin
    virgl_renderer_context_destroy(aCommand^.Header.ContextID);
   end;
   GPUContext:=CreateContext(aCommand^.Header.ContextID,CapsetID,DebugName);
   if assigned(GPUContext) then begin
    if assigned(virgl_renderer_context_create_with_flags) then begin
     virgl_renderer_context_create_with_flags(aCommand^.Header.ContextID,aCommand^.ContextInit,NLen,PAnsiChar(DebugName));
    end else if assigned(virgl_renderer_context_create) then begin
     virgl_renderer_context_create(aCommand^.Header.ContextID,NLen,PAnsiChar(DebugName));
    end;
    SendOKNoData(aQueueIndex,aDescriptorIndex,@aCommand^.Header);
   end else begin
    SendError(aQueueIndex,aDescriptorIndex,@aCommand^.Header,VIRTIO_GPU_RESP_ERR_OUT_OF_MEMORY);
   end;
  finally
   fVirglLock.Release;
  end;
 end else begin
  SendError(aQueueIndex,aDescriptorIndex,@aCommand^.Header,VIRTIO_GPU_RESP_ERR_UNSPEC);
 end;
end;

