begin
 SoftFloatUnpack(aA,aMantissaBits,aSignShift,aInfiniteExponent,Sign,Exponent,Mantissa);
 if Exponent=TPasRISCVInt32(aInfiniteExponent) then begin
  if Mantissa=0 then begin
   if Sign then begin
    result:=1;
   end else begin
    result:=128;
   end;
  end else if SoftFloatIsSignalingNaN(Mantissa,aMantissaBits) then begin
   result:=256;
  end else begin
   result:=512;
  end;
 end else if Exponent=0 then begin
  if Mantissa=0 then begin
   if Sign then begin
    result:=8;
   end else begin
    result:=16;
   end;
  end else begin
   if Sign then begin
    result:=4;
   end else begin
    result:=32;
   end;
  end;
 end else begin
  if Sign then begin
   result:=2;
  end else begin
   result:=64;
  end;
 end;
end;

function SoftFloatAddSubCore(const aA,aB:TPasRISCVUInt64;const aSub:boolean;const aMantissaBits,aSignShift:TPasRISCVInt32;const aInfiniteExponent:TPasRISCVUInt32;const aExponentBias:TPasRISCVInt32;const aCanonicalNaN:TPasRISCVUInt64;const aRM:TPasRISCVUInt8;var aFFlags:TPasRISCVUInt8):TPasRISCVUInt64;
