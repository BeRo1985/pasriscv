 if aShift<=0 then begin
  result:=aValue;
 end else if aShift>=128 then begin
  result:=SoftFloatBits128Zero;
 end else if aShift=64 then begin
  result.Lo:=aValue.Hi;
  result.Hi:=0;
 end else if aShift>64 then begin
  result.Lo:=aValue.Hi shr (aShift-64);
  result.Hi:=0;
 end else begin
  result.Lo:=(aValue.Lo shr aShift) or (aValue.Hi shl (64-aShift));
  result.Hi:=aValue.Hi shr aShift;
 end;
end;

function SoftFloatBits128ShrSticky(const aValue:TSoftFloatBits128;const aShift:TPasRISCVInt32):TSoftFloatBits128;
var Lost:boolean;
begin
 if aShift<=0 then begin
  result:=aValue;
 end else if aShift<64 then begin
  Lost:=(aValue.Lo and ((TPasRISCVUInt64(1) shl aShift)-1))<>0;
  result.Lo:=(aValue.Lo shr aShift) or (aValue.Hi shl (64-aShift));
  result.Hi:=aValue.Hi shr aShift;
  if Lost then begin
   result.Lo:=result.Lo or 1;
  end;
 end else if aShift=64 then begin
  result.Lo:=aValue.Hi;
  result.Hi:=0;
  if aValue.Lo<>0 then begin
   result.Lo:=result.Lo or 1;
  end;
 end else if aShift<128 then begin
  Lost:=aValue.Lo<>0;
  if (aShift>64) and ((aValue.Hi and ((TPasRISCVUInt64(1) shl (aShift-64))-1))<>0) then begin
   Lost:=true;
  end;
  result.Lo:=aValue.Hi shr (aShift-64);
  result.Hi:=0;
  if Lost then begin
   result.Lo:=result.Lo or 1;
  end;
 end else begin
  result.Hi:=0;
  if (aValue.Lo<>0) or (aValue.Hi<>0) then begin
   result.Lo:=1;
  end else begin
   result.Lo:=0;
  end;
 end;
end;

