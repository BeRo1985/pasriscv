procedure TPasRISCV.THART.TJustInTimeCompiler.EmitInit;
var GuestReg:TRegister;
{$ifdef PasRISCVJustInTimeCompilerFPU}
    FPURegister:TFPURegister;
{$endif}
{$ifdef PasRISCVJustInTimeCompilerVector}
    VReg:TPasRISCVUInt32;
{$endif}
begin

 fLinkage:=TLinkage.Jmp;
{$ifdef PasRISCVJustInTimeCompilerNativeLinker}
 fLinkEntryCount:=0;
{$endif}
 fPCOffset:=0;
 fInstructionCount:=0;

 fABIReclaimMask:=ABIReclaimHostRegisterMask;
 fABIReclaimCount:=0;
 fLRUCounter:=0;

 fHostIntRegisterMask:=DefaultHostRegisterMask;
 for GuestReg:=Low(TRegister) to High(TRegister) do begin
  fHostIntRegisterInfos[GuestReg].HostRegister:=REG_ILL;
  fHostIntRegisterInfos[GuestReg].LastUsed:=0;
  fHostIntRegisterInfos[GuestReg].Flags:=0;
  fHostIntRegisterInfos[GuestReg].AUIPCOffset:=0;
 end;

{$ifdef PasRISCVJustInTimeCompilerFPU}
 fBlockFSDirtyEmitted:=false;
 fHostFPURegisterMask:=DefaultFPURegisterMask;
 for FPURegister:=Low(TFPURegister) to High(TFPURegister) do begin
  fHostFPURegisterInfos[FPURegister].HostRegister:=REG_ILL;
  fHostFPURegisterInfos[FPURegister].LastUsed:=0;
  fHostFPURegisterInfos[FPURegister].Flags:=0;
 end;
{$endif}

{$ifdef PasRISCVJustInTimeCompilerVector}
 fBlockVectorEnabled:=false;
 fBlockVStartChecked:=false;
 fBlockVLChecked:=false;
 fBlockVTypeChecked:=false;
 fBlockVSDirtyEmitted:=false;
 fHostVectorRegisterMask:=DefaultVectorRegisterMask;
 for VReg:=0 to 31 do begin
  fHostVectorRegisterInfos[VReg].HostRegister:=REG_ILL;
  fHostVectorRegisterInfos[VReg].LastUsed:=0;
  fHostVectorRegisterInfos[VReg].Flags:=0;
 end;
{$endif}

{$ifdef PasRISCVJustInTimeCompilerCBO}
 fBlockCBOInvalChecked:=false;
 fBlockCBOCleanFlushChecked:=false;
 fBlockCBOZeroChecked:=false;
{$endif}

 fInitialCodeSize:=fTemporaryCodeSize;

end;

procedure TPasRISCV.THART.TJustInTimeCompiler.EmitEnd(const aLinkage:TLinkage);
var SavedHostRegMask:TPasRISCVUInt32;
    SavedABIReclaimMask:TPasRISCVUInt32;
    SavedABIReclaimCount:TPasRISCVUInt32;
    SavedIntRegInfos:TIntRegisterInfos;
{$ifdef PasRISCVJustInTimeCompilerFPU}
    SavedFPURegInfos:TFPURegisterInfos;
{$endif}
{$ifdef PasRISCVJustInTimeCompilerVector}
    SavedVectorRegisterInfos:TVectorRegisterInfos;
{$endif}
    ExitFixup:TPasRISCVUInt32;
    RunStateExitFixup:TPasRISCVUInt32;
begin

{if fTemporaryCodeSize=fInitialCodeSize then begin
  EmitNativeNOP;
 end;}

 SavedHostRegMask:=fHostIntRegisterMask;
 SavedABIReclaimMask:=fABIReclaimMask;
 SavedABIReclaimCount:=fABIReclaimCount;
 SavedIntRegInfos:=fHostIntRegisterInfos;
{$ifdef PasRISCVJustInTimeCompilerFPU}
 SavedFPURegInfos:=fHostFPURegisterInfos;
{$endif}
{$ifdef PasRISCVJustInTimeCompilerVector}
 SavedVectorRegisterInfos:=fHostVectorRegisterInfos;
{$endif}

{$ifdef PasRISCVJustInTimeCompilerDebug}
 if fDebugJITCounter<60 then begin
  writeln('  EmitEnd: pcOff=',fPCOffset,' cnt=',fInstructionCount,' linkage=',ord(aLinkage));
 end;
{$endif}

 // 1. Save all dirty guest registers
 SaveAllDirtyIntRegisters;
{$ifdef PasRISCVJustInTimeCompilerFPU}
 SaveAllDirtyFPURegisters;
{$endif}
{$ifdef PasRISCVJustInTimeCompilerVector}
 SaveAllDirtyVectorRegisters;
{$endif}

 // 2. Reset host reg mask
 fHostIntRegisterMask:=DefaultHostRegisterMask;

 // 3. Update guest PC
 EmitUpdatePC;

 // 4. Update cycle counter and check 16-bit boundary crossing
 if fInstructionCount<>0 then begin
  ExitFixup:=EmitCycleUpdateAndCheck(fInstructionCount);
 end else begin
  ExitFixup:=0;
 end;

 // 5. RunState check: jne .exit if not running
 EmitRunStateCheck;
 EmitJccRel32(CC_NE,0);
 RunStateExitFixup:=fTemporaryCodeSize-4;

 // 6. Restore ABI callee-saved registers
 EmitRestoreABIRegs;

 // 7. FPU epilog
{$if defined(PasRISCVJustInTimeCompiler) and defined(PasRISCVJustInTimeCompilerFPU)}
 EmitFPUEpilog;
{$ifend}

 // 8. Linkage-specific dispatch
{$ifdef PasRISCVJustInTimeCompilerNativeLinker}
 case aLinkage of
  TLinkage.Jmp:begin
   LinkBlock;
  end;
  TLinkage.Tail:begin
   EmitLookupBlock;
  end;
  else begin
   EmitRET;
  end;
 end;
{$else}
 EmitRET;
{$endif}

 // 9. .exit path (countdown expired or runstate not running)
 if ExitFixup<>0 then begin
  PatchJmpRel32(ExitFixup);
 end;
 PatchJmpRel32(RunStateExitFixup);

 EmitRestoreABIRegs;

 // 10. .exit path FPU epilog
{$if defined(PasRISCVJustInTimeCompiler) and defined(PasRISCVJustInTimeCompilerFPU)}
 EmitFPUEpilog;
{$ifend}

 EmitRET;

 // 11. Restore saved state for continued compilation
 fHostIntRegisterMask:=SavedHostRegMask;
 fABIReclaimMask:=SavedABIReclaimMask;
 fABIReclaimCount:=SavedABIReclaimCount;
 fHostIntRegisterInfos:=SavedIntRegInfos;
{$ifdef PasRISCVJustInTimeCompilerFPU}
 fHostFPURegisterInfos:=SavedFPURegInfos;
{$endif}
{$ifdef PasRISCVJustInTimeCompilerVector}
 fHostVectorRegisterInfos:=SavedVectorRegisterInfos;
{$endif}

end;

