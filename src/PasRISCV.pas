  end;
  TPasRISCV.TVirtIOSoundDevice.VIRTIO_SND_PCM_FMT_DSD_U16:begin
   BitsPerSample:=16;
  end;
  TPasRISCV.TVirtIOSoundDevice.VIRTIO_SND_PCM_FMT_DSD_U32:begin
