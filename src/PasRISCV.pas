 SetCount(aCount);
end;

procedure TPasRISCVDynamicArrayList<T>.Reserve(const aCount:TPasRISCVSizeInt);
var NewAllocated:TPasRISCVSizeInt;
begin
 NewAllocated:=RoundUpToPowerOfTwoSizeUInt(aCount);
 if fAllocated<NewAllocated then begin
  fAllocated:=NewAllocated;
  SetLength(fItems,fAllocated);
 end;
end;

procedure TPasRISCVDynamicArrayList<T>.Finish;
begin
 fAllocated:=fCount;
 if length(fItems)<>fAllocated then begin
  SetLength(fItems,fAllocated);
 end;
end;

