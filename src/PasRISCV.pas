procedure TPasRISCV.TVirtIOGPUDevice.HandleSubmit3D(const aQueueIndex,aDescriptorIndex:TPasRISCVUInt64;const aHeader:PVirtIOGPUCtrlHeader);
var Command:TVirtIOGPUCommandSubmit;
    RingIdx:TPasRISCVUInt8;
begin
 if fVirglInitialized then begin
  fVirglLock.Acquire;
  try
   Move(fRecvBuffer[0],Command,SizeOf(TVirtIOGPUCommandSubmit));
   if (Command.Size>0) and (SizeOf(TVirtIOGPUCommandSubmit)+Command.Size<=TPasRISCVUInt64(length(fRecvBuffer))) then begin
    if assigned(virgl_renderer_submit_cmd) then begin
     virgl_renderer_submit_cmd(@fRecvBuffer[SizeOf(TVirtIOGPUCommandSubmit)],aHeader^.ContextID,Command.Size div 4);
    end;
   end;
   if (aHeader^.Flags and VIRTIO_GPU_FLAG_FENCE)<>0 then begin
    if (aHeader^.Flags and VIRTIO_GPU_FLAG_INFO_RING_IDX)<>0 then begin
     RingIdx:=TPasRISCVUInt8((aHeader^.Flags shr 8) and $ff);
     if assigned(virgl_renderer_context_create_fence) then begin
      virgl_renderer_context_create_fence(aHeader^.ContextID,1{VIRGL_RENDERER_CONTEXT_FENCE_RING_IDX},RingIdx,aHeader^.FenceID,0);
     end;
    end else begin
     if assigned(virgl_renderer_create_fence) then begin
      virgl_renderer_create_fence(aHeader^.FenceID,aHeader^.ContextID);
     end;
    end;
    if assigned(virgl_renderer_poll) then begin
     virgl_renderer_poll;
    end;
    AddPendingFence(aQueueIndex,aDescriptorIndex,aHeader);
   end else begin
    if assigned(virgl_renderer_poll) then begin
     virgl_renderer_poll;
    end;
    SendOKNoData(aQueueIndex,aDescriptorIndex,aHeader);
   end;
  finally
   fVirglLock.Release;
  end;
 end else begin
  SendError(aQueueIndex,aDescriptorIndex,aHeader,VIRTIO_GPU_RESP_ERR_UNSPEC);
 end;
end;

